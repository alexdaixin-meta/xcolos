{
  "wikipedia": {
    "exclude_title": [
      "^List of",
      "^Lists of",
      "\\(video game\\)",
      "\\(disambiguation\\)",
      "\\(film\\)",
      "\\(TV",
      "\\(album\\)",
      "\\(band\\)",
      "\\(novel\\)",
      "\\(song\\)",
      "^Category:",
      "^Template:",
      "^Portal:",
      "^Outline of",
      "^Glossary of",
      " theory$",
      " equilibrium$",
      " strategy$",
      "^Game ",
      "Awards$",
      "^Perfect information",
      "^Information set",
      "^Card game$",
      "^Zero-sum game$",
      "^Solved game$",
      "^Hot game$",
      "^Focal point",
      "^Otome"
    ],
    "min_chars": 1200,
    "max_chars": 9000
  },
  "pagat.com": {
    "exclude_path": [
      "/index\\.html?$",
      "^/(class|number|links|alpha|sitemap|statistics)[/.]",
      "^/(de|it|es|fi)/",
      "^/(patience|solitaire)/",
      "history\\.html$",
      "^/poker/rules/"
    ]
  },
  "ultraboardgames.com": {
    "include_path": [
      "^/[^/]+/game-rules\\.php$"
    ],
    "title_segment": -2
  },
  "gamerules.com": {
    "include_path": [
      "^/rules/[^/]+/?$"
    ]
  },
  "bicyclecards.com": {
    "include_path": [
      "^/(how-to-play|rules)/[^/]+/?$"
    ]
  },
  "meeplelikeus.co.uk": {
    "exclude_path": [
      "accessibility-teardow",
      "newsletter",
      "patreon",
      "gaming-in-gothenburg",
      "game-dev-chronicles",
      "a-book-a-week",
      "^/author/"
    ],
    "title_strip": "\\s+(1[6-9]|20)\\d\\d$"
  }
}
