    {
      "use": "update",
      "phase": "deal",
      "label": "turn the trump card",
      "when": {
        "calc": "trick_in_hand == 1"
      },
      "do": [
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "set": {
            "key": "trump_card",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "trump_suit",
            "value": {
              "calc": "trump_card[0] if trump_card[0] in ['R', 'B', 'G', 'Y'] else 'none'"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "deal",
      "label": "the hand begins",
      "when": {
        "calc": "trick_in_hand == 1"
      },
      "to": "all",
      "text": "Hand {hand_number}: dealer is seat {dealer}; turned card is {trump_card}; trump is {trump_suit}."
    },
    {
      "use": "update",
      "phase": "deal",
      "label": "reset bids and tricks",
      "when": {
        "calc": "trick_in_hand == 1"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "tricks_taken",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid_said",
            "value": ""
          }
        }
      ]
    },
    {
      "use": "sync",
      "phase": "deal",
      "label": "your hand",
      "when": {
        "calc": "trick_in_hand == 1"
      },
      "mode": "self",
      "to": "all",
      "fields": [
        "hand",
        "score"
      ],
      "text": "Your cards and score for this hand (trump card {trump_card}):"
    },
    {
      "use": "poll",
      "phase": "bid",
      "label": "the bids",
      "when": {
        "calc": "trick_in_hand == 1"
      },
      "to": "acting",
      "answer": {
        "type": "number",
        "min": {
          "calc": "bid_min"
        },
        "max": {
          "calc": "bid_max"
        }
      },
      "store": "bid_said",
      "text": "Hand {hand_number}, trump is {trump_suit} (turned card {trump_card}). Bid how many of the {tricks_per_hand} tricks you will take, a whole number from {bid_min} to {bid_max}. Nobody sees any bid until all are in."
    },
    {
      "use": "update",
      "phase": "bid",
      "label": "the bids revealed",
      "when": {
        "calc": "trick_in_hand == 1"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": {
              "calc": "int(you.bid_said)"
            },
            "text": "Seat {player} bids {value}."
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "trick",
      "label": "clear the trick",
      "do": [
        {
          "set": {
            "key": "led_suit",
            "value": "none"
          }
        },
        {
          "set": {
            "key": "trick_cards",
            "value": {
              "calc": "[]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "played_card",
            "value": ""
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "trick",
      "label": "lead card",
      "to": {
        "where": "you.seat == leader"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "hand"
        }
      },
      "each": {
        "do": [
          {
            "remove": {
              "player": "$seat",
              "key": "hand",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "trick_cards",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "played_history",
              "value": "$answer"
            }
          },
          {
            "set": {
              "player": "$seat",
              "key": "played_card",
              "value": "$answer"
            }
          },
          {
            "set": {
              "key": "led_suit",
              "value": {
                "calc": "$answer[0]"
              },
              "if": {
                "calc": "$answer[0] in ['R', 'B', 'G', 'Y']"
              }
            }
          }
        ]
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} leads {value}."
      },
      "text": "Trick {trick_in_hand} of hand {hand_number}. You lead: play any card from your hand. Trump is {trump_suit}."
    },
    {
      "use": "ask",
      "phase": "trick",
      "label": "second card",
      "to": {
        "where": "you.seat == leader % 3 + 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "hand"
        }
      },
      "each": {
        "do": [
          {
            "set": {
              "key": "led_suit",
              "value": {
                "calc": "$answer[0]"
              },
              "if": {
                "calc": "led_suit == 'none' and trick_cards[0][0] != 'W' and $answer[0] in ['R', 'B', 'G', 'Y']"
              }
            }
          },
          {
            "remove": {
              "player": "$seat",
              "key": "hand",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "trick_cards",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "played_history",
              "value": "$answer"
            }
          },
          {
            "set": {
              "player": "$seat",
              "key": "played_card",
              "value": "$answer"
            }
          }
        ]
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} plays {value}."
      },
      "text": "Trick {trick_in_hand}: cards so far {trick_cards}, led suit {led_suit}, trump {trump_suit}. Play any card from your hand; you need not follow suit."
    },
    {
      "use": "ask",
      "phase": "trick",
      "label": "third card",
      "to": {
        "where": "you.seat == (leader + 1) % 3 + 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "hand"
        }
      },
      "each": {
