      "to": "all",
      "text": "You start with:"
    },
    {
      "use": "tell",
      "label": "deck composition",
      "to": "all",
      "text": "The goods deck holds {deck_size} cards: {deck_diamond} Diamond, {deck_silver} Silver and {deck_cloth} Cloth, shuffled."
    }
  ],
  "steps": [
    {
      "use": "update",
      "phase": "start",
      "label": "the round begins",
      "do": [
        {
          "adjust": {
            "key": "round",
            "value": 1
          }
        },
        {
          "set": {
            "key": "first_seat",
            "value": {
              "calc": "1 if round in [1, 4, 5, 8, 9, 12, 13, 16] else 2"
            }
          }
        }
      ],
      "text": "Round {round} of {rounds}. Seat {first_seat} acts first."
    },
    {
      "use": "update",
      "phase": "start",
      "label": "restock",
      "do": [
        {
          "adjust": {
            "key": "market_cloth",
            "value": {
              "calc": "restock_per_round"
            },
            "if": {
              "calc": "round in [1, 2, 9, 10]"
            },
            "text": "Restock: one Cloth card is added to the market."
          }
        },
        {
          "adjust": {
            "key": "market_silver",
            "value": {
              "calc": "restock_per_round"
            },
            "if": {
              "calc": "round in [3, 4, 11, 12]"
            },
            "text": "Restock: one Silver card is added to the market."
          }
        },
        {
          "adjust": {
            "key": "market_camel",
            "value": {
              "calc": "restock_per_round"
            },
            "if": {
              "calc": "round in [5, 6, 15, 16]"
            },
            "text": "Restock: one Camel card is added to the market."
          }
        },
        {
          "adjust": {
            "key": "market_diamond",
            "value": {
              "calc": "restock_per_round"
            },
            "if": {
              "calc": "round in [7, 8, 13, 14]"
            },
            "text": "Restock: one Diamond card is added to the market."
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "draw",
      "label": "private draw",
      "do": [
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "draw_kept",
            "value": {
              "calc": "1 if sum([p.diamond + p.silver + p.cloth for p in players if p.seat == first_seat]) < hand_limit else 0"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "first_seat"
            },
            "key": "diamond",
            "value": {
              "calc": "draws_per_round"
            },
            "if": {
              "calc": "pick == 'Diamond' and draw_kept == 1"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "first_seat"
            },
            "key": "silver",
            "value": {
              "calc": "draws_per_round"
            },
            "if": {
              "calc": "pick == 'Silver' and draw_kept == 1"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "first_seat"
            },
            "key": "cloth",
            "value": {
              "calc": "draws_per_round"
            },
            "if": {
              "calc": "pick == 'Cloth' and draw_kept == 1"
            }
          }
        },
        {
          "append": {
            "key": "discard",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "draw_kept == 0"
            }
          }
        },
        {
          "set": {
            "player": {
              "calc": "first_seat"
            },
            "key": "last_draw",
            "value": {
              "calc": "pick + (' (kept)' if draw_kept == 1 else ' (discarded: hand full)')"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "[o[0] for o in catalog if (o[1] == 'TAKE' and o[3] >= take_min and (market_diamond if o[2] == 'Diamond' else (market_silver if o[2] == 'Silver' else market_cloth)) >= o[3] and you.camels >= o[3] - 1 and you.diamond + you.silver + you.cloth + o[3] <= hand_limit) or (o[1] == 'CAMELS' and market_camel >= 1) or (o[1] == 'SELL' and o[3] >= (sell_min_diamond if o[2] == 'Diamond' else (sell_min_silver if o[2] == 'Silver' else sell_min_cloth)) and (you.diamond if o[2] == 'Diamond' else (you.silver if o[2] == 'Silver' else you.cloth)) >= o[3])]"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "len(you.offer) == 0"
            },
            "key": "offer",
            "value": [
              "PASS"
            ]
          }
        }
      ],
      "text": "Seat {first_seat} draws a card from the deck in private."
    },
    {
      "use": "sync",
      "phase": "first turn",
      "label": "first player's view",
      "mode": "self",
      "to": {
        "where": "you.seat == first_seat"
      },
      "text": "Your hand and herd (last_draw is the card you just drew):"
    },
    {
      "use": "ask",
      "phase": "first turn",
      "label": "first player's turn",
      "to": {
        "where": "you.seat == first_seat and 'PASS' not in you.offer"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "a1"
      },
      "text": "Round {round}: your turn. Market: Diamond {market_diamond}, Silver {market_silver}, Cloth {market_cloth}, Camel {market_camel}. Prices: Diamond {price_diamond}, Silver {price_silver}, Cloth {price_cloth}. Choose one action: TAKE <good> <n> (return n-1 camels to the market), CAMELS (take all market camels), or SELL <good> <n>."
    },
    {
      "use": "update",
      "phase": "first turn",
      "label": "resolve first turn",
      "do": [
        {
          "set": {
            "key": "mover",
            "value": {
              "calc": "first_seat"
            }
          }
        },
        {
          "set": {
            "key": "act_kind",
            "value": {
              "calc": "([o[1] for o in catalog if o[0] == $a1] + ['PASS'])[0] if any(p.seat == mover and 'PASS' not in p.offer and $a1 in p.offer for p in players) else 'PASS'"
            }
          }
        },
        {
          "set": {
            "key": "act_good",
            "value": {
              "calc": "([o[2] for o in catalog if o[0] == $a1] + [''])[0] if act_kind != 'PASS' else ''"
            }
          }
        },
        {
          "set": {
            "key": "act_n",
            "value": {
              "calc": "([o[3] for o in catalog if o[0] == $a1] + [0])[0] if act_kind != 'PASS' else 0"
            }
          }
        },
        {
          "set": {
            "key": "last_action",
            "value": {
              "calc": "$a1 if act_kind != 'PASS' else 'PASS'"
            }
          }
        },
        {
          "adjust": {
            "key": "market_diamond",
            "value": {
              "calc": "-act_n"
            },
            "if": {
              "calc": "act_kind == 'TAKE' and act_good == 'Diamond'"
            }
          }
        },
        {
          "adjust": {
            "key": "market_silver",
            "value": {
              "calc": "-act_n"
            },
            "if": {
              "calc": "act_kind == 'TAKE' and act_good == 'Silver'"
            }
          }
        },
        {
          "adjust": {
            "key": "market_cloth",
            "value": {
              "calc": "-act_n"
            },
            "if": {
              "calc": "act_kind == 'TAKE' and act_good == 'Cloth'"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "mover"
            },
            "key": "diamond",
            "value": {
              "calc": "act_n"
            },
            "if": {
              "calc": "act_kind == 'TAKE' and act_good == 'Diamond'"
            }
          }
        },
        {
