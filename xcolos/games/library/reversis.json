      "use": "update",
      "phase": "lead",
      "label": "the lead is played",
      "do": [
        {
          "set": {
            "key": "lead_card",
            "value": "$lead"
          }
        },
        {
          "remove": {
            "player": {
              "calc": "leader"
            },
            "key": "hand",
            "value": {
              "calc": "lead_card"
            }
          }
        },
        {
          "set": {
            "player": {
              "calc": "leader"
            },
            "key": "played_card",
            "value": {
              "calc": "lead_card"
            }
          }
        },
        {
          "set": {
