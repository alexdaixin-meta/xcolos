            }
          }
        },
        {
          "set": {
            "key": "open_triplets",
            "value": {
              "calc": "['T1', 'T2', 'T3', 'T4']"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "layout",
      "label": "the triplets",
      "to": "all",
      "text": "Round {round} (session {session}). Face-up cards: T1 A {t1_a}, B {t1_b}; T2 A {t2_a}, B {t2_b}; T3 A {t3_a}, B {t3_b}; T4 A {t4_a}, B {t4_b}. Each triplet also has one face-down card."
    },
    {
      "use": "update",
      "phase": "draft",
      "label": "prepare the draft",
      "do": [
        {
          "set": {
            "key": "picker",
            "value": {
              "calc": "((round - 1) % len(players)) + 1"
            }
          }
        },
        {
          "set": {
            "key": "picks_made",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "[x[0] + ': keep ' + k[0] + ' (' + x[k[2]] + '), give ' + k[1] + ' (' + x[k[3]] + ') to seat ' + r[1] for x in [['T1', t1_a, t1_b], ['T2', t2_a, t2_b], ['T3', t3_a, t3_b], ['T4', t4_a, t4_b]] if x[0] in open_triplets for k in [['A', 'B', 1, 2], ['B', 'A', 2, 1]] for r in [[1, '1'], [2, '2'], [3, '3'], [4, '4']] if r[0] != you.seat]"
            }
          }
        }
      ]
    },
    {
      "use": "repeat",
      "phase": "draft",
      "label": "the draft",
      "until": {
        "calc": "picks_made >= len(players)"
      },
      "max": 4,
      "steps": [
        {
          "use": "ask",
          "phase": "draft",
          "label": "pick a triplet",
          "to": {
            "where": "you.seat == picker"
          },
          "answer": {
            "type": "choice",
            "options": {
              "attribute": "offer"
            }
          },
          "broadcast": {
            "to": "all",
            "text": "Seat {seat} picks {value}."
          },
          "each": {
            "do": [
              {
                "set": {
                  "key": "trip",
                  "value": {
                    "calc": "'T1' if 'T1:' in $answer else ('T2' if 'T2:' in $answer else ('T3' if 'T3:' in $answer else 'T4'))"
                  }
                }
              },
              {
                "set": {
                  "key": "kc",
                  "value": {
                    "calc": "(t1_a if trip == 'T1' else (t2_a if trip == 'T2' else (t3_a if trip == 'T3' else t4_a))) if 'keep A' in $answer else (t1_b if trip == 'T1' else (t2_b if trip == 'T2' else (t3_b if trip == 'T3' else t4_b)))"
                  }
                }
              },
              {
                "set": {
                  "key": "gc",
                  "value": {
                    "calc": "(t1_b if trip == 'T1' else (t2_b if trip == 'T2' else (t3_b if trip == 'T3' else t4_b))) if 'keep A' in $answer else (t1_a if trip == 'T1' else (t2_a if trip == 'T2' else (t3_a if trip == 'T3' else t4_a)))"
                  }
                }
              },
              {
                "set": {
                  "key": "hc",
                  "value": {
                    "calc": "t1_h if trip == 'T1' else (t2_h if trip == 'T2' else (t3_h if trip == 'T3' else t4_h))"
                  }
                }
              },
              {
                "set": {
                  "key": "recv",
                  "value": {
                    "calc": "1 if 'to seat 1' in $answer else (2 if 'to seat 2' in $answer else (3 if 'to seat 3' in $answer else 4))"
                  }
                }
              },
              {
                "adjust": {
                  "player": "$seat",
                  "key": "pub_red",
                  "value": {
                    "calc": "count_increment"
                  },
                  "if": {
                    "calc": "kc == 'Red'"
                  }
                }
              },
              {
                "adjust": {
                  "player": "$seat",
                  "key": "pub_blue",
                  "value": {
                    "calc": "count_increment"
                  },
                  "if": {
                    "calc": "kc == 'Blue'"
                  }
                }
              },
              {
                "adjust": {
                  "player": "$seat",
                  "key": "pub_green",
                  "value": {
                    "calc": "count_increment"
                  },
                  "if": {
                    "calc": "kc == 'Green'"
                  }
                }
              },
              {
                "adjust": {
                  "player": "$seat",
                  "key": "pub_yellow",
                  "value": {
                    "calc": "count_increment"
                  },
                  "if": {
                    "calc": "kc == 'Yellow'"
                  }
                }
              },
              {
                "adjust": {
                  "player": {
                    "calc": "recv"
                  },
                  "key": "pub_red",
                  "value": {
                    "calc": "count_increment"
                  },
                  "if": {
                    "calc": "gc == 'Red'"
                  }
                }
              },
              {
                "adjust": {
