            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "purple",
            "value": {
              "calc": "starting_colour_total"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "kept",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
            "key": "public_record",
            "value": ""
          }
        },
        {
          "set": {
            "players": "all",
            "key": "church",
            "value": false
          }
        },
        {
          "set": {
            "players": "all",
            "key": "vp",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "the dice",
      "do": [
        {
          "set": {
            "key": "die_red",
            "value": {
              "calc": "die_start"
            }
          }
        },
        {
          "set": {
            "key": "die_blue",
            "value": {
              "calc": "die_start"
            }
          }
        },
        {
          "set": {
            "key": "die_green",
            "value": {
              "calc": "die_start"
            }
          }
        },
        {
          "set": {
            "key": "die_yellow",
            "value": {
              "calc": "die_start"
            }
          }
        },
        {
          "set": {
            "key": "die_purple",
            "value": {
              "calc": "die_start"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "label": "the deck makeup",
      "to": "all",
      "text": "The deck has {deck_size} cards, shuffled once: {colour_cards_total} colour cards (Red, Blue, Green, Yellow, Purple, each with values 1, 1, 2, 2, 3, 4), Gold cards worth {gold_card_small}, {gold_card_mid} and {gold_card_large}, and {church_cards} Church cards. All five dice start at {die_start}. Everyone starts with {starting_gold} gold."
    },
    {
      "use": "sync",
      "label": "the table",
      "mode": "self",
      "to": "all",
      "fields": [
        "gold",
        "red",
        "blue",
        "green",
        "yellow",
        "purple"
      ],
      "text": "You start with:"
    }
  ],
  "steps": [
    {
      "use": "update",
      "phase": "deal",
      "label": "the round begins",
      "do": [
        {
          "adjust": {
            "key": "round",
            "value": 1
          }
        },
        {
          "set": {
            "key": "active_seat",
            "value": {
              "calc": "active_order[round - 1]"
            }
          }
        }
      ],
      "text": "Round {round}: seat {active_seat} is active."
    },
    {
      "use": "update",
      "phase": "deal",
      "label": "deal three cards",
      "do": [
        {
          "set": {
            "key": "dealt",
            "value": {
              "calc": "[deck[0], deck[1], deck[2]]"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "dealt[0]"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "dealt[1]"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "dealt[2]"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "dealt"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "offer",
            "value": {
              "calc": "['KEEP ' + dealt[0] + ', AUCTION ' + dealt[1] + ', GIVE ' + dealt[2], 'KEEP ' + dealt[0] + ', AUCTION ' + dealt[2] + ', GIVE ' + dealt[1], 'KEEP ' + dealt[1] + ', AUCTION ' + dealt[0] + ', GIVE ' + dealt[2], 'KEEP ' + dealt[1] + ', AUCTION ' + dealt[2] + ', GIVE ' + dealt[0], 'KEEP ' + dealt[2] + ', AUCTION ' + dealt[0] + ', GIVE ' + dealt[1], 'KEEP ' + dealt[2] + ', AUCTION ' + dealt[1] + ', GIVE ' + dealt[0]]"
            }
          }
        }
      ]
    },
    {
      "use": "sync",
      "phase": "deal",
      "label": "the active seat sees its cards",
      "mode": "self",
      "to": {
        "where": "you.seat == active_seat"
      },
      "fields": [
        "hand"
      ],
      "text": "Your three cards this round:"
    },
    {
      "use": "ask",
      "phase": "split",
      "label": "the split",
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "split"
      },
      "text": "Assign your three cards, one each, to KEEP (yours, face-down), AUCTION (bid on by everyone) and GIVE (goes openly to the next seat). Choose one assignment."
    },
    {
      "use": "update",
      "phase": "split",
      "label": "the keep card",
      "do": [
        {
          "set": {
            "key": "split_idx",
            "value": {
              "calc": "min([i for i in [0, 1, 2, 3, 4, 5] if players[active_seat - 1].offer[i] == $split])"
            }
          }
        },
        {
          "set": {
            "key": "keep_card",
            "value": {
              "calc": "dealt[[0, 0, 1, 1, 2, 2][split_idx]]"
            }
          }
        },
        {
          "set": {
            "key": "give_card",
            "value": {
              "calc": "dealt[[2, 1, 2, 0, 1, 0][split_idx]]"
            }
          }
        },
        {
          "append": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "kept",
            "value": {
              "calc": "keep_card"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "red",
            "value": {
              "calc": "int(keep_card[len(keep_card) - 1]) if keep_card[len(keep_card) - 1] in '1234' else 0"
            },
            "if": {
              "calc": "keep_card in ['Red 1', 'Red 2', 'Red 3', 'Red 4']"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "blue",
            "value": {
              "calc": "int(keep_card[len(keep_card) - 1]) if keep_card[len(keep_card) - 1] in '1234' else 0"
            },
            "if": {
              "calc": "keep_card in ['Blue 1', 'Blue 2', 'Blue 3', 'Blue 4']"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "green",
            "value": {
              "calc": "int(keep_card[len(keep_card) - 1]) if keep_card[len(keep_card) - 1] in '1234' else 0"
            },
            "if": {
              "calc": "keep_card in ['Green 1', 'Green 2', 'Green 3', 'Green 4']"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "yellow",
            "value": {
              "calc": "int(keep_card[len(keep_card) - 1]) if keep_card[len(keep_card) - 1] in '1234' else 0"
            },
            "if": {
              "calc": "keep_card in ['Yellow 1', 'Yellow 2', 'Yellow 3', 'Yellow 4']"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "purple",
            "value": {
              "calc": "int(keep_card[len(keep_card) - 1]) if keep_card[len(keep_card) - 1] in '1234' else 0"
            },
            "if": {
              "calc": "keep_card in ['Purple 1', 'Purple 2', 'Purple 3', 'Purple 4']"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "gold",
            "value": {
              "calc": "int(keep_card[len(keep_card) - 1]) if keep_card[len(keep_card) - 1] in '1234' else 0"
            },
            "if": {
              "calc": "keep_card in ['Gold 2', 'Gold 3', 'Gold 4']"
            },
            "text": "Seat {player}'s purse grows."
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "church",
            "value": true,
            "if": {
              "calc": "keep_card == 'Church'"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "split",
      "label": "the give card",
      "do": [
        {
          "set": {
            "key": "give_seat",
            "value": {
              "calc": "active_seat % player_count + 1"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == give_seat"
            },
            "key": "red",
            "value": {
              "calc": "int(give_card[len(give_card) - 1]) if give_card[len(give_card) - 1] in '1234' else 0"
            },
            "if": {
              "calc": "give_card in ['Red 1', 'Red 2', 'Red 3', 'Red 4']"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == give_seat"
            },
            "key": "blue",
            "value": {
              "calc": "int(give_card[len(give_card) - 1]) if give_card[len(give_card) - 1] in '1234' else 0"
            },
            "if": {
              "calc": "give_card in ['Blue 1', 'Blue 2', 'Blue 3', 'Blue 4']"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == give_seat"
            },
            "key": "green",
            "value": {
              "calc": "int(give_card[len(give_card) - 1]) if give_card[len(give_card) - 1] in '1234' else 0"
            },
            "if": {
              "calc": "give_card in ['Green 1', 'Green 2', 'Green 3', 'Green 4']"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == give_seat"
            },
            "key": "yellow",
            "value": {
