  "setup": [
    {
      "use": "update",
      "label": "shuffle the deck and fix the turn order",
      "do": [
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "[pr[1] for pr in sorted([[uniform(0, 1), c] for c in deck])]"
            }
          }
        },
        {
          "set": {
            "key": "active_order",
            "value": {
              "calc": "[active_seat_round_1, active_seat_round_2, active_seat_round_3, active_seat_round_4, active_seat_round_5, active_seat_round_6, active_seat_round_7, active_seat_round_8, active_seat_round_9, active_seat_round_10, active_seat_round_11, active_seat_round_12]"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "starting purses",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "gold",
            "value": {
              "calc": "starting_gold"
            }
          }
        },
        {
          "set": {
