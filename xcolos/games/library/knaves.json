        "text": "Seat {seat} plays {value}."
      },
      "text": "Trick {trick_in_hand} of hand {hand_number}; trumps are {trump_suit}; led suit {led_suit}. Play a card: you are offered only cards of the led suit if you hold any; otherwise any card in your hand."
    },
    {
      "use": "ask",
      "phase": "play",
      "label": "third to play",
      "to": {
        "where": "you.seat == (leader + 1) % num_players + 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "each": {
        "do": [
          {
            "remove": {
              "player": "$seat",
              "key": "hand",
              "value": "$answer"
            }
          },
          {
            "set": {
              "player": "$seat",
              "key": "played_card",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "discard",
              "value": "$answer"
            }
          }
        ]
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} plays {value}."
      },
      "text": "Trick {trick_in_hand} of hand {hand_number}; trumps are {trump_suit}; led suit {led_suit}. Play a card: you are offered only cards of the led suit if you hold any; otherwise any card in your hand."
    },
    {
      "use": "update",
      "phase": "score",
      "label": "the trick is won",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "trick_points",
            "value": {
              "calc": "0 if (you.played_card[-1] != trump_suit and you.played_card[-1] != led_suit) else ((rank_value_A if you.played_card[0] == 'A' else (rank_value_K if you.played_card[0] == 'K' else (rank_value_Q if you.played_card[0] == 'Q' else (rank_value_J if you.played_card[0] == 'J' else rank_value_10)))) + (trump_bonus if you.played_card[-1] == trump_suit else 0))"
            }
          }
        },
        {
          "set": {
            "key": "trick_winner",
            "value": {
              "calc": "[p.seat for p in players if p.trick_points == max([q.trick_points for q in players])][0]"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "trick_winner"
            },
            "key": "tricks_taken",
            "value": 1
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "trick_winner"
            },
            "key": "hand_score",
            "value": {
              "calc": "trick_base_points - (penalty_JS if 'JS' in [p.played_card for p in players] else 0) - (penalty_JC if 'JC' in [p.played_card for p in players] else 0) - (penalty_JD if 'JD' in [p.played_card for p in players] else 0) - (penalty_JH if 'JH' in [p.played_card for p in players] else 0)"
            }
          }
        },
        {
          "set": {
            "key": "leader",
            "value": {
              "calc": "trick_winner"
            }
          }
        }
      ],
      "text": "Seat {trick_winner} wins trick {trick_in_hand} of hand {hand_number} and leads next. Hand scores: seat 1 {players[0].hand_score}, seat 2 {players[1].hand_score}, seat 3 {players[2].hand_score}."
    },
    {
      "use": "update",
      "phase": "score",
      "label": "end of hand",
      "when": {
        "calc": "trick_in_hand == tricks_per_hand"
      },
      "do": [
        {
          "adjust": {
            "players": {
              "where": "you.tricks_taken == you.bid"
            },
            "key": "hand_score",
            "value": {
              "calc": "exact_bid_bonus"
            },
            "text": "Seat {player} made their bid exactly and gains the bonus."
          }
        },
        {
          "adjust": {
            "players": "all",
            "key": "total",
            "value": {
              "calc": "you.hand_score"
            }
          }
        }
      ],
      "text": "Hand {hand_number} is over. Totals: seat 1 {players[0].total}, seat 2 {players[1].total}, seat 3 {players[2].total}."
    },
    {
      "use": "update",
      "phase": "score",
      "label": "next round",
      "do": [
        {
          "adjust": {
            "key": "round",
            "value": 1
          }
        },
        {
          "set": {
            "key": "trick_in_hand",
            "value": {
              "calc": "(round - 1) % tricks_per_hand + 1"
            }
          }
        },
        {
          "set": {
            "key": "hand_number",
            "value": {
              "calc": "int((round - 1) / tricks_per_hand) + 1"
            }
          }
        }
      ]
    },
    {
      "use": "check",
      "phase": "score",
      "label": "after the last trick",
      "when": {
        "calc": "round > total_rounds"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "round > total_rounds"
      },
      "rank_by": "you.total",
      "text": "Winner: {result}. Final totals: Seat 1 {players[0].total}, Seat 2 {players[1].total}, Seat 3 {players[2].total}."
    }
  },
  "limits": {
    "rounds": 36,
    "rounds_max": 40,
    "actions_max": 2000,
    "deadline_s": 120
  },
  "rules": "Three players, seats 1, 2 and 3, use a {deck_size}-card deck: A, K, Q, J and 10 of spades (S), clubs (C), diamonds (D) and hearts (H). Within a suit, cards rank A (high), K, Q, J, 10 (low). Everyone starts with a total of 0.\n\nThe game has exactly {total_rounds} rounds; each round is one trick. Rounds 1-6 form hand 1, rounds 7-12 hand 2, and so on up to rounds 31-36, hand 6. In hand h the dealer is seat ((h-1) mod 3)+1, and eldest, the seat to the dealer's left ((dealer mod 3)+1), leads the hand's first trick. So hand 1 is dealt by seat 1 and led by seat 2.\n\nAt the start of every hand the deck is reset to all 20 cards, hands and the discard pile are emptied, and every bid, tricks_taken and hand_score is set to 0. The deck is shuffled once; seats 1, 2 and 3 each get {cards_per_player} cards, seen only by their owner. Card {turned_card_position} is turned face up as the turned card and its suit is trumps; it is out of play. Card {hidden_card_position} goes face down, out of play, and is never revealed. The deck is then empty.\n\nRight after the deal, all three seats bid at the same moment, a whole number from {bid_min} to {bid_max}: the number of tricks you predict you will take this hand. All bids are then shown to everyone.\n\nEach trick: the leader plays any card from their hand first; its suit is the led suit. Then seat (leader mod 3)+1 plays, then the remaining seat, each seeing the cards already played. If you hold any card of the led suit, you must play one of them (you are offered only those). If you hold none, you may play any card, including a trump. Played cards go to the discard pile and never return.\n\nIf any trump was played, the highest trump wins the trick; otherwise the highest card of the led suit wins. The winner leads the next trick of the hand. The winner adds 1 to tricks_taken and adds to hand_score {trick_base_points}, minus a penalty for each Jack among the three cards in the trick: JS {penalty_JS}, JC {penalty_JC}, JD {penalty_JD}, JH {penalty_JH}. A Jack is penalised even when it is a trump. A trick can therefore score less than zero (JH and JS together: 2-4-1 = -3).\n\nAfter the sixth trick of a hand: each player whose tricks_taken equals their bid adds {exact_bid_bonus} to hand_score; a player who missed their bid, over or under, gets no bonus. Every player then adds hand_score to their total, and the totals are announced.\n\nAfter round {total_rounds} the player with the highest total wins. Players tied for the highest total share the result (a draw)."
}
