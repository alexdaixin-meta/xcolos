            "value": 0
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "deal the informants",
      "do": [
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "informant_deck[int(uniform(0, len(informant_deck)))]"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == 1"
            },
            "key": "informant",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "informant_deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "informant_deck[int(uniform(0, len(informant_deck)))]"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == 2"
            },
            "key": "informant",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "informant_deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "informant_deck[int(uniform(0, len(informant_deck)))]"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == 3"
            },
            "key": "informant",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "informant_deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "informant_deck[int(uniform(0, len(informant_deck)))]"
            },
            "if": {
              "calc": "len(players) >= 4"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == 4"
            },
            "key": "informant",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "informant_deck",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "len(players) >= 4"
            }
          }
        }
      ]
    },
    {
      "use": "sync",
      "label": "your informant",
      "mode": "self",
      "to": "all",
      "fields": [
        "informant",
        "deputies",
        "money"
      ],
      "text": "Your secret informant outlaw (only you know it; its poster rises by the informant tip at the end of the game):"
    },
    {
      "use": "update",
      "label": "the clock",
      "do": [
        {
          "set": {
            "key": "round",
            "value": 0
          }
        }
      ]
    }
  ],
  "steps": [
    {
      "use": "update",
      "phase": "sighting",
      "label": "the sighting",
      "do": [
        {
          "adjust": {
            "key": "round",
            "value": 1
          }
        },
        {
          "set": {
            "key": "sighted",
            "value": {
              "calc": "outlaws[int(uniform(0, len(outlaws)))]"
            }
          }
        },
        {
          "adjust": {
            "key": "poster_red",
            "value": {
              "calc": "sighting_bonus"
            },
            "if": {
              "calc": "sighted == 'Red'"
            }
          }
        },
        {
          "adjust": {
            "key": "poster_blue",
            "value": {
              "calc": "sighting_bonus"
            },
            "if": {
              "calc": "sighted == 'Blue'"
            }
          }
        },
        {
          "adjust": {
            "key": "poster_green",
            "value": {
              "calc": "sighting_bonus"
            },
            "if": {
              "calc": "sighted == 'Green'"
            }
          }
        },
        {
          "adjust": {
            "key": "poster_yellow",
            "value": {
              "calc": "sighting_bonus"
            },
            "if": {
              "calc": "sighted == 'Yellow'"
            }
          }
        },
        {
          "adjust": {
            "key": "poster_black",
            "value": {
              "calc": "sighting_bonus"
            },
            "if": {
              "calc": "sighted == 'Black'"
            }
          }
        },
        {
          "set": {
            "key": "sighted_poster",
            "value": {
              "calc": "poster_red if sighted == 'Red' else (poster_blue if sighted == 'Blue' else (poster_green if sighted == 'Green' else (poster_yellow if sighted == 'Yellow' else poster_black)))"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "commit_raw",
            "value": ""
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "sighting",
      "label": "the sighting is announced",
      "to": "all",
      "text": "Round {round}: {sighted} was sighted; its poster is now {sighted_poster}."
    },
    {
      "use": "sync",
      "phase": "sighting",
      "label": "your standing",
      "mode": "self",
      "to": "all",
      "fields": [
        "deputies",
        "informant",
        "d_red",
        "d_blue",
        "d_green",
        "d_yellow",
        "d_black"
      ],
      "text": "Where you stand:"
    },
    {
      "use": "poll",
      "phase": "talk",
      "label": "talk",
      "to": "acting",
      "answer": {
        "type": "text",
        "max_words": 40
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} says: {value}"
      },
      "text": "Write one short message to the table. Everyone writes at the same time; all messages are shown once all are in. Talk is not binding."
    },
    {
      "use": "poll",
      "phase": "commitment",
      "label": "commitment",
      "to": "acting",
      "answer": {
        "type": "choice",
        "options": [
          "Red 0",
          "Red 1",
          "Red 2",
          "Red 3",
          "Red 4",
          "Blue 0",
          "Blue 1",
          "Blue 2",
          "Blue 3",
          "Blue 4",
          "Green 0",
          "Green 1",
          "Green 2",
          "Green 3",
          "Green 4",
          "Yellow 0",
          "Yellow 1",
          "Yellow 2",
          "Yellow 3",
          "Yellow 4",
          "Black 0",
          "Black 1",
          "Black 2",
          "Black 3",
          "Black 4"
        ]
      },
      "store": "commit_raw",
      "text": "Secretly choose one outlaw and a number of deputies from {min_commit_per_round} to {max_commit_per_round}, as '<outlaw> <n>'. If the number exceeds your remaining deputies, it is reduced to your remaining deputies. Nobody sees any choice until all are in."
    },
    {
      "use": "update",
      "phase": "commitment",
      "label": "read the commitments",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "choice_outlaw",
            "value": {
              "calc": "('Red' if you.commit_raw[0] == 'R' else ('Green' if you.commit_raw[0] == 'G' else ('Yellow' if you.commit_raw[0] == 'Y' else ('Blue' if you.commit_raw[2] == 'u' else 'Black')))) if len(you.commit_raw) > 2 else 'Red'"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "choice_number",
            "value": {
              "calc": "max(min_commit_per_round, min(max_commit_per_round, you.deputies, (4 if you.commit_raw[len(you.commit_raw) - 1] == '4' else (3 if you.commit_raw[len(you.commit_raw) - 1] == '3' else (2 if you.commit_raw[len(you.commit_raw) - 1] == '2' else (1 if you.commit_raw[len(you.commit_raw) - 1] == '1' else 0)))))) if len(you.commit_raw) > 0 else 0"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "reveal",
      "label": "the reveal",
      "to": "all",
      "text": "Commitments this round [seat, deputies committed, outlaw]: {[[p.seat, p.choice_number, p.choice_outlaw] for p in players]}."
    },
    {
      "use": "update",
      "phase": "resolution",
      "label": "the resolution",
      "do": [
        {
          "adjust": {
            "players": {
              "where": "you.choice_outlaw == 'Red'"
            },
            "key": "d_red",
            "value": {
              "calc": "you.choice_number"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.choice_outlaw == 'Blue'"
            },
            "key": "d_blue",
            "value": {
              "calc": "you.choice_number"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.choice_outlaw == 'Green'"
            },
            "key": "d_green",
            "value": {
              "calc": "you.choice_number"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.choice_outlaw == 'Yellow'"
            },
            "key": "d_yellow",
            "value": {
              "calc": "you.choice_number"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.choice_outlaw == 'Black'"
            },
            "key": "d_black",
            "value": {
              "calc": "you.choice_number"
            }
          }
        },
        {
          "adjust": {
            "players": "all",
            "key": "deputies",
            "value": {
              "calc": "0 - you.choice_number"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "end",
      "label": "the informants are revealed",
      "when": {
        "calc": "round == rounds"
      },
      "do": [
        {
          "adjust": {
            "key": "poster_red",
            "value": {
              "calc": "informant_tip"
            },
            "if": {
              "calc": "any(p.informant == 'Red' for p in players)"
            }
          }
        },
        {
          "adjust": {
            "key": "poster_blue",
            "value": {
              "calc": "informant_tip"
            },
            "if": {
              "calc": "any(p.informant == 'Blue' for p in players)"
            }
          }
        },
        {
          "adjust": {
            "key": "poster_green",
            "value": {
              "calc": "informant_tip"
            },
            "if": {
              "calc": "any(p.informant == 'Green' for p in players)"
            }
          }
        },
        {
          "adjust": {
            "key": "poster_yellow",
            "value": {
              "calc": "informant_tip"
            },
            "if": {
              "calc": "any(p.informant == 'Yellow' for p in players)"
            }
          }
        },
        {
          "adjust": {
            "key": "poster_black",
            "value": {
              "calc": "informant_tip"
            },
            "if": {
              "calc": "any(p.informant == 'Black' for p in players)"
            }
          }
        }
      ],
      "text": "The informants are revealed [seat, informant]: {[[p.seat, p.informant] for p in players]}. Each informant outlaw's poster rises by {informant_tip}."
    },
    {
      "use": "update",
      "phase": "end",
      "label": "the payout",
      "when": {
        "calc": "round == rounds"
      },
      "do": [
        {
          "set": {
            "key": "max_red",
            "value": {
              "calc": "max([p.d_red for p in players])"
            }
          }
        },
        {
          "set": {
            "key": "max_blue",
            "value": {
              "calc": "max([p.d_blue for p in players])"
            }
          }
        },
        {
          "set": {
            "key": "max_green",
            "value": {
              "calc": "max([p.d_green for p in players])"
            }
          }
        },
        {
          "set": {
            "key": "max_yellow",
            "value": {
              "calc": "max([p.d_yellow for p in players])"
            }
          }
        },
        {
          "set": {
            "key": "max_black",
            "value": {
              "calc": "max([p.d_black for p in players])"
            }
          }
        },
        {
          "set": {
            "key": "tied_red",
            "value": {
              "calc": "count(p.d_red == max_red for p in players)"
            }
          }
        },
        {
          "set": {
            "key": "tied_blue",
            "value": {
              "calc": "count(p.d_blue == max_blue for p in players)"
            }
          }
        },
        {
          "set": {
            "key": "tied_green",
            "value": {
              "calc": "count(p.d_green == max_green for p in players)"
            }
          }
        },
        {
          "set": {
            "key": "tied_yellow",
            "value": {
              "calc": "count(p.d_yellow == max_yellow for p in players)"
            }
          }
        },
        {
          "set": {
            "key": "tied_black",
            "value": {
              "calc": "count(p.d_black == max_black for p in players)"
            }
          }
        },
        {
          "adjust": {
            "players": "all",
            "key": "money",
            "value": {
              "calc": "(int(poster_red / tied_red) if (max_red > 0 and you.d_red == max_red) else 0) + (int(poster_blue / tied_blue) if (max_blue > 0 and you.d_blue == max_blue) else 0) + (int(poster_green / tied_green) if (max_green > 0 and you.d_green == max_green) else 0) + (int(poster_yellow / tied_yellow) if (max_yellow > 0 and you.d_yellow == max_yellow) else 0) + (int(poster_black / tied_black) if (max_black > 0 and you.d_black == max_black) else 0)"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "end",
      "label": "the final figures",
      "when": {
        "calc": "round == rounds"
      },
      "to": "all",
      "text": "Final posters: Red {poster_red}, Blue {poster_blue}, Green {poster_green}, Yellow {poster_yellow}, Black {poster_black}. Informants [seat, outlaw]: {[[p.seat, p.informant] for p in players]}. Money [seat, dollars]: {[[p.seat, p.money] for p in players]}."
    },
    {
      "use": "check",
      "phase": "end",
      "label": "after the last round",
      "when": {
        "calc": "round >= rounds"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "round >= rounds"
      },
      "rank_by": "you.money",
      "reveal": [
        "informant"
      ],
      "text": "Winner: {result}. Final money [seat, dollars]: {[[p.seat, p.money] for p in players]}."
    }
  },
  "limits": {
    "rounds": 6,
    "rounds_max": 6,
    "actions_max": 500,
    "deadline_s": 120
  },
  "rules": "OUTLAWS: There are {outlaw_count} outlaws: Red, Blue, Green, Yellow and Black. Each has a public poster starting at ${starting_poster}.\n\nSETUP: Each player receives {starting_deputies} deputies, which must last the whole game, and ${starting_money}. Each player is secretly assigned one informant outlaw at random, with no two players sharing one. Only that player knows it. The informant outlaw carries a hidden tip of ${informant_tip}, added to its poster at the end of the game. Outlaws that are nobody's informant carry no tip. Each player has a public deputy count on each outlaw, starting at 0. The game lasts {rounds} rounds.\n\nEACH ROUND:\n1. Sighting: one outlaw is drawn uniformly at random from all five (with replacement; the same outlaw may be sighted in several rounds). It is announced, and its poster rises by ${sighting_bonus}.\n2. Talk: every player writes one short message at the same time, without seeing the others. All messages are then shown to everyone. Talk is not binding.\n3. Commitment: at the same time, every player secretly chooses one outlaw and a number of deputies from {min_commit_per_round} to {max_commit_per_round}, answered as '<outlaw> <n>' (for example 'Red 3'). If the number exceeds their remaining deputies, it is reduced to their remaining deputies; otherwise the full number is committed.\n4. Reveal: all choices are announced.\n5. Resolution: each player's remaining deputies fall by the number they committed, and their deputy count on the chosen outlaw rises by that number. Commitments do not change posters.\n\nEND OF GAME (after round {rounds}):\n- All informants are revealed. Each informant outlaw's poster rises by ${informant_tip}.\n- For each outlaw: if no player has any deputies on it, it escapes and pays nobody. Otherwise the player with the highest deputy count on it receives its whole poster. If several players tie for the highest count, the poster is split equally among them, rounded down to the dollar.\n- Unused deputies are worth nothing.\n- Each player's money is the sum of their payouts.\n\nThe player with the most money after the final payout wins. Players tied for the most money share the result."
}
