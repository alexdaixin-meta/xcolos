              }
            }
          }
        ]
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} plays {value}."
      },
      "text": "Trick {trick_in_hand} of hand {hand_number}. Played so far [seat, card]: {trick_cards}. Lead suit: {lead_suit}. You are offered only the cards you may legally play. Play one card face up."
    },
    {
