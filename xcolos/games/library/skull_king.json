      "text": "Hand {hand_number} of {hands}: the {deck_size} cards are shuffled and each player is dealt {cards_dealt_per_player} cards face down. The other {cards_set_aside} cards are set aside unseen."
    },
    {
      "use": "sync",
      "phase": "deal",
      "label": "your cards",
      "when": {
        "calc": "trick_in_hand == 1"
      },
      "mode": "self",
      "to": "all",
      "fields": [
        "hand"
      ],
      "text": "Your cards for this hand:"
    },
    {
      "use": "poll",
      "phase": "bid",
      "label": "the bids",
      "when": {
        "calc": "trick_in_hand == 1"
      },
      "to": "acting",
      "answer": {
        "type": "number",
        "min": {
          "calc": "bid_min"
        },
        "max": {
          "calc": "bid_max"
        }
      },
      "store": "bid",
      "text": "Hand {hand_number}: look at the cards in your hand. Secretly bid how many of this hand's {tricks_per_hand} tricks you will win, a whole number from {bid_min} to {bid_max}. No bid is shown until everyone has bid."
    },
    {
      "use": "tell",
      "phase": "bid",
      "label": "bids revealed",
      "when": {
        "calc": "trick_in_hand == 1"
      },
      "to": "all",
      "text": "Bids for hand {hand_number}: Seat 1 bid {players[0].bid}, Seat 2 bid {players[1].bid}, Seat 3 bid {players[2].bid}. Seat {leader} leads the first trick."
    },
    {
      "use": "update",
      "phase": "trick",
      "label": "clear the trick",
      "do": [
        {
          "set": {
            "key": "trick_cards",
            "value": []
          }
        },
        {
          "set": {
            "key": "trick_plain",
            "value": []
          }
        },
        {
          "set": {
            "key": "lead_suit",
            "value": ""
          }
        },
        {
          "set": {
            "players": "all",
            "key": "played_card",
            "value": ""
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "you.hand"
            }
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "trick",
      "label": "the lead",
      "to": {
        "where": "you.seat == leader"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "each": {
        "do": [
          {
            "remove": {
              "player": "$seat",
              "key": "hand",
              "value": "$answer"
            }
          },
          {
            "set": {
              "player": "$seat",
              "key": "played_card",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "trick_cards",
              "value": {
                "calc": "[$seat, $answer]"
              }
            }
          },
          {
            "append": {
              "key": "trick_plain",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "discards",
              "value": "$answer"
            }
          },
          {
            "set": {
              "key": "lead_suit",
              "value": {
                "calc": "'Green' if $answer in green_set else ('Yellow' if $answer in yellow_set else 'Black')"
              },
              "if": {
                "calc": "lead_suit == '' and ($answer in green_set or $answer in yellow_set or $answer in black_set)"
              }
            }
          },
          {
            "set": {
              "players": "all",
              "key": "offer",
              "value": {
                "calc": "you.hand if (lead_suit == '' or not any(c in (green_set if lead_suit == 'Green' else (yellow_set if lead_suit == 'Yellow' else black_set)) for c in you.hand)) else [c for c in you.hand if c in specials or c in (green_set if lead_suit == 'Green' else (yellow_set if lead_suit == 'Yellow' else black_set))]"
              }
            }
          }
        ]
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} plays {value}."
      },
      "text": "Trick {trick_in_hand} of hand {hand_number}: you lead. You may play any card in your hand. Play one card face up."
    },
    {
      "use": "ask",
      "phase": "trick",
      "label": "the second card",
      "to": {
        "where": "you.seat == leader % player_count + 1"
