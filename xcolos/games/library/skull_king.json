        {
          "set": {
            "players": "all",
            "key": "score",
            "value": {
              "calc": "starting_score"
            }
          }
        },
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "['G1', 'G2', 'G3', 'G4', 'G5', 'G6', 'G7', 'Y1', 'Y2', 'Y3', 'Y4', 'Y5', 'Y6', 'Y7', 'B1', 'B2', 'B3', 'B4', 'B5', 'Pirate', 'Pirate', 'Escape', 'Escape', 'Mermaid', 'SkullKing']"
