{
  "schema": 1,
  "meta": {
    "id": "for_sale",
    "name": "For Sale: Sealed Bids",
    "players": {
      "min": 3,
      "max": 3,
      "suggested": 3
    },
    "blurb": "Buy properties with sealed bids and private coins, then sell them for cheques; most cheques plus leftover coins wins."
  },
  "statuses": [
    {
      "id": "playing",
      "acts": true,
      "initial": true
