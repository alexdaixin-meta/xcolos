  "steps": [
    {
      "use": "update",
      "phase": "reveal",
      "label": "new round",
      "do": [
        {
          "adjust": {
            "key": "round",
            "value": 1
          }
        },
        {
          "set": {
            "key": "slicer",
            "value": {
              "calc": "round - player_count * int((round - 1) / player_count)"
            }
          }
        },
        {
          "set": {
            "key": "first_picker",
            "value": {
              "calc": "slicer + 1 if slicer < player_count else 1"
            }
          }
        },
        {
          "set": {
            "key": "second_picker",
            "value": {
              "calc": "first_picker + 1 if first_picker < player_count else 1"
            }
          }
        },
        {
          "set": {
            "key": "taken",
            "value": []
          }
        }
      ]
    },
    {
