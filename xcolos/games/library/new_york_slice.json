              "calc": "count(s == 'Pepperoni' for s in portion)"
            },
            "if": {
              "calc": "slicer_mode == 'eat'"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "slicer"
            },
            "key": "pepperoni",
            "value": {
              "calc": "count(s == 'Pepperoni' for s in portion)"
            },
            "if": {
              "calc": "slicer_mode == 'collect'"
            }
          }
        },
        {
          "append": {
            "key": "taken",
            "value": {
              "calc": "last_letter"
            }
          }
        }
      ],
      "text": "The Slicer, seat {slicer}, takes the last portion {last_letter} ({portion}) with {slicer_mode}."
    },
    {
      "use": "update",
      "phase": "scoring",
      "label": "final scoring",
      "when": {
        "calc": "round >= rounds"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "score",
            "value": {
              "calc": "(majority_cheese if you.cheese > max([p.cheese for p in players if p.seat != you.seat]) else 0) + (majority_mushroom if you.mushroom > max([p.mushroom for p in players if p.seat != you.seat]) else 0) + (majority_pepperoni if you.pepperoni > max([p.pepperoni for p in players if p.seat != you.seat]) else 0) + (majority_anchovy if you.anchovy > max([p.anchovy for p in players if p.seat != you.seat]) else 0) + eaten_pepperoni_point * you.eaten - anchovy_penalty * you.anchovy + favourite_bonus * (you.cheese if you.favourite == 'Cheese' else (you.mushroom if you.favourite == 'Mushroom' else (you.pepperoni if you.favourite == 'Pepperoni' else you.anchovy)))"
            }
          }
        },
        {
          "disclose": {
            "of": 1,
            "attribute": "favourite",
            "to": "all",
            "text": "Seat {subject}'s favourite was {value}."
          }
        },
        {
          "disclose": {
            "of": 2,
            "attribute": "favourite",
            "to": "all",
            "text": "Seat {subject}'s favourite was {value}."
          }
        },
        {
          "disclose": {
            "of": 3,
            "attribute": "favourite",
            "to": "all",
            "text": "Seat {subject}'s favourite was {value}."
          }
        }
      ],
      "text": "Final totals: Seat 1 {players[0].score}, Seat 2 {players[1].score}, Seat 3 {players[2].score}."
    },
    {
      "use": "check",
      "phase": "scoring",
      "label": "after round six",
      "when": {
        "calc": "round >= rounds"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "round >= rounds"
      },
      "rank_by": "you.score",
      "reveal": [
        "favourite"
      ],
      "text": "Winner: {result}. Final scores: Seat 1 {players[0].score}, Seat 2 {players[1].score}, Seat 3 {players[2].score}."
    }
  },
  "limits": {
    "rounds": 6,
    "rounds_max": 6,
    "actions_max": 200,
    "deadline_s": 120
  },
  "rules": "Three players, seated P1, P2, P3. The deck has {deck_size} slices: {slices_per_type} Cheese, {slices_per_type} Mushroom, {slices_per_type} Pepperoni and {slices_per_type} Anchovy. It is shuffled and split into {rows} rows of {row_size}. Each player is privately dealt one favourite topping, drawn without replacement from Cheese, Mushroom, Pepperoni and Anchovy, so the three favourites are all different and one topping is nobody's favourite. Favourites stay secret until final scoring.\n\nThe game has {rounds} rounds. The Slicer is P1 in round 1, then P2, P3, P1, P2, P3. Each round:\n1. Reveal. The next row of 6 slices is revealed, positions numbered 1 to 6.\n2. Talk. Every player writes one short message at the same time, without seeing the others. All messages are then shown to everyone. Messages are not binding.\n3. Cut. The Slicer states two whole numbers c1 and c2 with {cut_min} <= c1 < c2 <= {cut_max}. Portion A is positions 1 to c1, portion B is positions c1+1 to c2, portion C is positions c2+1 to 6. In the same answer the Slicer declares eat or collect; this applies to the pepperoni in whichever portion the Slicer ends up with. The three portions are announced.\n4. First pick. The player after the Slicer (P1 to P2, P2 to P3, P3 to P1) chooses any one portion and declares eat or collect.\n5. Second pick. The remaining non-Slicer player chooses one of the two remaining portions and declares eat or collect.\n6. Slicer. The Slicer takes the last portion, with the eat or collect declared at the cut.\n\nEat or collect: with eat, each Pepperoni slice in the portion is eaten for +{eaten_pepperoni_point} point and does not count as collected. With collect, every slice in the portion is collected, Pepperoni included. Non-pepperoni slices are always collected, whichever is declared.\n\nFinal scoring (after round {rounds}) uses only collected slices, plus eaten pepperoni and anchovy penalties.\n- Majority: the player with strictly the most collected slices of a type scores Cheese {majority_cheese}, Mushroom {majority_mushroom}, Pepperoni {majority_pepperoni}, Anchovy {majority_anchovy}. If there is a tie for most, nobody scores that type.\n- Eaten pepperoni: +{eaten_pepperoni_point} per eaten Pepperoni slice.\n- Anchovy penalty: -{anchovy_penalty} per collected Anchovy slice.\n- Favourite: +{favourite_bonus} per collected slice of your own favourite type. Eaten slices do not count.\n\nThe totals are announced and favourites revealed. The highest final total wins; players tied for the highest total share the win."
}
