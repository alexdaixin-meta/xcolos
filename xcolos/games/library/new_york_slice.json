      "text": "Round {round} of {rounds}. The row, positions 1 to 6 in order: {row}. Slicer: seat {slicer}. First picker: seat {first_picker}. Second picker: seat {second_picker}."
    },
    {
      "use": "poll",
      "phase": "talk",
      "label": "talk",
      "to": "acting",
      "answer": {
        "type": "text",
        "max_words": 40
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} says: {value}"
      },
      "text": "Round {round}, row {row}. Write one short message to the table. Everyone writes at the same time; messages are not binding."
    },
    {
      "use": "ask",
      "phase": "cut",
      "label": "the cut",
      "to": {
        "where": "you.seat == slicer"
      },
      "answer": {
        "type": "choice",
        "options": [
          "1-2 eat",
          "1-2 collect",
          "1-3 eat",
          "1-3 collect",
          "1-4 eat",
          "1-4 collect",
          "1-5 eat",
          "1-5 collect",
          "2-3 eat",
          "2-3 collect",
          "2-4 eat",
          "2-4 collect",
          "2-5 eat",
          "2-5 collect",
          "3-4 eat",
          "3-4 collect",
          "3-5 eat",
          "3-5 collect",
          "4-5 eat",
          "4-5 collect"
        ]
      },
      "verify": {
        "bind": "cut"
      },
      "text": "You are the Slicer. Row: {row}. Choose cuts c1-c2 ({cut_min} <= c1 < c2 <= {cut_max}): portion A is positions 1..c1, B is c1+1..c2, C is c2+1..6. Also declare eat or collect for the pepperoni in the portion you end up with; you get the portion the others leave."
    },
    {
      "use": "update",
      "phase": "cut",
      "label": "the portions",
      "do": [
        {
          "set": {
            "key": "c1",
            "value": {
              "calc": "int($cut[0])"
            }
          }
        },
        {
          "set": {
            "key": "c2",
            "value": {
              "calc": "int($cut[2])"
            }
          }
        },
        {
          "set": {
            "key": "slicer_mode",
            "value": {
              "calc": "'eat' if $cut[4] == 'e' else 'collect'"
            }
          }
        },
        {
          "set": {
            "key": "portion_a",
            "value": {
              "calc": "[row[i] for i in [0, 1, 2, 3, 4, 5] if i < c1]"
            }
          }
        },
        {
          "set": {
            "key": "portion_b",
            "value": {
              "calc": "[row[i] for i in [0, 1, 2, 3, 4, 5] if i >= c1 and i < c2]"
            }
          }
        },
        {
          "set": {
            "key": "portion_c",
            "value": {
              "calc": "[row[i] for i in [0, 1, 2, 3, 4, 5] if i >= c2]"
            }
          }
        }
      ],
      "text": "Seat {slicer} cuts at {c1}-{c2} and declares {slicer_mode}. Portion A: {portion_a}. Portion B: {portion_b}. Portion C: {portion_c}."
    },
    {
      "use": "ask",
      "phase": "pick",
      "label": "first pick",
      "to": {
        "where": "you.seat == first_picker"
      },
      "answer": {
        "type": "choice",
        "options": [
          "A eat",
          "A collect",
          "B eat",
          "B collect",
          "C eat",
          "C collect"
        ]
      },
      "verify": {
        "bind": "p1"
      },
      "text": "You pick first. Portion A: {portion_a}. Portion B: {portion_b}. Portion C: {portion_c}. Choose a portion and eat or collect: with eat, its Pepperoni is eaten for points and not collected; with collect, every slice is collected."
    },
    {
      "use": "update",
      "phase": "pick",
      "label": "first picker takes",
      "do": [
        {
          "set": {
            "key": "last_letter",
            "value": {
              "calc": "$p1[0]"
            }
          }
        },
        {
          "set": {
            "key": "last_mode",
            "value": {
              "calc": "'eat' if $p1[2] == 'e' else 'collect'"
            }
          }
        },
        {
          "set": {
            "key": "portion",
            "value": {
              "calc": "portion_a if last_letter == 'A' else (portion_b if last_letter == 'B' else portion_c)"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "first_picker"
            },
            "key": "cheese",
            "value": {
              "calc": "count(s == 'Cheese' for s in portion)"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "first_picker"
            },
            "key": "mushroom",
            "value": {
              "calc": "count(s == 'Mushroom' for s in portion)"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "first_picker"
            },
            "key": "anchovy",
            "value": {
              "calc": "count(s == 'Anchovy' for s in portion)"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "first_picker"
            },
            "key": "eaten",
            "value": {
              "calc": "count(s == 'Pepperoni' for s in portion)"
            },
            "if": {
              "calc": "last_mode == 'eat'"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "first_picker"
            },
            "key": "pepperoni",
            "value": {
              "calc": "count(s == 'Pepperoni' for s in portion)"
            },
            "if": {
              "calc": "last_mode == 'collect'"
            }
          }
        },
        {
          "append": {
            "key": "taken",
            "value": {
              "calc": "last_letter"
            }
          }
        },
        {
          "set": {
            "player": {
              "calc": "second_picker"
            },
            "key": "offer",
            "value": {
              "calc": "(['A eat', 'A collect'] if 'A' not in taken else []) + (['B eat', 'B collect'] if 'B' not in taken else []) + (['C eat', 'C collect'] if 'C' not in taken else [])"
            }
          }
        }
      ],
      "text": "Seat {first_picker} takes portion {last_letter} ({portion}) and chooses {last_mode}."
    },
    {
      "use": "ask",
      "phase": "pick",
      "label": "second pick",
      "to": {
        "where": "you.seat == second_picker"
      },
      "answer": {
        "type": "choice",
        "options": {
