              "calc": "initial_colour_value"
            }
          }
        },
        {
          "set": {
            "key": "value_blue",
            "value": {
              "calc": "initial_colour_value"
            }
          }
        },
        {
          "set": {
            "key": "value_green",
            "value": {
              "calc": "initial_colour_value"
            }
          }
        },
        {
          "set": {
            "key": "value_yellow",
            "value": {
              "calc": "initial_colour_value"
            }
          }
        },
        {
          "set": {
            "key": "value_purple",
            "value": {
              "calc": "initial_colour_value"
            }
          }
        },
        {
          "set": {
            "key": "status_red",
            "value": "not played yet"
          }
        },
        {
          "set": {
            "key": "status_blue",
            "value": "not played yet"
          }
        },
        {
          "set": {
            "key": "status_green",
            "value": "not played yet"
          }
        },
        {
          "set": {
            "key": "status_yellow",
            "value": "not played yet"
          }
        },
        {
          "set": {
            "key": "status_purple",
            "value": "not played yet"
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "set scores and round",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "score",
            "value": {
              "calc": "initial_score"
            }
          }
        },
        {
          "set": {
            "key": "round",
            "value": 1
          }
        },
        {
          "set": {
            "players": "all",
            "key": "message",
            "value": "(none yet)"
          }
        },
        {
          "set": {
            "players": "all",
            "key": "choice",
            "value": "(not chosen yet)"
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "deal favourites",
      "do": [
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "colour_pool[min(len(colour_pool) - 1, int(uniform(0, len(colour_pool))))]"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == 1"
            },
            "key": "favourite",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "colour_pool",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "colour_pool[min(len(colour_pool) - 1, int(uniform(0, len(colour_pool))))]"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == 2"
            },
            "key": "favourite",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "colour_pool",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "colour_pool[min(len(colour_pool) - 1, int(uniform(0, len(colour_pool))))]"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == 3"
            },
            "key": "favourite",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "colour_pool",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "colour_pool[min(len(colour_pool) - 1, int(uniform(0, len(colour_pool))))]"
            },
            "if": {
              "calc": "len(players) >= 4"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == 4"
            },
            "key": "favourite",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "colour_pool",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "len(players) >= 4"
            }
          }
        }
