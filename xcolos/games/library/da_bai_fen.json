            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "player": 4,
            "key": "hand",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "player": 4,
            "key": "hand",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "kitty",
            "value": {
              "calc": "deck"
            }
          }
        },
        {
          "set": {
            "key": "deck",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand1_cards",
            "value": {
              "calc": "you.hand if hand_number == 1 else you.hand1_cards"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand2_cards",
            "value": {
              "calc": "you.hand if hand_number == 2 else you.hand2_cards"
            }
          }
        },
        {
          "set": {
            "key": "kitty_hand1",
            "value": {
              "calc": "kitty if hand_number == 1 else kitty_hand1"
            }
          }
        },
        {
          "set": {
            "key": "kitty_hand2",
            "value": {
              "calc": "kitty if hand_number == 2 else kitty_hand2"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "deal",
      "label": "a replayed deal",
      "when": {
        "calc": "trick_number == 1 and hand_number >= 3"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "hand",
            "value": {
              "calc": "players[(you.seat - 2) % 4].hand1_cards if hand_number == 3 else players[(you.seat - 2) % 4].hand2_cards"
            }
          }
        },
        {
          "set": {
            "key": "kitty",
            "value": {
              "calc": "kitty_hand1 if hand_number == 3 else kitty_hand2"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "deal",
      "label": "a new hand",
      "when": {
        "calc": "trick_number == 1 and not is_replay"
      },
      "to": "all",
      "text": "Hand {hand_number} begins. Trump is {trump_suit}. Seat {leader} leads."
    },
    {
      "use": "tell",
      "phase": "deal",
      "label": "a replayed hand",
      "when": {
        "calc": "trick_number == 1 and is_replay"
      },
      "to": "all",
      "text": "Hand {hand_number} begins. Trump is {trump_suit}. Seat {leader} leads. This hand is a replay: each seat holds the cards the previous seat held in hand {replay_source}."
    },
    {
      "use": "sync",
      "phase": "play",
      "label": "your cards",
      "mode": "self",
      "to": "all",
      "fields": [
        "team",
        "hand",
        "score"
      ],
      "text": "Your cards and standing:"
    },
    {
      "use": "ask",
      "phase": "play",
      "label": "the lead",
      "to": {
        "where": "you.seat == leader"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "hand"
        }
      },
      "verify": {
        "bind": "lead"
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} leads {value}."
      },
      "each": {
        "do": [
          {
            "remove": {
              "player": "$seat",
              "key": "hand",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "trick_cards",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "played_this_hand",
              "value": "$answer"
            }
          },
          {
            "set": {
              "player": "$seat",
              "key": "played_card",
              "value": "$answer"
            }
          },
          {
            "set": {
              "key": "led_card",
              "value": "$answer"
            }
          },
          {
            "set": {
              "key": "led_is_trump",
              "value": {
                "calc": "$answer in ['JOKER_BIG', 'JOKER_SMALL'] or $answer[0] == trump_suit"
              }
            }
          },
          {
            "set": {
              "key": "led_suit",
              "value": {
                "calc": "'TRUMP' if ($answer in ['JOKER_BIG', 'JOKER_SMALL'] or $answer[0] == trump_suit) else $answer[0]"
              }
            }
          },
          {
            "set": {
              "players": "all",
              "key": "offer",
              "value": {
                "calc": "(([c for c in you.hand if c in ['JOKER_BIG', 'JOKER_SMALL'] or c[0] == trump_suit]) if len([c for c in you.hand if c in ['JOKER_BIG', 'JOKER_SMALL'] or c[0] == trump_suit]) > 0 else you.hand) if led_is_trump else (([c for c in you.hand if c not in ['JOKER_BIG', 'JOKER_SMALL'] and c[0] == led_suit]) if len([c for c in you.hand if c not in ['JOKER_BIG', 'JOKER_SMALL'] and c[0] == led_suit]) > 0 else you.hand)"
              }
            }
          }
        ]
      },
      "text": "Trick {trick_number} of hand {hand_number}. Trump is {trump_suit}. You lead: play any card from your hand."
    },
    {
      "use": "ask",
      "phase": "play",
      "label": "the second card",
      "to": {
        "where": "you.seat == leader % 4 + 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "second"
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} plays {value}."
      },
      "each": {
        "do": [
          {
            "remove": {
              "player": "$seat",
              "key": "hand",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "trick_cards",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "played_this_hand",
              "value": "$answer"
            }
          },
          {
            "set": {
              "player": "$seat",
              "key": "played_card",
              "value": "$answer"
            }
          }
        ]
      },
      "text": "Trick {trick_number} of hand {hand_number}. Trump is {trump_suit}. Cards so far: {trick_cards}. Play one of the legal cards offered."
    },
    {
      "use": "ask",
      "phase": "play",
      "label": "the third card",
      "to": {
        "where": "you.seat == (leader + 1) % 4 + 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "third"
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} plays {value}."
      },
      "each": {
        "do": [
          {
            "remove": {
              "player": "$seat",
              "key": "hand",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "trick_cards",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "played_this_hand",
              "value": "$answer"
            }
          },
          {
            "set": {
              "player": "$seat",
              "key": "played_card",
              "value": "$answer"
            }
          }
        ]
      },
      "text": "Trick {trick_number} of hand {hand_number}. Trump is {trump_suit}. Cards so far: {trick_cards}. Play one of the legal cards offered."
    },
    {
      "use": "ask",
      "phase": "play",
      "label": "the fourth card",
      "to": {
        "where": "you.seat == (leader + 2) % 4 + 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "fourth"
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} plays {value}."
      },
      "each": {
        "do": [
          {
            "remove": {
              "player": "$seat",
              "key": "hand",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "trick_cards",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "played_this_hand",
              "value": "$answer"
            }
          },
          {
            "set": {
              "player": "$seat",
              "key": "played_card",
              "value": "$answer"
            }
          }
        ]
      },
      "text": "Trick {trick_number} of hand {hand_number}. Trump is {trump_suit}. Cards so far: {trick_cards}. Play one of the legal cards offered."
    },
    {
      "use": "update",
      "phase": "score",
      "label": "the trick is won",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "card_strength",
            "value": {
              "calc": "sum([((trump_strength_base if (c in ['JOKER_BIG', 'JOKER_SMALL'] or c[0] == trump_suit) else led_suit_strength_base) + (rank_big_joker if c == 'JOKER_BIG' else (rank_small_joker if c == 'JOKER_SMALL' else (rank_ace if c[1] == 'A' else (rank_king if c[1] == 'K' else (rank_queen if c[1] == 'Q' else (rank_jack if c[1] == 'J' else (rank_ten if c[1] == '1' else rank_five)))))))) if ((c in ['JOKER_BIG', 'JOKER_SMALL'] or c[0] == trump_suit) or ((not led_is_trump) and c[0] == led_suit)) else 0 for c in [you.played_card]])"
            }
          }
        },
        {
          "set": {
            "key": "trick_winner",
            "value": {
              "calc": "[p.seat for p in players if p.card_strength == max([q.card_strength for q in players])][0]"
            }
          }
        },
        {
          "set": {
            "key": "trick_points",
            "value": {
              "calc": "sum([(points_five if c[1] == '5' else (points_ten if c[1] == '1' else (points_king if c[1] == 'K' else points_other))) for c in trick_cards])"
            }
          }
        },
        {
          "adjust": {
            "key": "team_a_total",
            "value": {
              "calc": "trick_points if trick_winner in [1, 3] else 0"
            }
          }
        },
        {
          "adjust": {
            "key": "team_b_total",
            "value": {
              "calc": "0 if trick_winner in [1, 3] else trick_points"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "score",
            "value": {
              "calc": "team_a_total if you.team == 'A' else team_b_total"
            }
          }
        },
        {
          "set": {
            "key": "leader",
            "value": {
              "calc": "trick_winner"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "score",
      "label": "the trick result",
      "to": "all",
      "text": "Trick {trick_number} of hand {hand_number}: cards {trick_cards}. Seat {trick_winner} wins {trick_points} points. Team A {team_a_total}, Team B {team_b_total}."
    },
    {
      "use": "update",
      "phase": "score",
      "label": "the kitty",
      "when": {
        "calc": "trick_number == tricks_per_hand"
      },
      "do": [
        {
          "set": {
            "key": "kitty_revealed",
            "value": {
              "calc": "kitty"
            }
          }
        },
        {
          "adjust": {
            "key": "team_a_total",
            "value": {
              "calc": "kitty_multiplier * sum([(points_five if c[1] == '5' else (points_ten if c[1] == '1' else (points_king if c[1] == 'K' else points_other))) for c in kitty]) if trick_winner in [1, 3] else 0"
            }
          }
        },
        {
          "adjust": {
            "key": "team_b_total",
            "value": {
              "calc": "0 if trick_winner in [1, 3] else kitty_multiplier * sum([(points_five if c[1] == '5' else (points_ten if c[1] == '1' else (points_king if c[1] == 'K' else points_other))) for c in kitty])"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "score",
            "value": {
              "calc": "team_a_total if you.team == 'A' else team_b_total"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "score",
      "label": "the end of the hand",
      "when": {
        "calc": "trick_number == tricks_per_hand"
      },
      "to": "all",
      "text": "End of hand {hand_number}. Kitty: {kitty_revealed}, doubled for the team of seat {trick_winner}. Team A {team_a_total}, Team B {team_b_total}."
    },
    {
      "use": "update",
      "phase": "score",
      "label": "clear the trick",
      "do": [
        {
          "set": {
            "key": "trick_cards",
            "value": []
          }
        },
        {
          "set": {
            "key": "led_card",
            "value": ""
          }
        },
        {
          "set": {
            "players": "all",
            "key": "played_card",
            "value": ""
          }
        },
        {
          "adjust": {
            "key": "trick_number",
            "value": 1
          }
        },
        {
          "set": {
            "key": "hand_number",
            "value": {
              "calc": "hand_number + 1 if trick_number > tricks_per_hand else hand_number"
            }
          }
        },
        {
          "set": {
            "key": "trick_number",
            "value": {
              "calc": "1 if trick_number > tricks_per_hand else trick_number"
            }
          }
        }
      ]
    },
    {
      "use": "check",
      "phase": "score",
      "label": "after the last hand",
      "when": {
        "calc": "hand_number > hands"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "hand_number > hands"
      },
      "rank_by": "you.score",
      "text": "Winner: {result}. Final totals: Team A (seats 1 and 3) {team_a_total}, Team B (seats 2 and 4) {team_b_total}."
    }
  },
  "limits": {
    "rounds": 24,
    "rounds_max": 30,
    "actions_max": 2000,
    "deadline_s": 120
  },
  "rules": "SEATS AND TEAMS: Seats are numbered 1, 2, 3, 4 in anticlockwise order. Team A is seats 1 and 3; Team B is seats 2 and 4. Play always proceeds anticlockwise: after seat 1 comes 2, then 3, then 4, then 1.\n\nCARDS: The deck has {deck_size} cards: the Big Joker (JOKER_BIG), the Small Joker (JOKER_SMALL), and four suits (Spades S, Hearts H, Clubs C, Diamonds D) each containing A, K, Q, J, 10, 5. Cards are written as suit letter plus rank, e.g. SA, H10, D5. Point values: a 5 is worth {points_five} points, a 10 is worth {points_ten}, a K is worth {points_king}, and all other cards {points_other}. Each suit holds {points_per_suit} points, so the deck holds {points_in_deck}.\n\nTRUMPS: Hands 1 and 3 have Spades as trump; hands 2 and 4 have Hearts as trump. The trumps are, from high to low: Big Joker, Small Joker, then A, K, Q, J, 10, 5 of the trump suit. Both jokers belong to the trump suit for following purposes. In every non-trump suit the order is A, K, Q, J, 10, 5.\n\nTHE MATCH has {hands} hands of {tricks_per_hand} tricks each, {total_rounds} rounds in total. Each round is one trick.\n\nDEALING: At the start of hand 1 the cards are shuffled at random. Each seat receives {cards_per_seat} cards, private to that seat, and the remaining {kitty_size} cards form the kitty, face down and seen by no one. Hand 2 is a new random shuffle, dealt the same way. Hand 3 replays hand 1: every seat receives the exact cards held in hand 1 by the seat before it in seat order (seat 2 gets seat 1's hand 1 cards, seat 3 gets seat 2's, seat 4 gets seat 3's, seat 1 gets seat 4's), and the kitty is the same 2 cards. Hand 4 replays hand 2 in the same rotated way. Players are told when a hand is a replay.\n\nFIRST LEADER of each hand: seat {first_leader_hand_1} in hand 1, seat {first_leader_hand_2} in hand 2, seat {first_leader_hand_3} in hand 3, seat {first_leader_hand_4} in hand 4. In each replay, the first leader holds the same cards as the first leader of the original hand.\n\nA TRICK: The leader plays any one card from their hand face up. Then the other three seats, in anticlockwise order, each play one card, seeing all cards already played to the trick. Following: if the led card is a trump (a joker or a trump-suit card), each player must play a trump if they hold one. Otherwise each player must play a card of the led suit if they hold one. A player with no card of the required suit may play any card. You are offered only your legal cards. Winning: if any trump was played, the highest trump wins the trick. Otherwise the highest card of the led suit wins. Off-suit non-trump cards never win.\n\nAFTER EACH TRICK: All four cards are announced along with the winner. The winner's team adds the point value of the four cards to its match total. The winner leads the next trick of the same hand.\n\nEND OF HAND: After the 6th trick the kitty is revealed. Its point value multiplied by {kitty_multiplier} is added to the match total of the team that won the 6th trick. The next hand begins with its own deal and first leader.\n\nINFORMATION: You always see your own cards, all cards played so far in the hand, both teams' match totals, the trump suit, the trick number and the hand number. Other players' hands and the kitty stay hidden until the kitty is revealed at the end of the hand. There is no table talk.\n\nWINNING: After hand 4, the team with the higher match total (captured card points plus doubled kitty points) wins; both partners win. If the totals are equal, the match is a draw and all four seats share it."
}
