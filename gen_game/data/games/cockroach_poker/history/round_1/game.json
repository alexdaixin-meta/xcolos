              "key": "hand",
              "value": "$answer"
            }
          },
          {
            "adjust": {
              "player": "$seat",
              "key": "hand_size",
              "value": -1
            }
          }
        ]
      },
      "text": "You are the sender. Choose one card from your hand to send face-down. Nobody else will see which card it is."
    },
    {
      "use": "ask",
      "phase": "send",
      "label": "declare the creature",
