            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "election",
      "label": "crowned",
      "when": {
        "calc": "candidate != '' and no_count == 0"
      },
      "to": "all",
      "text": "Election on character {candidate}: {no_count} No votes. All voted Yes, so {candidate} is crowned king (height {king_height}). The game ends after this round."
    },
    {
      "use": "tell",
      "phase": "election",
      "label": "eliminated",
      "when": {
        "calc": "candidate != '' and no_count > 0"
      },
      "to": "all",
      "text": "Election on character {candidate}: {no_count} No vote(s). Character {candidate} is eliminated (height {eliminated_height}) for the rest of the game. Who voted No is not revealed."
    },
