          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "announce",
      "label": "the heights",
      "to": "all",
      "text": "Round {round} of {round_limit}. Seat {first_raiser} raises first. Heights (-2 not in play, -1 eliminated, 6 king): A {h_a}, B {h_b}, C {h_c}, D {h_d}, E {h_e}, F {h_f}, G {h_g}, H {h_h}, I {h_i}, J {h_j}, K {h_k}, L {h_l}, M {h_m}, N {h_n}, O {h_o}."
    },
    {
      "use": "poll",
      "phase": "talk",
      "label": "talk",
      "to": "acting",
      "answer": {
        "type": "text",
        "max_words": 30
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} says: {value}"
      },
      "text": "Write one short message to the table. Everyone writes at the same time; messages bind no one."
    },
    {
      "use": "repeat",
      "label": "the raises",
      "until": {
        "calc": "raise_idx >= len(players)"
      },
      "max": 10,
      "steps": [
        {
          "use": "update",
          "phase": "raise",
          "label": "next raiser",
          "do": [
            {
              "set": {
                "key": "raiser",
                "value": {
                  "calc": "((first_raiser - 1 + raise_idx) % len(players)) + 1"
                }
              }
            },
            {
              "adjust": {
                "key": "raise_idx",
                "value": 1
              }
            },
            {
              "set": {
                "key": "raise_options",
                "value": {
                  "calc": "[p[0] for p in [['A', h_a], ['B', h_b], ['C', h_c], ['D', h_d], ['E', h_e], ['F', h_f], ['G', h_g], ['H', h_h], ['I', h_i], ['J', h_j], ['K', h_k], ['L', h_l], ['M', h_m], ['N', h_n], ['O', h_o]] if p[1] >= start_height and (p[1] + raise_amount < max_active_height or (p[1] + raise_amount == max_active_height and count(x == max_active_height for x in [h_a, h_b, h_c, h_d, h_e, h_f, h_g, h_h, h_i, h_j, h_k, h_l, h_m, h_n, h_o]) == 0))]"
                }
              }
            }
          ]
        },
        {
          "use": "ask",
          "phase": "raise",
          "label": "raise",
          "to": {
            "where": "you.seat == raiser and len(raise_options) > 0"
          },
          "answer": {
            "type": "choice",
            "options": {
              "game": "raise_options"
            }
          },
          "each": {
            "do": [
              {
                "adjust": {
                  "key": "h_a",
                  "value": {
                    "calc": "raise_amount"
                  },
                  "if": {
                    "calc": "$answer == 'A'"
                  }
                }
              },
              {
                "adjust": {
                  "key": "h_b",
                  "value": {
                    "calc": "raise_amount"
                  },
                  "if": {
                    "calc": "$answer == 'B'"
                  }
                }
              },
              {
                "adjust": {
                  "key": "h_c",
                  "value": {
                    "calc": "raise_amount"
                  },
                  "if": {
                    "calc": "$answer == 'C'"
                  }
                }
              },
              {
                "adjust": {
                  "key": "h_d",
                  "value": {
                    "calc": "raise_amount"
                  },
                  "if": {
                    "calc": "$answer == 'D'"
                  }
                }
              },
              {
                "adjust": {
                  "key": "h_e",
