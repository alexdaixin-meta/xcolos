            "text": "Seat {seat} raises character {value} by {raise_amount}."
          },
          "text": "Your turn to raise. Choose one character to raise by {raise_amount}. Current heights: A {h_a}, B {h_b}, C {h_c}, D {h_d}, E {h_e}, F {h_f}, G {h_g}, H {h_h}, I {h_i}, J {h_j}, K {h_k}, L {h_l}, M {h_m}, N {h_n}, O {h_o}. Only legal raises are offered."
        }
      ]
    },
    {
      "use": "update",
      "phase": "election",
      "label": "find the candidate",
      "do": [
        {
          "set": {
            "key": "candidate",
            "value": {
              "calc": "([p[0] for p in [['A', h_a], ['B', h_b], ['C', h_c], ['D', h_d], ['E', h_e], ['F', h_f], ['G', h_g], ['H', h_h], ['I', h_i], ['J', h_j], ['K', h_k], ['L', h_l], ['M', h_m], ['N', h_n], ['O', h_o]] if p[1] == max_active_height] + [''])[0]"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.no_cards < 1"
            },
            "key": "vote",
            "value": "Yes",
            "if": {
              "calc": "candidate != ''"
            }
          }
        }
      ]
    },
    {
      "use": "poll",
      "phase": "election",
      "label": "the vote",
      "when": {
        "calc": "candidate != ''"
      },
      "to": {
        "where": "you.no_cards >= 1"
      },
      "answer": {
        "type": "choice",
        "options": [
          "Yes",
          "No"
        ]
      },
      "store": "vote",
      "text": "Character {candidate} is at height {max_active_height} and stands for king. Vote Yes or No, in secret. If every vote is Yes, {candidate} is crowned king. If any vote is No, {candidate} is eliminated and each No voter spends one No card."
    },
    {
      "use": "update",
      "phase": "election",
      "label": "resolve the election",
      "when": {
        "calc": "candidate != ''"
      },
      "do": [
        {
          "set": {
            "key": "no_count",
            "value": {
              "calc": "count(p.vote == 'No' for p in players)"
            }
          }
        },
        {
          "set": {
            "key": "king_crowned",
            "value": {
              "calc": "no_count == 0"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.vote == 'No' and you.no_cards >= 1"
            },
            "key": "no_cards",
            "value": -1
          }
        },
        {
          "set": {
            "key": "h_a",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'A'"
            }
          }
        },
        {
          "set": {
            "key": "h_b",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'B'"
            }
          }
        },
        {
          "set": {
            "key": "h_c",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'C'"
            }
          }
        },
        {
          "set": {
            "key": "h_d",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'D'"
            }
          }
        },
        {
          "set": {
            "key": "h_e",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'E'"
            }
          }
        },
        {
          "set": {
            "key": "h_f",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'F'"
            }
          }
        },
        {
          "set": {
            "key": "h_g",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'G'"
            }
          }
        },
        {
          "set": {
            "key": "h_h",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'H'"
            }
          }
        },
        {
          "set": {
            "key": "h_i",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'I'"
            }
          }
        },
        {
          "set": {
            "key": "h_j",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'J'"
            }
          }
        },
        {
          "set": {
            "key": "h_k",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'K'"
            }
          }
        },
        {
          "set": {
            "key": "h_l",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'L'"
            }
          }
        },
        {
          "set": {
            "key": "h_m",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'M'"
            }
          }
        },
        {
          "set": {
            "key": "h_n",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
              "calc": "candidate == 'N'"
            }
          }
        },
        {
          "set": {
            "key": "h_o",
            "value": {
              "calc": "king_height if no_count == 0 else eliminated_height"
            },
            "if": {
