      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "score",
            "value": {
              "calc": "sum([(king_score if p[1] == king_height else (eliminated_score if p[1] == eliminated_height else p[1])) for p in [['A', h_a], ['B', h_b], ['C', h_c], ['D', h_d], ['E', h_e], ['F', h_f], ['G', h_g], ['H', h_h], ['I', h_i], ['J', h_j], ['K', h_k], ['L', h_l], ['M', h_m], ['N', h_n], ['O', h_o]] if p[0] in you.goal])"
            }
          }
        }
      ],
      "text": "The game is over. Goals are revealed and scored."
    },
    {
      "use": "check",
      "phase": "scoring",
      "label": "end check",
      "when": {
        "calc": "king_crowned or round >= round_limit"
      },
      "against": [
        "over"
      ]
    }
