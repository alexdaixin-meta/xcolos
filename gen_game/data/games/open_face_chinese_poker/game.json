    {
      "use": "update",
      "phase": "deal",
      "label": "shuffle the deck",
      "when": {
        "calc": "round_in_hand == 1 and hand_number % 2 == 1"
      },
      "do": [
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "[c[1] for c in sorted([[uniform(0, 1), d] for d in deck])]"
            }
          }
        }
      ],
      "text": "Hand {hand_number} begins: the deck is shuffled into a new fixed order, used for this hand and the next."
    },
    {
      "use": "update",
