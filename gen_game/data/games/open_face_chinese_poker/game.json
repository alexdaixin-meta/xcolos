      "text": "Hand {hand_number}, round {round_in_hand}: each player is dealt 3 cards in private."
    },
    {
      "use": "sync",
      "phase": "deal",
      "label": "your cards",
      "mode": "self",
      "to": "all",
      "text": "Hand {hand_number}, round {round_in_hand}. Your cards and rows:"
    },
    {
      "use": "poll",
      "phase": "choose",
      "label": "card choice",
      "to": "acting",
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "hand"
        }
      },
      "store": "chosen_card",
      "text": "Hand {hand_number}, round {round_in_hand}: keep exactly 1 of your 3 cards. The other 2 are discarded and never shown to your opponent."
    },
    {
      "use": "poll",
      "phase": "choose",
      "label": "row choice",
      "to": "acting",
      "answer": {
        "type": "choice",
        "options": [
          "Front",
          "Middle",
          "Back"
        ]
      },
      "store": "chosen_row",
      "text": "Name a row for the card you kept: Front (1 slot), Middle (2 slots) or Back (2 slots). If the named row is full, the card goes to the first row that is not full, checking Back, then Middle, then Front."
    },
    {
      "use": "update",
      "phase": "place",
      "label": "place the cards",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "chosen_card",
            "value": {
              "calc": "int(you.chosen_card)"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "chosen_row",
            "value": {
              "calc": "you.chosen_row if ((you.chosen_row == 'Front' and you.front == 0) or (you.chosen_row == 'Middle' and you.mid2 == 0) or (you.chosen_row == 'Back' and you.back2 == 0)) else ('Back' if you.back2 == 0 else ('Middle' if you.mid2 == 0 else 'Front'))"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "front",
            "value": {
              "calc": "you.chosen_card if you.chosen_row == 'Front' else you.front"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "mid2",
            "value": {
              "calc": "you.chosen_card if (you.chosen_row == 'Middle' and you.mid1 != 0) else you.mid2"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "mid1",
            "value": {
              "calc": "you.chosen_card if (you.chosen_row == 'Middle' and you.mid1 == 0) else you.mid1"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "back2",
            "value": {
              "calc": "you.chosen_card if (you.chosen_row == 'Back' and you.back1 != 0) else you.back2"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "back1",
            "value": {
              "calc": "you.chosen_card if (you.chosen_row == 'Back' and you.back1 == 0) else you.back1"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand",
            "value": []
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "reveal",
      "label": "the reveal",
      "to": "all",
      "text": "Revealed: Seat 1 kept {players[0].chosen_card}, placed in {players[0].chosen_row}. Seat 2 kept {players[1].chosen_card}, placed in {players[1].chosen_row}. Rows now - Seat 1: Front {players[0].front}, Middle {players[0].mid1} {players[0].mid2}, Back {players[0].back1} {players[0].back2}. Seat 2: Front {players[1].front}, Middle {players[1].mid1} {players[1].mid2}, Back {players[1].back1} {players[1].back2}."
    },
    {
      "use": "update",
      "phase": "score",
      "label": "score the hand",
      "when": {
        "calc": "round_in_hand == rounds_per_hand"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "fouled",
            "value": {
              "calc": "(front_multiplier * you.front > you.mid1 + you.mid2 + (pair_bonus if you.mid1 == you.mid2 else 0)) or (you.mid1 + you.mid2 + (pair_bonus if you.mid1 == you.mid2 else 0) > you.back1 + you.back2 + (pair_bonus if you.back1 == you.back2 else 0))"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "royalty",
            "value": {
              "calc": "0 if you.fouled else ((front_royalty if you.front >= front_royalty_min_value else 0) + (middle_pair_royalty if you.mid1 == you.mid2 else 0) + (back_pair_royalty if you.back1 == you.back2 else 0))"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "front",
            "value": {
              "calc": "front_multiplier * you.front"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "mid1",
            "value": {
              "calc": "you.mid1 + you.mid2 + (pair_bonus if you.mid1 == you.mid2 else 0)"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "back1",
            "value": {
              "calc": "you.back1 + you.back2 + (pair_bonus if you.back1 == you.back2 else 0)"
            }
          }
        },
        {
          "set": {
            "key": "seat_strengths",
            "value": {
              "calc": "[players[0].front, players[0].mid1, players[0].back1, (1 if players[0].fouled else 0), players[1].front, players[1].mid1, players[1].back1, (1 if players[1].fouled else 0)]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand_score",
            "value": {
              "calc": "0 if you.fouled else ((foul_win_points + you.royalty) if any(q.fouled for q in players if q.seat != you.seat) else (row_win_points * (count(you.front > q.front for q in players if q.seat != you.seat) + count(you.mid1 > q.mid1 for q in players if q.seat != you.seat) + count(you.back1 > q.back1 for q in players if q.seat != you.seat)) + (scoop_bonus if (count(you.front > q.front for q in players if q.seat != you.seat) + count(you.mid1 > q.mid1 for q in players if q.seat != you.seat) + count(you.back1 > q.back1 for q in players if q.seat != you.seat)) == 3 else 0) + you.royalty))"
            }
          }
        },
        {
          "adjust": {
            "players": "all",
            "key": "total",
            "value": {
              "calc": "you.hand_score"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "score",
      "label": "hand results",
      "when": {
        "calc": "round_in_hand == rounds_per_hand"
      },
      "to": "all",
      "text": "Hand {hand_number} scored. Seat 1: Front {players[0].front}, Middle {players[0].mid1}, Back {players[0].back1}, fouled {players[0].fouled}, royalties {players[0].royalty}, hand score {players[0].hand_score}, total {players[0].total}. Seat 2: Front {players[1].front}, Middle {players[1].mid1}, Back {players[1].back1}, fouled {players[1].fouled}, royalties {players[1].royalty}, hand score {players[1].hand_score}, total {players[1].total}."
    },
    {
      "use": "update",
      "phase": "advance",
      "label": "next round",
      "do": [
        {
          "adjust": {
            "key": "round_in_hand",
            "value": 1
          }
        },
        {
          "set": {
            "players": "all",
            "key": "front",
            "value": 0,
            "if": {
              "calc": "round_in_hand > rounds_per_hand"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "mid1",
            "value": 0,
            "if": {
              "calc": "round_in_hand > rounds_per_hand"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "mid2",
