            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "back1",
            "value": 0,
            "if": {
              "calc": "round_in_hand > rounds_per_hand"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "back2",
            "value": 0,
            "if": {
              "calc": "round_in_hand > rounds_per_hand"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[0]"
            },
            "if": {
              "calc": "round_in_hand > rounds_per_hand and hand_number % 2 == 1"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "round_in_hand > rounds_per_hand and hand_number % 2 == 1"
            }
          }
        },
        {
          "append": {
            "key": "deck",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "round_in_hand > rounds_per_hand and hand_number % 2 == 1"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[0]"
            },
            "if": {
              "calc": "round_in_hand > rounds_per_hand and hand_number % 2 == 1"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "round_in_hand > rounds_per_hand and hand_number % 2 == 1"
            }
          }
        },
        {
          "append": {
            "key": "deck",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "round_in_hand > rounds_per_hand and hand_number % 2 == 1"
            }
          }
        },
        {
          "adjust": {
            "key": "hand_number",
            "value": 1,
            "if": {
              "calc": "round_in_hand > rounds_per_hand"
            }
          }
        },
        {
          "set": {
            "key": "round_in_hand",
            "value": 1,
            "if": {
              "calc": "round_in_hand > rounds_per_hand"
            }
          }
        }
      ]
    },
    {
      "use": "check",
      "phase": "advance",
      "label": "after the last hand",
      "when": {
        "calc": "hand_number > hands"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "hand_number > hands"
      },
      "rank_by": "you.total",
      "text": "Winner: {result}. Final match totals: Seat 1 {players[0].total}, Seat 2 {players[1].total}."
    }
  },
  "limits": {
    "rounds": 20,
    "rounds_max": 25,
    "actions_max": 400,
    "deadline_s": 120
  },
  "rules": "DECK: {deck_size} cards, values {card_value_min} to {card_value_max}, {copies_per_value} copies of each value. There are no suits.\n\nMATCH: {hands} hands of {rounds_per_hand} rounds each, {total_rounds} rounds in total. The match ends when hand_number exceeds {hands}. At the start of hand 1 the deck is shuffled and its order is fixed; hands 1 and 2 both use this order. At the start of hand 3 it is shuffled again; hands 3 and 4 both use the new order.\n\nSEATS: Player A is seat 1 and Player B is seat 2. In each round r of a hand (r = 1 to 5), Seat X receives deck positions 6r-5, 6r-4 and 6r-3, and Seat Y receives positions 6r-2, 6r-1 and 6r. Positions 31 and 32 are never used ({unused_positions} unused positions; {cards_used_per_hand} cards used per hand). In hands 1 and 3, Player A is Seat X and Player B is Seat Y. In hands 2 and 4 they swap: B is Seat X and A is Seat Y. So in hand 2 each player is dealt exactly the cards the other was dealt in hand 1, round by round, and likewise for hand 4 and hand 3.\n\nROWS: Each player builds a Front row ({front_slots} slot), a Middle row ({middle_slots} slots) and a Back row ({back_slots} slots).\n\nEACH ROUND:\n(1) Deal: each player privately receives their {cards_per_seat_per_round} cards for this round.\n(2) Card choice: at the same moment, each player secretly chooses {cards_kept_per_round} of their 3 cards to keep.\n(3) Row choice: at the same moment, each player secretly names a row (Front, Middle or Back) for the kept card. If the named row is not full, the card goes there. If the named row is full, the card goes to the first row that is not full, checking in the order Back, Middle, Front.\n(4) The {cards_discarded_per_round} unkept cards are discarded. Discards are never shown to the opponent.\n(5) Reveal: both kept cards are announced face up, with the row each went to.\nAfter round 5 each player has exactly 5 placed cards, and the hand is scored.\n\nROW STRENGTH:\n- Front = {front_multiplier} x its card value (a Front 5 has strength 10).\n- Middle and Back = the sum of the two card values, plus {pair_bonus} if the two values are equal (a pair). For example 4 and 4 = 108; 3 and 6 = 9.\n\nFOUL: a hand fouls if Front strength > Middle strength, or Middle strength > Back strength. Equal strengths are allowed and do not foul; otherwise the hand does not foul.\n\nROYALTIES (non-fouling players only; a fouling player earns none):\n- Front card value {front_royalty_min_value} or 8: +{front_royalty}.\n- Middle pair: +{middle_pair_royalty}.\n- Back pair: +{back_pair_royalty}.\n\nSCORING EACH HAND:\n- If neither player fouls, compare each row. The higher strength scores {row_win_points} point for its owner; equal strengths score nothing. A player who wins all three rows scores {scoop_bonus} more points (scoop). Each player then adds their own royalties.\n- If exactly one player fouls, the other scores {foul_win_points} plus their own royalties, and the fouler scores 0.\n- If both foul, both score 0.\nThe hand scores are added to the match totals. All row strengths, both foul results and both hand scores are announced. Rows are then cleared for the next hand.\n\nINFORMATION: Each player sees their own dealt cards and every revealed placement. Players may use anything seen in earlier hands. In hands 2 and 4 you know exactly which 3 cards your opponent is offered each round, because they are the cards you were offered in the previous hand. In hands 1 and 3 you know the opponent was offered the cards you are about to receive in the next hand.\n\nWINNING: After round {total_rounds}, the player with the higher match total (the sum of their four hand scores) wins. Equal totals are a draw (a shared win)."
}
