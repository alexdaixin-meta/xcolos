  "steps": [
    {
      "use": "update",
      "phase": "bidding",
      "label": "the deal",
      "when": {
        "calc": "round_in_hand == 0"
      },
      "do": [
        {
          "set": {
            "key": "dealer",
            "value": {
              "calc": "1 if hand_number % 2 == 1 else 2"
            }
          }
        },
        {
          "set": {
            "key": "forehand",
            "value": {
              "calc": "[p.seat for p in players if p.seat != dealer][0]"
            }
          }
        },
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "[i[0] for i in card_info]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand",
            "value": []
          }
        },
        {
