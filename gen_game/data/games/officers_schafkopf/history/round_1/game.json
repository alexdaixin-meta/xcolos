              "calc": "[['Ace of Acorns', 'Acorns', 'Ace', points_ace, plain_rank_ace, 0, 0], ['Ten of Acorns', 'Acorns', 'Ten', points_ten, plain_rank_ten, 0, 1], ['Ober of Acorns', 'Acorns', 'Ober', points_ober, plain_rank_ober, 0, 2], ['Unter of Acorns', 'Acorns', 'Unter', points_unter, plain_rank_unter, 0, 3], ['Ace of Leaves', 'Leaves', 'Ace', points_ace, plain_rank_ace, 1, 4], ['Ten of Leaves', 'Leaves', 'Ten', points_ten, plain_rank_ten, 1, 5], ['Ober of Leaves', 'Leaves', 'Ober', points_ober, plain_rank_ober, 1, 6], ['Unter of Leaves', 'Leaves', 'Unter', points_unter, plain_rank_unter, 1, 7], ['Ace of Hearts', 'Hearts', 'Ace', points_ace, plain_rank_ace, 2, 8], ['Ten of Hearts', 'Hearts', 'Ten', points_ten, plain_rank_ten, 2, 9], ['Ober of Hearts', 'Hearts', 'Ober', points_ober, plain_rank_ober, 2, 10], ['Unter of Hearts', 'Hearts', 'Unter', points_unter, plain_rank_unter, 2, 11], ['Ace of Bells', 'Bells', 'Ace', points_ace, plain_rank_ace, 3, 12], ['Ten of Bells', 'Bells', 'Ten', points_ten, plain_rank_ten, 3, 13], ['Ober of Bells', 'Bells', 'Ober', points_ober, plain_rank_ober, 3, 14], ['Unter of Bells', 'Bells', 'Unter', points_unter, plain_rank_unter, 3, 15]]"
            }
          }
        }
      ]
    },
