  "setup": [
    {
      "use": "update",
      "label": "the merchants",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "florins",
            "value": {
              "calc": "starting_florins"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "track_spice",
            "value": {
              "calc": "track_start"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "track_silk",
            "value": {
              "calc": "track_start"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "track_grain",
            "value": {
              "calc": "track_start"
            }
          }
        },
        {
