  "steps": [
    {
      "use": "update",
      "phase": "ask",
      "label": "a new round",
      "do": [
        {
          "adjust": {
            "key": "round",
            "value": 1
          }
        },
        {
          "set": {
            "key": "active_seat",
            "value": {
              "calc": "((round - 1) % len(players)) + 1"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "guess",
            "value": ""
          }
        },
        {
          "set": {
            "players": "all",
            "key": "guessed",
            "value": false
          }
        },
        {
          "set": {
            "key": "k",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "['EVEN to seat ' + ['1','2','3','4'][p.seat - 1] for p in players if p.seat != you.seat] + ['HIGH to seat ' + ['1','2','3','4'][p.seat - 1] for p in players if p.seat != you.seat] + ['NUMBER to seat ' + ['1','2','3','4'][p.seat - 1] for p in players if p.seat != you.seat] + ['SUM15 to seat ' + ['1','2','3','4'][p.seat - 1] for p in players if p.seat != you.seat] + ['PAIR to seat ' + ['1','2','3','4'][p.seat - 1] for p in players if p.seat != you.seat] + ['MISSING to seat ' + ['1','2','3','4'][p.seat - 1] for p in players if p.seat != you.seat]"
            }
          }
        }
      ],
      "text": "Round {round} of at most {final_round}: seat {active_seat} is the active player."
    },
    {
      "use": "ask",
      "phase": "ask",
      "label": "choose a question and respondent",
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "qr"
      },
      "text": "You are the active player. Choose a question and the other seat who answers it. EVEN: how many even tiles (2, 4, 6) do they see? HIGH: how many tiles numbered 5, 6 or 7? NUMBER: how many tiles of a number k you name next? SUM15: how many racks they see total 15 or more? PAIR: how many racks they see hold two or more tiles of the same number? MISSING: how many of the numbers 1 to 7 appear on none of the racks they see? The respondent sees every rack except their own, yours included."
    },
    {
      "use": "update",
      "phase": "ask",
      "label": "record the question",
      "do": [
        {
          "set": {
            "key": "question",
            "value": {
              "calc": "[q for q in ['EVEN', 'HIGH', 'NUMBER', 'SUM15', 'PAIR', 'MISSING'] if $qr in [q + ' to seat 1', q + ' to seat 2', q + ' to seat 3', q + ' to seat 4']][0]"
            }
          }
        },
        {
          "set": {
            "key": "respondent",
            "value": {
              "calc": "[s for s in [1, 2, 3, 4] if $qr == question + ' to seat ' + ['1','2','3','4'][s - 1]][0]"
            }
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "ask",
      "label": "choose k",
      "when": {
        "calc": "question == 'NUMBER'"
      },
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "number",
        "min": {
          "calc": "k_min"
        },
        "max": {
          "calc": "k_max"
        }
      },
      "verify": {
        "bind": "kk"
      },
      "text": "Name the number k (from {k_min} to {k_max}) for the NUMBER question: the respondent will say how many tiles numbered k they see."
    },
    {
      "use": "update",
      "phase": "ask",
      "label": "the answer",
      "do": [
        {
          "set": {
            "key": "k",
            "value": "$kk",
            "if": {
              "calc": "question == 'NUMBER'"
            }
          }
        },
        {
          "set": {
            "key": "seen",
            "value": {
              "calc": "[p.rack[0] for p in players if p.seat != respondent] + [p.rack[1] for p in players if p.seat != respondent] + [p.rack[2] for p in players if p.seat != respondent]"
            }
          }
        },
        {
          "set": {
            "key": "answer",
            "value": {
              "calc": "count(t % 2 == 0 for t in seen) if question == 'EVEN' else (count(t >= high_min for t in seen) if question == 'HIGH' else (count(t == k for t in seen) if question == 'NUMBER' else (count(sum(p.rack) >= sum_threshold for p in players if p.seat != respondent) if question == 'SUM15' else (count(p.rack[0] == p.rack[1] or p.rack[1] == p.rack[2] or p.rack[0] == p.rack[2] for p in players if p.seat != respondent) if question == 'PAIR' else count(v not in seen for v in [1, 2, 3, 4, 5, 6, 7])))))"
            }
          }
        }
      ],
      "text": "Seat {active_seat} asked seat {respondent} the {question} question (k = {k}; k applies only to NUMBER). Answer: {answer}."
    },
    {
      "use": "poll",
      "phase": "guess",
      "label": "guess poll",
      "to": "acting",
      "answer": {
        "type": "choice",
        "options": {
          "game": "guess_options"
        }
      },
      "store": "guess",
      "text": "Guess your own rack or PASS. Choose PASS, or three numbers in ascending order (for example '3 5 7'). A correct guess (the same three numbers, duplicates included) scores {correct_guess_points}; a wrong guess scores {wrong_guess_points}; PASS scores {pass_points} and keeps your rack. Anyone who guesses, right or wrong, reveals their rack and gets three new tiles."
    },
    {
      "use": "update",
      "phase": "guess",
      "label": "scoring",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "guessed",
            "value": {
              "calc": "you.guess != 'PASS' and you.guess != ''"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.guessed"
            },
            "key": "score",
            "value": {
              "calc": "correct_guess_points if you.guess == ['1','2','3','4','5','6','7'][sorted(you.rack)[0] - 1] + ' ' + ['1','2','3','4','5','6','7'][sorted(you.rack)[1] - 1] + ' ' + ['1','2','3','4','5','6','7'][sorted(you.rack)[2] - 1] else wrong_guess_points"
            }
          }
        }
      ],
      "text": "Guesses scored. Scores [seat, score]: {[[p.seat, p.score] for p in players]}."
    },
    {
      "use": "update",
      "phase": "replace",
      "label": "reveal and replace",
      "when": {
        "calc": "count(p.guessed for p in players) > 0"
      },
      "do": [
        {
          "set": {
            "key": "last_reveal",
            "value": {
              "calc": "[[p.seat, p.rack] for p in players if p.guessed]"
            }
          }
        },
        {
          "set": {
            "key": "discard",
            "value": {
              "calc": "discard + players[0].rack"
            },
            "if": {
              "calc": "players[0].guessed"
            }
          }
        },
        {
          "set": {
            "key": "discard",
            "value": {
              "calc": "discard + players[1].rack"
            },
            "if": {
              "calc": "players[1].guessed"
            }
          }
        },
        {
          "set": {
            "key": "discard",
            "value": {
