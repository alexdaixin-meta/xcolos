  "steps": [
    {
      "use": "update",
      "phase": "start",
      "label": "the round begins",
      "do": [
        {
          "adjust": {
            "key": "round",
            "value": 1
          }
        },
        {
          "set": {
            "key": "active_seat",
            "value": {
              "calc": "(round - 1) % num_seats + 1"
            }
          }
        },
        {
          "set": {
            "key": "required_rank",
            "value": {
              "calc": "(round - 1) % num_ranks + 1"
            }
          }
        },
        {
          "set": {
            "key": "skipped",
            "value": {
              "calc": "players[active_seat - 1].hand_size == 0"
            }
          }
        },
        {
          "set": {
            "key": "k",
            "value": 0
          }
        },
        {
          "set": {
            "key": "statement",
            "value": "(none)"
          }
        },
        {
          "set": {
