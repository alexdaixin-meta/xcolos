            "value": false
          }
        },
        {
          "set": {
            "key": "challengers",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "response",
            "value": "(none)"
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "start",
      "label": "announce the round",
      "when": {
        "calc": "not skipped"
      },
      "to": "all",
      "text": "Round {round}: Seat {active_seat} must play rank {required_rank}."
    },
    {
      "use": "tell",
      "phase": "start",
      "label": "announce the skip",
      "when": {
        "calc": "skipped"
      },
      "to": "all",
      "text": "Round {round}: Seat {active_seat} must play rank {required_rank} and skips, holding 0 cards."
    },
    {
      "use": "sync",
      "phase": "start",
      "label": "your hand",
      "mode": "self",
      "to": "all",
      "fields": [
        "hand",
        "hand_size"
      ],
      "text": "Your hand:"
    },
    {
      "use": "ask",
      "phase": "play",
      "label": "choose k",
      "when": {
        "calc": "not skipped"
      },
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "number",
        "min": {
          "calc": "k_min"
        },
        "max": {
          "calc": "k_max"
        }
      },
      "each": {
        "do": [
          {
            "set": {
              "key": "k",
              "value": {
                "calc": "min($answer, players[$seat - 1].hand_size)"
              }
            }
          }
        ]
      },
      "text": "You must play rank {required_rank}. How many cards do you play face down ({k_min} to {k_max})? If you choose more than you hold, you play your whole hand. Cards of rank {required_rank} are taken first, then the next rank up, and so on, 6 wrapping to 1."
    },
    {
      "use": "ask",
      "phase": "play",
      "label": "statement",
      "when": {
        "calc": "not skipped"
      },
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "text",
        "max_words": 25
      },
      "each": {
        "do": [
          {
            "set": {
              "key": "statement",
              "value": "$answer"
            }
          }
        ]
      },
      "text": "Add one short public statement to your claim of {k} cards of rank {required_rank}. It may be untrue, and it may be empty."
    },
