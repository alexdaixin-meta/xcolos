      "use": "update",
      "phase": "play",
      "label": "the cards go down",
      "when": {
        "calc": "not skipped"
      },
      "do": [
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "sorted([((c - required_rank) % num_ranks) * num_ranks + c - 1 for c in players[active_seat - 1].hand])[0] % num_ranks + 1"
            },
            "if": {
              "calc": "len(played) < k"
            }
          }
        },
        {
          "remove": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "len(played) < k"
            }
          }
        },
        {
          "append": {
            "key": "pile",
