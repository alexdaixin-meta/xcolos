[
  {
    "name": "Both scores start at 0 and stay 0 after a turn of questions; leg 1 goes on to turn 2",
    "rule": "R1",
    "players": 2,
    "rounds": 1,
    "rules": [
      {
        "seat": 1,
        "options_include": "sum"
      },
      {
        "seat": 2,
        "options_include": "sum"
      }
    ],
    "expect": {
      "players": {
        "1": {
          "score": 0,
          "legs_solved": 0
        },
        "2": {
          "score": 0,
          "legs_solved": 0
        }
      },
      "game": {
        "leg": 1,
        "turn_in_leg": 2
      }
    },
    "rule_text": "The match is 4 legs of 6 turns each, 24 turns in all, and both scores start at 0."
  },
  {
    "name": "Codes chosen on turn 1 are used to answer questions",
    "rule": "R2",
    "players": 2,
    "rounds": 1,
    "rules": [
      {
        "seat": 1,
        "options_include": "2-5"
      },
      {
        "seat": 2,
        "options_include": "1-3"
      },
      {
        "seat": 1,
        "options_include": "sum"
      },
      {
        "seat": 2,
        "options_include": "gap"
      }
    ],
    "expect": {
      "players": {
        "1": {
          "last_action": "sum",
          "last_answer": "MIDDLE"
        },
        "2": {
          "last_action": "gap",
          "last_answer": "APART"
        }
      },
      "game": {
        "leg": 1,
        "turn_in_leg": 2
      }
    },
    "rule_text": "When turn_in_leg is 1, both players choose a code at the same time and in secret from the 21 codes low-high with 0 <= low <= high <= 5, for example 3-3."
  },
  {
    "name": "Code chosen on turn 1 is kept on turn 2",
    "rule": "R3",
    "players": 2,
    "rounds": 2,
    "rules": [
      {
        "seat": 2,
        "options_include": "4-5"
      },
      {
        "seat": 1,
        "options_include": "sum"
      },
      {
        "seat": 1,
        "options_include": "big"
      }
    ],
    "expect": {
      "players": {
        "1": {
          "last_action": "big",
          "last_answer": "2"
        }
      },
      "game": {
        "turn_in_leg": 3
      }
    },
    "rule_text": "A player's code is not changed during a leg; code_low and code_high are only set on turn 1 of a leg."
  },
  {
    "name": "Each unsolved player is offered the five questions and guesses",
    "rule": "R4",
    "players": 2,
    "rounds": 1,
    "rules": [
      {
        "seat": 1,
        "options_include": "sum"
      },
      {
        "seat": 2,
        "options_include": "edge"
      }
    ],
    "expect": {
      "offered": [
        {
          "seat": 1,
          "option": "sum"
        },
        {
          "seat": 1,
          "option": "odd"
        },
        {
          "seat": 1,
          "option": "gap"
        },
        {
          "seat": 1,
          "option": "big"
        },
        {
          "seat": 1,
          "option": "edge"
        },
        {
          "seat": 1,
          "option": "guess 3-3"
        },
        {
          "seat": 2,
          "option": "sum"
        },
        {
          "seat": 2,
          "option": "guess 0-5"
        }
      ],
      "players": {
        "1": {
          "last_action": "sum"
        },
        "2": {
          "last_action": "edge"
        }
      }
    },
    "rule_text": "On each turn, every unsolved player picks at the same time exactly one action: sum, odd, gap, big, edge, or guess of a full code."
  },
  {
    "name": "Sum: 2-5 gives HIGH, 0-1 gives LOW",
    "rule": "R5",
    "players": 2,
    "rounds": 1,
    "given": {
      "game": {
        "turn_in_leg": 2,
        "seat1_code_low": 0,
        "seat1_code_high": 1,
        "seat2_code_low": 2,
        "seat2_code_high": 5
      },
      "players": {
        "1": {
          "code_low": 0,
          "code_high": 1
        },
        "2": {
          "code_low": 2,
          "code_high": 5
        }
      }
    },
    "rules": [
      {
        "seat": 1,
        "options_include": "sum"
      },
      {
        "seat": 2,
        "options_include": "sum"
      }
    ],
    "expect": {
      "players": {
        "1": {
          "last_answer": "HIGH"
        },
        "2": {
          "last_answer": "LOW"
        }
      }
    },
    "rule_text": "When a player asks sum and the opponent's code is (L, H), then the answer is LOW if L+H is 0-3, MIDDLE if 4-6, HIGH if 7-10; for example code 2-5 gives HIGH."
  },
  {
    "name": "Odd: 1-3 gives 2, 0-4 gives 0",
    "rule": "R6",
    "players": 2,
    "rounds": 1,
    "given": {
      "game": {
        "turn_in_leg": 2,
        "seat1_code_low": 0,
        "seat1_code_high": 4,
        "seat2_code_low": 1,
        "seat2_code_high": 3
      },
      "players": {
        "1": {
          "code_low": 0,
          "code_high": 4
        },
        "2": {
          "code_low": 1,
          "code_high": 3
        }
      }
    },
    "rules": [
      {
        "seat": 1,
        "options_include": "odd"
      },
      {
        "seat": 2,
        "options_include": "odd"
      }
    ],
    "expect": {
      "players": {
        "1": {
          "last_answer": "2"
        },
        "2": {
          "last_answer": "0"
        }
      }
    },
    "rule_text": "When a player asks odd, then the answer is the number of odd tiles in the opponent's code; for example code 1-3 gives 2 and code 0-4 gives 0."
  },
  {
    "name": "Gap: 2-4 gives APART, 3-3 gives PAIR",
    "rule": "R7",
    "players": 2,
    "rounds": 1,
    "given": {
      "game": {
        "turn_in_leg": 2,
        "seat1_code_low": 3,
        "seat1_code_high": 3,
        "seat2_code_low": 2,
        "seat2_code_high": 4
      },
      "players": {
        "1": {
          "code_low": 3,
          "code_high": 3
        },
        "2": {
          "code_low": 2,
          "code_high": 4
        }
      }
    },
    "rules": [
      {
        "seat": 1,
        "options_include": "gap"
      },
      {
        "seat": 2,
        "options_include": "gap"
      }
    ],
    "expect": {
      "players": {
        "1": {
          "last_answer": "APART"
        },
        "2": {
          "last_answer": "PAIR"
        }
      }
    },
    "rule_text": "When a player asks gap, then the answer is PAIR if H-L = 0, ADJACENT if H-L = 1, APART if H-L >= 2; for example code 2-4 gives APART."
  },
  {
    "name": "Big: 2-3 gives 1, 4-5 gives 2",
    "rule": "R8",
    "players": 2,
    "rounds": 1,
    "given": {
      "game": {
        "turn_in_leg": 2,
        "seat1_code_low": 4,
        "seat1_code_high": 5,
        "seat2_code_low": 2,
        "seat2_code_high": 3
      },
      "players": {
        "1": {
          "code_low": 4,
          "code_high": 5
        },
        "2": {
          "code_low": 2,
          "code_high": 3
        }
      }
    },
    "rules": [
      {
        "seat": 1,
        "options_include": "big"
      },
      {
        "seat": 2,
        "options_include": "big"
      }
    ],
    "expect": {
      "players": {
        "1": {
          "last_answer": "1"
        },
        "2": {
          "last_answer": "2"
        }
      }
    },
    "rule_text": "When a player asks big, then the answer is the number of tiles that are 3 or more; for example code 2-3 gives 1."
  },
  {
    "name": "Edge: 0-5 gives 2, 0-0 gives 2",
    "rule": "R9",
    "players": 2,
    "rounds": 1,
    "given": {
      "game": {
        "turn_in_leg": 2,
        "seat1_code_low": 0,
        "seat1_code_high": 0,
        "seat2_code_low": 0,
        "seat2_code_high": 5
      },
      "players": {
        "1": {
          "code_low": 0,
          "code_high": 0
        },
        "2": {
          "code_low": 0,
          "code_high": 5
        }
      }
    },
    "rules": [
      {
        "seat": 1,
        "options_include": "edge"
      },
      {
        "seat": 2,
        "options_include": "edge"
      }
    ],
    "expect": {
      "players": {
        "1": {
          "last_answer": "2"
        },
        "2": {
          "last_answer": "2"
        }
      }
