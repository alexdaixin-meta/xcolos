    "rule_text": "When a player asks edge, then the answer is the number of tiles equal to 0 or 5; for example code 0-5 gives 2 and code 0-0 gives 2."
  },
  {
    "name": "Repeating odd in the same leg gives the same answer",
    "rule": "R10",
    "players": 2,
    "rounds": 2,
    "given": {
      "game": {
        "turn_in_leg": 2,
        "seat1_code_low": 0,
        "seat1_code_high": 0,
        "seat2_code_low": 1,
        "seat2_code_high": 4
      },
      "players": {
        "1": {
          "code_low": 0,
          "code_high": 0
        },
        "2": {
          "code_low": 1,
          "code_high": 4
        }
      }
    },
    "rules": [
      {
        "seat": 1,
        "options_include": "odd",
        "times": 2
      }
    ],
    "expect": {
      "players": {
        "1": {
          "last_action": "odd",
          "last_answer": "1"
        }
      },
      "game": {
        "turn_in_leg": 4
      }
    },
    "rule_text": "When a player repeats a question in the same leg, then the answer is the same as before, because the code has not changed."
  },
  {
    "name": "Correct guess on turn 3 scores 4",
    "rule": "R11",
    "players": 2,
    "rounds": 1,
    "given": {
      "game": {
        "turn_in_leg": 3,
        "seat1_code_low": 0,
        "seat1_code_high": 0,
        "seat2_code_low": 2,
        "seat2_code_high": 5
      },
      "players": {
        "1": {
          "code_low": 0,
          "code_high": 0,
          "score": 0
        },
        "2": {
          "code_low": 2,
          "code_high": 5,
          "score": 0
        }
      }
    },
    "rules": [
      {
        "seat": 1,
        "options_include": "guess 2-5"
      },
      {
        "seat": 2,
        "options_include": "sum"
      }
    ],
    "expect": {
      "players": {
        "1": {
          "score": 4,
          "last_answer": "CORRECT"
        },
        "2": {
          "score": 0
        }
      }
    },
    "rule_text": "When a guess equals the opponent's code exactly, then it is CORRECT and the guesser scores 7 minus turn_in_leg: 6 on turn 1, 5 on turn 2, 4 on turn 3, 3 on turn 4, 2 on turn 5, 1 on turn 6."
  },
  {
    "name": "Correct guess adds a solved leg and the solver sits out the next turn",
    "rule": "R12",
    "players": 2,
    "rounds": 2,
    "given": {
      "game": {
        "turn_in_leg": 2,
        "seat1_code_low": 0,
        "seat1_code_high": 0,
        "seat2_code_low": 1,
        "seat2_code_high": 4
      },
      "players": {
        "1": {
          "code_low": 0,
          "code_high": 0
        },
        "2": {
          "code_low": 1,
          "code_high": 4
        }
      }
    },
    "rules": [
      {
        "seat": 1,
        "options_include": "guess 1-4"
      },
      {
        "seat": 2,
        "options_include": "sum",
        "times": "all"
      }
    ],
    "expect": {
      "players": {
        "1": {
          "score": 5,
          "legs_solved": 1,
          "last_action": "solved"
        },
        "2": {
          "score": 0,
          "legs_solved": 0
        }
      }
    },
    "rule_text": "When a guess is correct, then the guesser's legs_solved increases by 1 and solved becomes true for the rest of the leg."
  },
  {
    "name": "Wrong guess scores 0 and costs nothing",
    "rule": "R13",
    "players": 2,
    "rounds": 1,
    "given": {
      "game": {
        "turn_in_leg": 2,
        "seat1_code_low": 0,
        "seat1_code_high": 0,
        "seat2_code_low": 3,
        "seat2_code_high": 4
      },
      "players": {
        "1": {
          "code_low": 0,
          "code_high": 0,
          "score": 3,
          "legs_solved": 1
        },
        "2": {
          "code_low": 3,
          "code_high": 4
        }
      }
    },
    "rules": [
      {
        "seat": 1,
        "options_include": "guess 3-3"
      },
      {
        "seat": 2,
        "options_include": "sum"
      }
    ],
    "expect": {
      "players": {
        "1": {
          "score": 3,
          "legs_solved": 1
        }
      }
    },
    "rule_text": "When a guess is wrong, then it scores 0, costs nothing, and the answer is how many guessed tiles appear in the code, each code tile matching at most one guessed tile; for example guess 3-3 against code 3-4 answers 1, and guess 1-2 against code 3-4 answers 0."
  },
  {
    "name": "A solved player is not asked and scores nothing; the other keeps playing",
    "rule": "R14",
    "players": 2,
    "rounds": 1,
    "given": {
      "game": {
        "turn_in_leg": 3,
        "seat1_code_low": 2,
        "seat1_code_high": 2,
        "seat2_code_low": 1,
        "seat2_code_high": 4
      },
      "players": {
        "1": {
          "code_low": 2,
          "code_high": 2,
          "solved": true,
          "score": 5,
          "legs_solved": 1
        },
        "2": {
          "code_low": 1,
          "code_high": 4
        }
      }
    },
    "rules": [
      {
        "seat": 2,
        "options_include": "guess 2-2"
      }
    ],
    "expect": {
      "players": {
        "1": {
          "score": 5,
          "legs_solved": 1,
          "last_action": "solved"
        },
        "2": {
          "score": 4,
          "legs_solved": 1,
          "last_answer": "CORRECT"
        }
      },
      "not_offered": [
        {
          "seat": 1,
          "option": "sum"
        },
        {
          "seat": 1,
          "option": "guess 1-4"
        }
      ],
      "offered": [
        {
          "seat": 2,
          "option": "sum"
        }
      ]
    },
    "rule_text": "When a player has solved == true, then they are not asked for an action for the rest of that leg and score nothing more in it, while the other player keeps playing normally."
  },
  {
    "name": "Both actions and their truthful answers are reported",
    "rule": "R15",
    "players": 2,
    "rounds": 1,
    "given": {
      "game": {
        "turn_in_leg": 2,
        "seat1_code_low": 3,
        "seat1_code_high": 5,
        "seat2_code_low": 1,
        "seat2_code_high": 2
      },
      "players": {
        "1": {
          "code_low": 3,
          "code_high": 5
        },
        "2": {
          "code_low": 1,
          "code_high": 2
        }
      }
    },
    "rules": [
      {
        "seat": 1,
        "options_include": "gap"
      },
      {
        "seat": 2,
        "options_include": "big"
      }
    ],
    "expect": {
      "players": {
        "1": {
          "last_action": "gap",
          "last_answer": "ADJACENT"
        },
        "2": {
          "last_action": "big",
          "last_answer": "2"
        }
      }
    },
    "rule_text": "After both have chosen on a turn, then both players are told each player's action and its truthful answer, computed from the opponent's code."
  },
  {
    "name": "After turn 6 the next leg starts and solved is reset",
    "rule": "R16",
    "players": 2,
    "rounds": 2,
    "given": {
      "game": {
        "leg": 1,
        "turn_in_leg": 6,
        "seat1_code_low": 0,
        "seat1_code_high": 0,
        "seat2_code_low": 1,
        "seat2_code_high": 1
      },
      "players": {
        "1": {
          "code_low": 0,
          "code_high": 0,
          "solved": true,
          "score": 4,
          "legs_solved": 1
        },
        "2": {
          "code_low": 1,
          "code_high": 1
        }
      }
    },
    "rules": [
      {
        "seat": 2,
        "options_include": "sum",
        "times": "all"
      },
      {
        "seat": 1,
        "options_include": "edge"
      }
    ],
    "expect": {
      "game": {
        "leg": 2,
        "turn_in_leg": 2
      },
      "players": {
        "1": {
          "score": 4,
          "legs_solved": 1,
          "last_action": "edge"
        },
        "2": {
          "score": 0,
          "legs_solved": 0
        }
      },
      "offered": [
        {
          "seat": 1,
          "option": "guess 0-0"
        }
      ]
    },
    "rule_text": "When turn 6 of a leg ends, then both codes are revealed to both players, solved is reset, and the next leg starts with new codes; a leg nobody solved scores nothing."
  },
  {
