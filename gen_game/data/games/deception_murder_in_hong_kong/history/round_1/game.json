    },
    {
      "use": "poll",
      "phase": "accusation",
      "label": "accusation means",
      "to": {
        "where": "you.pick_clue != '' and you.pick_clue != 'PASS'"
      },
      "answer": {
        "type": "choice",
        "options": {
          "game": "means_options"
        }
      },
      "store": "pick_means",
      "text": "Name the Means of your accusation (any Means word on the table)."
    },
    {
      "use": "update",
      "phase": "resolution",
      "label": "resolution",
      "do": [
        {
          "set": {
            "players": {
              "where": "you.pick_clue == 'PASS'"
            },
            "key": "acc_clue",
            "value": "PASS",
            "text": "Seat {player} passes.",
            "announce_to": "all"
          }
        },
        {
          "set": {
            "players": {
              "where": "you.pick_clue != '' and you.pick_clue != 'PASS'"
            },
            "key": "acc_clue",
            "value": {
              "calc": "you.pick_clue"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.pick_clue != '' and you.pick_clue != 'PASS'"
            },
            "key": "acc_means",
            "value": {
              "calc": "you.pick_means"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.pick_clue != '' and you.pick_clue != 'PASS'"
            },
            "key": "verdict",
            "value": {
              "calc": "you.pick_clue + ' with ' + you.pick_means + ': ' + ('CORRECT' if you.pick_clue == key_evidence and you.pick_means == means_of_murder else 'wrong')"
            },
            "text": "Seat {player} accuses {value}.",
            "announce_to": "all"
          }
        },
        {
          "set": {
            "players": {
              "where": "you.pick_clue != '' and you.pick_clue != 'PASS' and you.badge >= 1"
            },
            "key": "badge",
            "value": {
              "calc": "you.badge - 1"
            }
          }
        },
        {
          "set": {
            "key": "solved",
            "value": true,
            "if": {
              "calc": "any(p.pick_clue == key_evidence and p.pick_means == means_of_murder for p in players)"
            },
            "text": "The case is SOLVED.",
            "announce_to": "all"
          }
        }
      ],
      "text": "The accusations of round {round} are revealed."
    },
    {
      "use": "ask",
      "phase": "hunt",
      "label": "witness hunt",
      "when": {
        "calc": "solved"
      },
      "to": {
        "where": "you.role == 'Murderer'"
      },
      "answer": {
        "type": "player",
        "exclude_self": true,
        "exclude": {
          "where": "you.seat == scientist_seat or you.role in ['Murderer', 'Accomplice']"
        }
      },
      "verify": {
        "bind": "ht"
      },
      "text": "The case is solved. Name the seat you believe is the Witness. If you are right, the Murderer side wins; otherwise the Investigator side wins."
    },
    {
      "use": "update",
      "phase": "hunt",
      "label": "hunt result",
      "when": {
        "calc": "solved"
      },
      "do": [
        {
          "set": {
            "key": "hunt_target",
            "value": "$ht"
          }
        },
        {
          "set": {
            "players": {
              "where": "you.side == 'murderer'"
            },
            "key": "won",
            "value": {
              "calc": "win_value"
            },
            "if": {
              "calc": "any(p.role == 'Witness' and p.seat == hunt_target for p in players)"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.side == 'investigator'"
            },
            "key": "won",
            "value": {
              "calc": "win_value"
            },
            "if": {
              "calc": "not any(p.role == 'Witness' and p.seat == hunt_target for p in players)"
            }
          }
        },
        {
          "set": {
            "key": "game_over",
            "value": 1
          }
        }
      ],
      "text": "The Murderer names seat {hunt_target} as the Witness."
    },
    {
      "use": "update",
      "phase": "end",
      "label": "time runs out",
      "when": {
        "calc": "not solved and round >= rounds"
      },
      "do": [
        {
          "set": {
            "players": {
              "where": "you.side == 'murderer'"
            },
            "key": "won",
            "value": {
              "calc": "win_value"
            }
          }
        },
        {
          "set": {
            "key": "game_over",
            "value": 1
          }
        }
      ],
      "text": "Round {rounds} ends with the case unsolved. The Murderer side wins."
    },
    {
      "use": "check",
      "phase": "end",
      "label": "is it over",
      "when": {
        "calc": "game_over == 1"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "game_over == 1"
      },
      "rank_by": "you.won",
      "min_to_win": 1,
      "reveal": [
        "role"
      ],
      "text": "Winner: {result}. Solved: {solved}; Key Evidence {key_evidence}, Means of Murder {means_of_murder}; Witness Hunt named seat {hunt_target}."
    }
  },
  "limits": {
    "rounds": 6,
    "rounds_max": 6,
    "actions_max": 400,
    "deadline_s": 120
  },
  "rules": "ROLES. Seat {scientist_seat} is publicly the Forensic Scientist. The other players are secretly and randomly dealt {murderers} Murderer, {accomplices} Accomplice, {witnesses} Witness, and Investigators for the rest (player count minus {investigators_formula_offset}). The Murderer and Accomplice are the Murderer side. The Scientist, Witness and Investigators are the Investigator side. The Accomplice is told who the Murderer is. The Witness is told who the Murderer and Accomplice are, but not which of the two is which, and not the solution. The Scientist is told all roles.\n\nCARDS. Every player except the Scientist is dealt, face up for all to see, {clues_per_player} Clue words from the Clue list ({clue_list_size} words) and {means_per_player} Means words from the Means list ({means_list_size} words), with no repeats.\n\nSOLUTION. The Murderer privately chooses one of their own Clues as the Key Evidence and one of their own Means as the Means of Murder. The Scientist and the Accomplice are then told the solution privately; no one else is.\n\nSCENE TILES. Each tile lists {options_per_tile} options. Cause of Death: Suffocation, Severe Injury, Loss of Blood, Illness, Poisoning, Accident. Location: Living Room, Bedroom, Bathroom, Kitchen, Street, Office. The Deck holds {deck_tiles} tiles: Time of Death (Dawn, Morning, Noon, Afternoon, Evening, Night); Weather (Sunny, Stormy, Dry, Humid, Cold, Hot); Victim's Build (Large, Thin, Tall, Short, Disfigured, Fit); Trace at Scene (Fingerprint, Footprint, Bruise, Blood Stain, Body Fluid, Scar); Corpse Condition (Still Warm, Stiff, Decayed, Incomplete, Intact, Twisted); Duration of Crime (Instant, Brief, Gradual, Prolonged, Days, Unclear).\n\nBADGES. Every player except the Scientist starts with {starting_badges} badge.\n\nEACH ROUND ({rounds} rounds):\n1. Tile. In round 1 the tile is Cause of Death. In round 2 it is Location. In rounds 3, 4 and 5, one tile is drawn at random from the Deck and removed ({deck_draws} draws in all).\n2. Marker. The Scientist privately chooses exactly one of the tile's {options_per_tile} options, and the marked option is announced to all. The Scientist may never send any other message.\n3. Talk. Every player except the Scientist writes one short message at the same time. All messages are then shown to everyone.\n4. Accusation. Every player who still has a badge chooses at the same time either PASS or one accusation: one Clue word and one Means word currently on the table. Anyone who accuses loses their badge, whether the accusation is right or wrong, and is never asked to accuse again. A player who passes keeps their badge.\n5. Resolution. Every accusation is announced with its accuser. An accusation is correct only if its Clue is the Key Evidence and its Means is the Means of Murder, and each is announced as correct or wrong. A pair taken from two different players' cards is always wrong. If any accusation is correct, the case is SOLVED and play moves to the Witness Hunt. Otherwise the next round begins.\n\nWITNESS HUNT. When the case is solved, the Murderer privately names one player other than the Scientist, the Accomplice and themself. If that player is the Witness, the Murderer side wins. Otherwise the Investigator side wins.\n\nEND. If the case is not solved by the end of round {rounds}, the Murderer side wins. Every player on the winning side gets won = {win_value} and shares the win; there are no draws."
}
