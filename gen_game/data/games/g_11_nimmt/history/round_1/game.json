              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "append": {
            "key": "pile_c",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        }
      ],
      "text": "The piles start: A {pile_a}, B {pile_b}, C {pile_c}."
    },
    {
      "use": "update",
      "label": "set aside the rest",
      "do": [
        {
          "set": {
            "key": "set_aside",
            "value": {
              "calc": "[c for c in deck]"
            }
          }
        },
        {
          "set": {
            "key": "deck",
            "value": []
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "the supply and the turn order",
      "do": [
        {
          "set": {
            "key": "bull_supply",
            "value": {
              "calc": "len(players) - bull_supply_offset"
            }
          }
        },
        {
          "set": {
            "key": "max_cycles",
            "value": {
              "calc": "max_cycles_with_4 if len(players) >= 4 else max_cycles_with_3"
            }
          }
        },
        {
          "set": {
            "key": "active_seat",
            "value": 1
          }
        },
        {
          "set": {
            "key": "cycle",
            "value": 0
          }
        },
        {
          "set": {
            "key": "ending_triggered",
            "value": false
          }
        }
      ]
    }
  ],
  "steps": [
    {
      "use": "update",
      "phase": "turn",
      "label": "build the action offer",
      "do": [
        {
          "set": {
            "key": "extra_stopped",
            "value": false
          }
        },
        {
          "set": {
            "key": "action_kind",
            "value": ""
          }
        },
        {
          "set": {
            "key": "chosen_pile",
            "value": ""
          }
        },
        {
          "set": {
            "key": "taken_size",
            "value": 0
          }
        },
        {
          "set": {
            "key": "chosen_card",
            "value": 0
          }
        },
        {
          "set": {
            "key": "extra_card",
            "value": 0
          }
        },
        {
          "set": {
            "key": "restart_card",
            "value": 0
          }
        },
        {
          "set": {
            "key": "victim",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "['play ' + card_labels[c - 1] + ' on A' for c in you.hand if (c - pile_a[len(pile_a) - 1]) % legal_modulus >= legal_step_min and (c - pile_a[len(pile_a) - 1]) % legal_modulus <= legal_step_max] + ['play ' + card_labels[c - 1] + ' on B' for c in you.hand if (c - pile_b[len(pile_b) - 1]) % legal_modulus >= legal_step_min and (c - pile_b[len(pile_b) - 1]) % legal_modulus <= legal_step_max] + ['play ' + card_labels[c - 1] + ' on C' for c in you.hand if (c - pile_c[len(pile_c) - 1]) % legal_modulus >= legal_step_min and (c - pile_c[len(pile_c) - 1]) % legal_modulus <= legal_step_max] + ['take A', 'take B', 'take C']"
            }
          }
        }
      ]
    },
    {
      "use": "sync",
      "phase": "turn",
      "label": "the state",
      "mode": "self",
      "to": "all",
      "text": "Seat {active_seat} is to move. Piles: A {pile_a}, B {pile_b}, C {pile_c}. Bull supply {bull_supply}. Cycle {cycle} of {max_cycles}. Last action: {last_action}. Where you stand:"
    },
    {
      "use": "ask",
      "phase": "turn",
      "label": "main action",
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "main"
      },
      "text": "Your turn. Piles: A {pile_a}, B {pile_b}, C {pile_c} (the last card is the top). Play a legal card onto a pile, or take a pile."
    },
    {
      "use": "update",
      "phase": "turn",
      "label": "read the action",
      "do": [
        {
          "set": {
            "key": "chosen_card",
            "value": {
              "calc": "max([c for c in cards if $main == 'play ' + card_labels[c - 1] + ' on A' or $main == 'play ' + card_labels[c - 1] + ' on B' or $main == 'play ' + card_labels[c - 1] + ' on C'] + [0])"
            }
          }
        },
        {
          "set": {
            "key": "chosen_pile",
            "value": {
              "calc": "'A' if ($main == 'take A' or any([$main == 'play ' + card_labels[c - 1] + ' on A' for c in cards])) else ('B' if ($main == 'take B' or any([$main == 'play ' + card_labels[c - 1] + ' on B' for c in cards])) else ('C' if ($main == 'take C' or any([$main == 'play ' + card_labels[c - 1] + ' on C' for c in cards])) else ('A' if len(pile_a) <= len(pile_b) and len(pile_a) <= len(pile_c) else ('B' if len(pile_b) <= len(pile_c) else 'C'))))"
            }
          }
        },
        {
          "set": {
            "key": "action_kind",
            "value": {
              "calc": "'play' if chosen_card > 0 else 'take'"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "turn",
      "label": "the play",
      "when": {
        "calc": "action_kind == 'play'"
      },
      "do": [
        {
          "remove": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "chosen_card"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand_size",
            "value": -1
          }
        },
        {
          "append": {
            "key": "pile_a",
            "value": {
              "calc": "chosen_card"
            },
            "if": {
              "calc": "chosen_pile == 'A'"
            }
          }
        },
        {
          "append": {
            "key": "pile_b",
            "value": {
              "calc": "chosen_card"
            },
            "if": {
              "calc": "chosen_pile == 'B'"
            }
          }
        },
        {
          "append": {
            "key": "pile_c",
            "value": {
              "calc": "chosen_card"
            },
            "if": {
              "calc": "chosen_pile == 'C'"
            }
          }
        },
        {
          "set": {
            "key": "pile_top",
            "value": {
              "calc": "chosen_card"
            }
          }
        },
        {
          "set": {
            "key": "last_action",
            "value": {
              "calc": "'Seat ' + card_labels[active_seat - 1] + ' plays ' + card_labels[chosen_card - 1] + ' on ' + chosen_pile"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "offer",
            "value": {
              "calc": "['stop'] + [card_labels[c - 1] for c in you.hand if (c - pile_top) % legal_modulus >= legal_step_min and (c - pile_top) % legal_modulus <= legal_step_max]"
            }
          }
        }
      ],
      "text": "{last_action}."
    },
    {
      "use": "ask",
      "phase": "turn",
      "label": "first extra card",
      "when": {
        "calc": "action_kind == 'play' and max([p.bulls for p in players if p.seat == active_seat] + [0]) >= bulls_for_first_extra"
      },
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "x1"
      },
      "text": "Your bull lets you add one more card legal on the new top of pile {chosen_pile}, or stop. Piles: A {pile_a}, B {pile_b}, C {pile_c}."
    },
    {
      "use": "update",
      "phase": "turn",
      "label": "apply the first extra card",
      "when": {
        "calc": "action_kind == 'play' and max([p.bulls for p in players if p.seat == active_seat] + [0]) >= bulls_for_first_extra"
      },
      "do": [
        {
          "set": {
            "key": "extra_card",
            "value": {
              "calc": "max([c for c in cards if card_labels[c - 1] == $x1] + [0])"
            }
          }
        },
        {
          "set": {
            "key": "extra_stopped",
            "value": {
              "calc": "extra_card == 0"
            }
          }
        },
        {
          "remove": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "extra_card"
            },
            "if": {
              "calc": "extra_card > 0"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand_size",
            "value": -1,
            "if": {
              "calc": "extra_card > 0"
            }
          }
        },
        {
          "append": {
            "key": "pile_a",
            "value": {
              "calc": "extra_card"
            },
            "if": {
              "calc": "extra_card > 0 and chosen_pile == 'A'"
            }
          }
        },
        {
          "append": {
            "key": "pile_b",
            "value": {
              "calc": "extra_card"
            },
            "if": {
              "calc": "extra_card > 0 and chosen_pile == 'B'"
            }
          }
        },
        {
          "append": {
            "key": "pile_c",
            "value": {
              "calc": "extra_card"
            },
            "if": {
              "calc": "extra_card > 0 and chosen_pile == 'C'"
            }
          }
        },
        {
          "set": {
            "key": "pile_top",
            "value": {
              "calc": "extra_card"
            },
            "if": {
              "calc": "extra_card > 0"
            }
          }
        },
        {
          "set": {
            "key": "last_action",
            "value": {
              "calc": "last_action + ', then ' + card_labels[extra_card - 1]"
            },
            "if": {
              "calc": "extra_card > 0"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "offer",
            "value": {
              "calc": "['stop'] + [card_labels[c - 1] for c in you.hand if (c - pile_top) % legal_modulus >= legal_step_min and (c - pile_top) % legal_modulus <= legal_step_max]"
            }
          }
        }
      ],
      "text": "{last_action}."
    },
    {
      "use": "ask",
      "phase": "turn",
      "label": "second extra card",
      "when": {
        "calc": "action_kind == 'play' and not extra_stopped and max([p.bulls for p in players if p.seat == active_seat] + [0]) >= bulls_for_second_extra"
      },
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "x2"
      },
      "text": "Your second bull lets you add one more card legal on the new top of pile {chosen_pile}, or stop. Piles: A {pile_a}, B {pile_b}, C {pile_c}."
    },
    {
      "use": "update",
      "phase": "turn",
      "label": "apply the second extra card",
      "when": {
        "calc": "action_kind == 'play' and not extra_stopped and max([p.bulls for p in players if p.seat == active_seat] + [0]) >= bulls_for_second_extra"
      },
      "do": [
        {
          "set": {
            "key": "extra_card",
            "value": {
              "calc": "max([c for c in cards if card_labels[c - 1] == $x2] + [0])"
            }
          }
        },
        {
          "set": {
            "key": "extra_stopped",
            "value": true
          }
        },
        {
          "remove": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "extra_card"
            },
            "if": {
              "calc": "extra_card > 0"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand_size",
            "value": -1,
            "if": {
              "calc": "extra_card > 0"
            }
          }
        },
        {
          "append": {
            "key": "pile_a",
            "value": {
              "calc": "extra_card"
            },
            "if": {
              "calc": "extra_card > 0 and chosen_pile == 'A'"
            }
          }
        },
        {
          "append": {
            "key": "pile_b",
            "value": {
              "calc": "extra_card"
            },
            "if": {
              "calc": "extra_card > 0 and chosen_pile == 'B'"
            }
          }
        },
        {
          "append": {
            "key": "pile_c",
            "value": {
              "calc": "extra_card"
            },
            "if": {
              "calc": "extra_card > 0 and chosen_pile == 'C'"
            }
          }
        },
        {
          "set": {
            "key": "last_action",
            "value": {
              "calc": "last_action + ', then ' + card_labels[extra_card - 1]"
            },
            "if": {
              "calc": "extra_card > 0"
            }
          }
        }
      ],
      "text": "{last_action}."
    },
    {
      "use": "update",
      "phase": "turn",
      "label": "the take",
      "when": {
        "calc": "action_kind == 'take'"
      },
      "do": [
        {
          "set": {
            "key": "taken_size",
            "value": {
              "calc": "len(pile_a) if chosen_pile == 'A' else (len(pile_b) if chosen_pile == 'B' else len(pile_c))"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "you.hand + (pile_a if chosen_pile == 'A' else (pile_b if chosen_pile == 'B' else pile_c))"
            }
          }
        },
        {
          "set": {
            "key": "pile_a",
            "value": [],
            "if": {
              "calc": "chosen_pile == 'A'"
            }
          }
        },
        {
          "set": {
            "key": "pile_b",
            "value": [],
            "if": {
              "calc": "chosen_pile == 'B'"
            }
          }
        },
        {
          "set": {
            "key": "pile_c",
            "value": [],
            "if": {
              "calc": "chosen_pile == 'C'"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand_size",
            "value": {
              "calc": "taken_size"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "offer",
            "value": {
              "calc": "[card_labels[c - 1] for c in you.hand]"
            }
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "turn",
      "label": "restart card",
      "when": {
        "calc": "action_kind == 'take'"
      },
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "rc"
      },
      "text": "You took pile {chosen_pile} ({taken_size} cards). Choose one card from your hand to place face up as the single card of the restarted pile {chosen_pile}."
    },
    {
      "use": "update",
      "phase": "turn",
      "label": "restart the pile",
      "when": {
        "calc": "action_kind == 'take'"
      },
      "do": [
        {
          "set": {
            "key": "restart_card",
            "value": {
              "calc": "max([c for c in cards if card_labels[c - 1] == $rc] + [0])"
            }
          }
        },
        {
          "remove": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "restart_card"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand_size",
            "value": -1
          }
        },
        {
          "set": {
            "key": "pile_a",
            "value": {
              "calc": "[restart_card]"
            },
            "if": {
              "calc": "chosen_pile == 'A'"
            }
          }
        },
        {
          "set": {
            "key": "pile_b",
            "value": {
              "calc": "[restart_card]"
            },
            "if": {
              "calc": "chosen_pile == 'B'"
            }
          }
        },
        {
          "set": {
            "key": "pile_c",
            "value": {
              "calc": "[restart_card]"
            },
            "if": {
              "calc": "chosen_pile == 'C'"
            }
          }
        },
        {
          "set": {
            "key": "last_action",
            "value": {
              "calc": "'Seat ' + card_labels[active_seat - 1] + ' takes ' + chosen_pile + ' (' + card_labels[taken_size - 1] + ' cards) and restarts it with ' + card_labels[restart_card - 1]"
            }
          }
        }
      ],
      "text": "{last_action}."
    },
    {
      "use": "update",
      "phase": "turn",
      "label": "the bull for a big take",
      "when": {
        "calc": "action_kind == 'take' and taken_size >= take_bull_threshold"
      },
      "do": [
        {
          "set": {
            "key": "victim",
            "value": {
              "calc": "0 if bull_supply > 0 or max([p.bulls for p in players if p.seat != active_seat] + [0]) == 0 else ((active_seat - 1 + min([(p.seat - active_seat) % len(players) for p in players if p.seat != active_seat and p.bulls == max([q.bulls for q in players if q.seat != active_seat])])) % len(players)) + 1"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "active_seat"
            },
            "key": "bulls",
            "value": 1,
            "if": {
              "calc": "bull_supply > 0 or victim > 0"
            },
            "text": "Seat {player} gains a bull."
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "victim"
            },
            "key": "bulls",
            "value": -1,
            "if": {
              "calc": "victim > 0"
            },
            "text": "The bull is taken from seat {player}."
          }
        },
        {
          "adjust": {
            "key": "bull_supply",
            "value": -1,
            "if": {
              "calc": "bull_supply > 0"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "turn",
      "label": "an empty hand",
      "when": {
        "calc": "max([p.hand_size for p in players if p.seat == active_seat] + [0]) == 0"
      },
      "do": [
        {
          "set": {
            "key": "ending_triggered",
            "value": true
          }
        }
      ],
      "text": "Seat {active_seat} has emptied their hand. The game ends after the last seat's turn in this cycle."
    },
    {
      "use": "update",
      "phase": "turn",
      "label": "pass the turn",
      "do": [
        {
          "adjust": {
            "key": "cycle",
            "value": 1,
            "if": {
              "calc": "active_seat == len(players)"
            }
          }
        },
        {
          "set": {
            "key": "active_seat",
            "value": {
              "calc": "1 if active_seat == len(players) else active_seat + 1"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "end",
      "label": "count the penalties",
      "when": {
        "calc": "active_seat == 1 and (ending_triggered or cycle >= max_cycles)"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "penalty",
            "value": {
              "calc": "empty_hand_penalty if len(you.hand) == 0 else sum([oxheads_multiple_of_10 if c % 10 == 0 else (oxheads_multiple_of_5_not_10 if c % 5 == 0 else oxheads_other) for c in you.hand])"
            }
          }
        }
      ]
    },
    {
      "use": "check",
      "phase": "end",
      "label": "end of the cycle",
      "when": {
        "calc": "active_seat == 1 and (ending_triggered or cycle >= max_cycles)"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "active_seat == 1 and (ending_triggered or cycle >= max_cycles)"
      },
      "rank_by": "0 - you.penalty",
      "reveal": [
        "hand"
      ],
      "text": "Winner: {result}, with the lowest penalty. Final penalties [seat, ox-heads]: {[[p.seat, p.penalty] for p in players]}."
    }
  },
  "limits": {
    "rounds": 45,
    "rounds_max": 45,
    "actions_max": 1500,
    "deadline_s": 120
  },
  "rules": "SETUP. The deck holds the cards numbered {deck_low} to {deck_high} ({deck_size} cards). Ox-heads per card: {oxheads_multiple_of_10} if the number is a multiple of 10; {oxheads_multiple_of_5_not_10} if it is a multiple of 5 but not of 10; {oxheads_other} otherwise. The whole deck holds {deck_total_oxheads} ox-heads. The deck is shuffled once; this is the only random event in the game. Each player is dealt {hand_size_start} cards face down as a private hand. {pile_count} cards are turned face up to start Pile A, Pile B and Pile C, {start_cards_per_pile} card each. The remaining cards ({set_aside_with_4} with 4 players, {set_aside_with_3} with 3) are set aside unseen for the rest of the game. The supply of bull tokens equals the number of players minus {bull_supply_offset} (3 with 4 players, 2 with 3 players). Seats are numbered 1 to N. Seat 1 moves first, and play proceeds in seat order.\n\nWHAT IS PUBLIC. The full ordered contents of every pile (the last card listed is the top), each player's hand size and bull count, and every action taken. Only the contents of hands and the set-aside cards are hidden.\n\nLEGAL PLAY. A card c may be played on a pile whose top card is t if (c - t) mod {legal_modulus} is between {legal_step_min} and {legal_step_max}. Examples: on 12 you may play 13 to 18; on 37 you may play 38, 39, 40, 1, 2 or 3.\n\nA TURN. The active player privately chooses one action: (a) PLAY card X onto pile P, where X is in their hand and legal on P; or (b) TAKE pile P. You are offered every legal play and always the three takes. A player may take even when a legal play exists. If the chosen action is illegal or missing, the player instead TAKES the smallest pile (ties: A before B before C).\n\nIf the player PLAYED: card X goes on top of pile P. If they hold at least {bulls_for_first_extra} bull, they may then add one more card legal on the new top of the same pile, or stop; if they stop, no more cards are added. If they hold {bulls_for_second_extra} or more bulls and did not stop, they may add a second extra card the same way, or stop. If no card in hand is legal, the only option is to stop. Bulls are not spent by using them: your bull count stays the same.\n\nIf the player TOOK pile P: all cards of P go into their hand. They must then choose any one card from their hand to place face up as the single card of the restarted pile P. If P held {take_bull_threshold} or more cards before it was taken, the player gains a bull from the supply. If the supply is empty, they instead take one bull from the opponent holding the most bulls; ties go to the first such player in seat order after the taker. If no opponent has a bull, nothing happens. If P held fewer than {take_bull_threshold} cards, no bull changes hands.\n\nIf the active player's hand is now empty, the game will end at the end of the current cycle, that is, after the player in seat N has finished their turn; every player therefore gets the same number of turns. If the hand is not empty, play simply passes to the next seat.\n\nEND OF GAME. The game ends at the end of the cycle in which any player emptied their hand. It also ends after {max_cycles_with_4} full cycles ({max_turns_with_4} turns with 4 players) or {max_cycles_with_3} full cycles ({max_turns_with_3} turns with 3 players), whichever comes first. This game's limit is {max_cycles} cycles. Each player's penalty is the total ox-heads of the cards in their hand; a player with an empty hand scores {empty_hand_penalty}. The player with the lowest penalty wins. If two or more players tie for lowest, they share the win as a draw."
}
