                "calc": "[s for s in suit_names if s[0] == win_card[0]][0]"
              }
            }
          },
          {
            "set": {
              "key": "winning_seat",
              "value": "$seat"
            }
          },
          {
            "set": {
              "players": {
                "where": "you.seat == leader % len(players) + 1"
              },
              "key": "offer",
              "value": {
                "calc": "[c for c in you.hand if c[0] == led_suit[0] and (win_card[0] != led_suit[0] or len([d for d in you.hand if d[0] == led_suit[0] and d[-1] + win_card[-1] in higher_pairs]) == 0 or c[-1] + win_card[-1] in higher_pairs)] if len([c for c in you.hand if c[0] == led_suit[0]]) > 0 else ([c for c in you.hand if c[0] == trump[0] and (win_card[0] != trump[0] or len([d for d in you.hand if d[0] == trump[0] and d[-1] + win_card[-1] in higher_pairs]) == 0 or c[-1] + win_card[-1] in higher_pairs)] if len([c for c in you.hand if c[0] == trump[0]]) > 0 else you.hand)"
              }
            }
          }
        ]
      },
      "text": "You lead trick {round_in_deal} of deal {deal_number}. Trump is {trump}. Play any card from your hand."
    },
    {
      "use": "ask",
      "phase": "trick",
      "label": "second card",
      "when": {
        "prose": "The card played obeys the legal-card rules: follow the suit led if able, and then overtake when the currently winning card is of the suit led; if void in the suit led, play a trump if able, overtaking the highest trump played if able; otherwise any card."
      },
      "to": {
        "where": "you.seat == leader % len(players) + 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "second_card"
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} plays {value}."
      },
      "each": {
        "do": [
          {
            "remove": {
