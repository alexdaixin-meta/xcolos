  },
  "setup": [
    {
      "use": "update",
      "label": "seats and match scores",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "score",
            "value": {
              "calc": "starting_score"
            }
          }
        },
        {
          "set": {
            "key": "eldest",
            "value": 1
          }
        }
      ],
      "text": "Seats 1, 2 and 3 sit in seat order 1, 2, 3, 1 and so on. Every match score starts at {starting_score}."
    },
    {
      "use": "update",
      "label": "the cards",
      "do": [
        {
          "set": {
            "key": "suit_names",
            "value": [
              "Hearts",
              "Bells",
              "Leaves",
              "Acorns"
            ]
          }
        },
        {
          "set": {
            "key": "full_deck",
            "value": [
              "Hearts A",
              "Hearts 10",
              "Hearts K",
              "Hearts O",
              "Hearts U",
              "Hearts 9",
              "Bells A",
              "Bells 10",
              "Bells K",
              "Bells O",
              "Bells U",
              "Bells 9",
              "Leaves A",
              "Leaves 10",
              "Leaves K",
              "Leaves O",
              "Leaves U",
              "Leaves 9",
              "Acorns A",
              "Acorns 10",
              "Acorns K",
              "Acorns O",
              "Acorns U",
              "Acorns 9"
            ]
          }
        },
        {
          "set": {
            "key": "higher_pairs",
            "value": [
              "A0",
              "AK",
              "AO",
              "AU",
              "A9",
              "0K",
              "0O",
              "0U",
              "09",
              "KO",
              "KU",
              "K9",
              "OU",
              "O9",
              "U9"
            ]
          }
        }
      ],
      "text": "The {deck_size} cards are Hearts, Bells, Leaves and Acorns, each with A, 10, K, O, U and 9, ranking high to low A, 10, K, O, U, 9."
    },
    {
      "use": "tell",
      "label": "no talk",
      "to": "all",
      "text": "There is no talk at any time in this match."
    }
  ],
  "steps": [
    {
      "use": "update",
      "phase": "count",
      "label": "advance the round",
      "do": [
        {
          "adjust": {
            "key": "round_number",
            "value": 1
          }
        },
        {
          "set": {
            "key": "round_in_deal",
            "value": {
              "calc": "(round_number - 1) % rounds_per_deal + 1"
            }
          }
        },
        {
          "set": {
            "key": "deal_number",
            "value": {
              "calc": "(round_number - 1) // rounds_per_deal + 1"
            }
          }
        },
        {
          "set": {
            "key": "eldest",
            "value": {
              "calc": "(deal_number - 1) % len(players) + 1"
            },
            "if": {
              "calc": "round_in_deal == 1"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "deal",
      "label": "reset for a new deal",
      "when": {
        "calc": "round_in_deal == 1"
      },
      "do": [
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "full_deck"
            }
          }
        },
        {
          "set": {
            "key": "talon",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid_choice",
            "value": ""
          }
        },
        {
          "set": {
            "players": "all",
            "key": "flek",
            "value": ""
          }
        },
        {
          "set": {
            "players": "all",
            "key": "is_declarer",
            "value": false
          }
        },
        {
          "set": {
            "players": "all",
            "key": "played_card",
            "value": ""
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": []
          }
        },
        {
          "set": {
            "key": "deal_played",
            "value": false
          }
        },
        {
          "set": {
            "key": "declarer",
            "value": 0
          }
        },
        {
          "set": {
            "key": "contract",
            "value": 0
          }
        },
        {
          "set": {
            "key": "trump",
            "value": "none yet"
          }
        },
        {
          "set": {
            "key": "stake_v",
            "value": 0
          }
        },
        {
          "set": {
            "key": "declarer_points",
            "value": 0
          }
        },
        {
          "set": {
            "key": "defender_points",
            "value": 0
          }
        },
        {
          "set": {
            "key": "trick",
            "value": []
          }
        },
        {
          "set": {
            "key": "led_suit",
            "value": "none yet"
          }
        },
        {
          "set": {
            "key": "winning_seat",
            "value": 0
          }
        },
        {
          "set": {
            "key": "win_card",
            "value": ""
          }
        },
        {
          "set": {
            "key": "leader",
            "value": 0
          }
        }
      ],
      "text": "Deal {deal_number} of {deals} begins. The eldest is Seat {eldest}. All {deck_size} cards are shuffled."
    },
    {
      "use": "repeat",
      "phase": "deal",
      "label": "deal the cards",
      "until": {
        "calc": "round_in_deal != 1 or len(deck) == 0"
      },
      "max": 10,
      "steps": [
        {
          "use": "update",
          "label": "one card to each seat",
          "do": [
            {
              "set": {
                "key": "pick",
                "value": {
                  "calc": "deck[int(uniform(0, len(deck)))]"
                }
              }
            },
            {
              "append": {
                "player": 1,
                "key": "hand",
                "value": {
                  "calc": "pick"
                }
              }
            },
            {
              "remove": {
                "key": "deck",
                "value": {
                  "calc": "pick"
                }
              }
            },
            {
              "set": {
                "key": "pick",
                "value": {
                  "calc": "deck[int(uniform(0, len(deck)))]"
                }
              }
            },
            {
              "append": {
                "player": 2,
                "key": "hand",
                "value": {
                  "calc": "pick"
                }
              }
            },
            {
              "remove": {
                "key": "deck",
                "value": {
                  "calc": "pick"
                }
              }
            },
            {
              "set": {
                "key": "pick",
                "value": {
                  "calc": "deck[int(uniform(0, len(deck)))]"
                }
              }
            },
            {
              "append": {
                "player": 3,
                "key": "hand",
                "value": {
                  "calc": "pick"
                }
              }
            },
            {
              "remove": {
                "key": "deck",
                "value": {
                  "calc": "pick"
                }
              }
            },
            {
              "set": {
                "key": "talon",
                "value": {
                  "calc": "deck"
                },
                "if": {
                  "calc": "len(deck) == talon_size"
                }
              }
            },
            {
              "set": {
                "key": "deck",
                "value": [],
                "if": {
                  "calc": "len(deck) == talon_size"
                }
              }
            },
            {
              "set": {
                "players": "all",
                "key": "hand",
                "value": {
                  "calc": "[c for c in full_deck if c in you.hand]"
                },
                "if": {
                  "calc": "len(deck) == 0"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "use": "sync",
      "phase": "deal",
      "label": "your hand",
      "when": {
        "calc": "round_in_deal == 1"
      },
      "mode": "self",
      "to": "all",
      "fields": [
        "hand",
        "score"
      ],
      "text": "Your hand for deal {deal_number}:"
    },
    {
      "use": "poll",
      "phase": "bid",
      "label": "the bid",
      "when": {
        "calc": "round_in_deal == 1"
      },
      "to": "acting",
      "answer": {
        "type": "choice",
        "options": [
          "PASS",
          "40",
          "50",
          "60"
        ]
      },
      "store": "bid_choice",
      "text": "Deal {deal_number}: bid in secret. Choose PASS, 40, 50 or 60: the card points you promise to take as declarer. Nobody sees another bid. The highest bid becomes declarer; a tie goes to the tied player with the lowest match score, then to the tied player first in seat order from the eldest (Seat {eldest}). If all three pass, the deal is not played."
    },
    {
      "use": "update",
      "phase": "bid",
      "label": "find the declarer",
      "when": {
        "calc": "round_in_deal == 1"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": {
              "calc": "bid_low if you.bid_choice == '40' else (bid_mid if you.bid_choice == '50' else (bid_high if you.bid_choice == '60' else 0))"
            }
          }
        },
        {
          "set": {
            "key": "high_bid",
            "value": {
              "calc": "max([p.bid for p in players])"
            }
          }
        },
        {
          "set": {
            "key": "deal_played",
            "value": {
              "calc": "high_bid > 0"
            }
          }
        },
        {
          "set": {
            "key": "declarer",
            "value": {
              "calc": "[p.seat for p in players if p.bid == high_bid and p.score * 10 + (p.seat - eldest + len(players)) % len(players) == min([q.score * 10 + (q.seat - eldest + len(players)) % len(players) for q in players if q.bid == high_bid])][0]"
            },
            "if": {
              "calc": "deal_played"
            }
          }
        },
        {
          "set": {
            "key": "contract",
            "value": {
              "calc": "high_bid"
            },
            "if": {
              "calc": "deal_played"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == declarer"
            },
            "key": "is_declarer",
            "value": true,
            "if": {
              "calc": "deal_played"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "bid",
      "label": "all passed",
      "when": {
        "calc": "round_in_deal == 1 and not deal_played"
      },
      "to": "all",
      "text": "All three passed; deal {deal_number} is not played."
    },
    {
      "use": "ask",
      "phase": "bid",
      "label": "choose trump",
      "when": {
        "calc": "round_in_deal == 1 and deal_played"
      },
      "to": {
        "where": "you.seat == declarer"
      },
      "answer": {
        "type": "choice",
        "options": [
          "Hearts",
          "Bells",
          "Leaves",
          "Acorns"
        ]
      },
      "verify": {
        "bind": "trump_pick"
      },
      "each": {
        "do": [
          {
            "set": {
              "key": "trump",
              "value": "$answer"
            }
          }
        ]
      },
      "text": "You are the declarer with a contract of {contract}. Choose trump: Hearts, Bells, Leaves or Acorns. Hearts trump doubles the stake."
    },
    {
      "use": "tell",
      "phase": "bid",
      "label": "the contract",
      "when": {
        "calc": "round_in_deal == 1 and deal_played"
      },
      "to": "all",
      "text": "Declarer: Seat {declarer}, contract {contract}, trump {trump}. The other two seats are the defenders."
    },
    {
      "use": "poll",
      "phase": "bid",
      "label": "flek",
      "when": {
        "calc": "round_in_deal == 1 and deal_played"
      },
      "to": {
        "where": "not you.is_declarer"
      },
      "answer": {
        "type": "choice",
        "options": [
          "FLEK",
          "NO"
        ]
      },
      "store": "flek",
      "broadcast": {
        "to": "all",
        "text": "Flek: Seat {seat} says {value}."
      },
      "text": "You are a defender against Seat {declarer}'s contract of {contract} with {trump} trump. Choose FLEK or NO at the same time as the other defender. If at least one defender chooses FLEK, the stake V is doubled; if both choose NO, it is not."
    },
    {
      "use": "update",
      "phase": "bid",
      "label": "the stake",
      "when": {
        "calc": "round_in_deal == 1 and deal_played"
      },
      "do": [
        {
          "set": {
            "key": "stake_v",
            "value": {
              "calc": "(stake_for_40 if contract == bid_low else (stake_for_50 if contract == bid_mid else stake_for_60)) * (hearts_trump_multiplier if trump == 'Hearts' else 1) * (flek_multiplier if count(p.flek == 'FLEK' for p in players) > 0 else 1)"
            }
          }
        }
      ],
      "text": "V = {stake_v} (contract {contract}, trump {trump})."
    },
    {
      "use": "update",
      "phase": "trick",
      "label": "a new trick",
      "when": {
        "calc": "round_in_deal >= 2 and deal_played"
      },
      "do": [
        {
          "set": {
            "key": "leader",
            "value": {
              "calc": "declarer if round_in_deal == 2 else winning_seat"
            }
          }
        },
        {
          "set": {
            "key": "trick",
            "value": []
          }
        },
        {
          "set": {
            "key": "led_suit",
            "value": "none yet"
          }
        },
        {
          "set": {
            "players": "all",
            "key": "played_card",
            "value": ""
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": []
          }
        },
        {
          "set": {
            "key": "winning_seat",
            "value": 0
          }
        },
        {
          "set": {
            "key": "win_card",
            "value": ""
          }
        }
      ],
      "text": "Trick {round_in_deal} of deal {deal_number} (round {round_number}): Seat {leader} leads. Trump is {trump}."
    },
    {
      "use": "ask",
      "phase": "trick",
      "label": "lead a card",
      "when": {
        "calc": "round_in_deal >= 2 and deal_played"
      },
      "to": {
        "where": "you.seat == leader"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "hand"
        }
      },
      "verify": {
        "bind": "lead_card"
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} leads {value}."
      },
      "each": {
