              "value": "$answer"
            }
          },
          {
            "set": {
              "key": "winning_seat",
              "value": "$seat",
              "if": {
                "calc": "(pick[0] == trump[0] and win_card[0] != trump[0]) or (pick[0] == win_card[0] and pick[-1] + win_card[-1] in higher_pairs)"
              }
            }
          },
          {
            "set": {
              "key": "win_card",
              "value": {
                "calc": "pick"
              },
              "if": {
                "calc": "(pick[0] == trump[0] and win_card[0] != trump[0]) or (pick[0] == win_card[0] and pick[-1] + win_card[-1] in higher_pairs)"
              }
            }
          },
          {
            "set": {
              "players": {
                "where": "you.seat == (leader + 1) % len(players) + 1"
              },
              "key": "offer",
              "value": {
                "calc": "[c for c in you.hand if c[0] == led_suit[0] and (win_card[0] != led_suit[0] or len([d for d in you.hand if d[0] == led_suit[0] and d[-1] + win_card[-1] in higher_pairs]) == 0 or c[-1] + win_card[-1] in higher_pairs)] if len([c for c in you.hand if c[0] == led_suit[0]]) > 0 else ([c for c in you.hand if c[0] == trump[0] and (win_card[0] != trump[0] or len([d for d in you.hand if d[0] == trump[0] and d[-1] + win_card[-1] in higher_pairs]) == 0 or c[-1] + win_card[-1] in higher_pairs)] if len([c for c in you.hand if c[0] == trump[0]]) > 0 else you.hand)"
              }
            }
          }
        ]
      },
      "text": "Trick {round_in_deal}: the cards played so far are {trick}; {led_suit} was led and trump is {trump}. Play one of the legal cards offered."
    },
    {
      "use": "ask",
      "phase": "trick",
      "label": "third card",
      "when": {
        "prose": "The card played obeys the legal-card rules: follow the suit led if able, and then overtake when the currently winning card is of the suit led; if void in the suit led, play a trump if able, overtaking the highest trump played if able; otherwise any card."
      },
      "to": {
        "where": "you.seat == (leader + 1) % len(players) + 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "third_card"
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} plays {value}."
      },
      "each": {
        "do": [
          {
            "remove": {
              "player": "$seat",
              "key": "hand",
              "value": "$answer"
            }
          },
          {
            "set": {
              "player": "$seat",
              "key": "played_card",
              "value": "$answer"
            }
          },
          {
            "append": {
              "key": "trick",
              "value": "$answer"
            }
          },
          {
            "set": {
              "key": "pick",
              "value": "$answer"
            }
          },
          {
            "set": {
              "key": "winning_seat",
              "value": "$seat",
              "if": {
                "calc": "(pick[0] == trump[0] and win_card[0] != trump[0]) or (pick[0] == win_card[0] and pick[-1] + win_card[-1] in higher_pairs)"
              }
            }
          },
          {
            "set": {
              "key": "win_card",
              "value": {
                "calc": "pick"
              },
              "if": {
                "calc": "(pick[0] == trump[0] and win_card[0] != trump[0]) or (pick[0] == win_card[0] and pick[-1] + win_card[-1] in higher_pairs)"
              }
            }
          }
        ]
      },
      "text": "Trick {round_in_deal}: the cards played so far are {trick}; {led_suit} was led and trump is {trump}. Play one of the legal cards offered."
    },
    {
      "use": "update",
      "phase": "trick",
      "label": "the trick is won",
      "when": {
        "calc": "round_in_deal >= 2 and deal_played"
      },
      "do": [
        {
          "set": {
            "key": "trick_points",
            "value": {
              "calc": "sum([ace_points if c[-1] == 'A' else (ten_points if c[-1] == '0' else other_card_points) for c in trick]) + (last_trick_bonus if round_in_deal == rounds_per_deal else 0)"
            }
          }
        },
        {
          "adjust": {
            "key": "declarer_points",
            "value": {
              "calc": "trick_points"
            },
            "if": {
              "calc": "winning_seat == declarer"
            }
          }
        },
        {
          "adjust": {
            "key": "defender_points",
            "value": {
              "calc": "trick_points"
            },
            "if": {
              "calc": "winning_seat != declarer"
            }
          }
        }
      ],
      "text": "Seat {winning_seat} wins the trick. Declarer {declarer_points}, defenders {defender_points}."
    },
    {
      "use": "update",
      "phase": "score",
      "label": "the deal is scored",
      "when": {
        "calc": "round_in_deal == rounds_per_deal and deal_played"
      },
      "do": [
        {
          "adjust": {
            "players": {
              "where": "you.seat == declarer"
            },
            "key": "score",
            "value": {
              "calc": "declarer_win_multiplier * stake_v if declarer_points >= contract else -declarer_win_multiplier * stake_v"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat != declarer"
            },
            "key": "score",
            "value": {
              "calc": "-defender_win_multiplier * stake_v if declarer_points >= contract else defender_win_multiplier * stake_v"
            }
          }
        }
      ],
      "text": "Deal {deal_number} is over: the declarer, Seat {declarer}, took {declarer_points} against a contract of {contract} at V = {stake_v}. Match scores: Seat 1 {players[0].score}, Seat 2 {players[1].score}, Seat 3 {players[2].score}."
    },
    {
      "use": "check",
      "phase": "score",
      "label": "after round 40",
      "when": {
        "calc": "round_number >= total_rounds"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "round_number >= total_rounds"
      },
      "rank_by": "you.score",
      "text": "Winner: {result}. Final match scores: Seat 1 {players[0].score}, Seat 2 {players[1].score}, Seat 3 {players[2].score}."
    }
  },
  "limits": {
    "rounds": 40,
    "rounds_max": 40,
    "actions_max": 3000,
    "deadline_s": 120
  },
  "rules": "DECK: {deck_size} cards in {suits} suits (Hearts, Bells, Leaves, Acorns). Each suit has A, 10, K, O (Ober), U (Unter) and 9, ranking high to low A, 10, K, O, U, 9. Card points: each Ace {ace_points}, each Ten {ten_points}, all other cards {other_card_points}. The side that wins the last (7th) trick of a deal also gets {last_trick_bonus}. At most {max_card_points} card points are available in a deal; fewer if Aces or Tens lie in the talon.\n\nSEATS AND MATCH: Seats 1, 2 and 3. Seat order runs 1, 2, 3, 1 and so on. The match has {deals} deals of {rounds_per_deal} rounds each, {total_rounds} rounds in total. The eldest is Seat 1 in deal 1, Seat 2 in deal 2, Seat 3 in deal 3, Seat 1 in deal 4 and Seat 2 in deal 5. Match scores start at {starting_score} and are public. There is no talk at any time. Hands are shown to their owner sorted by suit (Hearts, Bells, Leaves, Acorns), then by rank from high to low.\n\nROUND 1 OF EACH DEAL (DEAL AND BID): (a) Shuffle all {deck_size} cards. Deal {hand_size} cards privately to each seat. The remaining {talon_size} cards are the talon. The talon is face down, is never played and is never shown to anyone, including at the end of the deal. Each player sees only their own hand. (b) All three players bid at the same time without seeing the other bids. The options are PASS, {bid_low}, {bid_mid} or {bid_high}. (c) If all three pass, the deal is not played. Rounds 2-8 of this deal are skipped with no plays and no scoring. (d) Otherwise the highest bid wins and that player is the declarer. If several players tie for the highest bid, it goes to the tied player with the lowest match score. If they are still tied, it goes to the tied player who comes first in seat order starting from the eldest. (e) The declarer chooses trump: Hearts, Bells, Leaves or Acorns. (f) The declarer, the contract (the winning bid) and trump are announced. The other two players are the defenders, and their card points this deal are pooled together. (g) Flek: the two defenders each choose FLEK or NO at the same time. Both choices are announced. (h) Stake V: start at {stake_for_40} for a 40 contract, {stake_for_50} for 50 and {stake_for_60} for 60. Double V (x{hearts_trump_multiplier}) if trump is Hearts; otherwise it is not doubled for trump. Double V again (x{flek_multiplier}) if at least one defender chose FLEK; if both chose NO, it is not doubled for flek. V is announced.\n\nROUNDS 2-8 OF EACH DEAL (ONE TRICK PER ROUND, {tricks_per_deal} tricks): (a) The declarer leads in round 2. In later rounds, the winner of the previous trick leads. The leader plays any card from their hand face up. Then the next player in seat order plays, then the third. Each card is shown to everyone as it is played. (b) LEGAL CARDS. The 'currently winning card' is the card that would win the trick right now under rule (c). The following rules apply to every player, whoever is currently winning. 1. If you hold a card of the suit led, you must play a card of that suit. If the currently winning card is of the suit led, you must play a higher card of that suit if you have one. This includes the case where trump was led. If the currently winning card is a trump and the suit led is not trump, any card of the suit led is legal. 2. If you hold no card of the suit led but hold a trump, you must play a trump. If a trump has already been played in this trick, you must play a higher trump than the highest one played if you have one; otherwise any trump. 3. If you hold neither the suit led nor a trump, you may play any card. You are only ever offered the cards these rules allow. (c) The trick is won by the highest trump in it. If it contains no trump, it is won by the highest card of the suit led. (d) The trick's card points go to the declarer if the declarer won it, or to the defenders' pooled total if either defender won it. In round 8 the last-trick {last_trick_bonus} also goes to the side that won the trick. Running totals are announced. (e) The trick winner leads the next round.\n\nSCORING AT THE END OF ROUND 8 (only if the deal was played): the contract is made if the declarer's card points are at least the contract (40, 50 or 60). Made: the declarer gains {declarer_win_multiplier}V and each defender loses V. Failed: the declarer loses {declarer_win_multiplier}V and each defender gains V. Match scores are announced.\n\nEND: the game ends after round {total_rounds}. The player with the highest match score wins. If two or three players tie for the highest score, the game is a draw among them."
}
