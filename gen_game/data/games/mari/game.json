  "schema": 1,
  "meta": {
    "id": "mari",
    "name": "Mini Mari\u00e1\u0161 with Hidden Talon",
    "players": {
      "min": 3,
      "max": 3,
      "suggested": 3
    },
    "blurb": "Three players, five deals of a 24-card trick-taking game: a sealed bid, a trump call, flek, then seven strict tricks."
  },
