            }
          }
        },
        {
          "remove": {
            "player": {
              "calc": "seat_now"
            },
            "key": "hand",
            "value": {
              "calc": "play_card"
            }
          }
        },
        {
          "append": {
            "key": "trick_cards",
            "value": {
              "calc": "play_card"
            }
          }
        },
        {
          "append": {
            "key": "trick_seats",
            "value": {
              "calc": "seat_now"
            }
          }
        },
        {
          "set": {
            "key": "play_key",
            "value": {
              "calc": "play_card % num_ranks + (trump_key_bonus if int(play_card / num_ranks) == trump else 0) + (led_suit_key_bonus if int(play_card / num_ranks) == led_suit else 0)"
            }
          }
