    {
      "use": "sync",
      "phase": "deal",
      "label": "your hand",
      "when": {
        "calc": "trick == 1"
      },
      "mode": "self",
      "to": "all",
      "fields": [
        "hand_cards",
        "hand",
        "score"
      ],
      "text": "Deal {deal}: your hand and score:"
    },
    {
      "use": "poll",
      "phase": "bid",
      "label": "the bid",
      "when": {
        "calc": "trick == 1"
      },
      "to": "acting",
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "store": "bid",
      "text": "Deal {deal}, eldest hand: seat {eldest}. Bid in secret: 'N S' with N in 50, 60, 70, 80, 90 (the card points you promise to take) and S the trump suit (H Hearts, B Bells, L Leaves, A Acorns), or PASS. The eldest may not pass. The highest N becomes declarer; ties go to the seat first in order from the eldest. Hearts as trump doubles the stake."
    },
    {
      "use": "update",
      "phase": "bid",
      "label": "resolve the bid",
      "when": {
        "calc": "trick == 1"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": {
              "calc": "you.bid if (you.bid in bid_names or (you.bid == 'PASS' and you.seat != eldest)) else ('PASS' if you.seat != eldest else bid_names[int((eldest_default_bid - bid_min) / bid_step) * num_suits + num_suits - 1])"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid_value",
            "value": {
              "calc": "sum([bid_min + bid_step * int(i / num_suits) for i in index_list if i < len(bid_names) and bid_names[i] == you.bid])"
            }
          }
        },
        {
          "set": {
            "key": "declarer",
            "value": {
              "calc": "[p.seat for p in players if p.bid_value * bid_step + len(players) - ((p.seat - eldest + len(players)) % len(players)) == max([q.bid_value * bid_step + len(players) - ((q.seat - eldest + len(players)) % len(players)) for q in players])][0]"
            }
          }
        },
        {
          "set": {
            "key": "contract",
            "value": {
              "calc": "sum([p.bid_value for p in players if p.seat == declarer])"
            }
          }
        },
        {
          "set": {
            "key": "trump",
            "value": {
              "calc": "sum([i % num_suits for i in index_list if i < len(bid_names) and bid_names[i] == [p.bid for p in players if p.seat == declarer][0]])"
            }
          }
        },
        {
          "set": {
