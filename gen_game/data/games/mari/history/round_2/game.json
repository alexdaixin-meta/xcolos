          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand_cards",
            "value": {
              "calc": "[card_names[c] for c in sorted(you.hand)]"
            }
          }
        },
        {
          "set": {
            "key": "seat_now",
            "value": {
              "calc": "seat_now % len(players) + 1"
            }
          }
        },
        {
          "set": {
