      "label": "lead offer",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "[card_names[c] for c in sorted(you.hand)] if you.seat == leader else []"
            }
          }
        }
      ]
    },
    {
