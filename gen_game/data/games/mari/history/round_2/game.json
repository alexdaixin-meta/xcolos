      "do": [
        {
          "set": {
            "players": "all",
            "key": "flek_answer",
            "value": "NO"
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == declarer"
            },
            "key": "offer",
            "value": [
              "RE",
              "NO"
            ]
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat != declarer"
            },
            "key": "offer",
            "value": [
              "FLEK",
              "NO"
            ]
          }
        }
      ]
