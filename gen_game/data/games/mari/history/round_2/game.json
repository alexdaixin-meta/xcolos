          "set": {
            "players": "all",
            "key": "flek_answer",
            "value": {
              "calc": "you.flek_answer if you.flek_answer in you.offer else 'NO'"
            }
          }
        },
        {
          "set": {
            "key": "multiplier",
            "value": {
              "calc": "multiplier * flek_factor"
            },
            "if": {
              "calc": "count(p.seat != declarer and p.flek_answer == 'FLEK' for p in players) >= 1"
            }
          }
        },
        {
          "set": {
            "key": "multiplier",
            "value": {
              "calc": "multiplier * re_factor"
            },
            "if": {
              "calc": "count(p.seat != declarer and p.flek_answer == 'FLEK' for p in players) >= 1 and count(p.seat == declarer and p.flek_answer == 'RE' for p in players) >= 1"
            }
          }
        },
        {
          "set": {
            "key": "flek_shown",
            "value": {
              "calc": "'seat 1 ' + players[0].flek_answer + ', seat 2 ' + players[1].flek_answer + ', seat 3 ' + players[2].flek_answer"
            }
          }
        }
      ],
      "text": "Flek answers: {flek_shown}. The multiplier is now {multiplier}."
