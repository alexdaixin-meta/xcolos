            "value": {
              "calc": "seat_now"
            }
          }
        },
        {
          "set": {
            "key": "play_key",
            "value": {
              "calc": "play_card % num_ranks + (trump_key_bonus if int(play_card / num_ranks) == trump else 0) + (led_suit_key_bonus if int(play_card / num_ranks) == led_suit else 0)"
            }
          }
        },
        {
          "set": {
            "key": "best_seat",
            "value": {
              "calc": "seat_now if play_key > best_key else best_seat"
            }
          }
        },
        {
          "set": {
            "key": "best_key",
            "value": {
              "calc": "max(best_key, play_key)"
            }
          }
        },
        {
          "set": {
            "key": "card_name",
            "value": {
              "calc": "card_names[play_card]"
            }
          }
        },
        {
          "set": {
            "key": "trick_shown",
            "value": {
              "calc": "trick_shown + ', ' + seat_labels[seat_now - 1] + ' ' + card_name"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand_cards",
            "value": {
              "calc": "[card_names[c] for c in sorted(you.hand)]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": []
          }
        }
      ],
      "text": "Third card: {card_name}. The trick: {trick_shown}."
    },
    {
      "use": "update",
      "phase": "play",
      "label": "award the trick",
      "do": [
        {
          "set": {
            "key": "trick_points",
            "value": {
              "calc": "sum([(ace_points if c % num_ranks == 2 else (ten_points if c % num_ranks == 1 else king_points)) for c in trick_cards]) + (last_trick_bonus if trick == tricks_per_deal else 0)"
            }
          }
        },
        {
          "adjust": {
            "key": "declarer_points",
            "value": {
              "calc": "trick_points"
            },
            "if": {
              "calc": "best_seat == declarer"
            }
          }
        },
        {
          "adjust": {
            "key": "defender_points",
            "value": {
              "calc": "trick_points"
            },
            "if": {
              "calc": "best_seat != declarer"
            }
          }
        },
        {
          "set": {
            "key": "leader",
            "value": {
              "calc": "best_seat"
            }
          }
        },
        {
          "set": {
            "key": "trick_cards",
            "value": []
          }
        },
        {
          "set": {
            "key": "trick_seats",
            "value": []
          }
        },
        {
          "set": {
            "key": "trick_shown",
            "value": "no cards played yet"
          }
        }
      ],
      "text": "Seat {leader} wins trick {trick} worth {trick_points} points and leads next. Declarer points {declarer_points}, defender points {defender_points}."
    },
    {
      "use": "update",
      "phase": "settle",
      "label": "settle the deal",
      "when": {
        "calc": "trick == tricks_per_deal"
      },
      "do": [
        {
          "set": {
            "key": "stake",
            "value": {
              "calc": "base_stake * multiplier * (hearts_factor if trump == 0 else 1)"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "declarer"
            },
            "key": "score",
            "value": {
              "calc": "declarer_win_factor * stake"
            },
            "if": {
              "calc": "declarer_points >= contract"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat != declarer"
            },
            "key": "score",
            "value": {
              "calc": "-stake"
            },
            "if": {
              "calc": "declarer_points >= contract"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "declarer"
            },
            "key": "score",
            "value": {
              "calc": "-declarer_loss_factor * stake"
            },
            "if": {
              "calc": "declarer_points < contract"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat != declarer"
            },
            "key": "score",
            "value": {
              "calc": "stake"
            },
            "if": {
              "calc": "declarer_points < contract"
            }
          }
        },
        {
          "set": {
            "key": "deal_outcome",
            "value": {
              "calc": "'the declarer made the contract' if declarer_points >= contract else 'the declarer failed the contract'"
            }
          }
        }
      ],
      "text": "Deal {deal} settled: {deal_outcome} ({declarer_points} of {contract}). Stake {stake}. Scores: seat 1 {players[0].score}, seat 2 {players[1].score}, seat 3 {players[2].score}."
    },
    {
      "use": "update",
      "phase": "settle",
      "label": "advance",
      "do": [
        {
          "adjust": {
            "key": "deal",
            "value": 1,
            "if": {
              "calc": "trick == tricks_per_deal"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": "",
            "if": {
              "calc": "trick == tricks_per_deal"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid_value",
            "value": 0,
            "if": {
              "calc": "trick == tricks_per_deal"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "flek_answer",
            "value": "NO",
            "if": {
              "calc": "trick == tricks_per_deal"
            }
          }
        },
        {
          "set": {
            "key": "eldest",
            "value": {
              "calc": "(deal - 1) % len(players) + 1"
            }
          }
        },
        {
          "set": {
            "key": "trick",
            "value": {
