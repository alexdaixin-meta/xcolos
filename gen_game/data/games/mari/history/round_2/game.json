            "value": {
              "calc": "([card_names[c] for c in sorted(you.hand) if int(c / num_ranks) == led_suit] if len([c for c in you.hand if int(c / num_ranks) == led_suit]) > 0 else ([card_names[c] for c in sorted(you.hand) if int(c / num_ranks) == trump] if len([c for c in you.hand if int(c / num_ranks) == trump]) > 0 else [card_names[c] for c in sorted(you.hand)])) if you.seat == seat_now else []"
            }
