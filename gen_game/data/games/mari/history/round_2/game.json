        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "store": "flek_answer",
      "text": "Declarer seat {declarer}, contract {contract}, trump {trump_name}. Defenders: FLEK doubles the stake multiplier, NO leaves it. Declarer: RE doubles it again, but only if at least one defender said FLEK; NO leaves it."
    },
    {
      "use": "update",
