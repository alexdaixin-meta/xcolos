{
  "schema": 1,
  "meta": {
    "id": "durak",
    "name": "Duel Durak (seeded)",
    "players": {
      "min": 2,
      "max": 2,
      "suggested": 2
    },
    "blurb": "Two-player Durak: eight cards each, no drawing, a trump picked by offer and choice, and the first to empty their hand wins."
  },
  "statuses": [
