      "label": "starting table values",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "hand_size",
            "value": {
              "calc": "len(you.hand)"
            }
          }
        },
        {
          "set": {
            "key": "trump",
            "value": {
              "calc": "trump_unset"
            }
          }
        },
