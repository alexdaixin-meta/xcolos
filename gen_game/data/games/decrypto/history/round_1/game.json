  "steps": [
    {
      "use": "update",
      "phase": "roles",
      "label": "the round roles",
      "do": [
        {
          "adjust": {
            "key": "round_number",
            "value": 1
          }
        },
        {
          "set": {
            "key": "enc_team",
            "value": {
              "calc": "'A' if ((round_number + 1) // 2) % 2 == round_number % 2 else 'B'"
            }
          }
        },
        {
          "set": {
            "key": "encryptor_seat",
            "value": {
              "calc": "(1 if enc_team == 'A' else 3) + (0 if ((round_number + 1) // 2) % 2 == 1 else 1)"
            }
          }
        },
        {
          "set": {
            "key": "decoder_seat",
            "value": {
              "calc": "(1 if enc_team == 'A' else 3) + (1 if ((round_number + 1) // 2) % 2 == 1 else 0)"
            }
          }
        },
        {
          "set": {
            "key": "interceptor_seat",
            "value": {
              "calc": "0 if round_number < first_interception_round else ((3 if enc_team == 'A' else 1) + (1 if ((round_number + 1) // 2) % 2 == 1 else 0))"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "my_code",
            "value": ""
          }
        },
        {
          "set": {
            "players": "all",
            "key": "guess",
            "value": ""
          }
        },
        {
          "set": {
            "key": "revealed_code",
            "value": ""
          }
        },
        {
          "set": {
            "key": "decoder_guess",
            "value": ""
          }
        },
        {
          "set": {
            "key": "interceptor_guess",
            "value": ""
          }
        },
        {
          "set": {
            "key": "current_clues",
            "value": ""
          }
        },
        {
          "set": {
            "key": "clue_valid",
            "value": false
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "roles",
      "label": "announce with interceptor",
      "when": {
        "calc": "interceptor_seat > 0"
      },
      "to": "all",
      "text": "Round {round_number} of {max_rounds}: Team {enc_team} encrypts. Encryptor seat {encryptor_seat}. Decoder seat {decoder_seat}. Interceptor seat {interceptor_seat}."
    },
    {
      "use": "tell",
      "phase": "roles",
      "label": "announce without interceptor",
      "when": {
        "calc": "interceptor_seat == 0"
      },
      "to": "all",
      "text": "Round {round_number} of {max_rounds}: Team {enc_team} encrypts. Encryptor seat {encryptor_seat}. Decoder seat {decoder_seat}. There is no interception this round."
    },
    {
      "use": "update",
      "phase": "code",
      "label": "draw the code",
      "do": [
        {
          "set": {
            "key": "current_code",
            "value": {
              "calc": "code_list[min(int(uniform(0, code_count)), code_count - 1)]"
            }
          }
        },
        {
          "set": {
            "player": {
              "calc": "encryptor_seat"
            },
            "key": "my_code",
            "value": {
              "calc": "current_code"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "code",
      "label": "your keywords this round",
      "to": "all",
      "text": "Round {round_number}. You are on Team {team}. Your team's keywords, numbered 1-4 in order: {keywords}."
    },
    {
      "use": "tell",
      "phase": "code",
      "label": "your secret code",
      "to": {
        "where": "you.seat == encryptor_seat"
      },
      "text": "You are the Encryptor. Your secret code is {my_code}."
    },
    {
      "use": "ask",
      "phase": "clues",
      "label": "write the clues",
      "to": {
        "where": "you.seat == encryptor_seat"
      },
      "answer": {
        "type": "text",
        "max_words": 15
      },
      "verify": {
        "bind": "clues"
      },
      "text": "You are the Encryptor. Write three clues in code order, one per digit, separated by ' / ', each at most {clue_max_words} words. Each clue must relate by meaning to your team's keyword with that number. No spelling, letters, counts, rhyme, number or position hints; never use the keyword or a form of it; never repeat a clue in your team's history."
    },
    {
      "use": "update",
      "phase": "clues",
      "label": "store the clues",
      "do": [
        {
          "set": {
            "key": "current_clues",
            "value": "$clues"
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "clues",
      "label": "referee rules on clues",
      "when": {
        "prose": "Each of the three clues in current_clues relates by meaning or association to the keyword (from the encrypting team's keywords) numbered by its digit of current_code, no clue hints by spelling, letters, letter count, rhyme or keyword number or position, no clue contains its keyword or a form of it, and no clue repeats a clue already in the encrypting team's clue history."
      },
      "do": [
        {
          "set": {
            "key": "clue_valid",
            "value": true
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "clues",
      "label": "invalid clue set",
      "when": {
        "calc": "not clue_valid"
      },
      "do": [
        {
          "set": {
            "key": "revealed_code",
            "value": {
              "calc": "current_code"
            }
          }
        },
        {
          "adjust": {
            "key": "a_miscommunications",
            "value": 1,
            "if": {
              "calc": "enc_team == 'A'"
            }
          }
        },
        {
          "adjust": {
            "key": "b_miscommunications",
            "value": 1,
            "if": {
              "calc": "enc_team == 'B'"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "clues",
      "label": "show the clues",
      "when": {
        "calc": "clue_valid"
      },
      "to": "all",
      "text": "Team {enc_team}'s clues, in code order: {current_clues}"
    },
    {
      "use": "tell",
      "phase": "clues",
      "label": "invalid clues announced",
      "when": {
        "calc": "not clue_valid"
      },
      "to": "all",
      "text": "The referee ruled Team {enc_team}'s clue set invalid. The code was {revealed_code}. Team {enc_team} gains 1 Miscommunication. No clues are added and no guesses are taken. Tokens: A {a_interceptions} Interceptions / {a_miscommunications} Miscommunications; B {b_interceptions} Interceptions / {b_miscommunications} Miscommunications."
    },
    {
      "use": "poll",
      "phase": "guess",
      "label": "guess the code",
      "when": {
        "calc": "clue_valid"
      },
      "to": {
        "where": "you.seat == decoder_seat or you.seat == interceptor_seat"
      },
      "answer": {
        "type": "choice",
        "options": {
          "game": "code_list"
        }
      },
      "store": "guess",
      "text": "Guess Team {enc_team}'s code from the clues: {current_clues}. Choose one code. Your guess stays secret until both guesses are in."
    },
    {
      "use": "update",
      "phase": "reveal",
      "label": "score the guesses",
      "when": {
        "calc": "clue_valid"
      },
      "do": [
        {
          "set": {
            "key": "revealed_code",
            "value": {
              "calc": "current_code"
            }
          }
        },
        {
          "set": {
            "key": "decoder_guess",
            "value": {
              "calc": "[p.guess for p in players if p.seat == decoder_seat][0]"
            }
          }
        },
        {
          "set": {
            "key": "interceptor_guess",
            "value": {
              "calc": "[p.guess for p in players if p.seat == interceptor_seat][0]"
            },
            "if": {
              "calc": "interceptor_seat > 0"
            }
          }
        },
        {
          "adjust": {
            "key": "a_miscommunications",
            "value": 1,
            "if": {
              "calc": "enc_team == 'A' and decoder_guess != current_code"
            }
          }
        },
        {
          "adjust": {
            "key": "b_miscommunications",
            "value": 1,
            "if": {
              "calc": "enc_team == 'B' and decoder_guess != current_code"
            }
          }
        },
        {
          "adjust": {
            "key": "b_interceptions",
            "value": 1,
            "if": {
              "calc": "enc_team == 'A' and interceptor_seat > 0 and interceptor_guess == current_code"
            }
          }
        },
        {
          "adjust": {
            "key": "a_interceptions",
            "value": 1,
            "if": {
              "calc": "enc_team == 'B' and interceptor_seat > 0 and interceptor_guess == current_code"
            }
          }
        },
        {
          "append": {
            "key": "clue_history_a",
            "value": {
              "calc": "'keyword ' + current_code[0] + ': clue 1 of ' + current_clues"
            },
            "if": {
              "calc": "enc_team == 'A'"
            }
          }
        },
        {
          "append": {
            "key": "clue_history_a",
            "value": {
              "calc": "'keyword ' + current_code[2] + ': clue 2 of ' + current_clues"
            },
            "if": {
              "calc": "enc_team == 'A'"
            }
          }
        },
        {
          "append": {
            "key": "clue_history_a",
            "value": {
              "calc": "'keyword ' + current_code[4] + ': clue 3 of ' + current_clues"
            },
            "if": {
              "calc": "enc_team == 'A'"
            }
          }
        },
        {
          "append": {
            "key": "clue_history_b",
            "value": {
              "calc": "'keyword ' + current_code[0] + ': clue 1 of ' + current_clues"
            },
            "if": {
              "calc": "enc_team == 'B'"
            }
          }
        },
        {
          "append": {
            "key": "clue_history_b",
            "value": {
              "calc": "'keyword ' + current_code[2] + ': clue 2 of ' + current_clues"
            },
            "if": {
              "calc": "enc_team == 'B'"
            }
          }
        },
        {
          "append": {
            "key": "clue_history_b",
            "value": {
              "calc": "'keyword ' + current_code[4] + ': clue 3 of ' + current_clues"
            },
            "if": {
              "calc": "enc_team == 'B'"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "reveal",
      "label": "the reveal",
      "when": {
        "calc": "clue_valid"
      },
      "to": "all",
      "text": "The code was {revealed_code}. Decoder guessed {decoder_guess}. Interceptor guessed {interceptor_guess} (blank when there is no Interceptor). Tokens: A {a_interceptions} Interceptions / {a_miscommunications} Miscommunications; B {b_interceptions} Interceptions / {b_miscommunications} Miscommunications."
    },
    {
      "use": "update",
      "phase": "end",
      "label": "standings at the end of the pair",
      "when": {
        "calc": "round_number % 2 == 0"
      },
      "do": [
        {
          "set": {
            "players": {
              "where": "you.seat <= team_size"
            },
            "key": "standing",
            "value": {
              "calc": "((1 if (a_interceptions >= interception_trigger or b_miscommunications >= miscommunication_trigger) else 0) - (1 if (b_interceptions >= interception_trigger or a_miscommunications >= miscommunication_trigger) else 0)) * trigger_weight + a_interceptions - a_miscommunications"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat > team_size"
            },
            "key": "standing",
            "value": {
              "calc": "((1 if (b_interceptions >= interception_trigger or a_miscommunications >= miscommunication_trigger) else 0) - (1 if (a_interceptions >= interception_trigger or b_miscommunications >= miscommunication_trigger) else 0)) * trigger_weight + b_interceptions - b_miscommunications"
            }
          }
        }
      ]
    },
    {
      "use": "check",
      "phase": "end",
      "label": "end of the pair",
      "when": {
        "calc": "round_number % 2 == 0"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "round_number % 2 == 0 and (a_interceptions >= interception_trigger or b_miscommunications >= miscommunication_trigger or b_interceptions >= interception_trigger or a_miscommunications >= miscommunication_trigger or round_number >= max_rounds)"
      },
      "rank_by": "you.standing",
      "text": "Winner: {result}. Team A: {a_interceptions} Interceptions, {a_miscommunications} Miscommunications (standing {players[0].standing}); Team B: {b_interceptions} Interceptions, {b_miscommunications} Miscommunications (standing {players[2].standing})."
    }
  },
  "limits": {
    "rounds": 16,
    "rounds_max": 16,
    "actions_max": 400,
    "deadline_s": 120
  }
}
