{
  "schema": 1,
  "meta": {
    "id": "one_night_revolution",
    "name": "One Night Revolution: Ten Nights",
    "players": {
      "min": 5,
      "max": 5,
      "suggested": 5
    },
    "blurb": "Five players, ten nights: each night a secret pair are Informants, the rest Rebels; investigate or frame, talk twice, vote, score alone."
  },
  "statuses": [
    {
      "id": "playing",
      "acts": true,
      "initial": true
    }
  ],
  "attributes": {
    "player": [
      {
        "key": "score",
        "visible": "public",
        "type": "number",
        "initial": 0
      },
      {
        "key": "rebel_points",
