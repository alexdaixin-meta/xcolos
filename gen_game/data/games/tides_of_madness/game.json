    {
      "use": "poll",
      "phase": "draft",
      "label": "choose obsession",
      "when": {
        "calc": "round_in_tide == 1"
      },
      "to": "acting",
      "answer": {
        "type": "choice",
        "options": [
          "Ruins",
          "Idols",
          "Deep",
          "Stars",
          "Shore"
        ]
      },
      "store": "obsession",
      "text": "Secretly choose your Obsession suit for tide {tide}. Its set points are multiplied by {obsession_multiplier} at the tide's scoring. Your opponent will not see it until the tide is scored."
    },
    {
      "use": "poll",
      "phase": "draft",
      "label": "draft pick",
      "to": "acting",
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "hand"
        }
      },
      "store": "pick_card",
      "text": "Round {round_in_tide} of tide {tide}: choose one card from your hand to place face down in your tableau. Afterwards the remaining hands are swapped (except after the fifth pick of a tide)."
    },
    {
      "use": "update",
      "phase": "draft",
      "label": "place picks and swap hands",
      "do": [
        {
          "remove": {
            "players": {
              "where": "you.pick_card in you.hand"
            },
            "key": "hand",
            "value": {
              "calc": "you.pick_card"
            }
          }
        },
        {
          "append": {
            "players": {
              "where": "you.pick_card != ''"
            },
            "key": "tableau",
            "value": {
              "calc": "you.pick_card"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "pick_card",
            "value": ""
          }
        },
        {
          "set": {
            "key": "temp_hand",
            "value": {
              "calc": "players[0].hand"
            },
            "if": {
              "calc": "round_in_tide < rounds_per_tide"
            }
          }
        },
        {
          "set": {
            "player": 1,
            "key": "hand",
            "value": {
              "calc": "players[1].hand"
            },
            "if": {
              "calc": "round_in_tide < rounds_per_tide"
            }
          }
        },
        {
          "set": {
            "player": 2,
            "key": "hand",
            "value": {
              "calc": "temp_hand"
            },
            "if": {
              "calc": "round_in_tide < rounds_per_tide"
            }
          }
        },
        {
          "set": {
            "key": "temp_hand",
            "value": []
          }
        }
      ],
      "text": "Both players place a card face down. After rounds 1-4 of a tide the remaining hands are swapped."
    },
    {
      "use": "update",
      "phase": "tide end",
      "label": "reveal",
      "when": {
        "calc": "round_in_tide == rounds_per_tide"
      },
      "do": [
        {
          "disclose": {
            "of": 1,
            "attribute": "tableau",
            "to": "all",
            "text": "Seat {subject} drafted this tide: {value}."
          }
        },
        {
          "disclose": {
            "of": 1,
            "attribute": "obsession",
            "to": "all",
            "text": "Seat {subject}'s Obsession: {value}."
          }
        },
        {
          "disclose": {
            "of": 2,
            "attribute": "tableau",
            "to": "all",
            "text": "Seat {subject} drafted this tide: {value}."
          }
        },
        {
          "disclose": {
            "of": 2,
            "attribute": "obsession",
            "to": "all",
            "text": "Seat {subject}'s Obsession: {value}."
          }
        }
      ],
      "text": "Tide {tide} is revealed. Retained cards: Seat 1 {players[0].retained}; Seat 2 {players[1].retained}."
    },
    {
      "use": "update",
      "phase": "tide end",
      "label": "score the tide",
      "when": {
        "calc": "round_in_tide == rounds_per_tide"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "tide_icons",
            "value": {
              "calc": "count('*' in c for c in you.tableau + you.retained)"
            }
          }
        },
        {
          "adjust": {
            "players": "all",
            "key": "madness",
            "value": {
              "calc": "you.tide_icons"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "tide_points",
            "value": {
              "calc": "sum([set_table[min(count(s in c for c in you.tableau + you.retained), len(set_table) - 1)] * (obsession_multiplier if s == you.obsession else 1) for s in suit_names]) + you.tide_icons * points_per_madness_card + (diversity_bonus if count(any(s in c for c in you.tableau + you.retained) for s in suit_names) >= diversity_suits_needed else 0)"
            }
          }
        },
        {
          "adjust": {
            "players": "all",
            "key": "score",
            "value": {
              "calc": "you.tide_points"
            }
          }
        },
        {
          "set": {
            "key": "bonus_seat",
            "value": {
              "calc": "1 if players[0].tide_icons > players[1].tide_icons else (2 if players[1].tide_icons > players[0].tide_icons else 0)"
            }
          }
        }
      ],
      "text": "Tide {tide} scoring. Seat 1: {players[0].tide_icons} madness icons, {players[0].tide_points} points, score {players[0].score}, madness {players[0].madness}. Seat 2: {players[1].tide_icons} madness icons, {players[1].tide_points} points, score {players[1].score}, madness {players[1].madness}."
    },
    {
      "use": "ask",
      "phase": "tide end",
      "label": "madness bonus",
      "when": {
        "calc": "round_in_tide == rounds_per_tide and bonus_seat > 0"
      },
      "to": {
        "where": "you.seat == bonus_seat"
      },
      "answer": {
        "type": "choice",
        "options": [
          "gain_4_points",
          "reduce_madness_1"
        ]
      },
      "each": {
        "do": [
          {
            "adjust": {
              "player": "$seat",
              "key": "score",
              "value": {
                "calc": "madness_bonus_points"
              },
              "if": {
                "calc": "$answer == 'gain_4_points'"
              }
            }
          },
          {
            "adjust": {
              "player": "$seat",
              "key": "madness",
              "value": {
                "calc": "-madness_bonus_reduction"
              },
              "if": {
                "calc": "$answer == 'reduce_madness_1' and players[$seat - 1].madness >= madness_bonus_reduction"
              }
            }
          }
        ]
      },
      "text": "You had strictly more madness icons this tide. Choose privately: gain_4_points (gain {madness_bonus_points} points) or reduce_madness_1 (reduce your madness total by {madness_bonus_reduction})."
    },
    {
      "use": "update",
      "phase": "tide end",
      "label": "madness check",
      "when": {
        "calc": "round_in_tide == rounds_per_tide"
      },
      "do": [
        {
          "set": {
            "players": {
              "where": "you.madness >= madness_loss_threshold and all(p.madness < you.madness for p in players if p.seat != you.seat)"
            },
            "key": "lost",
            "value": 1,
            "text": "Seat {player} has been driven mad and loses."
          }
        },
        {
          "set": {
            "key": "madness_end",
            "value": 1,
            "if": {
              "calc": "any(p.madness >= madness_loss_threshold for p in players)"
            }
          }
        },
        {
          "set_status": {
            "players": {
              "where": "you.lost == 1"
            },
            "to": "out",
            "text": "Seat {player} is out."
          }
        }
      ],
      "text": "Madness check: Seat 1 madness {players[0].madness}, Seat 2 madness {players[1].madness} (threshold {madness_loss_threshold})."
    },
    {
      "use": "check",
      "phase": "tide end",
      "label": "is the game over",
      "when": {
        "calc": "madness_end == 1 or (round == total_rounds and round_in_tide == rounds_per_tide)"
      },
      "against": [
        "over"
      ]
    },
    {
      "use": "poll",
      "phase": "tide end",
      "label": "retain a card",
      "when": {
        "calc": "round_in_tide == rounds_per_tide and tide <= retain_tides"
      },
      "to": "acting",
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "tableau"
        }
      },
      "store": "retain_pick",
      "text": "Choose {cards_retained_per_tide} card drafted this tide to retain permanently, face up. It counts in every later tide tableau. All other drafted cards return to the deck."
    },
    {
      "use": "update",
      "phase": "tide end",
      "label": "keep retained cards",
      "when": {
        "calc": "round_in_tide == rounds_per_tide and tide <= retain_tides"
      },
      "do": [
        {
          "append": {
            "players": {
              "where": "you.retain_pick != ''"
            },
            "key": "retained",
            "value": {
              "calc": "you.retain_pick"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "tableau",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
            "key": "obsession",
            "value": ""
          }
        },
        {
          "set": {
            "players": "all",
            "key": "retain_pick",
            "value": ""
          }
        }
      ],
      "text": "Retained cards: Seat 1 {players[0].retained}; Seat 2 {players[1].retained}."
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "madness_end == 1 or (round == total_rounds and round_in_tide == rounds_per_tide)"
      },
      "rank_by": "madness_end * (1 - you.lost) * 1000000 + (1 - madness_end) * (you.score * 100 + (99 - you.madness))",
      "text": "Winner: {result}. Final: Seat 1 score {players[0].score}, madness {players[0].madness}; Seat 2 score {players[1].score}, madness {players[1].madness}."
    }
  },
  "limits": {
    "rounds": 15,
    "rounds_max": 16,
    "actions_max": 1000,
    "deadline_s": 120
  }
}
