      },
      {
        "key": "wolf_b",
        "visible": "none",
        "type": "number",
        "initial": 0
      },
      {
        "key": "min_players",
        "visible": "public",
        "type": "number",
        "initial": 5
      },
      {
        "key": "max_players",
        "visible": "public",
        "type": "number",
        "initial": 7
      },
      {
        "key": "wolves_at_5_or_6",
