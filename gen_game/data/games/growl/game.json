        "initial": 2
      },
      {
        "key": "human_start_charms_at_5_or_6",
        "visible": "public",
        "type": "number",
        "initial": 2
      },
      {
        "key": "human_start_charms_at_7",
        "visible": "public",
        "type": "number",
        "initial": 3
      },
      {
        "key": "rounds_per_player",
        "visible": "public",
        "type": "number",
        "initial": 2
      },
      {
        "key": "card_weight_wound",
        "visible": "public",
        "type": "number",
        "initial": 30
      },
      {
        "key": "card_weight_charm",
        "visible": "public",
        "type": "number",
        "initial": 30
      },
      {
        "key": "card_weight_salve",
        "visible": "public",
        "type": "number",
        "initial": 25
      },
      {
        "key": "card_weight_bite",
        "visible": "public",
        "type": "number",
        "initial": 15
      },
      {
        "key": "card_pool_wound",
        "visible": "public",
        "type": "number",
        "initial": 6
      },
      {
        "key": "card_pool_charm",
        "visible": "public",
        "type": "number",
        "initial": 6
      },
      {
        "key": "card_pool_salve",
        "visible": "public",
        "type": "number",
        "initial": 5
      },
      {
        "key": "card_pool_bite",
        "visible": "public",
        "type": "number",
        "initial": 3
      },
      {
        "key": "accusation_wounds",
        "visible": "public",
        "type": "number",
        "initial": 1
      },
      {
        "key": "death_threshold",
        "visible": "public",
        "type": "number",
        "initial": 2
      },
      {
        "key": "infection_threshold",
        "visible": "public",
        "type": "number",
        "initial": 3
      },
      {
        "key": "end_alive_at_most",
        "visible": "public",
        "type": "number",
        "initial": 2
      },
      {
        "key": "charm_cost",
        "visible": "public",
        "type": "number",
        "initial": 1
      }
    ]
  },
  "setup": [
    {
      "use": "update",
      "label": "the table is laid",
      "do": [
        {
          "set": {
            "key": "card_pool",
            "value": [
              "Wound",
              "Wound",
              "Wound",
              "Wound",
              "Wound",
              "Wound",
              "Charm",
              "Charm",
              "Charm",
              "Charm",
              "Charm",
              "Charm",
              "Salve",
              "Salve",
              "Salve",
              "Salve",
              "Salve",
              "Bite",
              "Bite",
              "Bite"
            ]
          }
        },
        {
          "set": {
            "key": "wolves_won",
            "value": -1
          }
        },
        {
          "set": {
            "key": "seat_labels",
            "value": [
              "seat 1",
              "seat 2",
              "seat 3",
              "seat 4",
              "seat 5",
              "seat 6",
              "seat 7"
            ]
          }
        },
        {
          "set": {
            "key": "bite_labels",
            "value": [
              "Bite seat 1",
              "Bite seat 2",
              "Bite seat 3",
              "Bite seat 4",
              "Bite seat 5",
              "Bite seat 6",
              "Bite seat 7"
            ]
          }
        },
        {
          "set": {
            "key": "charm_labels",
            "value": [
              "Charm seat 1",
              "Charm seat 2",
              "Charm seat 3",
              "Charm seat 4",
              "Charm seat 5",
              "Charm seat 6",
              "Charm seat 7"
            ]
          }
        },
        {
          "set": {
            "key": "total_rounds",
            "value": {
              "calc": "rounds_per_player * len(players)"
            }
          }
        },
        {
          "set": {
            "key": "living_count",
            "value": {
              "calc": "len(players)"
            }
          }
        },
        {
          "set": {
            "key": "wolf_count",
            "value": {
              "calc": "wolves_at_7 if len(players) >= max_players else wolves_at_5_or_6"
            }
          }
        },
        {
          "set": {
            "key": "wolf_a",
            "value": {
              "calc": "min(len(players), 1 + int(uniform(0, len(players))))"
            }
          }
        },
        {
          "set": {
            "key": "wolf_b",
            "value": {
              "calc": "[p.seat for p in players if p.seat != wolf_a][min(len(players) - 2, int(uniform(0, len(players) - 1)))]"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == wolf_a or (wolf_count >= 2 and you.seat == wolf_b)"
            },
            "key": "role",
            "value": "wolf"
          }
        },
        {
          "set": {
            "players": {
              "where": "you.role == 'wolf'"
            },
            "key": "is_wolf",
            "value": 1
          }
        },
        {
          "set": {
            "players": {
              "where": "you.role == 'human'"
            },
            "key": "charms",
            "value": {
              "calc": "human_start_charms_at_7 if len(players) >= max_players else human_start_charms_at_5_or_6"
            }
          }
        },
        {
          "set": {
            "key": "living_wolves",
            "value": {
              "calc": "count(p.role == 'wolf' for p in players)"
            }
          }
        },
        {
          "set": {
            "key": "living_humans",
            "value": {
              "calc": "count(p.role == 'human' for p in players)"
            }
          }
        }
      ],
      "text": "The game lasts {total_rounds} rounds. Roles have been dealt in secret."
    },
    {
      "use": "sync",
      "label": "your role",
      "mode": "self",
      "to": "all",
      "fields": [
        "role",
        "charms",
        "bites",
        "wounds",
        "salves"
      ],
      "text": "You start with:"
    }
  ],
  "steps": [
    {
      "use": "update",
      "phase": "day",
      "label": "a new round",
      "do": [
        {
          "adjust": {
            "key": "round",
            "value": 1
          }
        },
        {
          "set": {
            "key": "active_seat",
            "value": {
              "calc": "min([p.seat for p in players if p.alive and p.seat > active_seat]) if any(p.alive and p.seat > active_seat for p in players) else min([p.seat for p in players if p.alive])"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "vote",
            "value": ""
          }
        },
        {
          "set": {
            "key": "give_offer",
            "value": {
              "calc": "[seat_labels[p.seat - 1] for p in players if p.alive and p.seat != active_seat]"
            }
          }
        },
        {
          "set": {
            "players": "acting",
            "key": "vote_offer",
            "value": {
              "calc": "[seat_labels[p.seat - 1] for p in players if p.alive and p.seat != you.seat] + ['nobody']"
            }
          }
        }
      ],
      "text": "Round {round} of {total_rounds} begins. Seat {active_seat} is the active player."
    },
    {
      "use": "update",
      "phase": "day",
      "label": "the draw",
      "do": [
        {
          "set": {
            "key": "card",
            "value": {
              "calc": "card_pool[min(len(card_pool) - 1, int(uniform(0, len(card_pool))))]"
            }
          }
        }
      ],
      "text": "The card drawn this Day is: {card}."
    },
    {
      "use": "poll",
      "phase": "day",
      "label": "talk",
      "to": "acting",
      "answer": {
        "type": "text",
        "max_words": 30
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} says: {value}"
      },
      "text": "Day talk: write one short message to the table. Everyone writes at the same moment; all messages are then shown to everyone."
    },
    {
      "use": "ask",
      "phase": "day",
      "label": "give the card",
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "choice",
        "options": {
          "game": "give_offer"
        }
      },
      "verify": {
        "bind": "give"
      },
      "text": "You are the active player. Give the {card} card to another living player. Wound or Salve adds 1 to their public counter; Charm gives them 1 Charm; Bite gives a human 1 Bite but is discarded with no effect on a wolf."
    },
    {
      "use": "update",
      "phase": "day",
      "label": "the card lands",
      "do": [
        {
          "set": {
            "key": "recipient_seat",
            "value": {
              "calc": "sum([p.seat for p in players if seat_labels[p.seat - 1] == $give])"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == recipient_seat"
            },
            "key": "wounds",
            "value": 1,
            "if": {
              "calc": "card == 'Wound'"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == recipient_seat"
            },
            "key": "salves",
            "value": 1,
            "if": {
              "calc": "card == 'Salve'"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == recipient_seat"
            },
            "key": "charms",
            "value": 1,
            "if": {
              "calc": "card == 'Charm'"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == recipient_seat and you.role == 'human'"
            },
            "key": "bites",
            "value": 1,
            "if": {
              "calc": "card == 'Bite'"
            }
          }
        }
      ],
      "text": "Seat {active_seat} gives the {card} card to seat {recipient_seat}."
    },
    {
      "use": "tell",
      "phase": "day",
      "label": "bite discarded",
      "when": {
        "calc": "card == 'Bite' and any(p.seat == recipient_seat and p.role == 'wolf' for p in players)"
      },
      "to": {
        "where": "you.seat == recipient_seat"
      },
      "text": "The Bite card given to you was discarded with no effect, because you are a wolf."
    },
    {
      "use": "poll",
      "phase": "day",
      "label": "accusation",
      "to": "acting",
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "vote_offer"
        }
      },
      "store": "vote",
      "text": "Accusation: name one other living player, or 'nobody'. Everyone votes at the same moment. If one player is named by strictly more than half of the living players ({living_count} alive), that player gains 1 Wound; otherwise nobody does. The vote counts are announced either way."
    },
    {
      "use": "update",
      "phase": "day",
      "label": "the votes are counted",
      "do": [
        {
          "set": {
            "players": "acting",
            "key": "votes_received",
            "value": {
              "calc": "count(p.alive and p.vote == seat_labels[you.seat - 1] for p in players)"
            },
            "text": "Seat {player} received {value} accusation votes."
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.alive and 2 * you.votes_received > living_count"
            },
            "key": "wounds",
            "value": {
              "calc": "accusation_wounds"
            },
            "text": "Seat {player} was named by more than half of the living players and gains a Wound."
          }
        }
      ],
      "text": "The accusation votes are counted."
    },
    {
      "use": "update",
      "phase": "day",
      "label": "death check",
      "do": [
        {
          "set": {
            "players": {
              "where": "you.alive and you.wounds - you.salves >= death_threshold"
            },
            "key": "revealed_role",
            "value": {
              "calc": "you.role"
            },
            "text": "Seat {player} dies. Their role is revealed: {value}."
          }
        },
        {
          "set": {
            "players": {
              "where": "you.alive and you.wounds - you.salves >= death_threshold"
            },
            "key": "alive",
            "value": false
          }
        },
        {
          "set_status": {
            "players": {
              "where": "not you.alive"
            },
            "to": "dead",
            "text": "Seat {player} is out of the game."
          }
        },
        {
          "set": {
            "key": "living_count",
            "value": {
              "calc": "count(p.alive for p in players)"
            }
          }
        },
        {
          "set": {
            "key": "living_wolves",
            "value": {
              "calc": "count(p.alive and p.role == 'wolf' for p in players)"
            }
          }
        },
        {
          "set": {
            "key": "living_humans",
            "value": {
              "calc": "count(p.alive and p.role == 'human' for p in players)"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "votes_received",
            "value": 0
          }
        },
        {
          "set": {
            "key": "game_over",
            "value": 1,
            "if": {
              "calc": "living_wolves == 0"
            }
          }
        },
        {
          "set": {
            "key": "wolves_won",
            "value": 0,
            "if": {
              "calc": "living_wolves == 0"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "won",
            "value": {
              "calc": "1 if you.is_wolf == wolves_won else 0"
            },
            "if": {
              "calc": "game_over == 1"
            }
          }
        },
        {
          "set": {
            "players": "acting",
            "key": "night_choice",
            "value": "None"
          }
        },
        {
          "set": {
            "players": "acting",
            "key": "night_offer",
            "value": {
              "calc": "[bite_labels[p.seat - 1] for p in players if p.alive and p.seat != you.seat] + [charm_labels[p.seat - 1] for p in players if p.alive and p.seat != you.seat] + ['None']"
            }
          }
        }
      ],
      "text": "The Day ends. Living players: {living_count}."
    },
    {
      "use": "check",
      "phase": "day",
      "label": "after the day",
      "when": {
        "calc": "game_over == 1"
      },
      "against": [
        "over"
      ]
    },
    {
      "use": "poll",
      "phase": "night",
      "label": "night action",
      "to": "acting",
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "night_offer"
        }
      },
      "store": "night_choice",
      "text": "Night: choose one action in secret. 'Bite seat k' works only if you are a wolf; a human's Bite counts as None. 'Charm seat k' costs {charm_cost} Charm; with no Charm it counts as None. Or choose 'None'. No messages at Night."
    },
    {
      "use": "update",
      "phase": "night",
      "label": "the night resolves",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "charm_ok",
            "value": {
              "calc": "1 if (you.alive and you.night_choice in charm_labels and you.charms >= charm_cost) else 0"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.charm_ok == 1"
            },
            "key": "charms",
            "value": {
              "calc": "-charm_cost"
            }
          }
        },
        {
          "set": {
            "players": "acting",
            "key": "charms_tonight",
            "value": {
              "calc": "count(p.charm_ok == 1 and p.night_choice == charm_labels[you.seat - 1] for p in players)"
            }
          }
        },
        {
          "set": {
            "players": "acting",
            "key": "calmed",
            "value": {
              "calc": "you.role == 'wolf' and you.charms_tonight >= 1"
            }
          }
        },
        {
          "set": {
            "players": "acting",
            "key": "bites_tonight",
            "value": {
              "calc": "count(p.alive and p.role == 'wolf' and not p.calmed and p.night_choice == bite_labels[you.seat - 1] for p in players) if you.role == 'human' else 0"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.role == 'human'"
            },
            "key": "bites",
            "value": {
              "calc": "max(0, you.bites + you.bites_tonight - you.charms_tonight)"
            }
          }
        },
        {
          "set": {
            "key": "bites_landed_tonight",
            "value": {
              "calc": "sum([p.bites_tonight for p in players if p.alive and p.role == 'human'])"
            }
          }
        },
        {
          "set": {
            "key": "wolves_calmed_tonight",
            "value": {
              "calc": "count(p.alive and p.calmed for p in players)"
            }
          }
        }
      ],
      "text": "The Night's actions are resolved."
    },
    {
      "use": "tell",
      "phase": "night",
      "label": "private report",
      "to": "acting",
      "text": "Your private Night report: {bites_tonight} Bites landed on you tonight and you received {charms_tonight} Charms. Senders are never named."
    },
    {
      "use": "tell",
      "phase": "night",
      "label": "calmed report",
      "when": {
        "calc": "wolves_calmed_tonight > 0"
      },
      "to": {
        "where": "you.calmed"
      },
      "text": "You were calmed tonight: your Bite was cancelled."
    },
    {
      "use": "tell",
      "phase": "night",
      "label": "public report",
      "to": "all",
      "text": "Tonight {bites_landed_tonight} Bites landed on humans and {wolves_calmed_tonight} wolves were calmed."
    },
    {
      "use": "tell",
      "phase": "night",
      "label": "infection notice",
      "when": {
        "calc": "any(p.alive and p.role == 'human' and p.bites >= infection_threshold for p in players)"
      },
      "to": {
        "where": "you.alive and you.role == 'human' and you.bites >= infection_threshold"
      },
      "text": "You have been infected. You are now a wolf: from next Night on you may Bite, and you win with the wolves. You keep your Charms."
    },
    {
      "use": "update",
      "phase": "night",
      "label": "infection",
      "do": [
        {
          "set": {
            "players": {
              "where": "you.alive and you.role == 'human' and you.bites >= infection_threshold"
            },
            "key": "is_wolf",
            "value": 1
          }
        },
        {
          "set": {
            "players": {
              "where": "you.alive and you.role == 'human' and you.bites >= infection_threshold"
            },
            "key": "role",
            "value": "wolf"
          }
        },
        {
          "set": {
            "players": {
              "where": "you.role == 'wolf' and you.bites > 0"
            },
            "key": "bites",
            "value": 0
          }
        },
        {
          "set": {
            "key": "living_wolves",
            "value": {
              "calc": "count(p.alive and p.role == 'wolf' for p in players)"
            }
          }
        },
        {
          "set": {
            "key": "living_humans",
            "value": {
              "calc": "count(p.alive and p.role == 'human' for p in players)"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "night_choice",
            "value": "None"
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bites_tonight",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "charms_tonight",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "calmed",
            "value": false
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "night",
      "label": "end of night",
      "do": [
        {
          "set": {
            "key": "game_over",
            "value": 1,
            "if": {
              "calc": "living_humans == 0 or living_count <= end_alive_at_most or round >= total_rounds"
            }
          }
        },
        {
          "set": {
            "key": "wolves_won",
            "value": {
              "calc": "1 if living_wolves >= living_humans else 0"
            },
            "if": {
              "calc": "game_over == 1"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "won",
            "value": {
              "calc": "1 if you.is_wolf == wolves_won else 0"
            },
            "if": {
              "calc": "game_over == 1"
            }
          }
        }
      ]
    },
    {
      "use": "check",
      "phase": "night",
      "label": "after the night",
      "when": {
        "calc": "game_over == 1"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "game_over == 1"
      },
      "rank_by": "1 - abs(you.is_wolf - wolves_won)",
      "min_to_win": 1,
      "reveal": [
        "role"
      ],
      "text": "Winner: {result}. Wolf team won: {wolves_won} (1 = wolves, 0 = humans). Living wolves {living_wolves}, living humans {living_humans}, round {round} of {total_rounds}."
    }
  },
  "limits": {
    "rounds": 14,
    "rounds_max": 14,
    "actions_max": 3000,
    "deadline_s": 120
  },
  "rules": "Players sit in a fixed order, numbered 1 to N ({min_players} to {max_players} players). Roles are dealt at random and told privately: {wolves_at_5_or_6} wolf with 5 or 6 players, {wolves_at_7} wolves with 7. Wolves are not told who the other wolf is. Everyone else is a human. Each player has four counters: Bites (private, meaningful only for humans), Charms (private), Wounds (public) and Salves (public). All start at 0, except that each human starts with {human_start_charms_at_5_or_6} Charms ({human_start_charms_at_7} at 7 players). The game lasts {rounds_per_player} x N rounds ({total_rounds} this game). Each round has a Day and a Night.\n\nDAY. 1) Active player: living players take the active role in seat order, skipping dead players; round 1 starts with seat 1. 2) Draw: one card is drawn at random and announced: Wound {card_weight_wound}%, Charm {card_weight_charm}%, Salve {card_weight_salve}%, Bite {card_weight_bite}%. 3) Talk: every living player writes one short message at the same moment, without seeing the others; then all messages are shown to everyone. 4) Give: the active player gives the card to another living player (never themselves); everyone sees who receives it. Wound or Salve adds 1 to the recipient's public counter. Charm gives the recipient 1 Charm. Bite gives a human recipient 1 Bite; if the recipient is a wolf, the card is discarded with no effect and only that wolf learns this. 5) Accusation: all living players vote at the same moment, each naming one other living player or 'nobody'. If one player is named by strictly more than half of the living players, that player gains {accusation_wounds} Wound; otherwise nobody gains a Wound. The vote counts are announced either way. 6) Death check: a player whose Wounds minus Salves is {death_threshold} or more dies; their role is revealed and they take no further part. If no wolves are alive, the humans win immediately; otherwise play continues.\n\nNIGHT (no messages). 7) Action: each living player secretly chooses one action: 'Bite seat X' (wolves only; a human who chooses Bite is treated as choosing None), 'Charm seat X' (requires at least {charm_cost} Charm and costs {charm_cost} Charm; with no Charm it is treated as None and costs nothing), or 'None'. X must be another living player. 8) Calm: every wolf targeted by at least one Charm is calmed and its Bite tonight is cancelled; Charms aimed at wolves are used up. A wolf not charmed bites normally. 9) Bites land: each uncancelled Bite on a human adds 1 to that human's Bites; a Bite aimed at a wolf has no effect. 10) Cures: each Charm on a human removes 1 of that human's Bites, but never below 0. 11) Private reports: each player is told privately how many Bites landed on them and how many Charms they received, never who sent them; a calmed wolf learns it was calmed. 12) Public report: the Bites that landed on humans tonight and the wolves calmed tonight are announced. 13) Infection: any living human with Bites of {infection_threshold} or more becomes a wolf, is told privately, has Bites reset to 0 and keeps their Charms; from next Night on they may Bite. Wolves never change back.\n\nEND CHECKS (after every Night): if every living player is a wolf, the wolves win. If {end_alive_at_most} or fewer players are alive, or after the Night of the final round, the game ends and is scored. Otherwise the next round begins.\n\nSCORING: count living wolves and living humans. If living wolves are at least as many as living humans, the wolf team wins; otherwise the human team wins. There are no draws. Each player wins or loses with the team of their role when the game ends, so converted humans win with the wolves, and dead players share their team's result."
}
