        "initial": 0
      },
      {
        "key": "active_seat",
        "visible": "public",
        "type": "number",
        "initial": 0
      },
      {
        "key": "card_pool",
        "visible": "none",
        "type": "list",
        "initial": []
      },
      {
        "key": "card",
        "visible": "public",
        "type": "text",
        "initial": ""
      },
      {
        "key": "recipient_seat",
        "visible": "public",
        "type": "number",
        "initial": 0
      },
      {
        "key": "living_count",
        "visible": "public",
        "type": "number",
        "initial": 0
      },
      {
        "key": "living_wolves",
        "visible": "none",
        "type": "number",
        "initial": 0
      },
      {
        "key": "living_humans",
        "visible": "none",
        "type": "number",
        "initial": 0
      },
      {
        "key": "bites_landed_tonight",
        "visible": "public",
