{
  "schema": 1,
  "meta": {
    "id": "growl",
    "name": "Growl: Charmed Nights",
    "players": {
      "min": 5,
      "max": 7,
      "suggested": 6
    },
    "blurb": "Hidden wolves bite humans by night to turn them; humans charm, give cards and accuse by day. The team with the numbers at the end wins."
  },
  "statuses": [
    {
      "id": "playing",
      "acts": true,
      "initial": true
    },
    {
      "id": "dead",
      "acts": false
    }
  ],
  "attributes": {
    "player": [
      {
        "key": "role",
        "visible": "ally",
        "type": "text",
        "initial": "human",
        "values": [
          "human",
          "wolf"
        ]
      },
      {
        "key": "is_wolf",
        "visible": "ally",
        "type": "number",
        "initial": 0
      },
      {
        "key": "bites",
        "visible": "ally",
