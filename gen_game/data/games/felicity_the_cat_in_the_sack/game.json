  "meta": {
    "id": "felicity_the_cat_in_the_sack",
    "name": "Cat in the Sack: Paid Entry",
    "players": {
      "min": 3,
      "max": 5,
      "suggested": 4
    },
    "blurb": "Feed a secret card into a shared sack, talk, pay to stay or get paid to drop, then bid sealed mice for a sack that may be worth less than nothing."
  },
  "statuses": [
