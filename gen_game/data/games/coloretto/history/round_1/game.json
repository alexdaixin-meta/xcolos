  "setup": [
    {
      "use": "update",
      "label": "fill the deck",
      "do": [
        {
          "set": {
            "key": "deck",
            "value": [
              "red",
              "red",
              "red",
              "red",
              "red",
              "red",
              "red",
              "blue",
              "blue",
              "blue",
              "blue",
              "blue",
              "blue",
              "blue",
              "green",
              "green",
              "green",
              "green",
              "green",
              "green",
              "green",
              "yellow",
              "yellow",
              "yellow",
