        },
        {
          "set": {
            "key": "deal",
            "value": {
              "calc": "int((round - 1) / rounds_per_deal) + 1"
            }
          }
        },
        {
          "set": {
            "key": "round_in_deal",
            "value": {
              "calc": "(round - 1) % rounds_per_deal + 1"
            }
          }
        }
      ]
