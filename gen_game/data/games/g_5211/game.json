  "setup": [
    {
      "use": "update",
      "label": "deal hands and bonus colours",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "hand",
            "value": {
              "calc": "['R1', 'R2', 'R3', 'B1', 'B2', 'B3', 'G1', 'G2', 'G3', 'Y1', 'Y2', 'Y3', 'K', 'K']"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "bonus_pool[int(uniform(0, len(bonus_pool)))]"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == 1"
            },
            "key": "bonus_colour",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "bonus_pool",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "bonus_pool[int(uniform(0, len(bonus_pool)))]"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == 2"
            },
            "key": "bonus_colour",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "bonus_pool",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "bonus_pool[int(uniform(0, len(bonus_pool)))]"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == 3"
            },
            "key": "bonus_colour",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "bonus_pool",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "bonus_pool[int(uniform(0, len(bonus_pool)))]"
            },
            "if": {
              "calc": "len(players) >= 4"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == 4"
            },
            "key": "bonus_colour",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "bonus_pool",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "len(players) >= 4"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "score",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "scored_cards",
            "value": 0
          }
        },
        {
          "set": {
            "key": "round",
