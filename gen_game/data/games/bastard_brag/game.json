    {
      "use": "tell",
      "phase": "deal",
      "label": "new deal",
      "when": {
        "calc": "deal_round == 1"
      },
      "to": "all",
      "text": "New deal. The face-up card U is {table_up}."
    },
    {
      "use": "sync",
      "phase": "deal",
      "label": "your state",
      "mode": "self",
      "to": "acting",
      "text": "Your hand and lives:"
    },
    {
      "use": "update",
      "phase": "play",
      "label": "the order and the offers",
      "do": [
        {
          "set": {
            "key": "turn_order",
            "value": {
              "calc": "[s for s in [leader_seat, leader_seat % player_count + 1, (leader_seat + 1) % player_count + 1] if not players[s - 1].eliminated]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "['take_up_give_1', 'take_up_give_2', 'take_up_give_3', 'blind_D1_give_1', 'blind_D1_give_2', 'blind_D1_give_3', 'blind_D2_give_1', 'blind_D2_give_2', 'blind_D2_give_3', 'whole_hand_expose_1', 'whole_hand_expose_2', 'whole_hand_expose_3'] + (['knock'] if you.seat == leader_seat and deal_round >= knock_min_deal_round else [])"
            }
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "play",
      "label": "first to act",
      "when": {
        "calc": "len(turn_order) >= 1"
      },
      "to": {
        "where": "you.seat == turn_order[0]"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "each": {
        "do": [
          {
            "set": {
              "key": "act",
              "value": "$answer"
            }
          },
          {
            "set": {
              "key": "actor",
              "value": "$seat"
            }
          },
          {
            "set": {
              "key": "kk",
              "value": {
                "calc": "1 if act[len(act) - 1] == '1' else (2 if act[len(act) - 1] == '2' else 3)"
              }
            }
          },
          {
            "set": {
              "key": "old_up",
              "value": {
                "calc": "table_up"
              }
            }
          },
          {
            "set": {
              "key": "tmp",
              "value": {
                "calc": "[p.hand[kk - 1] for p in players if p.seat == actor][0]"
              },
              "if": {
                "calc": "act != 'knock'"
              }
            }
          },
          {
            "set": {
              "key": "old_hand",
              "value": {
                "calc": "[p.hand for p in players if p.seat == actor][0]"
              },
              "if": {
                "calc": "act[0] == 'w'"
              }
            }
          },
          {
            "set": {
              "players": {
                "where": "you.seat == actor"
              },
              "key": "hand",
              "value": {
                "calc": "[table_up if i == kk - 1 else you.hand[i] for i in [0, 1, 2]]"
              },
              "if": {
                "calc": "act[0] == 't'"
              }
            }
          },
          {
            "set": {
              "key": "table_up",
              "value": {
                "calc": "tmp"
              },
              "if": {
                "calc": "act[0] == 't'"
              },
              "text": "Seat {actor} took the face-up {old_up} and left a face-up {tmp}."
            }
          },
          {
            "set": {
              "players": {
                "where": "you.seat == actor"
              },
              "key": "hand",
              "value": {
                "calc": "[table_d1 if i == kk - 1 else you.hand[i] for i in [0, 1, 2]]"
              },
              "if": {
                "calc": "act[0] == 'b' and act[7] == '1'"
              }
            }
          },
          {
            "set": {
              "key": "table_d1",
              "value": {
                "calc": "tmp"
              },
              "if": {
                "calc": "act[0] == 'b' and act[7] == '1'"
              },
              "text": "Seat {actor} made a blind swap with D1."
            }
          },
          {
            "set": {
              "players": {
                "where": "you.seat == actor"
              },
              "key": "hand",
              "value": {
                "calc": "[table_d2 if i == kk - 1 else you.hand[i] for i in [0, 1, 2]]"
              },
              "if": {
                "calc": "act[0] == 'b' and act[7] == '2'"
              }
            }
          },
          {
            "set": {
              "key": "table_d2",
              "value": {
                "calc": "tmp"
              },
              "if": {
                "calc": "act[0] == 'b' and act[7] == '2'"
              },
              "text": "Seat {actor} made a blind swap with D2."
            }
          },
          {
            "set": {
              "players": {
                "where": "you.seat == actor"
              },
              "key": "hand",
              "value": {
                "calc": "[table_up, table_d1, table_d2]"
              },
              "if": {
                "calc": "act[0] == 'w'"
              }
            }
          },
          {
            "set": {
              "key": "table_up",
              "value": {
                "calc": "old_hand[kk - 1]"
              },
              "if": {
                "calc": "act[0] == 'w'"
              },
              "text": "Seat {actor} swapped the whole hand and exposed a {tmp}."
            }
          },
          {
            "set": {
              "key": "table_d1",
              "value": {
                "calc": "[old_hand[i] for i in [0, 1, 2] if i != kk - 1][0]"
              },
              "if": {
                "calc": "act[0] == 'w'"
              }
            }
          },
          {
            "set": {
              "key": "table_d2",
              "value": {
                "calc": "[old_hand[i] for i in [0, 1, 2] if i != kk - 1][1]"
              },
              "if": {
                "calc": "act[0] == 'w'"
              }
            }
          },
          {
            "set": {
              "key": "knocker_seat",
              "value": {
                "calc": "actor"
              },
              "if": {
                "calc": "act == 'knock'"
              },
              "text": "Seat {actor} knocks."
            }
          }
        ]
      },
