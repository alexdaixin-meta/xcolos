          "set": {
            "key": "lowest_score",
            "value": {
              "calc": "min([p.hand_score for p in players if not p.eliminated])"
            }
          }
        },
        {
          "set": {
            "key": "highest_score",
            "value": {
              "calc": "max([p.hand_score for p in players if not p.eliminated])"
            }
          }
        }
      ]
