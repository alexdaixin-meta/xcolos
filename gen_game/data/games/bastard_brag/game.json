      "use": "update",
      "phase": "showdown",
      "label": "score the hands",
      "when": {
        "calc": "showdown_now"
      },
      "do": [
        {
          "set": {
            "players": {
              "where": "not you.eliminated"
            },
            "key": "hand_score",
            "value": {
              "calc": "prial_333_score if min(you.hand) == 3 and max(you.hand) == 3 else (prial_base + min(you.hand) if min(you.hand) == max(you.hand) else (run_123_score if min(you.hand) == 1 and sum(you.hand) - min(you.hand) - max(you.hand) == 2 and max(you.hand) == 3 else (run_base + max(you.hand) if sum(you.hand) - min(you.hand) - max(you.hand) == min(you.hand) + 1 and max(you.hand) == sum(you.hand) - min(you.hand) - max(you.hand) + 1 else (pair_base + pair_multiplier * (sum(you.hand) - min(you.hand) - max(you.hand)) + (min(you.hand) + max(you.hand) - (sum(you.hand) - min(you.hand) - max(you.hand))) if min(you.hand) == sum(you.hand) - min(you.hand) - max(you.hand) or max(you.hand) == sum(you.hand) - min(you.hand) - max(you.hand) else sum(you.hand)))))"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "not you.eliminated"
            },
            "key": "last_showdown_score",
            "value": {
              "calc": "you.hand_score"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "not you.eliminated"
            },
            "key": "shown_hand",
            "value": {
              "calc": "you.hand"
            }
          }
        },
