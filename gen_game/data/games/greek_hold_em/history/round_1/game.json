            },
            "key": "hole",
            "value": {
              "calc": "[dealt[2 * count(p.in_hand and p.seat < you.seat for p in players)], dealt[2 * count(p.in_hand and p.seat < you.seat for p in players) + 1]]"
            }
          }
        },
        {
          "set": {
            "key": "board",
            "value": {
