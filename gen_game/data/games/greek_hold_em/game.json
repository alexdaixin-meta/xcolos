  "setup": [
    {
      "use": "update",
      "label": "the start",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "total",
            "value": {
              "calc": "starting_total"
            }
          }
        },
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "sorted(deck + board_up + board_hidden + players[0].hole + players[1].hole + players[2].hole)"
            }
          }
        },
        {
          "set": {
            "key": "hand",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "sync",
      "label": "the table",
      "mode": "self",
      "to": "all",
      "fields": [
        "total"
      ],
      "text": "You start with:"
    }
  ],
  "steps": [
    {
      "use": "update",
      "phase": "deal",
      "label": "a new hand",
      "do": [
        {
          "adjust": {
            "key": "hand",
            "value": 1
          }
        },
        {
          "set": {
            "key": "first_actor",
            "value": {
              "calc": "hand - 1 - num_players * int((hand - 1) / num_players) + 1"
            }
          }
        },
        {
          "set": {
            "key": "second_actor",
            "value": {
              "calc": "first_actor + 1 - num_players * int(first_actor / num_players)"
            }
          }
        },
        {
          "set": {
            "key": "third_actor",
            "value": {
              "calc": "second_actor + 1 - num_players * int(second_actor / num_players)"
            }
          }
        },
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "sorted(deck + board_up + board_hidden + players[0].hole + players[1].hole + players[2].hole)"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hole",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
            "key": "revealed_hole",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
