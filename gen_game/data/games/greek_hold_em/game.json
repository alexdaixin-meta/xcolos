            "value": 0
          }
        },
        {
          "set": {
            "key": "best_score",
            "value": 0
          }
        },
        {
          "set": {
            "key": "winner_count",
            "value": 0
          }
        }
      ],
      "text": "Hand {hand} of {hands} begins. First actor: seat {first_actor}, second: seat {second_actor}, third: seat {third_actor}."
    },
    {
      "use": "update",
      "phase": "deal",
      "label": "the deal",
      "do": [
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "player": 1,
            "key": "hole",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "player": 1,
            "key": "hole",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "player": 2,
            "key": "hole",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "player": 2,
            "key": "hole",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "player": 3,
            "key": "hole",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "player": 3,
            "key": "hole",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "key": "board_up",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "key": "board_up",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "key": "board_up",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "key": "board_hidden",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        }
      ],
      "text": "The cards are dealt. Face-up board: {board_up}. Board card 4 stays face down."
    },
    {
      "use": "update",
      "phase": "deal",
      "label": "the ante",
      "do": [
        {
          "adjust": {
            "players": "all",
            "key": "paid",
            "value": {
              "calc": "ante"
            }
          }
        },
        {
          "set": {
            "key": "pot",
            "value": {
              "calc": "sum(p.paid for p in players)"
            }
          }
        }
      ],
      "text": "Each player antes {ante}. The pot is {pot}."
    },
    {
      "use": "sync",
      "phase": "deal",
      "label": "your cards",
      "mode": "self",
      "to": "all",
      "fields": [
        "hole",
        "total"
      ],
      "text": "Hand {hand}. Board: {board_up}. Pot {pot}. Seat {first_actor} acts first, seat {second_actor} second, seat {third_actor} third. Your hole cards:"
    },
    {
      "use": "ask",
      "phase": "betting",
      "label": "first actor",
      "to": {
        "where": "you.seat == first_actor"
      },
      "answer": {
        "type": "choice",
        "options": [
          "CHECK",
          "BET 2",
          "BET 4"
        ]
      },
      "each": {
        "do": [
          {
            "set": {
              "player": "$seat",
              "key": "action",
              "value": {
                "calc": "'BET' if $answer in ['BET 2', 'BET 4'] else $answer"
              }
            }
          },
          {
            "set": {
              "key": "bet_amount",
              "value": {
                "calc": "bet_small if $answer == 'BET 2' else bet_large"
              },
              "if": {
                "calc": "$answer in ['BET 2', 'BET 4']"
              }
            }
          },
          {
            "adjust": {
              "player": "$seat",
              "key": "paid",
              "value": {
                "calc": "bet_amount"
              },
              "if": {
                "calc": "$answer in ['BET 2', 'BET 4']"
              }
            }
          },
          {
            "adjust": {
              "key": "pot",
              "value": {
                "calc": "bet_amount"
              },
              "if": {
                "calc": "$answer in ['BET 2', 'BET 4']"
              }
            }
          },
          {
            "set": {
              "players": "all",
              "key": "offer",
              "value": {
                "calc": "['CHECK', 'BET 2', 'BET 4'] if bet_amount == 0 else ['CALL', 'FOLD']"
              }
            }
          }
        ]
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} (first actor): {value}."
      },
      "text": "Hand {hand}. You act first. Board: {board_up}. Your hole cards are in your state. Pot {pot}. CHECK, BET 2 or BET 4. A bet is paid into the pot at once and you will not act again this hand."
    },
    {
      "use": "ask",
      "phase": "betting",
      "label": "second actor",
      "to": {
        "where": "you.seat == second_actor"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "each": {
        "do": [
          {
            "set": {
              "player": "$seat",
              "key": "action",
              "value": {
                "calc": "'BET' if $answer in ['BET 2', 'BET 4'] else $answer"
              }
            }
          },
          {
            "set": {
              "key": "bet_amount",
              "value": {
                "calc": "bet_small if $answer == 'BET 2' else bet_large"
              },
              "if": {
                "calc": "$answer in ['BET 2', 'BET 4']"
              }
            }
          },
          {
            "adjust": {
              "player": "$seat",
              "key": "paid",
              "value": {
                "calc": "bet_amount"
              },
              "if": {
                "calc": "$answer in ['BET 2', 'BET 4', 'CALL']"
              }
            }
          },
          {
            "adjust": {
              "key": "pot",
              "value": {
                "calc": "bet_amount"
              },
              "if": {
                "calc": "$answer in ['BET 2', 'BET 4', 'CALL']"
              }
            }
          },
          {
            "set": {
              "player": "$seat",
              "key": "folded",
              "value": true,
              "if": {
                "calc": "$answer == 'FOLD'"
              }
            }
          },
          {
            "set": {
              "players": "all",
              "key": "offer",
              "value": {
                "calc": "['CHECK', 'BET 2', 'BET 4'] if bet_amount == 0 else ['CALL', 'FOLD']"
              }
            }
          }
        ]
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} (second actor): {value}."
      },
      "text": "Hand {hand}. You act second. Board: {board_up}. Your hole cards are in your state. Pot {pot}, current bet {bet_amount}. If nobody has bet you may CHECK, BET 2 or BET 4; if a bet has been made you may CALL (pay the bet into the pot) or FOLD (leave the hand, losing what you paid)."
    },
    {
      "use": "ask",
      "phase": "betting",
      "label": "third actor",
      "to": {
        "where": "you.seat == third_actor"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "each": {
        "do": [
          {
            "set": {
              "player": "$seat",
              "key": "action",
              "value": {
                "calc": "'BET' if $answer in ['BET 2', 'BET 4'] else $answer"
              }
            }
          },
          {
            "set": {
              "key": "bet_amount",
              "value": {
                "calc": "bet_small if $answer == 'BET 2' else bet_large"
              },
              "if": {
                "calc": "$answer in ['BET 2', 'BET 4']"
              }
            }
          },
          {
            "adjust": {
              "player": "$seat",
              "key": "paid",
              "value": {
                "calc": "bet_amount"
              },
              "if": {
                "calc": "$answer in ['BET 2', 'BET 4', 'CALL']"
              }
            }
          },
          {
            "adjust": {
              "key": "pot",
              "value": {
                "calc": "bet_amount"
              },
              "if": {
                "calc": "$answer in ['BET 2', 'BET 4', 'CALL']"
              }
            }
          },
          {
            "set": {
              "player": "$seat",
              "key": "folded",
              "value": true,
              "if": {
                "calc": "$answer == 'FOLD'"
              }
            }
          }
        ]
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} (third actor): {value}."
      },
      "text": "Hand {hand}. You act third. Board: {board_up}. Your hole cards are in your state. Pot {pot}, current bet {bet_amount}. If nobody has bet you may CHECK, BET 2 or BET 4; if a bet has been made you may CALL (pay the bet into the pot) or FOLD (leave the hand, losing what you paid)."
    },
    {
      "use": "poll",
      "phase": "response",
      "label": "response to the bet",
      "when": {
        "calc": "bet_amount > 0"
      },
      "to": {
        "where": "you.action == 'CHECK'"
      },
      "answer": {
        "type": "choice",
        "options": [
          "CALL",
          "FOLD"
        ]
      },
      "store": "action",
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} responds: {value}."
      },
      "text": "You checked and then a bet of {bet_amount} was made. Board: {board_up}. Your hole cards are in your state. Pot {pot}. CALL (pay {bet_amount} into the pot and stay in) or FOLD (leave the hand, losing what you paid). Other checkers choose at the same moment."
    },
    {
      "use": "update",
      "phase": "final board",
      "label": "responses and the final board",
      "do": [
        {
          "adjust": {
            "players": {
              "where": "you.action == 'CALL' and you.paid < ante + bet_amount"
            },
            "key": "paid",
            "value": {
              "calc": "bet_amount"
            }
          }
        },
        {
          "set": {
            "key": "pot",
            "value": {
              "calc": "sum(p.paid for p in players)"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.action == 'FOLD'"
            },
            "key": "folded",
            "value": true
          }
        },
        {
          "append": {
            "key": "board_up",
            "value": {
              "calc": "board_hidden[0]"
            },
            "if": {
              "calc": "len(board_hidden) > 0"
            }
          }
        },
        {
          "set": {
            "key": "board_hidden",
            "value": []
          }
        }
      ],
      "text": "Betting is over. Pot {pot}. Board card 4 is turned face up. Final board: {board_up}."
    },
    {
      "use": "update",
      "phase": "showdown",
      "label": "hand scores",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "hand_score",
            "value": {
              "calc": "you.hole[0] + you.hole[1] + (pair_bonus if you.hole[0] == you.hole[1] else 0) + match_bonus * min(max_matches, count(c == you.hole[0] or c == you.hole[1] for c in board_up))"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "showdown",
      "label": "the showdown",
      "do": [
        {
          "set": {
            "key": "in_count",
            "value": {
              "calc": "count(not p.folded for p in players)"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "not you.folded"
            },
            "key": "won",
            "value": {
              "calc": "pot"
            },
            "if": {
              "calc": "in_count == 1"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "not you.folded"
            },
            "key": "revealed_hole",
            "value": {
              "calc": "you.hole"
            },
            "if": {
              "calc": "in_count >= 2"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "not you.folded"
            },
            "key": "revealed_score",
            "value": {
              "calc": "you.hand_score"
            },
            "if": {
              "calc": "in_count >= 2"
            }
          }
        },
        {
          "set": {
            "key": "best_score",
            "value": {
              "calc": "max([p.hand_score for p in players if not p.folded])"
            },
            "if": {
              "calc": "in_count >= 2"
            }
          }
        },
        {
          "set": {
            "key": "winner_count",
            "value": {
              "calc": "count((not p.folded) and p.hand_score == best_score for p in players)"
            },
            "if": {
              "calc": "in_count >= 2"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "(not you.folded) and you.hand_score == best_score"
            },
            "key": "won",
            "value": {
              "calc": "pot / winner_count"
            },
            "if": {
              "calc": "in_count >= 2 and winner_count > 0"
            }
          }
        }
      ],
      "text": "Showdown: {in_count} player(s) still in, pot {pot}. Revealed hands [seat, cards, score]: {[[p.seat, p.revealed_hole, p.revealed_score] for p in players if not p.folded]}. Pot split [seat, won]: {[[p.seat, p.won] for p in players]}."
    },
    {
      "use": "update",
      "phase": "totals",
      "label": "the totals",
      "do": [
        {
          "adjust": {
            "players": "all",
            "key": "total",
            "value": {
              "calc": "you.won - you.paid"
            }
          }
        }
      ],
      "text": "Hand {hand} totals: Seat 1 {players[0].total}, Seat 2 {players[1].total}, Seat 3 {players[2].total}."
    },
    {
      "use": "check",
      "phase": "totals",
      "label": "after the last hand",
      "when": {
        "calc": "hand >= hands"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "hand >= hands"
      },
      "rank_by": "you.total",
      "text": "Winner: {result}. Final totals: Seat 1 {players[0].total}, Seat 2 {players[1].total}, Seat 3 {players[2].total}."
    }
  },
  "limits": {
    "rounds": 36,
    "rounds_max": 40,
    "actions_max": 3000,
    "deadline_s": 120
  },
  "rules": "Three players, seats 1, 2 and 3, each start with a chip total of {starting_total}. Totals may go negative and may include fractions from split pots. The deck has {deck_size} cards: ranks 1 to {ranks}, {copies_per_rank} copies of each, with no suits. The game lasts exactly {hands} hands. In hand h, the first actor is seat ((h - 1) mod 3) + 1, the second actor is the next seat after the first actor (wrapping from 3 to 1), and the third actor is the remaining seat.\n\nEach hand:\n1. Deal. All {deck_size} cards are shuffled. Each player gets {hole_cards} hole cards face down and {board_cards} board cards are dealt face down to the table. Each player sees only their own hole cards.\n2. Ante. Each player pays {ante} chip into the pot. The pot starts at {starting_pot}.\n3. Board. Board cards 1, 2 and 3 are turned face up. Board card 4 stays face down.\n4. The first actor chooses CHECK, BET 2 or BET 4. A bet is paid into the pot at once, and the choice is announced to all.\n5. The second actor chooses, announced to all. If nobody has bet yet: CHECK, BET 2 or BET 4. If a bet has been made: CALL (pay the same amount as the bet into the pot and stay in) or FOLD (leave the hand, losing everything already paid).\n6. The third actor chooses, with the same options as the second actor, announced to all.\n7. Response. Only if a bet was made after at least one player checked: each player who checked before the bet chooses, at the same moment, CALL (pay the bet amount and stay in) or FOLD (leave the hand, losing what was paid). The choices are then revealed. Only one bet is ever made in a hand: there are no raises, and the bettor never acts again.\n8. Final board. Board card 4 is turned face up.\n9. Hand scores. With hole ranks a and b: score = a + b, plus {pair_bonus} if a equals b, plus {match_bonus} for each board card whose rank equals a or b, counting at most {max_matches} matches.\n10. Showdown. If exactly one player has not folded, that player takes the whole pot and no hole cards are revealed. If two or three are still in, their hole cards and scores are revealed and the pot goes to the highest score among them; players tied for the highest score split the pot equally. If everyone checked, all three go to showdown.\n11. Folded players' hole cards are never revealed.\n12. Each player's total changes by the chips they won minus the chips they paid this hand. All three totals are announced. The totals always sum to 0.\n13. All cards return to the deck for the next shuffle.\n\nAfter hand {hands} the game ends. The highest chip total wins; players tied at the top share the win."
}
