            "key": "folded",
            "value": false
          }
        },
        {
          "set": {
            "players": "all",
            "key": "paid",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "won",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": [
              "CHECK",
              "BET 2",
              "BET 4"
            ]
          }
        },
        {
          "set": {
            "key": "board_up",
            "value": []
          }
        },
        {
          "set": {
            "key": "board_hidden",
            "value": []
          }
        },
        {
          "set": {
            "key": "bet_amount",
            "value": 0
          }
        },
        {
          "set": {
