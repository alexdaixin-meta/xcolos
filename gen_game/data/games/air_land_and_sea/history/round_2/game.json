          "set": {
            "key": "deck",
            "value": {
              "calc": "['Air 1', 'Air 2', 'Air 3', 'Air 4', 'Air 5', 'Air 6', 'Land 1', 'Land 2', 'Land 3', 'Land 4', 'Land 5', 'Land 6', 'Sea 1', 'Sea 2', 'Sea 3', 'Sea 4', 'Sea 5', 'Sea 6']"
