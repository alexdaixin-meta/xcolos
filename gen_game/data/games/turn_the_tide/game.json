{
  "schema": 1,
  "meta": {
    "id": "turn_the_tide",
    "name": "Turn The Tide: Short Seas (revised)",
    "players": {
      "min": 3,
      "max": 4,
      "suggested": 4
    },
    "blurb": "Play Weather cards at the same time to dodge high Tide levels, keep your lifelines, pass your hand left each deal, and finish with the highest score."
  },
  "statuses": [
    {
      "id": "playing",
      "acts": true,
      "initial": true
    }
  ],
  "attributes": {
