  "setup": [
    {
      "use": "update",
      "label": "build the deck",
      "do": [
        {
          "set": {
            "key": "deck",
            "value": [
              "Red 1",
              "Red 1",
              "Red 2",
              "Red 2",
              "Red 3",
              "Red 4",
              "Blue 1",
              "Blue 1",
              "Blue 2",
              "Blue 2",
              "Blue 3",
              "Blue 4",
              "Green 1",
              "Green 1",
              "Green 2",
              "Green 2",
              "Green 3",
              "Green 4",
              "Yellow 1",
              "Yellow 1",
              "Yellow 2",
              "Yellow 2",
              "Yellow 3",
              "Yellow 4",
              "Purple 1",
              "Purple 1",
              "Purple 2",
              "Purple 2",
              "Purple 3",
              "Purple 4",
              "Church",
              "Church",
              "Church",
              "Church",
              "Church",
              "Church"
            ]
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "shuffle the deck",
      "do": [
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "[x[1] for x in sorted([[uniform(0, 1), c] for c in deck])]"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "the scribes",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "gold",
            "value": {
              "calc": "starting_gold"
            }
          }
        },
        {
