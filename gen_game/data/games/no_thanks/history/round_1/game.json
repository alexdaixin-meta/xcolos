  "steps": [
    {
      "use": "update",
      "phase": "reveal",
      "label": "start the round",
      "do": [
        {
          "set": {
            "key": "taken",
            "value": false
          }
        },
        {
          "set": {
            "key": "drew",
            "value": {
              "calc": "current_card == 0 and len(deck) > 0"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            },
            "if": {
              "calc": "drew"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "drew"
            }
          }
        },
        {
          "set": {
            "key": "current_card",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "drew"
            }
          }
        },
        {
          "set": {
            "key": "lap_count",
            "value": 0,
            "if": {
              "calc": "drew"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "(['PAY'] if you.chips >= pay_cost else []) + ['TAKE']"
            }
          }
        }
      ],
      "text": "Card {current_card} is on offer. Pot: {pot}. Completed laps on this card: {lap_count}. Seat {lead_seat} is offered it first."
    },
    {
      "use": "ask",
      "phase": "offer",
      "label": "offer to the lead seat",
      "when": {
        "calc": "current_card != 0 and not taken"
      },
      "to": {
        "where": "you.seat == lead_seat"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "each": {
        "do": [
          {
            "adjust": {
              "player": "$seat",
              "key": "chips",
              "value": {
                "calc": "-pay_cost"
              },
              "if": {
                "calc": "$answer == 'PAY' and players[$seat - 1].chips >= pay_cost"
              }
            }
          },
          {
            "adjust": {
              "key": "pot",
              "value": {
                "calc": "pay_cost"
              },
              "if": {
                "calc": "$answer == 'PAY'"
              }
            }
          },
          {
            "set": {
              "key": "last_taker",
              "value": "$seat",
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "set": {
              "key": "last_card",
              "value": {
                "calc": "current_card"
              },
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "set": {
              "key": "last_gain",
              "value": {
                "calc": "pot"
              },
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "adjust": {
              "player": "$seat",
              "key": "card_points",
              "value": {
                "calc": "(0 if (current_card - 1) in players[$seat - 1].tableau else current_card) - (current_card + 1 if (current_card + 1) in players[$seat - 1].tableau else 0)"
              },
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "append": {
              "player": "$seat",
              "key": "tableau",
              "value": {
                "calc": "current_card"
              },
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "adjust": {
              "player": "$seat",
              "key": "chips",
              "value": {
                "calc": "pot"
              },
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "set": {
              "key": "pot",
              "value": 0,
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "set": {
              "key": "lead_seat",
              "value": "$seat",
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "set": {
              "key": "lap_count",
              "value": 0,
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "set": {
              "key": "taken",
              "value": true,
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "set": {
              "key": "current_card",
              "value": 0,
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          }
        ]
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} chooses {value}."
      },
      "text": "Card {current_card} is offered to you. Pot: {pot}. PAY puts {pay_cost} chip into the pot and passes the card on; TAKE gives you the card and every chip in the pot. With 0 chips you must TAKE."
    },
