  "steps": [
    {
      "use": "update",
      "label": "draw",
      "phase": "draw",
      "do": [
        {
          "adjust": {
            "key": "round_number",
            "value": 1
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            },
            "if": {
              "calc": "current_card == no_card_value and len(deck) > 0"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "current_card == no_card_value and len(deck) > 0"
            }
          }
        },
        {
          "set": {
            "key": "lap_count",
            "value": 0,
            "if": {
              "calc": "current_card == no_card_value and pick != no_card_value"
            }
          }
        },
        {
          "set": {
            "key": "current_card",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "current_card == no_card_value and pick != no_card_value"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "no_card_value"
            }
          }
        },
        {
          "set": {
            "key": "deck_left",
            "value": {
              "calc": "len(deck)"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "['TAKE'] + (['PAY'] if you.chips >= pay_cost else [])"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "label": "announce",
      "phase": "draw",
      "to": "all",
      "text": "Round {round_number}. Current card: {current_card}. Pot: {pot}. Lap count: {lap_count}. First offer to seat {lead_seat}. Tableaus and card points [seat, tableau, points]: {[[p.seat, p.tableau, p.card_points] for p in players]}. Cards left in deck: {deck_left}. Burned cards: {burned_count}."
    },
    {
      "use": "ask",
      "label": "offer 1",
      "phase": "offers",
      "when": {
        "calc": "current_card != no_card_value"
      },
      "to": {
        "where": "you.seat == ((lead_seat - 1) % len(players)) + 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "o1"
      },
      "each": {
        "do": [
          {
            "adjust": {
              "players": {
                "where": "you.seat == $seat"
              },
              "key": "chips",
              "value": {
                "calc": "-pay_cost"
              },
              "if": {
                "calc": "$answer == 'PAY' and you.chips >= pay_cost"
              }
            }
          },
          {
            "adjust": {
              "key": "pot",
              "value": {
                "calc": "pay_cost"
              },
              "if": {
                "calc": "$answer == 'PAY'"
              }
            }
          },
          {
            "adjust": {
              "players": {
                "where": "you.seat == $seat"
              },
              "key": "card_points",
              "value": {
                "calc": "current_card - ((current_card + 1) if (current_card + 1) in you.tableau else 0) - (current_card if (current_card - 1) in you.tableau else 0)"
              },
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "append": {
              "players": {
                "where": "you.seat == $seat"
              },
              "key": "tableau",
              "value": {
                "calc": "current_card"
              },
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "adjust": {
              "players": {
                "where": "you.seat == $seat"
              },
              "key": "chips",
              "value": {
                "calc": "pot"
              },
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "set": {
              "key": "pot",
              "value": 0,
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "set": {
              "key": "lead_seat",
              "value": "$seat",
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "set": {
              "key": "current_card",
              "value": {
                "calc": "no_card_value"
              },
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          }
        ]
      },
