  "steps": [
    {
      "use": "update",
      "phase": "draw",
      "label": "draw",
      "do": [
        {
          "adjust": {
            "key": "round_count",
            "value": 1
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))] if current_card == no_card and len(deck) > 0 else no_card"
            }
          }
        },
        {
          "set": {
            "key": "current_card",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "pick != no_card"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "pick != no_card"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "['TAKE'] + (['PAY'] if you.chips >= pay_cost else [])"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "draw",
      "label": "the card on offer",
      "to": "all",
      "text": "Card on offer: {current_card} (0 means none). Pot: {pot}. Laps untaken: {lap_count}. First offer this lap: seat {lead_seat}. Tableaus: {[[p.seat, p.tableau] for p in players]}. Burned: {burned}."
    },
    {
      "use": "ask",
      "phase": "offers",
      "label": "offer 1",
      "when": {
        "calc": "current_card != no_card"
      },
      "to": {
        "where": "you.seat == ((lead_seat - 1 + 0) % len(players)) + 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "o1"
      },
      "each": {
        "do": [
          {
            "adjust": {
              "players": {
                "where": "you.seat == $seat"
              },
              "key": "chips",
              "value": {
                "calc": "-pay_cost"
              },
              "if": {
                "calc": "$answer == 'PAY'"
              }
            }
          },
          {
            "adjust": {
              "key": "pot",
              "value": {
                "calc": "pay_cost"
              },
              "if": {
                "calc": "$answer == 'PAY'"
              }
            }
          },
          {
            "adjust": {
              "players": {
                "where": "you.seat == $seat"
              },
              "key": "card_points",
              "value": {
                "calc": "current_card - ((current_card + 1) if (current_card + 1) in you.tableau else 0) - (current_card if (current_card - 1) in you.tableau else 0)"
              },
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
          {
            "append": {
              "players": {
                "where": "you.seat == $seat"
              },
              "key": "tableau",
              "value": {
                "calc": "current_card"
              },
              "if": {
                "calc": "$answer == 'TAKE'"
              }
            }
          },
