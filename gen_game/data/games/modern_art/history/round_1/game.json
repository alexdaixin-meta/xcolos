    {
      "use": "sync",
      "label": "your starting state",
      "mode": "self",
      "to": "all",
      "fields": [
        "money",
        "hand",
        "owned_amber",
        "owned_blue",
        "owned_crimson"
      ],
      "text": "You start with:"
    }
  ],
  "steps": [
    {
      "use": "tell",
      "phase": "reveal",
      "label": "a new turn",
      "to": "all",
      "text": "A new turn begins. Seasons completed: {season} of {seasons}. Seat {auctioneer} is the auctioneer."
    },
    {
      "use": "update",
      "phase": "reveal",
      "label": "what the auctioneer may reveal",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "[a for a in ['Amber', 'Blue', 'Crimson'] if a in you.hand] if you.seat == auctioneer else []"
            }
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "reveal",
      "label": "choose a card to reveal",
      "to": {
        "where": "you.seat == auctioneer"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "card"
      },
      "text": "You are the auctioneer. Choose one painting from your hand to reveal: answer with the artist's name."
    },
    {
      "use": "update",
      "phase": "reveal",
      "label": "the reveal",
      "do": [
        {
          "set": {
            "key": "current_card",
            "value": "$card"
          }
        },
        {
          "remove": {
            "player": {
              "calc": "auctioneer"
            },
            "key": "hand",
            "value": {
              "calc": "current_card"
            }
          }
        },
        {
          "adjust": {
            "key": "played_amber",
            "value": 1,
            "if": {
              "calc": "current_card == 'Amber'"
            }
          }
        },
        {
          "adjust": {
            "key": "played_blue",
            "value": 1,
            "if": {
              "calc": "current_card == 'Blue'"
            }
          }
        },
        {
          "adjust": {
            "key": "played_crimson",
            "value": 1,
            "if": {
              "calc": "current_card == 'Crimson'"
            }
          }
        },
        {
          "set": {
            "key": "season_ending",
            "value": {
              "calc": "(played_amber if current_card == 'Amber' else (played_blue if current_card == 'Blue' else played_crimson)) == season_end_count"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "message",
            "value": ""
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": 0
          }
        }
      ],
      "text": "Seat {auctioneer} reveals a {current_card} painting. Played this season: Amber {played_amber}, Blue {played_blue}, Crimson {played_crimson}."
    },
    {
      "use": "tell",
      "phase": "reveal",
      "label": "the season ends",
      "when": {
        "calc": "season_ending"
      },
      "to": "all",
      "text": "That is the 4th {current_card} painting this season: the season ends. The card is not auctioned and no one owns it."
    },
    {
      "use": "poll",
      "phase": "auction",
      "label": "talk",
      "when": {
        "calc": "not season_ending"
      },
      "to": "acting",
      "answer": {
        "type": "text",
        "max_words": 30
      },
      "store": "message",
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} says: {value}"
      },
      "text": "A {current_card} painting is up for auction. Write one short message to the table; everyone writes at the same time and talk binds no one."
    },
    {
      "use": "poll",
      "phase": "auction",
      "label": "sealed bid",
      "when": {
        "calc": "not season_ending"
      },
      "to": "acting",
      "answer": {
        "type": "number",
        "min": {
          "calc": "min_bid"
        },
        "max": {
          "calc": "you.money"
        }
      },
      "store": "bid",
      "text": "Submit your sealed bid for the {current_card} painting: a whole number from {min_bid} up to your money. Highest bid wins; ties go to the auctioneer, then clockwise from the auctioneer; if every bid is 0 the auctioneer gets it free. A non-auctioneer winner pays the auctioneer; an auctioneer who wins pays the bank."
    },
    {
      "use": "update",
      "phase": "auction",
      "label": "find the winner",
      "when": {
        "calc": "not season_ending"
      },
      "do": [
        {
          "set": {
            "key": "winner_seat",
            "value": {
              "calc": "[p.seat for p in players if p.bid * 10 + player_count - ((p.seat - auctioneer + player_count) % player_count) == max([q.bid * 10 + player_count - ((q.seat - auctioneer + player_count) % player_count) for q in players])][0]"
            }
          }
        },
        {
          "set": {
            "key": "price",
            "value": {
              "calc": "[p.bid for p in players if p.seat == winner_seat][0]"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "auction",
      "label": "the sale",
      "when": {
        "calc": "not season_ending"
      },
      "do": [
        {
          "adjust": {
            "player": {
              "calc": "winner_seat"
            },
            "key": "money",
            "value": {
              "calc": "-price"
            },
            "if": {
              "calc": "price > 0 and [p.money for p in players if p.seat == winner_seat][0] >= price"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "auctioneer"
            },
            "key": "money",
            "value": {
              "calc": "price"
            },
            "if": {
              "calc": "price > 0 and winner_seat != auctioneer"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "winner_seat"
            },
            "key": "owned_amber",
            "value": 1,
            "if": {
              "calc": "current_card == 'Amber'"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "winner_seat"
            },
            "key": "owned_blue",
            "value": 1,
            "if": {
              "calc": "current_card == 'Blue'"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "winner_seat"
            },
            "key": "owned_crimson",
            "value": 1,
            "if": {
              "calc": "current_card == 'Crimson'"
            }
          }
        }
      ],
      "text": "Bids: seat 1 {players[0].bid}, seat 2 {players[1].bid}, seat 3 {players[2].bid}, seat 4 {players[3].bid}. Seat {winner_seat} buys the {current_card} painting for {price} (paid to the auctioneer, seat {auctioneer}, unless the auctioneer bought it, in which case it goes to the bank)."
    },
    {
      "use": "update",
      "phase": "season end",
      "label": "rank the artists",
      "when": {
        "calc": "season_ending"
      },
      "do": [
        {
          "set": {
            "key": "first_artist",
            "value": {
              "calc": "sorted([[played_amber * 10 + rarity_amber, 'Amber'], [played_blue * 10 + rarity_blue, 'Blue'], [played_crimson * 10 + rarity_crimson, 'Crimson']])[2][1]"
            }
          }
        },
        {
          "set": {
            "key": "second_artist",
            "value": {
              "calc": "sorted([[played_amber * 10 + rarity_amber, 'Amber'], [played_blue * 10 + rarity_blue, 'Blue'], [played_crimson * 10 + rarity_crimson, 'Crimson']])[1][1]"
            }
          }
        },
        {
          "adjust": {
            "key": "value_amber",
            "value": {
              "calc": "first_artist_gain if first_artist == 'Amber' else (second_artist_gain if second_artist == 'Amber' else third_artist_gain)"
            }
          }
        },
        {
          "adjust": {
            "key": "value_blue",
            "value": {
              "calc": "first_artist_gain if first_artist == 'Blue' else (second_artist_gain if second_artist == 'Blue' else third_artist_gain)"
            }
          }
        },
        {
          "adjust": {
            "key": "value_crimson",
            "value": {
              "calc": "first_artist_gain if first_artist == 'Crimson' else (second_artist_gain if second_artist == 'Crimson' else third_artist_gain)"
            }
          }
        }
      ],
      "text": "Season ranking: first {first_artist}, second {second_artist}. Artist values are now Amber {value_amber}, Blue {value_blue}, Crimson {value_crimson}."
    },
    {
      "use": "update",
      "phase": "season end",
      "label": "season payouts",
      "when": {
        "calc": "season_ending"
      },
      "do": [
        {
          "adjust": {
            "players": "all",
            "key": "money",
            "value": {
              "calc": "(you.owned_amber * value_amber if first_artist == 'Amber' else (you.owned_blue * value_blue if first_artist == 'Blue' else you.owned_crimson * value_crimson)) + (you.owned_amber * value_amber if second_artist == 'Amber' else (you.owned_blue * value_blue if second_artist == 'Blue' else you.owned_crimson * value_crimson))"
            },
            "text": "Seat {player} receives {value} from the bank."
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "season end",
      "label": "clear the season",
      "when": {
        "calc": "season_ending"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "owned_amber",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "owned_blue",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "owned_crimson",
            "value": 0
          }
        },
        {
          "set": {
            "key": "played_amber",
            "value": 0
          }
        },
        {
          "set": {
            "key": "played_blue",
            "value": 0
          }
        },
        {
          "set": {
            "key": "played_crimson",
            "value": 0
          }
        },
        {
          "adjust": {
            "key": "season",
            "value": 1
          }
        },
        {
          "set": {
            "key": "season_ending",
            "value": false
          }
        }
      ],
      "text": "All owned paintings are discarded and played counts reset. Seasons completed: {season} of {seasons}."
    },
    {
      "use": "update",
      "phase": "end of turn",
      "label": "pass the auctioneer role",
      "do": [
        {
          "set": {
            "key": "auctioneer",
            "value": {
              "calc": "(auctioneer % player_count) + 1"
            }
          }
        }
      ]
    },
    {
      "use": "check",
      "phase": "end of turn",
      "label": "after the last season",
      "when": {
        "calc": "season >= seasons"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "season >= seasons"
      },
      "rank_by": "you.money",
      "text": "Winner: {result}. Final money: Seat 1 {players[0].money}, Seat 2 {players[1].money}, Seat 3 {players[2].money}, Seat 4 {players[3].money}."
    }
  },
  "limits": {
    "rounds": 30,
    "rounds_max": 30,
    "actions_max": 1000,
    "deadline_s": 120
  }
}
