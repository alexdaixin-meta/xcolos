  "steps": [
    {
      "use": "sync",
      "phase": "seat 1",
      "label": "the state",
      "mode": "self",
      "to": "all",
      "text": "Where you stand:"
    },
    {
      "use": "update",
      "phase": "seat 1",
      "label": "seat 1 play options",
      "do": [
        {
          "set": {
            "players": {
              "where": "you.seat == 1"
            },
            "key": "play_offer",
            "value": {
              "calc": "['PLAY ' + k + 'W' for k in ['R', 'B', 'G'] if k + 'W' in you.hand and (you.top_r if k == 'R' else (you.top_b if k == 'B' else you.top_g)) == 0] + ['PLAY ' + c for c in you.hand if c[1] != 'W' and (10 if len(c) == 3 else int(c[1])) > (you.top_r if c[0] == 'R' else (you.top_b if c[0] == 'B' else you.top_g))] + ['DISCARD ' + c for c in you.hand if c[1] != 'W'] + ['DISCARD ' + k + 'W' for k in ['R', 'B', 'G'] if k + 'W' in you.hand]"
            }
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "seat 1",
      "label": "seat 1 plays or discards",
      "to": {
        "where": "you.seat == 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "play_offer"
        }
      },
      "verify": {
        "bind": "p1"
      },
      "text": "Your turn. PLAY a card onto your expedition (a number must be higher than the top number of its colour; a wager only before any number in its colour) or DISCARD a card face up."
    },
    {
      "use": "update",
      "phase": "seat 1",
      "label": "seat 1 play resolves",
      "do": [
        {
          "set": {
            "key": "act",
            "value": {
              "calc": "'PLAY' if 'PLAY' in $p1 else 'DISCARD'"
            }
          }
        },
        {
          "set": {
            "key": "card",
            "value": {
              "calc": "([c for c in players[0].hand if 'PLAY ' + c == $p1 or 'DISCARD ' + c == $p1] + [''])[0]"
            }
          }
        },
        {
          "set": {
            "key": "ccol",
            "value": {
              "calc": "card[0] if len(card) > 0 else ''"
            }
          }
        },
        {
          "set": {
            "key": "cnum",
            "value": {
              "calc": "0 if len(card) < 2 else (0 if card[1] == 'W' else (10 if len(card) == 3 else int(card[1])))"
            }
          }
        },
        {
          "set": {
            "key": "legal",
            "value": {
              "calc": "1 if len(card) > 0 and (act == 'DISCARD' or (cnum == 0 and (players[0].top_r if ccol == 'R' else (players[0].top_b if ccol == 'B' else players[0].top_g)) == 0) or (cnum > 0 and cnum > (players[0].top_r if ccol == 'R' else (players[0].top_b if ccol == 'B' else players[0].top_g)))) else 0"
            }
          }
        },
        {
          "set": {
            "key": "card",
            "value": {
              "calc": "players[0].hand[0] if len(players[0].hand) > 0 else ''"
            },
            "if": {
              "calc": "legal == 0"
            }
          }
        },
        {
          "set": {
            "key": "act",
            "value": "DISCARD",
            "if": {
              "calc": "legal == 0"
            }
          }
        },
        {
          "set": {
            "key": "ccol",
            "value": {
              "calc": "card[0] if len(card) > 0 else ''"
            }
          }
        },
        {
          "set": {
            "key": "cnum",
            "value": {
              "calc": "0 if len(card) < 2 else (0 if card[1] == 'W' else (10 if len(card) == 3 else int(card[1])))"
            }
          }
        },
        {
          "remove": {
            "player": 1,
            "key": "hand",
            "value": {
              "calc": "card"
            },
            "if": {
              "calc": "len(card) > 0"
            }
          }
        },
        {
          "adjust": {
            "player": 1,
            "key": "cnt_r",
            "value": 1,
            "if": {
              "calc": "act == 'PLAY' and ccol == 'R'"
            }
          }
        },
        {
          "adjust": {
            "player": 1,
            "key": "sum_r",
            "value": {
              "calc": "cnum"
            },
            "if": {
              "calc": "act == 'PLAY' and ccol == 'R' and cnum > 0"
            }
          }
        },
        {
          "set": {
            "player": 1,
            "key": "top_r",
            "value": {
              "calc": "cnum"
            },
            "if": {
              "calc": "act == 'PLAY' and ccol == 'R' and cnum > 0"
            }
          }
        },
        {
          "adjust": {
            "player": 1,
            "key": "wag_r",
            "value": 1,
            "if": {
              "calc": "act == 'PLAY' and ccol == 'R' and cnum == 0"
            }
          }
        },
        {
          "adjust": {
            "player": 1,
            "key": "cnt_b",
            "value": 1,
            "if": {
              "calc": "act == 'PLAY' and ccol == 'B'"
            }
          }
        },
        {
          "adjust": {
            "player": 1,
            "key": "sum_b",
            "value": {
              "calc": "cnum"
            },
            "if": {
              "calc": "act == 'PLAY' and ccol == 'B' and cnum > 0"
            }
          }
        },
        {
          "set": {
            "player": 1,
            "key": "top_b",
            "value": {
              "calc": "cnum"
            },
            "if": {
              "calc": "act == 'PLAY' and ccol == 'B' and cnum > 0"
            }
          }
        },
        {
          "adjust": {
            "player": 1,
            "key": "wag_b",
            "value": 1,
            "if": {
              "calc": "act == 'PLAY' and ccol == 'B' and cnum == 0"
            }
          }
        },
        {
          "adjust": {
            "player": 1,
            "key": "cnt_g",
            "value": 1,
            "if": {
              "calc": "act == 'PLAY' and ccol == 'G'"
            }
          }
        },
        {
          "adjust": {
            "player": 1,
            "key": "sum_g",
            "value": {
              "calc": "cnum"
            },
            "if": {
              "calc": "act == 'PLAY' and ccol == 'G' and cnum > 0"
            }
          }
        },
        {
          "set": {
            "player": 1,
            "key": "top_g",
            "value": {
              "calc": "cnum"
            },
            "if": {
              "calc": "act == 'PLAY' and ccol == 'G' and cnum > 0"
            }
          }
        },
        {
          "adjust": {
            "player": 1,
            "key": "wag_g",
            "value": 1,
            "if": {
              "calc": "act == 'PLAY' and ccol == 'G' and cnum == 0"
            }
          }
        },
        {
          "set": {
            "key": "discard_tops",
            "value": {
              "calc": "[c for c in discard_tops if c[0] != ccol] + [card]"
            },
            "if": {
              "calc": "act == 'DISCARD' and len(card) > 0"
            }
          }
        },
        {
          "set": {
            "key": "last_discard",
            "value": {
              "calc": "card"
            },
            "if": {
              "calc": "act == 'DISCARD' and len(card) > 0"
            }
          }
        },
        {
          "set": {
            "key": "last_action",
            "value": {
              "calc": "('played ' if act == 'PLAY' else 'discarded ') + card"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == 1"
            },
            "key": "draw_offer",
            "value": {
              "calc": "(['DECK'] if len(deck) > 0 else []) + [c for c in discard_tops if c != last_discard]"
            }
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "seat 1",
      "label": "seat 1 draws",
      "to": {
        "where": "you.seat == 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "draw_offer"
        }
      },
      "verify": {
        "bind": "d1"
      },
      "text": "Draw a card: DECK for the top card of the deck, or name a face-up discard (not the card you just discarded)."
    },
    {
      "use": "update",
      "phase": "seat 1",
      "label": "seat 1 draw resolves",
      "do": [
        {
          "set": {
            "key": "take",
            "value": {
              "calc": "'' if len(players[0].draw_offer) == 0 else ($d1 if ($d1 in discard_tops and $d1 != last_discard) else ('DECK' if len(deck) > 0 else [c for c in discard_tops if c != last_discard][0]))"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            },
            "if": {
              "calc": "take == 'DECK' and len(deck) > 0"
            }
          }
        },
        {
          "append": {
            "player": 1,
            "key": "hand",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "take == 'DECK' and len(deck) > 0"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "take == 'DECK' and len(deck) > 0"
            }
          }
        },
        {
          "append": {
            "player": 1,
            "key": "hand",
            "value": {
              "calc": "take"
            },
            "if": {
              "calc": "take != '' and take != 'DECK'"
            }
          }
        },
        {
          "remove": {
            "key": "discard_tops",
            "value": {
              "calc": "take"
            },
            "if": {
              "calc": "take != '' and take != 'DECK'"
            }
