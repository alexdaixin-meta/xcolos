            "value": {
              "calc": "cnum"
            },
            "if": {
              "calc": "act == 'PLAY' and ccol == 'G' and cnum > 0"
            }
          }
        },
        {
          "adjust": {
            "player": 2,
            "key": "wag_g",
            "value": 1,
            "if": {
              "calc": "act == 'PLAY' and ccol == 'G' and cnum == 0"
            }
          }
        },
        {
          "set": {
            "key": "discard_tops",
