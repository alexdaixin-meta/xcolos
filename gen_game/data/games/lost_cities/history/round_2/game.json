        "type": "choice",
        "options": {
          "attribute": "draw_offer"
        }
      },
      "verify": {
        "bind": "d2"
      },
      "text": "Draw a card: DECK for the top card of the deck, or name a face-up discard (not the card you just discarded)."
    },
    {
      "use": "update",
      "phase": "seat 2",
      "label": "seat 2 draw resolves",
      "do": [
        {
          "set": {
            "key": "take",
            "value": {
              "calc": "'' if len(players[1].draw_offer) == 0 else ($d2 if ($d2 in discard_tops and $d2 != last_discard) else ('DECK' if len(deck) > 0 else [c for c in discard_tops if c != last_discard][0]))"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            },
            "if": {
              "calc": "take == 'DECK' and len(deck) > 0"
            }
          }
        },
        {
          "append": {
            "player": 2,
            "key": "hand",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "take == 'DECK' and len(deck) > 0"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "take == 'DECK' and len(deck) > 0"
            }
          }
        },
        {
          "append": {
            "player": 2,
            "key": "hand",
            "value": {
              "calc": "take"
            },
            "if": {
              "calc": "take != '' and take != 'DECK'"
            }
          }
        },
        {
          "remove": {
            "key": "discard_tops",
            "value": {
              "calc": "take"
            },
            "if": {
              "calc": "take != '' and take != 'DECK'"
            }
          }
