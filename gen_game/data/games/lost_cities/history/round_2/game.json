              "calc": "1 if len(card) > 0 and (act == 'DISCARD' or (cnum == 0 and (players[1].top_r if ccol == 'R' else (players[1].top_b if ccol == 'B' else players[1].top_g)) == 0) or (cnum > 0 and cnum > (players[1].top_r if ccol == 'R' else (players[1].top_b if ccol == 'B' else players[1].top_g)))) else 0"
            }
          }
        },
        {
          "set": {
            "key": "card",
            "value": {
              "calc": "players[1].hand[0] if len(players[1].hand) > 0 else ''"
            },
            "if": {
              "calc": "legal == 0"
            }
          }
        },
        {
          "set": {
            "key": "act",
            "value": "DISCARD",
            "if": {
