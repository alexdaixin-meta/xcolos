          }
        },
        {
          "adjust": {
            "player": 2,
            "key": "wag_r",
            "value": 1,
            "if": {
              "calc": "act == 'PLAY' and ccol == 'R' and cnum == 0"
            }
          }
        },
        {
          "adjust": {
            "player": 2,
            "key": "cnt_b",
            "value": 1,
            "if": {
              "calc": "act == 'PLAY' and ccol == 'B'"
            }
          }
        },
        {
          "adjust": {
            "player": 2,
            "key": "sum_b",
            "value": {
              "calc": "cnum"
            },
            "if": {
              "calc": "act == 'PLAY' and ccol == 'B' and cnum > 0"
            }
          }
        },
        {
          "set": {
            "player": 2,
            "key": "top_b",
            "value": {
              "calc": "cnum"
            },
            "if": {
              "calc": "act == 'PLAY' and ccol == 'B' and cnum > 0"
            }
          }
        },
        {
          "adjust": {
            "player": 2,
            "key": "wag_b",
            "value": 1,
            "if": {
              "calc": "act == 'PLAY' and ccol == 'B' and cnum == 0"
            }
          }
        },
        {
          "adjust": {
            "player": 2,
            "key": "cnt_g",
            "value": 1,
            "if": {
              "calc": "act == 'PLAY' and ccol == 'G'"
            }
          }
        },
        {
          "adjust": {
            "player": 2,
            "key": "sum_g",
            "value": {
              "calc": "cnum"
            },
            "if": {
              "calc": "act == 'PLAY' and ccol == 'G' and cnum > 0"
