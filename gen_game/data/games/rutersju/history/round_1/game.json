            "options": {
              "attribute": "offer"
            }
          },
          "each": {
            "do": [
              {
                "set": {
                  "key": "cur_card",
                  "value": "$answer"
                }
              },
              {
                "set": {
                  "key": "led_suit",
                  "value": {
                    "calc": "cur_card[-1]"
                  },
                  "if": {
                    "calc": "plays_in_trick == 0"
                  }
                }
              },
              {
