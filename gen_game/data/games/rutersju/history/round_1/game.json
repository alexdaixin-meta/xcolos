  "setup": [
    {
      "use": "update",
      "label": "the start",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "score",
            "value": {
              "calc": "starting_score"
            }
          }
        },
        {
          "set": {
            "key": "deal_number",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "sync",
      "label": "the table",
      "mode": "self",
      "to": "all",
      "text": "You start with:"
    }
  ],
  "steps": [
    {
      "use": "update",
      "phase": "deal",
      "label": "a new deal",
      "do": [
        {
          "adjust": {
            "key": "deal_number",
            "value": 1
          }
        },
        {
          "set": {
            "key": "first_bidder",
            "value": {
              "calc": "(first_bidder_deal_1 - 1 + deal_number - 1) % len(players) + 1"
            }
          }
        },
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "['AS', 'KS', 'QS', 'JS', '10S', '9S', '8S', '7S', '6S', 'AH', 'KH', 'QH', 'JH', '10H', '9H', '8H', '7H', '6H', 'AD', 'KD', 'QD', 'JD', '10D', '9D', '8D', '7D', '6D', 'AC', 'KC', 'QC', 'JC', '10C', '9C', '8C', '7C', '6C']"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "tricks",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "is_declarer",
            "value": false
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": []
          }
        },
        {
          "set": {
            "key": "high_bid",
            "value": -1
          }
        },
        {
          "set": {
            "key": "declarer_seat",
            "value": 0
          }
        },
        {
          "set": {
            "key": "contract",
            "value": 0
          }
        },
        {
          "set": {
            "key": "trick_number",
            "value": 0
          }
        },
        {
          "set": {
            "key": "led_suit",
            "value": ""
          }
        },
        {
          "set": {
            "key": "trick_cards",
            "value": []
          }
        },
        {
          "set": {
            "key": "played_cards",
            "value": []
          }
        },
        {
          "set": {
            "key": "dealt_rounds",
            "value": 0
          }
        },
        {
          "set": {
            "key": "bids_made",
            "value": 0
          }
        },
        {
          "set": {
            "key": "plays_in_trick",
            "value": 0
          }
        },
        {
          "set": {
            "key": "best_seat",
            "value": 0
          }
        },
        {
          "set": {
            "key": "best_strength",
            "value": -1
          }
        },
        {
          "set": {
            "key": "turn_seat",
            "value": {
              "calc": "first_bidder"
            }
          }
        }
      ],
      "text": "Deal {deal_number} of {deals} begins. Seat {first_bidder} bids first."
    },
    {
      "use": "repeat",
      "phase": "deal",
      "label": "dealing",
      "until": {
        "calc": "dealt_rounds >= hand_size"
      },
      "max": 10,
      "steps": [
        {
          "use": "update",
          "phase": "deal",
          "label": "one card to each player",
          "do": [
            {
              "set": {
                "key": "pick",
                "value": {
                  "calc": "deck[int(uniform(0, len(deck)))]"
                }
              }
            },
            {
              "append": {
                "player": 1,
                "key": "hand",
                "value": {
                  "calc": "pick"
                }
              }
            },
            {
              "remove": {
                "key": "deck",
                "value": {
                  "calc": "pick"
                }
              }
            },
            {
              "set": {
                "key": "pick",
                "value": {
                  "calc": "deck[int(uniform(0, len(deck)))]"
                }
              }
            },
            {
              "append": {
                "player": 2,
                "key": "hand",
                "value": {
                  "calc": "pick"
                }
              }
            },
            {
              "remove": {
                "key": "deck",
                "value": {
                  "calc": "pick"
                }
              }
            },
            {
              "set": {
                "key": "pick",
                "value": {
                  "calc": "deck[int(uniform(0, len(deck)))]"
                }
              }
            },
            {
              "append": {
                "player": 3,
                "key": "hand",
                "value": {
                  "calc": "pick"
                }
              }
            },
            {
              "remove": {
                "key": "deck",
                "value": {
                  "calc": "pick"
                }
              }
            },
            {
              "set": {
                "key": "pick",
                "value": {
                  "calc": "deck[int(uniform(0, len(deck)))]"
                },
                "if": {
                  "calc": "len(players) >= 4"
                }
              }
            },
            {
              "append": {
                "player": 4,
                "key": "hand",
                "value": {
                  "calc": "pick"
                },
                "if": {
                  "calc": "len(players) >= 4"
                }
              }
            },
            {
              "remove": {
                "key": "deck",
                "value": {
                  "calc": "pick"
                },
                "if": {
                  "calc": "len(players) >= 4"
                }
              }
            },
            {
              "adjust": {
                "key": "dealt_rounds",
                "value": 1
              }
            }
          ]
        }
      ]
    },
    {
      "use": "sync",
      "phase": "deal",
      "label": "your hand",
      "mode": "self",
      "to": "all",
      "text": "Deal {deal_number}: your hand and the table."
    },
    {
      "use": "repeat",
      "phase": "bid",
      "label": "the bidding",
      "until": {
        "calc": "bids_made >= len(players)"
      },
      "max": 10,
      "steps": [
        {
          "use": "ask",
          "phase": "bid",
          "label": "bid",
          "to": {
            "where": "you.seat == turn_seat"
          },
          "answer": {
            "type": "number",
            "min": {
              "calc": "bid_min"
            },
            "max": {
              "calc": "bid_max"
            }
          },
          "each": {
            "do": [
              {
                "set": {
                  "player": "$seat",
                  "key": "bid",
                  "value": "$answer"
                }
              },
              {
                "set": {
                  "key": "declarer_seat",
                  "value": "$seat",
                  "if": {
                    "calc": "$answer >= high_bid"
                  }
                }
              },
              {
                "set": {
                  "key": "high_bid",
                  "value": {
                    "calc": "max(high_bid, $answer)"
                  }
                }
              },
              {
                "adjust": {
                  "key": "bids_made",
                  "value": 1
                }
              }
            ]
          },
          "broadcast": {
            "to": "all",
            "text": "Seat {seat} bids {value}."
          },
          "text": "Deal {deal_number}: bid how many of the 3 tricks you will take, a whole number from {bid_min} to {bid_max}. The highest bid so far is {high_bid} (-1 means no bid yet). The highest bidder becomes declarer; on a tie for highest, the one who bid last is declarer. There is no pass."
        },
        {
          "use": "update",
          "phase": "bid",
          "label": "next bidder",
          "do": [
            {
              "set": {
                "key": "turn_seat",
                "value": {
                  "calc": "turn_seat % len(players) + 1"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "use": "update",
      "phase": "bid",
      "label": "the declarer",
      "do": [
        {
          "set": {
            "key": "contract",
            "value": {
              "calc": "high_bid"
            }
          }
        },
        {
          "set": {
            "key": "leader_seat",
            "value": {
              "calc": "declarer_seat"
            }
          }
        },
        {
          "set": {
            "key": "turn_seat",
            "value": {
              "calc": "declarer_seat"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == declarer_seat"
            },
            "key": "is_declarer",
            "value": true
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "you.hand"
            }
          }
        }
      ],
      "text": "Seat {declarer_seat} is the declarer with a contract of {contract} and leads the first trick."
    },
    {
      "use": "repeat",
      "phase": "play",
      "label": "trick 1",
      "until": {
        "calc": "plays_in_trick >= len(players)"
      },
      "max": 10,
      "steps": [
        {
          "use": "ask",
          "phase": "play",
          "label": "trick 1 card",
          "to": {
            "where": "you.seat == turn_seat"
          },
          "answer": {
            "type": "choice",
            "options": {
              "attribute": "offer"
            }
          },
          "each": {
            "do": [
              {
                "set": {
                  "key": "cur_card",
                  "value": "$answer"
                }
              },
              {
                "set": {
                  "key": "led_suit",
                  "value": {
                    "calc": "cur_card[-1]"
                  },
                  "if": {
                    "calc": "plays_in_trick == 0"
                  }
                }
              },
              {
                "set": {
                  "key": "cur_str",
                  "value": {
                    "calc": "100 if cur_card == '7D' else (sum([p[1] for p in [['A', 8], ['K', 7], ['Q', 6], ['J', 5], ['1', 4], ['9', 3], ['8', 2], ['7', 1], ['6', 0]] if p[0] == cur_card[0]]) if cur_card[-1] == led_suit else -1)"
                  }
                }
              },
              {
                "set": {
                  "key": "best_seat",
                  "value": "$seat",
                  "if": {
                    "calc": "cur_str > best_strength"
                  }
                }
              },
              {
                "set": {
                  "key": "best_strength",
                  "value": {
                    "calc": "max(best_strength, cur_str)"
                  }
                }
              },
              {
                "remove": {
                  "player": "$seat",
                  "key": "hand",
                  "value": "$answer"
                }
              },
              {
                "append": {
                  "key": "trick_cards",
                  "value": {
                    "calc": "['1', '2', '3', '4'][turn_seat - 1] + ':' + cur_card"
                  }
                }
              },
              {
                "append": {
                  "key": "played_cards",
                  "value": {
                    "calc": "['1', '2', '3', '4'][turn_seat - 1] + ':' + cur_card"
                  }
                }
              },
              {
                "adjust": {
                  "key": "plays_in_trick",
                  "value": 1
                }
              }
            ]
          },
          "broadcast": {
            "to": "all",
            "text": "Seat {seat} plays {value}."
          },
          "text": "Deal {deal_number}, trick 1. Cards in this trick: {trick_cards}. Led suit: {led_suit} (empty means you lead). Play one card; you are offered only legal cards (you must follow the led suit if you can, otherwise any card). The 7 of diamonds wins any trick; otherwise the highest card of the led suit wins."
        },
        {
          "use": "update",
          "phase": "play",
          "label": "trick 1 next player",
          "do": [
            {
              "set": {
                "key": "turn_seat",
                "value": {
                  "calc": "turn_seat % len(players) + 1"
                }
              }
            },
            {
              "set": {
                "players": "all",
                "key": "offer",
                "value": {
                  "calc": "[c for c in you.hand if c[-1] == led_suit] if len([c for c in you.hand if c[-1] == led_suit]) > 0 else you.hand"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "use": "update",
      "phase": "play",
      "label": "trick 1 is won",
      "do": [
        {
          "adjust": {
            "player": {
              "calc": "best_seat"
            },
            "key": "tricks",
            "value": 1,
            "text": "Seat {player} wins the trick and leads next."
          }
        },
        {
          "set": {
            "key": "leader_seat",
            "value": {
              "calc": "best_seat"
            }
          }
        },
        {
          "set": {
            "key": "turn_seat",
            "value": {
              "calc": "best_seat"
            }
          }
        },
        {
          "adjust": {
            "key": "trick_number",
            "value": 1
          }
        },
        {
          "set": {
            "key": "trick_cards",
            "value": []
          }
        },
        {
          "set": {
            "key": "led_suit",
            "value": ""
          }
        },
        {
          "set": {
            "key": "plays_in_trick",
            "value": 0
          }
        },
        {
          "set": {
            "key": "best_seat",
            "value": 0
          }
        },
        {
          "set": {
            "key": "best_strength",
            "value": -1
          }
        },
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "you.hand"
            }
          }
        }
      ]
    },
    {
      "use": "repeat",
      "phase": "play",
      "label": "trick 2",
      "until": {
        "calc": "plays_in_trick >= len(players)"
      },
      "max": 10,
      "steps": [
        {
