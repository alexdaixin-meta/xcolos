                  "value": {
                    "calc": "100 if cur_card == '7D' else (sum([p[1] for p in [['A', 8], ['K', 7], ['Q', 6], ['J', 5], ['1', 4], ['9', 3], ['8', 2], ['7', 1], ['6', 0]] if p[0] == cur_card[0]]) if cur_card[-1] == led_suit else -1)"
                  }
                }
              },
              {
                "set": {
                  "key": "best_seat",
                  "value": "$seat",
                  "if": {
                    "calc": "cur_str > best_strength"
                  }
                }
              },
              {
                "set": {
                  "key": "best_strength",
