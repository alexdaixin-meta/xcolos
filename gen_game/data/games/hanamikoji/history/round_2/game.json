  "steps": [
    {
      "use": "update",
      "phase": "deal",
      "label": "start of the hand",
      "when": {
        "calc": "round_in_hand == 1"
      },
      "do": [
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "[1 for k in [1, 2, 3, 4, 5, 6] if k <= cards_g1] + [2 for k in [1, 2, 3, 4, 5, 6] if k <= cards_g2] + [3 for k in [1, 2, 3, 4, 5, 6] if k <= cards_g3] + [4 for k in [1, 2, 3, 4, 5, 6] if k <= cards_g4] + [5 for k in [1, 2, 3, 4, 5, 6] if k <= cards_g5]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand",
            "value": {
              "calc": "[]"
            }
          }
        },
        {
          "set": {
            "key": "drawn",
            "value": {
              "calc": "deck[min(len(deck) - 1, int(uniform(0, len(deck))))]"
            }
          }
        },
        {
          "set": {
            "key": "removed_card",
            "value": {
              "calc": "[drawn]"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "drawn"
            }
          }
        },
        {
          "set": {
            "key": "drawn",
            "value": {
              "calc": "deck[min(len(deck) - 1, int(uniform(0, len(deck))))]"
            }
          }
        },
