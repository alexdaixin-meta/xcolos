        },
        {
          "set": {
            "players": "all",
            "key": "hand",
            "value": {
              "calc": "sorted(you.hand)"
            }
          }
        },
        {
          "set": {
            "key": "discard",
            "value": {
              "calc": "[]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "unused_actions",
            "value": {
              "calc": "['Secret', 'Trade-off', 'Gift', 'Competition']"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "secret",
            "value": {
              "calc": "[]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "kept",
            "value": {
              "calc": "[]"
            },
            "if": {
              "calc": "hand_number % hands_per_pair == 1"
            }
          }
        },
        {
          "set": {
            "key": "starting_seat",
            "value": {
              "calc": "1 if hand_number % hands_per_pair == 1 else 2"
            }
          }
        },
        {
          "set": {
            "key": "revealed",
            "value": {
              "calc": "[]"
            }
          }
        }
      ],
      "text": "Hand {hand_number} begins. The {cards_total} Items are shuffled, {cards_removed_per_hand} card is set aside unseen, each player is dealt {hand_size_dealt} cards in private and {deck_size_after_deal} cards form the deck. Seat {starting_seat} starts this hand."
    },
    {
      "use": "update",
      "phase": "round",
      "label": "the active seat",
      "do": [
        {
          "set": {
            "key": "active_seat",
            "value": {
              "calc": "starting_seat if round_in_hand % 2 == 1 else 3 - starting_seat"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "round",
      "label": "round announcement",
      "to": "all",
      "text": "Hand {hand_number}, round {round_in_hand}: seat {active_seat} is active. Unused actions: seat 1 {players[0].unused_actions}, seat 2 {players[1].unused_actions}. Pair totals G1-G5: seat 1 {[count(x == g for x in players[0].kept) for g in [1, 2, 3, 4, 5]]}, seat 2 {[count(x == g for x in players[1].kept) for g in [1, 2, 3, 4, 5]]}. Markers G1-G5 (0 neutral, 1 seat 1, 2 seat 2): {marker_1} {marker_2} {marker_3} {marker_4} {marker_5}."
    },
    {
      "use": "update",
      "phase": "round",
      "label": "the draw",
      "do": [
        {
          "set": {
            "key": "drawn",
            "value": {
              "calc": "deck[min(len(deck) - 1, int(uniform(0, len(deck))))]"
            },
            "if": {
              "calc": "len(deck) > 0"
            }
          }
        },
        {
          "append": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "drawn"
            },
            "if": {
              "calc": "len(deck) > 0"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "drawn"
            },
            "if": {
              "calc": "len(deck) > 0"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand",
            "value": {
              "calc": "sorted(you.hand)"
            }
          }
        }
      ],
      "text": "Seat {active_seat} draws a card from the deck."
    },
    {
      "use": "sync",
      "phase": "round",
      "label": "your hand",
      "mode": "self",
      "to": "all",
      "fields": [
        "hand",
        "secret"
      ],
      "text": "Your hand and your Secret:"
    },
    {
      "use": "ask",
      "phase": "action",
      "label": "choose an action",
      "when": {
        "calc": "len(players[active_seat - 1].unused_actions) > 1"
      },
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "unused_actions"
        }
      },
      "verify": {
        "bind": "act"
      },
      "text": "Name one of your unused actions. Secret: keep 1 card face down. Trade-off: discard 2 cards face down. Gift: reveal 3 cards, your opponent keeps 1 and you keep the other 2. Competition: reveal 4 cards as two pairs, your opponent keeps one pair and you keep the other."
    },
    {
      "use": "update",
      "phase": "action",
      "label": "resolve the action",
      "do": [
        {
          "set": {
            "key": "chosen_action",
            "value": {
              "calc": "players[active_seat - 1].unused_actions[0]"
            }
          }
        },
        {
          "set": {
            "key": "chosen_action",
            "value": "$act",
            "if": {
              "calc": "len(players[active_seat - 1].unused_actions) > 1 and $act in players[active_seat - 1].unused_actions"
            }
          }
        },
        {
          "set": {
            "key": "need",
            "value": {
              "calc": "secret_cards if chosen_action == 'Secret' else (tradeoff_cards if chosen_action == 'Trade-off' else (gift_cards if chosen_action == 'Gift' else competition_cards))"
            }
          }
        },
        {
          "set": {
            "key": "chosen_cards",
            "value": {
              "calc": "[sorted(players[active_seat - 1].hand)[i] for i in [0, 1, 2, 3] if i < need and i < len(players[active_seat - 1].hand)]"
            }
          }
        }
      ],
      "text": "Seat {active_seat} uses {chosen_action}."
    },
    {
      "use": "ask",
      "phase": "action",
      "label": "choose the cards",
      "when": {
        "calc": "len(players[active_seat - 1].hand) > need or chosen_action == 'Competition'"
      },
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "text",
        "max_words": 8
      },
      "verify": {
        "bind": "cards"
      },
      "text": "You are using {chosen_action}. Write the cards it uses from your hand as space-separated numbers with repeats written out (for example '5 5 2'): Secret 1 number, Trade-off 2, Gift 3 (offers 1, 2, 3 in the order written), Competition 4 (the first two are pair A, the last two pair B). If the answer is illegal, your lowest cards in ascending order are used instead."
    },
    {
      "use": "update",
      "phase": "action",
      "label": "accept the written cards",
      "when": {
        "prose": "The answer is exactly the required number of card numbers for chosen_action (Secret 1, Trade-off 2, Gift 3, Competition 4), and no number appears more often than that card appears in the active player's hand."
      },
      "do": [
        {
          "set": {
            "key": "chosen_cards",
            "value": {
              "calc": "[int(c) for c in $cards if c in '12345']"
            },
            "if": {
              "calc": "(len(players[active_seat - 1].hand) > need or chosen_action == 'Competition') and len([int(c) for c in $cards if c in '12345']) == need and all(count(x == g for x in [int(c) for c in $cards if c in '12345']) <= count(y == g for y in players[active_seat - 1].hand) for g in [1, 2, 3, 4, 5])"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "action",
      "label": "the cards leave the hand",
      "do": [
        {
          "remove": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "chosen_cards[0]"
            },
            "if": {
              "calc": "len(chosen_cards) > 0"
            }
          }
        },
        {
          "remove": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "chosen_cards[1]"
            },
            "if": {
              "calc": "len(chosen_cards) > 1"
            }
          }
        },
        {
          "remove": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "chosen_cards[2]"
            },
            "if": {
              "calc": "len(chosen_cards) > 2"
            }
          }
        },
        {
          "remove": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "chosen_cards[3]"
            },
            "if": {
              "calc": "len(chosen_cards) > 3"
            }
          }
        },
        {
          "append": {
            "player": {
              "calc": "active_seat"
            },
            "key": "secret",
            "value": {
              "calc": "chosen_cards[0]"
            },
            "if": {
              "calc": "chosen_action == 'Secret' and len(chosen_cards) > 0"
            }
          }
        },
        {
          "append": {
            "key": "discard",
            "value": {
              "calc": "chosen_cards[0]"
            },
            "if": {
              "calc": "chosen_action == 'Trade-off' and len(chosen_cards) > 0"
            }
          }
        },
        {
          "append": {
            "key": "discard",
            "value": {
              "calc": "chosen_cards[1]"
            },
            "if": {
              "calc": "chosen_action == 'Trade-off' and len(chosen_cards) > 1"
            }
          }
        },
        {
          "remove": {
            "player": {
              "calc": "active_seat"
            },
            "key": "unused_actions",
            "value": {
              "calc": "chosen_action"
            }
          }
        },
        {
          "set": {
            "key": "revealed",
            "value": {
              "calc": "chosen_cards if chosen_action in ['Gift', 'Competition'] else []"
            }
          }
        },
        {
          "set": {
            "key": "pick_options",
            "value": {
              "calc": "['1', '2', '3'] if chosen_action == 'Gift' else ['1', '2']"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "default_pick"
            }
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "pick",
      "label": "the opponent picks",
      "when": {
        "calc": "chosen_action in ['Gift', 'Competition'] and len(chosen_cards) == need"
      },
      "to": {
        "where": "you.seat != active_seat"
      },
      "answer": {
        "type": "choice",
        "options": {
          "game": "pick_options"
        }
      },
      "verify": {
        "bind": "pk"
      },
      "text": "Seat {active_seat} used {chosen_action} and revealed {revealed}. For a Gift these are offers 1, 2 and 3 in that order: pick one card to keep, and seat {active_seat} keeps the other two. For a Competition the first two cards are pair A (answer 1) and the last two pair B (answer 2): pick a pair to keep, and seat {active_seat} keeps the other pair."
    },
    {
      "use": "update",
      "phase": "pick",
      "label": "the split",
      "do": [
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "int($pk)"
            },
            "if": {
              "calc": "chosen_action in ['Gift', 'Competition'] and len(chosen_cards) == need and $pk in pick_options"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat != active_seat"
            },
            "key": "kept",
            "value": {
              "calc": "you.kept + ([chosen_cards[pick - 1]] if chosen_action == 'Gift' else [chosen_cards[i] for i in [0, 1, 2, 3] if (i < 2) == (pick == 1)])"
            },
            "if": {
              "calc": "chosen_action in ['Gift', 'Competition'] and len(chosen_cards) == need"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "kept",
            "value": {
              "calc": "you.kept + ([chosen_cards[i] for i in [0, 1, 2] if i != pick - 1] if chosen_action == 'Gift' else [chosen_cards[i] for i in [0, 1, 2, 3] if (i < 2) == (pick == 2)])"
            },
            "if": {
              "calc": "chosen_action in ['Gift', 'Competition'] and len(chosen_cards) == need"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "pick",
      "label": "a revealed action",
      "when": {
        "calc": "chosen_action in ['Gift', 'Competition']"
      },
      "to": "all",
      "text": "Seat {active_seat} used {chosen_action} and revealed {revealed}. The opponent picked {pick} and kept it; seat {active_seat} kept the rest. Kept cards this pair: seat 1 {players[0].kept}, seat 2 {players[1].kept}."
    },
    {
      "use": "tell",
      "phase": "pick",
      "label": "a hidden action",
      "when": {
        "calc": "chosen_action in ['Secret', 'Trade-off']"
      },
      "to": "all",
      "text": "Seat {active_seat} used {chosen_action}. The cards stay face down."
    },
    {
      "use": "update",
      "phase": "end of hand",
      "label": "the secrets are revealed",
      "when": {
        "calc": "round_in_hand == rounds_per_hand"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "kept",
            "value": {
              "calc": "you.kept + you.secret"
            }
          }
        }
      ],
      "text": "Hand {hand_number} is over. Secrets: seat 1 {players[0].secret}, seat 2 {players[1].secret}. Pair totals G1-G5: seat 1 {[count(x == g for x in players[0].kept) for g in [1, 2, 3, 4, 5]]}, seat 2 {[count(x == g for x in players[1].kept) for g in [1, 2, 3, 4, 5]]}."
    },
    {
      "use": "update",
      "phase": "end of pair",
      "label": "the markers move",
      "when": {
        "calc": "round_in_hand == rounds_per_hand and hand_number % hands_per_pair == 0"
      },
      "do": [
        {
          "set": {
            "key": "marker_1",
            "value": {
              "calc": "1 if count(x == 1 for x in players[0].kept) > count(x == 1 for x in players[1].kept) else (2 if count(x == 1 for x in players[0].kept) < count(x == 1 for x in players[1].kept) else marker_1)"
            }
          }
        },
        {
          "set": {
            "key": "marker_2",
            "value": {
              "calc": "1 if count(x == 2 for x in players[0].kept) > count(x == 2 for x in players[1].kept) else (2 if count(x == 2 for x in players[0].kept) < count(x == 2 for x in players[1].kept) else marker_2)"
            }
          }
        },
        {
          "set": {
            "key": "marker_3",
            "value": {
              "calc": "1 if count(x == 3 for x in players[0].kept) > count(x == 3 for x in players[1].kept) else (2 if count(x == 3 for x in players[0].kept) < count(x == 3 for x in players[1].kept) else marker_3)"
            }
          }
        },
        {
          "set": {
            "key": "marker_4",
            "value": {
              "calc": "1 if count(x == 4 for x in players[0].kept) > count(x == 4 for x in players[1].kept) else (2 if count(x == 4 for x in players[0].kept) < count(x == 4 for x in players[1].kept) else marker_4)"
            }
          }
        },
        {
          "set": {
            "key": "marker_5",
            "value": {
              "calc": "1 if count(x == 5 for x in players[0].kept) > count(x == 5 for x in players[1].kept) else (2 if count(x == 5 for x in players[0].kept) < count(x == 5 for x in players[1].kept) else marker_5)"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "charm",
            "value": {
              "calc": "(charm_g1 if marker_1 == you.seat else 0) + (charm_g2 if marker_2 == you.seat else 0) + (charm_g3 if marker_3 == you.seat else 0) + (charm_g4 if marker_4 == you.seat else 0) + (charm_g5 if marker_5 == you.seat else 0)"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "geisha_count",
            "value": {
              "calc": "count(m == you.seat for m in [marker_1, marker_2, marker_3, marker_4, marker_5])"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "standing",
            "value": {
              "calc": "(1000 if you.charm >= charm_to_win else 0) + (100 if you.geisha_count >= geisha_to_win else 0) + you.charm * 10 + you.geisha_count"
            }
          }
        },
        {
          "set": {
            "key": "game_over",
            "value": {
              "calc": "any(p.charm >= charm_to_win or p.geisha_count >= geisha_to_win for p in players) or hand_number >= max_hands"
            }
          }
        }
      ],
      "text": "The pair is over. Markers G1-G5 (0 neutral, 1 seat 1, 2 seat 2): {marker_1} {marker_2} {marker_3} {marker_4} {marker_5}. Seat 1: Charm {players[0].charm}, Geisha {players[0].geisha_count}. Seat 2: Charm {players[1].charm}, Geisha {players[1].geisha_count}."
    },
    {
      "use": "check",
      "phase": "end of pair",
      "label": "is the game over",
      "when": {
        "calc": "game_over"
      },
      "against": [
        "over"
      ]
    },
    {
      "use": "update",
      "phase": "end of round",
      "label": "advance the round",
      "do": [
        {
          "set": {
            "key": "hand_number",
            "value": {
              "calc": "hand_number + (1 if round_in_hand == rounds_per_hand else 0)"
            }
          }
        },
        {
          "set": {
            "key": "round_in_hand",
            "value": {
              "calc": "1 if round_in_hand == rounds_per_hand else round_in_hand + 1"
            }
          }
        }
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "game_over"
      },
      "rank_by": "you.standing",
      "text": "Winner: {result}. Seat 1: Charm {players[0].charm}, Geisha {players[0].geisha_count}. Seat 2: Charm {players[1].charm}, Geisha {players[1].geisha_count}. Markers G1-G5: {marker_1} {marker_2} {marker_3} {marker_4} {marker_5}."
    }
  },
  "limits": {
    "rounds": 32,
    "rounds_max": 32,
    "actions_max": 1000,
    "deadline_s": 120
  },
  "rules": "Two players compete for the favour of {geisha_count_total} Geisha, G1 to G5, with Charm G1={charm_g1}, G2={charm_g2}, G3={charm_g3}, G4={charm_g4}, G5={charm_g5} (total {charm_total}). There are {cards_total} Item cards: {cards_g1} of G1, {cards_g2} of G2, {cards_g3} of G3, {cards_g4} of G4 and {cards_g5} of G5, each written as its Geisha number 1 to 5. Each Geisha has a Victory Marker that is neutral, on seat 1's side or on seat 2's side; all start neutral.\n\nThe game has at most {max_hands} hands of {rounds_per_hand} rounds. Hands 1 and 2 form pair 1, hands 3 and 4 form pair 2. Seat 1 starts hands 1 and 3, seat 2 starts hands 2 and 4. The starting player is active in rounds 1, 3, 5 and 7, the other player in rounds 2, 4, 6 and 8; the player who is not active is the opponent.\n\nStart of each hand: all {cards_total} Items are shuffled, {cards_removed_per_hand} card is removed face down unseen and plays no part, each player is dealt {hand_size_dealt} cards as a private hand, and the other {deck_size_after_deal} form the deck. Both players' four actions (Secret, Trade-off, Gift, Competition) become unused and both Secrets are emptied. At the start of hands 1 and 3 only, both players' kept cards (pair totals) are reset to zero. Victory Markers always stay where they are.\n\nEach round: the game announces the hand, round, active player, unused actions, pair totals and markers. The active player draws the top deck card and sees their hand. They name one unused action; an illegal or missing action means the first unused action in the order Secret, Trade-off, Gift, Competition is used. Then they write the cards it uses as space-separated numbers with repeats written out (e.g. '5 5 2'); the cards are legal if no number is written more often than that card is in their hand.\n- Secret: exactly {secret_cards} card, set face down as their Secret.\n- Trade-off: exactly {tradeoff_cards} cards, discarded face down; they count for nobody.\n- Gift: exactly {gift_cards} cards, revealed in the order written as offers 1, 2 and 3. The opponent picks 1, 2 or 3 and keeps that card; the active player keeps the other two.\n- Competition: exactly {competition_cards} cards, all revealed; the first two are pair A, the last two pair B. The opponent picks 1 (pair A) or 2 (pair B) and keeps it; the active player keeps the other pair.\nIf the card answer is legal, those cards are used. If it is illegal (wrong count, unreadable or not in hand), the required number of lowest-numbered cards in hand are used in ascending order (for Competition the first two of them form pair A); the action still goes ahead. An illegal or missing pick counts as {default_pick}. The named cards leave the hand and the action is spent for the rest of the hand. Gift and Competition are announced with the revealed cards and the split; Secret and Trade-off are announced only as used, never the cards. Each player holds 10 cards per hand and spends exactly 10.\n\nEnd of each hand (after round 8): both Secrets are revealed and added to their owners' kept cards, and both players' pair totals are announced.\n\nEnd of each pair (after hands 2 and 4): for each Geisha, the player with the strictly higher pair total moves its marker to their side; on a tie the marker stays where it is (neutral, or on a side from pair 1). Charm is the sum of the Charm of the Geisha on your side; Geisha count is the number of markers on your side. If a player has {charm_to_win} or more Charm, they win. Otherwise, if a player has {geisha_to_win} or more Geisha, they win. Otherwise, after pair 1 the game continues with hand 3; after pair 2 the higher Charm wins, then the higher Geisha count, and if both are equal the game is a draw (a shared result)."
}
