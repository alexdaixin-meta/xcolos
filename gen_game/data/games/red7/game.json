      "to": "all",
      "text": "You start with:"
    }
  ],
  "steps": [
    {
      "use": "update",
      "phase": "new hand",
      "label": "a new hand",
      "when": {
        "calc": "hand_over"
      },
      "do": [
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "all_cards"
            }
          }
        },
        {
          "set": {
            "key": "set_aside",
            "value": {
              "calc": "[]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand",
            "value": {
              "calc": "[]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "palette",
            "value": {
              "calc": "[]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "alive",
            "value": true
          }
        },
        {
          "set": {
            "players": "all",
            "key": "elim_order",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "key_value",
            "value": 0
          }
        },
        {
          "set_status": {
            "players": "all",
            "to": "playing"
          }
        },
        {
          "set": {
            "key": "eliminated_count",
            "value": 0
          }
        },
        {
          "set": {
            "key": "alive_count",
            "value": {
              "calc": "len(players)"
            }
          }
        },
        {
          "set": {
            "key": "canvas",
            "value": {
              "calc": "rank_red"
            }
          }
        }
      ]
    },
    {
      "use": "repeat",
      "phase": "new hand",
      "label": "the deal",
      "when": {
        "calc": "hand_over"
      },
      "until": {
        "calc": "all([len(p.hand) >= hand_size and len(p.palette) >= palette_start_size for p in players])"
      },
      "max": 30,
      "steps": [
        {
          "use": "update",
          "label": "deal one card",
          "do": [
            {
              "set": {
                "key": "pick",
                "value": {
                  "calc": "deck[int(uniform(0, len(deck)))]"
                }
              }
            },
            {
              "set": {
                "key": "deal_seat",
                "value": {
                  "calc": "min([p.seat for p in players if len(p.hand) < hand_size] + [p.seat + 100 for p in players if len(p.palette) < palette_start_size])"
                }
              }
            },
            {
              "append": {
                "player": {
                  "calc": "deal_seat"
                },
                "key": "hand",
                "value": {
                  "calc": "pick"
                },
                "if": {
                  "calc": "deal_seat < 100"
                }
              }
            },
            {
              "append": {
                "player": {
                  "calc": "deal_seat - 100"
                },
                "key": "palette",
                "value": {
                  "calc": "pick"
                },
                "if": {
                  "calc": "deal_seat >= 100"
                }
              }
            },
            {
              "remove": {
                "key": "deck",
                "value": {
                  "calc": "pick"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "use": "update",
      "phase": "new hand",
      "label": "set aside and first leader",
      "when": {
        "calc": "hand_over"
      },
      "do": [
        {
          "set": {
            "key": "set_aside",
            "value": {
              "calc": "deck"
            }
          }
        },
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "[]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "key_value",
            "value": {
              "calc": "max([0] + you.palette)"
            }
          }
        },
        {
          "set": {
            "key": "leader_seat",
            "value": {
              "calc": "min([p.seat for p in players if max([0] + p.palette) == max([max([0] + q.palette) for q in players])])"
            }
          }
        },
        {
          "set": {
            "key": "turn_seat",
            "value": {
              "calc": "leader_seat + 1 if leader_seat < len(players) else 1"
            }
          }
        },
        {
          "set": {
            "key": "hand_over",
            "value": false
          }
        }
      ],
      "text": "A new hand is dealt: {hand_size} hidden cards each and one face-up palette card. The Canvas is Red (3). Seat {leader_seat} has the strongest palette card, so seat {turn_seat} plays first."
    },
    {
      "use": "update",
      "phase": "round",
      "label": "start of round",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "acted_this_round",
            "value": false
          }
        }
      ]
    },
    {
      "use": "sync",
      "phase": "round",
      "label": "where you stand",
      "mode": "self",
      "to": "all",
      "text": "Where you stand:"
    },
    {
      "use": "repeat",
      "phase": "turns",
      "label": "the turns",
      "until": {
        "calc": "hand_over or all([p.acted_this_round for p in players if p.alive])"
      },
      "max": 10,
      "steps": [
        {
          "use": "update",
          "label": "your options",
          "do": [
            {
              "set": {
                "players": {
                  "where": "you.seat == turn_seat"
                },
                "key": "offer",
                "value": {
                  "calc": "['play ' + card_names[c] for c in you.hand] + ['discard ' + card_names[c] for c in you.hand] + ['play ' + card_names[you.hand[x[0]]] + ' then discard ' + card_names[you.hand[x[1]]] for x in pair_index if x[0] < len(you.hand) and x[1] < len(you.hand)] + ['fold']"
                }
              }
            }
          ]
        },
        {
          "use": "ask",
          "label": "your turn",
          "to": {
            "where": "you.seat == turn_seat"
          },
          "answer": {
            "type": "choice",
            "options": {
              "attribute": "offer"
            }
          },
          "verify": {
            "bind": "act"
          },
          "text": "Your turn. The Canvas rule is {canvas} (3 = Red, 2 = Green, 1 = Violet). Play a card to your palette, discard a card to make its colour the rule, play then discard two different cards, or fold. If you are not strictly leading afterwards, or you fold, you are eliminated from this hand."
        },
        {
          "use": "update",
          "label": "resolve the turn",
          "do": [
            {
              "set": {
                "key": "last_action",
                "value": "$act"
              }
            },
            {
              "set": {
                "players": {
                  "where": "you.seat == turn_seat"
                },
                "key": "sel_play",
                "value": {
                  "calc": "max([0] + [c for c in you.hand if $act == 'play ' + card_names[c]] + [you.hand[x[0]] for x in pair_index if x[0] < len(you.hand) and x[1] < len(you.hand) and $act == 'play ' + card_names[you.hand[x[0]]] + ' then discard ' + card_names[you.hand[x[1]]]])"
                }
              }
            },
            {
              "set": {
                "players": {
                  "where": "you.seat == turn_seat"
                },
                "key": "sel_discard",
                "value": {
                  "calc": "max([0] + [c for c in you.hand if $act == 'discard ' + card_names[c]] + [you.hand[x[1]] for x in pair_index if x[0] < len(you.hand) and x[1] < len(you.hand) and $act == 'play ' + card_names[you.hand[x[0]]] + ' then discard ' + card_names[you.hand[x[1]]]])"
                }
              }
            },
            {
              "set": {
                "key": "play_card",
                "value": {
                  "calc": "max([0] + [p.sel_play for p in players if p.seat == turn_seat])"
                }
              }
            },
            {
              "set": {
                "key": "discard_card",
                "value": {
                  "calc": "max([0] + [p.sel_discard for p in players if p.seat == turn_seat])"
                }
              }
            },
            {
              "remove": {
                "player": {
                  "calc": "turn_seat"
                },
                "key": "hand",
                "value": {
                  "calc": "play_card"
                },
                "if": {
                  "calc": "play_card > 0"
                }
              }
            },
            {
              "append": {
                "player": {
                  "calc": "turn_seat"
                },
                "key": "palette",
                "value": {
                  "calc": "play_card"
                },
                "if": {
                  "calc": "play_card > 0"
                }
              }
            },
            {
              "remove": {
                "player": {
                  "calc": "turn_seat"
                },
                "key": "hand",
                "value": {
                  "calc": "discard_card"
                },
                "if": {
                  "calc": "discard_card > 0"
                }
              }
            },
            {
              "set": {
                "key": "canvas",
                "value": {
                  "calc": "discard_card - int(discard_card / strength_number_multiplier) * strength_number_multiplier"
                },
                "if": {
                  "calc": "discard_card > 0"
                }
              }
            },
            {
              "set": {
                "player": {
                  "calc": "turn_seat"
                },
                "key": "acted_this_round",
                "value": true
              }
            },
            {
              "set": {
                "players": {
                  "where": "you.alive"
                },
                "key": "key_value",
                "value": {
                  "calc": "max([0] + you.palette) if canvas == rank_red else ((key_count_multiplier * len([s for s in you.palette if int(s / strength_number_multiplier) in [even_number_1, even_number_2, even_number_3]]) + max([0] + [s for s in you.palette if int(s / strength_number_multiplier) in [even_number_1, even_number_2, even_number_3]])) if canvas == rank_green else (key_count_multiplier * len([s for s in you.palette if int(s / strength_number_multiplier) <= low_number_max]) + max([0] + [s for s in you.palette if int(s / strength_number_multiplier) <= low_number_max])))"
                }
              }
            },
            {
              "set": {
                "key": "actor_out",
                "value": {
                  "calc": "$act == 'fold' or max([0] + [p.key_value for p in players if p.seat == turn_seat]) <= max([0] + [p.key_value for p in players if p.alive and p.seat != turn_seat])"
                }
              }
            },
            {
              "adjust": {
                "key": "eliminated_count",
                "value": 1,
                "if": {
                  "calc": "actor_out"
                }
              }
            },
            {
              "adjust": {
                "key": "alive_count",
                "value": -1,
                "if": {
                  "calc": "actor_out"
                }
              }
            },
            {
              "set": {
                "player": {
                  "calc": "turn_seat"
                },
                "key": "alive",
                "value": false,
                "if": {
                  "calc": "actor_out"
                }
              }
            },
            {
              "set": {
                "player": {
                  "calc": "turn_seat"
                },
                "key": "elim_order",
                "value": {
                  "calc": "eliminated_count"
                },
                "if": {
                  "calc": "actor_out"
                }
              }
            },
            {
              "set_status": {
                "player": {
                  "calc": "turn_seat"
                },
                "to": "out",
                "if": {
                  "calc": "actor_out"
                },
                "text": "Seat {player} is not leading and is eliminated from this hand. Their palette stays on the table but no longer counts."
              }
            }
          ],
          "text": "Seat {turn_seat}: {last_action}. The Canvas is now {canvas} (3 = Red, 2 = Green, 1 = Violet)."
        },
        {
          "use": "update",
          "label": "the hand ends",
          "when": {
            "calc": "alive_count <= 1 and not hand_over"
          },
          "do": [
            {
              "set": {
                "key": "hand_winner",
                "value": {
                  "calc": "max([0] + [p.seat for p in players if p.alive])"
                }
              }
            },
            {
              "adjust": {
                "player": {
                  "calc": "hand_winner"
                },
                "key": "points",
                "value": {
                  "calc": "winner_points_2p if len(players) == 2 else winner_points_3p"
                },
                "if": {
                  "calc": "hand_winner > 0"
                }
              }
            },
            {
              "adjust": {
                "player": {
                  "calc": "max([0] + [p.seat for p in players if p.elim_order == 1])"
                },
                "key": "points",
                "value": {
                  "calc": "loser_points_2p"
                },
                "if": {
                  "calc": "len(players) == 2 and any([p.elim_order == 1 for p in players])"
                }
              }
            },
            {
              "adjust": {
                "player": {
                  "calc": "max([0] + [p.seat for p in players if p.elim_order == 2])"
                },
                "key": "points",
                "value": {
                  "calc": "second_points_3p"
                },
                "if": {
                  "calc": "len(players) == 3 and any([p.elim_order == 2 for p in players])"
                }
              }
            },
            {
              "adjust": {
                "player": {
                  "calc": "max([0] + [p.seat for p in players if p.elim_order == 1])"
                },
                "key": "points",
                "value": {
                  "calc": "first_out_points_3p"
                },
                "if": {
                  "calc": "len(players) == 3 and any([p.elim_order == 1 for p in players])"
                }
              }
            },
            {
              "set": {
                "players": "all",
                "key": "is_recent_winner",
                "value": {
                  "calc": "1 if you.seat == hand_winner else 0"
                }
              }
            },
            {
              "set": {
                "key": "most_recent_winner",
                "value": {
                  "calc": "hand_winner"
                }
              }
            },
            {
              "set": {
                "key": "hand_over",
                "value": true
              }
            }
          ],
          "text": "The hand is over. Seat {hand_winner} is the last player alive and wins the hand. Points [seat, points]: {[[p.seat, p.points] for p in players]}."
        },
        {
          "use": "update",
          "label": "pass the turn",
          "when": {
            "calc": "not hand_over"
          },
          "do": [
            {
              "set": {
                "key": "turn_seat",
                "value": {
                  "calc": "min([p.seat for p in players if p.alive and p.seat > turn_seat]) if len([p.seat for p in players if p.alive and p.seat > turn_seat]) > 0 else min([p.seat for p in players if p.alive])"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "use": "update",
      "phase": "round",
      "label": "end of round",
      "do": [
        {
          "adjust": {
            "key": "round_no",
            "value": 1
          }
        }
      ]
    },
    {
      "use": "check",
      "phase": "round",
      "label": "is the match over",
      "when": {
        "calc": "(len(players) == 2 and max([p.points for p in players]) >= target_points_2p) or (len(players) == 3 and hand_over and max([p.points for p in players]) >= target_points_3p) or round_no >= round_cap"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "(len(players) == 2 and max([p.points for p in players]) >= target_points_2p) or (len(players) == 3 and hand_over and max([p.points for p in players]) >= target_points_3p) or round_no >= round_cap"
      },
      "rank_by": "you.points * 10 + you.is_recent_winner",
      "min_to_win": 1,
      "text": "Winner: {result}. Final points [seat, points]: {[[p.seat, p.points] for p in players]}; most recent hand winner: seat {most_recent_winner}."
    }
  },
  "limits": {
    "rounds": 40,
    "rounds_max": 40,
    "actions_max": 2000,
    "deadline_s": 120
  },
  "rules": "CARDS. There are {deck_size} cards: numbers {card_numbers_min} to {card_numbers_max} in each of {colours} colours, Red, Green and Violet. Colour rank is Red {rank_red}, Green {rank_green}, Violet {rank_violet}. A card's strength is number x {strength_number_multiplier} + colour rank (7 Red = 73, 4 Violet = 41). Higher strength beats lower. A card is EVEN if its number is {even_number_1}, {even_number_2} or {even_number_3}. A card is LOW if its number is {low_number_max} or less.\n\nTHE RULE. The Canvas shows one colour, which is the current rule (canvas 3 = Red, 2 = Green, 1 = Violet). Each living player has a KEY under the current rule:\n- Red: key = strength of the highest card in your palette.\n- Green: key = {key_count_multiplier} x (number of even cards in your palette) + strength of your highest even card, or 0 if you have no even card.\n- Violet: key = {key_count_multiplier} x (number of low cards in your palette) + strength of your highest low card, or 0 if you have no low card.\nYou are LEADING if your key is strictly higher than every other living player's key. If keys tie, including at 0, no tied player is leading.\n\nSETUP OF A HAND. Shuffle all {deck_size} cards. Deal each player {hand_size} cards as a hidden hand, then {palette_start_size} card face up as their palette. The remaining cards ({set_aside_2p} with 2 players, {set_aside_3p} with 3 players) are set aside unseen for this hand. The Canvas starts as Red. Everyone is alive. The initial leader is the player whose palette card has the highest strength. The first turn of the hand goes to the next player in seat order after that leader.\n\nA TURN. On your turn choose exactly one:\n(a) play one card from your hand face up to your palette;\n(b) discard one card from your hand to the Canvas, so the rule becomes that card's colour and the card leaves play;\n(c) do (a), then (b), with two different cards;\n(d) fold.\nThen keys are recomputed under the current rule. If you are leading, you stay alive and play goes on. If you are not leading, or you folded, you are eliminated from the hand: your palette stays visible but no longer counts. If you have no cards left in hand when your turn comes, you can only fold. Play passes to the next living player in seat order.\n\nA ROUND is one pass of turns through all living players in seat order, starting with the player whose turn it is.\n\nEND OF A HAND. A hand ends the moment only one player is alive. That player is the hand winner and becomes the most recent hand winner.\n- With 2 players: the hand winner scores {winner_points_2p} point; the other scores {loser_points_2p}.\n- With 3 players: the hand winner scores {winner_points_3p} points; the player whose elimination left one survivor scores {second_points_3p}; the first player eliminated scores {first_out_points_3p}.\nIf the match is not over, a new hand is set up at the start of the next round.\n\nEND OF THE MATCH.\n- With 2 players, the match ends when a player reaches {target_points_2p} points.\n- With 3 players, the match ends after any hand in which a player reaches {target_points_3p} or more points.\n- In either case, it also ends when round {round_cap} is complete; an unfinished hand then scores nothing.\n\nINFORMATION. Palettes, the Canvas, eliminations, points and the most recent hand winner are public. Hands and set-aside cards are hidden. There is no table talk.\n\nWINNING. The player with the most points when the match ends wins. If two or more players share the most points, the tied player who won the most recently completed hand wins. If no hand was completed at all, the match is a draw with no winner."
}
