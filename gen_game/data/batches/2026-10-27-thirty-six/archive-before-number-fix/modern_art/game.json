{
  "schema": 1,
  "meta": {
    "id": "modern_art",
    "name": "Modern Art: Sealed Gallery",
    "players": {
      "min": 3,
      "max": 3,
      "suggested": 3
    },
    "blurb": "Three dealers auction 18 paintings by three artists in sealed bids. Artists gain value at each season's end, and the richest dealer wins."
  },
