        "initial": 1
      }
    ]
  },
  "setup": [
    {
      "use": "update",
      "label": "starting state",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "money",
            "value": {
              "calc": "starting_money"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand_red",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand_blue",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand_green",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "owned_red",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "owned_blue",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "owned_green",
            "value": 0
          }
        },
        {
          "set": {
            "key": "season_red",
            "value": 0
          }
        },
        {
          "set": {
            "key": "season_blue",
            "value": 0
          }
        },
        {
          "set": {
            "key": "season_green",
            "value": 0
          }
        },
        {
          "set": {
            "key": "value_red",
            "value": 0
          }
        },
        {
          "set": {
            "key": "value_blue",
            "value": 0
          }
        },
        {
          "set": {
            "key": "value_green",
            "value": 0
          }
        },
        {
          "set": {
            "key": "seasons_done",
            "value": 0
          }
        },
        {
          "set": {
            "key": "auctioneer",
            "value": {
              "calc": "first_auctioneer_seat"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "draw the deal roll",
      "do": [
        {
          "set": {
            "key": "deal_roll",
            "value": {
              "calc": "min(deal_roll_max, max(deal_roll_min, int(uniform(deal_roll_min, deal_roll_max + 1))))"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "deal the compositions",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "composition",
            "value": {
              "calc": "[['A', 'B', 'C'], ['A', 'C', 'B'], ['B', 'A', 'C'], ['B', 'C', 'A'], ['C', 'A', 'B'], ['C', 'B', 'A']][deal_roll - 1][you.seat - 1]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand_red",
            "value": {
              "calc": "composition_A_red if you.composition == 'A' else (composition_B_red if you.composition == 'B' else composition_C_red)"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand_blue",
            "value": {
              "calc": "composition_A_blue if you.composition == 'A' else (composition_B_blue if you.composition == 'B' else composition_C_blue)"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand_green",
            "value": {
              "calc": "composition_A_green if you.composition == 'A' else (composition_B_green if you.composition == 'B' else composition_C_green)"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "label": "the compositions",
      "to": "all",
      "text": "Three hand compositions of {hand_size} cards exist: A is Red {composition_A_red}, Blue {composition_A_blue}, Green {composition_A_green}; B is Red {composition_B_red}, Blue {composition_B_blue}, Green {composition_B_green}; C is Red {composition_C_red}, Blue {composition_C_blue}, Green {composition_C_green}. Each seat holds a different one."
    },
    {
      "use": "tell",
      "label": "your hand",
      "to": "all",
      "text": "Your hand (only you see it): Red {hand_red}, Blue {hand_blue}, Green {hand_green}."
    }
  ],
  "steps": [
    {
      "use": "tell",
      "phase": "play",
      "label": "where you stand",
      "to": "all",
      "text": "Your hand: Red {hand_red}, Blue {hand_blue}, Green {hand_green}. Money: seat 1 {players[0].money}, seat 2 {players[1].money}, seat 3 {players[2].money}. Owned this season (Red/Blue/Green): seat 1 {players[0].owned_red}/{players[0].owned_blue}/{players[0].owned_green}, seat 2 {players[1].owned_red}/{players[1].owned_blue}/{players[1].owned_green}, seat 3 {players[2].owned_red}/{players[2].owned_blue}/{players[2].owned_green}. Season counts: Red {season_red}, Blue {season_blue}, Green {season_green}. Values: Red {value_red}, Blue {value_blue}, Green {value_green}. Seasons done: {seasons_done}. Auctioneer: seat {auctioneer}."
    },
    {
      "use": "update",
      "phase": "play",
      "label": "build the card offer",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "offer",
            "value": {
              "calc": "(['Red'] if you.hand_red > 0 else []) + (['Blue'] if you.hand_blue > 0 else []) + (['Green'] if you.hand_green > 0 else [])"
            }
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "play",
      "label": "choose a card",
      "to": {
        "where": "you.seat == auctioneer"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "chosen"
      },
      "text": "You are the auctioneer. Choose one artist from your hand to put up for auction."
    },
    {
      "use": "update",
      "phase": "play",
      "label": "reveal the card",
      "do": [
        {
          "set": {
            "key": "current_artist",
            "value": "$chosen"
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "auctioneer"
            },
            "key": "hand_red",
            "value": -1,
            "if": {
              "calc": "current_artist == 'Red'"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "auctioneer"
            },
            "key": "hand_blue",
            "value": -1,
            "if": {
              "calc": "current_artist == 'Blue'"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "auctioneer"
            },
            "key": "hand_green",
            "value": -1,
            "if": {
              "calc": "current_artist == 'Green'"
            }
          }
        },
        {
          "adjust": {
            "key": "season_red",
            "value": 1,
            "if": {
              "calc": "current_artist == 'Red'"
            }
          }
        },
        {
          "adjust": {
            "key": "season_blue",
            "value": 1,
            "if": {
              "calc": "current_artist == 'Blue'"
            }
          }
        },
        {
          "adjust": {
            "key": "season_green",
            "value": 1,
            "if": {
              "calc": "current_artist == 'Green'"
            }
          }
        },
        {
          "set": {
            "key": "season_ended",
            "value": {
              "calc": "(season_red if current_artist == 'Red' else (season_blue if current_artist == 'Blue' else season_green)) == season_ending_count"
            }
          }
        },
        {
          "set": {
            "key": "winner_seat",
            "value": 0
          }
        },
        {
          "set": {
            "key": "price",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "message",
            "value": ""
          }
        }
      ],
      "text": "Seat {auctioneer} plays {current_artist}."
    },
    {
      "use": "tell",
      "phase": "play",
      "label": "season-ending card",
      "when": {
        "calc": "season_ended"
      },
      "to": "all",
      "text": "That is {current_artist}'s card number {season_ending_count} this season: it is discarded unsold and the season ends."
    },
    {
      "use": "poll",
      "phase": "talk",
      "label": "talk",
      "when": {
        "calc": "not season_ended"
      },
      "to": "acting",
      "answer": {
        "type": "text",
        "max_words": 30
      },
      "store": "message",
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} says: {value}"
      },
      "text": "A {current_artist} painting is up for auction. Write one short message to the table. Nothing said is binding."
    },
    {
      "use": "poll",
      "phase": "auction",
      "label": "sealed bids",
      "when": {
        "calc": "not season_ended"
      },
      "to": "acting",
      "answer": {
        "type": "number",
        "min": {
          "calc": "min_bid"
        },
        "max": {
          "calc": "you.money"
        }
      },
      "store": "bid",
      "text": "Submit a sealed bid for the {current_artist} painting: a whole number from {min_bid} up to your money. Seat {auctioneer} is the auctioneer and bids too."
    },
    {
      "use": "update",
      "phase": "auction",
      "label": "settle the auction",
      "when": {
        "calc": "not season_ended"
      },
      "do": [
        {
          "set": {
            "key": "last_bids",
            "value": {
              "calc": "[p.bid for p in players]"
            }
          }
        },
        {
          "set": {
            "key": "winner_seat",
            "value": {
              "calc": "auctioneer if max([p.bid for p in players]) == 0 else [p.seat for p in players if p.bid * 3 + (0 if p.seat == auctioneer else (2 if p.seat - auctioneer in [1, -2] else 1)) == max([q.bid * 3 + (0 if q.seat == auctioneer else (2 if q.seat - auctioneer in [1, -2] else 1)) for q in players])][0]"
            }
          }
        },
        {
          "set": {
            "key": "price",
            "value": {
              "calc": "sum([p.bid for p in players if p.seat == winner_seat])"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "winner_seat"
            },
            "key": "money",
            "value": {
              "calc": "-price"
            },
            "if": {
              "calc": "price > 0"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "auctioneer"
            },
            "key": "money",
            "value": {
              "calc": "price"
            },
            "if": {
              "calc": "price > 0 and winner_seat != auctioneer"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "winner_seat"
            },
            "key": "owned_red",
            "value": 1,
            "if": {
              "calc": "current_artist == 'Red'"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "winner_seat"
            },
            "key": "owned_blue",
            "value": 1,
            "if": {
              "calc": "current_artist == 'Blue'"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "winner_seat"
            },
            "key": "owned_green",
            "value": 1,
            "if": {
              "calc": "current_artist == 'Green'"
            }
          }
        }
      ],
      "text": "Bids for {current_artist} (seats 1, 2, 3): {last_bids}. Seat {winner_seat} wins the painting at price {price}."
    },
    {
      "use": "update",
      "phase": "scoring",
      "label": "is it scoring time",
      "do": [
        {
          "set": {
            "key": "scoring_now",
            "value": {
              "calc": "season_ended or (sum([p.hand_red + p.hand_blue + p.hand_green for p in players]) == 0 and season_red + season_blue + season_green > 0)"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "scoring",
      "label": "season scoring",
      "when": {
        "calc": "scoring_now"
      },
      "do": [
        {
          "set": {
            "key": "first_artist",
            "value": {
              "calc": "'Red' if (season_red >= season_blue and season_red >= season_green) else ('Blue' if season_blue >= season_green else 'Green')"
            }
          }
        },
        {
          "set": {
            "key": "second_artist",
            "value": {
              "calc": "('Blue' if season_blue >= season_green else 'Green') if first_artist == 'Red' else (('Red' if season_red >= season_green else 'Green') if first_artist == 'Blue' else ('Red' if season_red >= season_blue else 'Blue'))"
            }
          }
        },
        {
          "set": {
            "key": "second_artist",
            "value": "",
            "if": {
              "calc": "(second_artist == 'Red' and season_red == 0) or (second_artist == 'Blue' and season_blue == 0) or (second_artist == 'Green' and season_green == 0)"
            }
          }
        },
        {
          "adjust": {
            "key": "value_red",
            "value": {
              "calc": "first_place_bonus"
            },
            "if": {
              "calc": "first_artist == 'Red'"
            }
          }
        },
        {
          "adjust": {
            "key": "value_blue",
            "value": {
              "calc": "first_place_bonus"
            },
            "if": {
              "calc": "first_artist == 'Blue'"
            }
          }
        },
        {
          "adjust": {
            "key": "value_green",
            "value": {
              "calc": "first_place_bonus"
            },
            "if": {
              "calc": "first_artist == 'Green'"
            }
          }
        },
        {
          "adjust": {
            "key": "value_red",
            "value": {
              "calc": "second_place_bonus"
            },
            "if": {
              "calc": "second_artist == 'Red'"
            }
          }
        },
        {
          "adjust": {
            "key": "value_blue",
            "value": {
              "calc": "second_place_bonus"
            },
            "if": {
              "calc": "second_artist == 'Blue'"
            }
          }
        },
        {
          "adjust": {
            "key": "value_green",
            "value": {
              "calc": "second_place_bonus"
            },
            "if": {
              "calc": "second_artist == 'Green'"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "payout",
            "value": {
              "calc": "(you.owned_red * value_red if first_artist == 'Red' or second_artist == 'Red' else 0) + (you.owned_blue * value_blue if first_artist == 'Blue' or second_artist == 'Blue' else 0) + (you.owned_green * value_green if first_artist == 'Green' or second_artist == 'Green' else 0)"
            }
          }
        },
        {
          "adjust": {
            "players": "all",
            "key": "money",
            "value": {
              "calc": "you.payout"
            }
          }
        },
        {
          "set": {
            "key": "last_payouts",
            "value": {
              "calc": "[p.payout for p in players]"
            }
          }
        }
      ],
      "text": "Season scoring. First: {first_artist}. Second: {second_artist} (blank means no second place). Values now Red {value_red}, Blue {value_blue}, Green {value_green}. Payouts (seats 1, 2, 3): {last_payouts}."
    },
    {
      "use": "update",
      "phase": "scoring",
      "label": "close the season",
      "when": {
        "calc": "scoring_now"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "owned_red",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "owned_blue",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "owned_green",
            "value": 0
          }
        },
        {
          "set": {
            "key": "season_red",
            "value": 0
          }
        },
        {
          "set": {
            "key": "season_blue",
            "value": 0
          }
        },
        {
          "set": {
            "key": "season_green",
            "value": 0
          }
        },
        {
          "adjust": {
            "key": "seasons_done",
            "value": 1
          }
        }
      ],
      "text": "The season is over. Seasons done: {seasons_done} of {seasons_to_end}."
    },
    {
      "use": "update",
      "phase": "pass",
      "label": "pass the auctioneer role",
      "do": [
        {
          "set": {
            "key": "auctioneer",
            "value": {
              "calc": "([s for s in [[2, 3, 1], [3, 1, 2], [1, 2, 3]][auctioneer - 1] if sum([p.hand_red + p.hand_blue + p.hand_green for p in players if p.seat == s]) > 0] + [auctioneer])[0]"
            }
          }
        }
      ],
      "text": "Seat {auctioneer} is now the auctioneer."
    },
    {
      "use": "check",
      "phase": "pass",
      "label": "is the game over",
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "seasons_done >= seasons_to_end or sum([p.hand_red + p.hand_blue + p.hand_green for p in players]) == 0"
      },
      "rank_by": "you.money",
      "text": "Winner: {result}. Final money: Seat 1 {players[0].money}, Seat 2 {players[1].money}, Seat 3 {players[2].money}."
    }
  },
  "limits": {
    "rounds": 21,
    "rounds_max": 21,
    "actions_max": 1000,
    "deadline_s": 120
  },
  "rules": "Three players (seats 1, 2 and 3) deal paintings by three artists: Red, Blue and Green. Everyone starts with {starting_money} money; money is public at all times.\n\nHands: there are three hand compositions of {hand_size} cards. A is Red {composition_A_red}, Blue {composition_A_blue}, Green {composition_A_green}. B is Red {composition_B_red}, Blue {composition_B_blue}, Green {composition_B_green}. C is Red {composition_C_red}, Blue {composition_C_blue}, Green {composition_C_green}. At setup a random number from {deal_roll_min} to {deal_roll_max} gives each seat a different composition. You see only your own hand counts. This is the only random event in the game.\n\nEach round: (1) The auctioneer (seat {first_auctioneer_seat} first) chooses one artist they still hold a card of. (2) The card is revealed to everyone as the current artist; the auctioneer's hand count for it falls by 1 and that artist's season count rises by 1. (3) If that season count is now {season_ending_count}, the card is discarded unsold: no talk, no bidding, no money moves, and the season is scored. (4) Otherwise all three players each write one short message at the same moment; all messages are then shown to everyone. Talk is not binding. (5) Then all three players, the auctioneer included, submit at the same moment a sealed whole-number bid from {min_bid} up to their current money. The highest bid wins. If bids tie for highest, the tied player first in seat order starting from the seat after the auctioneer wins, with the auctioneer last. If every bid is 0, the auctioneer wins at price 0. (6) If the winner is not the auctioneer, the winner pays their bid to the auctioneer. If the winner is the auctioneer, they pay their bid to the bank (nothing if it is 0). In every case the winner's owned count of that artist rises by 1; paintings the auctioneer keeps score like any other. All three bids, the winner and the price are announced. Owned counts are public.\n\nSeason scoring happens when the season-ending card was just played, or when all hands are empty and at least one season count is above 0. First place is the artist with the highest season count (ties broken Red, then Blue, then Green); its cumulative value rises by {first_place_bonus}. Second place is the best of the other two by season count (same tie order), only if its season count is above 0; its value rises by {second_place_bonus}. The third artist, and any artist with season count 0, does not place. Each player receives from the bank, for each placed artist, their owned count times that artist's cumulative value. Unplaced artists pay 0, even if their value is above 0 from earlier seasons. Then all owned counts and season counts reset to 0 and one more season is done.\n\nAfter each round the auctioneer role passes to the next seat (1 to 2, 2 to 3, 3 to 1), skipping any seat whose hand is empty.\n\nThe game ends when {seasons_to_end} seasons are done, or when all hands are empty (after any unfinished season is scored); at most {max_rounds} rounds. The player with the most money wins; players tied for the most money share the result (a draw)."
}
