  "setup": [
    {
      "use": "update",
      "label": "shuffle the deck",
      "do": [
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "[pair[1] for pair in sorted([[uniform(0, 1), c] for c in deck])]"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "the scribes",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "gold",
            "value": {
              "calc": "starting_gold"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "red",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "blue",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "green",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bought",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "church_pending",
            "value": false
          }
        },
        {
          "set": {
            "players": "all",
            "key": "church_choice",
            "value": "none"
          }
        },
        {
          "set": {
            "players": "all",
            "key": "message",
            "value": ""
          }
        },
        {
          "set": {
            "players": "all",
            "key": "vp",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "the table",
      "do": [
        {
          "set": {
            "key": "vp_red",
            "value": {
              "calc": "starting_colour_vp"
            }
          }
        },
        {
          "set": {
            "key": "vp_blue",
            "value": {
              "calc": "starting_colour_vp"
            }
          }
        },
        {
          "set": {
            "key": "vp_green",
            "value": {
              "calc": "starting_colour_vp"
            }
          }
        },
        {
          "set": {
            "key": "round",
            "value": 0
          }
        },
        {
          "set": {
            "key": "lot",
            "value": "none"
          }
        },
        {
          "set": {
            "key": "drawn",
            "value": []
          }
        }
      ]
    },
    {
      "use": "sync",
      "label": "your starting state",
      "mode": "self",
      "to": "all",
      "fields": [
        "gold",
        "red",
        "blue",
        "green",
        "vp"
      ],
      "text": "You start with:"
    }
  ],
  "steps": [
    {
      "use": "update",
      "phase": "draw",
      "label": "a new round",
      "do": [
        {
          "adjust": {
            "key": "round",
            "value": 1
          }
        },
        {
          "set": {
            "key": "active_seat",
            "value": {
              "calc": "(round - 1) % 3 + 1"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "message",
            "value": ""
          }
        }
      ],
      "text": "Round {round} of {rounds}: seat {active_seat} is the active seat."
    },
    {
      "use": "update",
      "phase": "draw",
      "label": "draw two cards",
      "do": [
        {
          "set": {
            "key": "drawn",
            "value": {
              "calc": "[deck[0], deck[1]]"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "deck[0]"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "deck[0]"
            }
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "draw",
      "label": "keep a card",
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "choice",
        "options": {
          "game": "drawn"
        }
      },
      "verify": {
        "bind": "keep_choice"
      },
      "each": {
        "do": [
          {
            "set": {
              "key": "kept",
              "value": "$answer"
            }
          },
          {
            "append": {
              "player": "$seat",
              "key": "hand",
              "value": {
                "calc": "kept"
              }
            }
          },
          {
            "adjust": {
              "player": "$seat",
              "key": "red",
              "value": {
                "calc": "int(kept[-1]) if kept[0] == 'r' else 0"
              },
              "if": {
                "calc": "kept[0] == 'r'"
              }
            }
          },
          {
            "adjust": {
              "player": "$seat",
              "key": "blue",
              "value": {
                "calc": "int(kept[-1]) if kept[0] == 'b' else 0"
              },
              "if": {
                "calc": "kept[0] == 'b'"
              }
            }
          },
          {
            "adjust": {
              "player": "$seat",
              "key": "green",
              "value": {
                "calc": "int(kept[-1]) if (kept[0] == 'g' and kept[1] == 'r') else 0"
              },
              "if": {
                "calc": "kept[0] == 'g' and kept[1] == 'r'"
              }
            }
          },
          {
            "adjust": {
              "player": "$seat",
              "key": "gold",
              "value": {
                "calc": "int(kept[-1]) if (kept[0] == 'g' and kept[1] == 'o') else 0"
              },
              "if": {
                "calc": "kept[0] == 'g' and kept[1] == 'o'"
              }
            }
          },
          {
            "set": {
              "player": "$seat",
              "key": "church_pending",
              "value": true,
              "if": {
                "calc": "kept == 'church'"
              }
            }
          }
        ]
      },
      "text": "You are the active seat. The options are the two cards you drew, seen only by you. Keep one in your private hand (never announced); the other becomes the lot that the other two seats bid on."
    },
    {
      "use": "update",
      "phase": "draw",
      "label": "the lot",
      "do": [
        {
          "set": {
            "key": "lot",
            "value": {
              "calc": "drawn[1] if kept == drawn[0] else drawn[0]"
            }
          }
        },
        {
          "set": {
            "key": "drawn",
            "value": []
          }
        }
      ],
      "text": "Seat {active_seat} has kept one card. The lot up for auction is {lot}."
    },
    {
      "use": "poll",
      "phase": "talk",
      "label": "talk",
      "to": "acting",
      "answer": {
        "type": "text",
        "max_words": 40
      },
      "store": "message",
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} says: {value}"
      },
      "text": "Write one short message to the table. Everyone writes at the same moment and all messages are then shown with who wrote them. Nothing said is binding: propose prices, alliances or Church moves, bluff, or say nothing useful."
    },
    {
      "use": "poll",
      "phase": "auction",
      "label": "bid on the lot",
      "to": {
        "where": "you.seat != active_seat"
      },
      "answer": {
        "type": "number",
        "min": 0,
        "max": {
          "calc": "you.gold"
        }
      },
      "store": "bid",
      "text": "Secretly bid a whole number from 0 up to your gold for the lot {lot}. If one bid is strictly greater than the other and at least {min_winning_bid}, that bidder pays it to the active seat {active_seat} and takes the lot. If the bids are equal (including 0 and 0), nobody pays and the lot is discarded."
    },
    {
      "use": "update",
      "phase": "auction",
      "label": "settle the auction",
      "do": [
        {
          "set": {
            "key": "last_lot",
            "value": {
              "calc": "lot"
            }
          }
        },
        {
          "set": {
            "key": "last_bids",
            "value": {
              "calc": "[[p.seat, p.bid] for p in players if p.seat != active_seat]"
            }
          }
        },
        {
          "set": {
            "key": "last_price",
            "value": {
              "calc": "max([p.bid for p in players if p.seat != active_seat])"
            }
          }
        },
        {
          "set": {
            "key": "last_winner",
            "value": {
              "calc": "sum([p.seat for p in players if p.seat != active_seat and p.bid == last_price]) if (count(p.seat != active_seat and p.bid == last_price for p in players) == 1 and last_price >= min_winning_bid) else 0"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "last_winner"
            },
            "key": "gold",
            "value": {
              "calc": "-last_price"
            },
            "if": {
              "calc": "last_winner > 0"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "active_seat"
            },
            "key": "gold",
            "value": {
              "calc": "last_price"
            },
            "if": {
              "calc": "last_winner > 0"
            }
          }
        },
        {
          "append": {
            "player": {
              "calc": "last_winner"
            },
            "key": "bought",
            "value": {
              "calc": "last_lot"
            },
            "if": {
              "calc": "last_winner > 0"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "last_winner"
            },
            "key": "red",
            "value": {
              "calc": "int(last_lot[-1]) if last_lot[0] == 'r' else 0"
            },
            "if": {
              "calc": "last_winner > 0 and last_lot[0] == 'r'"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "last_winner"
            },
            "key": "blue",
            "value": {
              "calc": "int(last_lot[-1]) if last_lot[0] == 'b' else 0"
            },
            "if": {
              "calc": "last_winner > 0 and last_lot[0] == 'b'"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "last_winner"
            },
            "key": "green",
            "value": {
              "calc": "int(last_lot[-1]) if (last_lot[0] == 'g' and last_lot[1] == 'r') else 0"
            },
            "if": {
              "calc": "last_winner > 0 and last_lot[0] == 'g' and last_lot[1] == 'r'"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "last_winner"
            },
            "key": "gold",
            "value": {
              "calc": "int(last_lot[-1]) if (last_lot[0] == 'g' and last_lot[1] == 'o') else 0"
            },
            "if": {
              "calc": "last_winner > 0 and last_lot[0] == 'g' and last_lot[1] == 'o'"
            }
          }
        },
        {
          "set": {
            "player": {
              "calc": "last_winner"
            },
            "key": "church_pending",
            "value": true,
            "if": {
              "calc": "last_winner > 0 and last_lot == 'church'"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": 0
          }
        },
        {
          "set": {
            "key": "lot",
            "value": "none"
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "auction",
      "label": "the lot is sold",
      "when": {
        "calc": "last_winner > 0"
      },
      "to": "all",
      "text": "Bids [seat, bid]: {last_bids}. Seat {last_winner} wins {last_lot} for {last_price}, paid to seat {active_seat}."
    },
    {
      "use": "tell",
      "phase": "auction",
      "label": "the lot is discarded",
      "when": {
        "calc": "last_winner == 0"
      },
      "to": "all",
      "text": "Bids [seat, bid]: {last_bids}. No bid is strictly higher and at least {min_winning_bid}: nobody pays and {last_lot} is discarded."
    },
    {
      "use": "poll",
      "phase": "church",
      "label": "church choice",
      "when": {
        "calc": "count(p.church_pending for p in players) > 0"
      },
      "to": {
        "where": "you.church_pending"
      },
      "answer": {
        "type": "choice",
        "options": [
          "red up",
          "red down",
          "blue up",
          "blue down",
          "green up",
          "green down"
        ]
      },
      "store": "church_choice",
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} makes the Church choice: {value}."
      },
      "text": "You gained a Church card this round. Choose one colour to move up or down by 1. All choices this round are combined (ups minus downs) and each colour value is then kept between {vp_min} and {vp_max}."
    },
    {
      "use": "update",
      "phase": "church",
      "label": "the church resolves",
      "do": [
        {
          "set": {
            "key": "vp_red",
            "value": {
              "calc": "min(vp_max, max(vp_min, vp_red + count(p.church_choice == 'red up' for p in players) - count(p.church_choice == 'red down' for p in players)))"
            }
          }
        },
        {
          "set": {
            "key": "vp_blue",
            "value": {
              "calc": "min(vp_max, max(vp_min, vp_blue + count(p.church_choice == 'blue up' for p in players) - count(p.church_choice == 'blue down' for p in players)))"
            }
          }
        },
        {
          "set": {
            "key": "vp_green",
            "value": {
              "calc": "min(vp_max, max(vp_min, vp_green + count(p.church_choice == 'green up' for p in players) - count(p.church_choice == 'green down' for p in players)))"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "church_pending",
            "value": false
          }
        },
        {
          "set": {
            "players": "all",
            "key": "church_choice",
            "value": "none"
          }
        }
      ],
      "text": "Colour values: red {vp_red}, blue {vp_blue}, green {vp_green}."
    },
    {
      "use": "update",
      "phase": "scoring",
      "label": "colour scoring",
      "when": {
        "calc": "round >= rounds"
      },
      "do": [
        {
          "adjust": {
            "players": {
              "where": "you.red > max([p.red for p in players if p.seat != you.seat])"
            },
            "key": "vp",
            "value": {
              "calc": "vp_red"
            },
            "text": "Seat {player} has the most red and scores {vp_red}."
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.blue > max([p.blue for p in players if p.seat != you.seat])"
            },
            "key": "vp",
            "value": {
              "calc": "vp_blue"
            },
            "text": "Seat {player} has the most blue and scores {vp_blue}."
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.green > max([p.green for p in players if p.seat != you.seat])"
            },
            "key": "vp",
            "value": {
              "calc": "vp_green"
            },
            "text": "Seat {player} has the most green and scores {vp_green}."
          }
        }
      ],
      "text": "The deck is empty. Hands, colour totals and gold are revealed and each colour is scored."
    },
    {
      "use": "sync",
      "phase": "scoring",
      "label": "your state",
      "mode": "self",
      "to": "all",
      "fields": [
        "gold",
        "red",
        "blue",
        "green",
        "vp",
        "hand",
