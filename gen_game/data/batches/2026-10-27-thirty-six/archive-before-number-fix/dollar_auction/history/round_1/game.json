  "steps": [
    {
      "use": "update",
      "phase": "open",
      "label": "the next auction",
      "do": [
        {
          "adjust": {
            "key": "auction",
            "value": 1
          }
        },
        {
          "set": {
            "key": "auction_winner",
            "value": "none"
          }
        },
        {
          "set": {
            "players": "all",
            "key": "committed",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "stage_raise",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "open",
      "label": "auction announced",
      "to": "all",
      "text": "Auction {auction} of {auctions} begins."
    },
    {
      "use": "sync",
      "phase": "open",
      "label": "your standing",
      "mode": "self",
      "to": "all",
      "fields": [
        "coins",
        "committed",
        "values"
      ],
      "text": "Your state for auction {auction} (your value for this auction is entry {auction} of your values list):"
    },
    {
      "use": "poll",
      "phase": "talk",
      "label": "talk",
      "to": "acting",
      "answer": {
        "type": "text",
        "max_words": 40
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} says: {value}"
      },
      "text": "Write one short message to the table for auction {auction}. It is not binding: claim values, propose who takes which auction, or bluff."
    },
    {
      "use": "poll",
      "phase": "raise",
      "label": "raise stage 1",
      "to": {
        "where": "you.coins - you.committed > 0"
      },
      "answer": {
        "type": "number",
        "min": 0,
        "max": {
          "calc": "you.coins - you.committed"
        }
      },
      "store": "stage_raise",
      "text": "Auction {auction}, raise stage 1 of {raise_stages}: secretly choose a raise, a whole number from 0 up to your coins minus what you have already committed this auction. Every committed coin is paid whether or not you win."
    },
    {
      "use": "update",
      "phase": "raise",
      "label": "stage 1 commits",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "raise",
            "value": {
              "calc": "you.stage_raise"
            }
          }
        },
        {
          "adjust": {
            "players": "all",
            "key": "committed",
            "value": {
              "calc": "you.stage_raise"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "stage_raise",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "raise",
      "label": "bids after stage 1",
      "to": "all",
      "text": "Committed bids after stage 1 [seat, committed]: {[[p.seat, p.committed] for p in players]}."
    },
    {
      "use": "poll",
      "phase": "raise",
      "label": "raise stage 2",
      "to": {
        "where": "you.coins - you.committed > 0"
      },
      "answer": {
        "type": "number",
        "min": 0,
        "max": {
          "calc": "you.coins - you.committed"
        }
      },
      "store": "stage_raise",
      "text": "Auction {auction}, raise stage 2 of {raise_stages}: secretly choose a raise, a whole number from 0 up to your coins minus what you have already committed this auction. Every committed coin is paid whether or not you win."
    },
    {
      "use": "update",
      "phase": "raise",
      "label": "stage 2 commits",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "raise",
            "value": {
              "calc": "you.stage_raise"
            }
          }
        },
        {
          "adjust": {
            "players": "all",
            "key": "committed",
            "value": {
              "calc": "you.stage_raise"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "stage_raise",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "raise",
      "label": "bids after stage 2",
      "to": "all",
      "text": "Committed bids after stage 2 [seat, committed]: {[[p.seat, p.committed] for p in players]}."
    },
    {
      "use": "poll",
      "phase": "raise",
      "label": "raise stage 3",
      "to": {
        "where": "you.coins - you.committed > 0"
      },
      "answer": {
        "type": "number",
        "min": 0,
        "max": {
          "calc": "you.coins - you.committed"
        }
      },
      "store": "stage_raise",
      "text": "Auction {auction}, raise stage 3 of {raise_stages} (the last): secretly choose a raise, a whole number from 0 up to your coins minus what you have already committed this auction. Every committed coin is paid whether or not you win."
    },
    {
      "use": "update",
      "phase": "raise",
      "label": "stage 3 commits",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "raise",
            "value": {
              "calc": "you.stage_raise"
            }
          }
        },
        {
          "adjust": {
            "players": "all",
            "key": "committed",
            "value": {
              "calc": "you.stage_raise"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "stage_raise",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "raise",
      "label": "final bids",
      "to": "all",
      "text": "Final committed bids for auction {auction} [seat, committed]: {[[p.seat, p.committed] for p in players]}."
    },
    {
      "use": "update",
      "phase": "resolve",
      "label": "resolution",
      "do": [
        {
          "set": {
            "key": "top_bid",
            "value": {
              "calc": "max([p.committed for p in players])"
            }
          }
        },
        {
          "set": {
            "key": "top_count",
            "value": {
              "calc": "count(p.committed == top_bid for p in players)"
            }
          }
        },
        {
          "set": {
            "key": "auction_winner",
            "value": {
              "calc": "['none', 'seat 1', 'seat 2', 'seat 3', 'seat 4'][min([p.seat for p in players if p.committed == top_bid])] if (top_count == 1 and top_bid >= min_winning_bid) else 'none'"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.committed == top_bid and top_count == 1 and top_bid >= min_winning_bid"
            },
            "key": "prize_points",
            "value": {
              "calc": "you.values[auction - 1]"
            }
          }
        },
        {
          "adjust": {
            "players": "all",
            "key": "coins",
            "value": {
              "calc": "-you.committed"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "resolve",
      "label": "auction result",
      "to": "all",
      "text": "Auction {auction} winner: {auction_winner}. Remaining coins [seat, coins]: {[[p.seat, p.coins] for p in players]}."
    },
    {
      "use": "update",
      "phase": "resolve",
      "label": "clear the bids",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "committed",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "raise",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "resolve",
      "label": "final scores",
      "when": {
        "calc": "auction >= auctions"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "final_score",
            "value": {
              "calc": "you.coins + you.prize_points"
            }
          }
        }
      ],
      "text": "All private values revealed [seat, values, prize points]: {[[p.seat, p.values, p.prize_points] for p in players]}."
    },
    {
      "use": "check",
      "phase": "resolve",
      "label": "after the last auction",
      "when": {
        "calc": "auction >= auctions"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "auction >= auctions"
      },
      "rank_by": "you.coins + you.prize_points",
      "reveal": [
        "values",
        "prize_points"
      ],
      "text": "Winner: {result}. Final scores (coins + prize points) [seat, score]: {[[p.seat, p.coins + p.prize_points] for p in players]}."
    }
  },
  "limits": {
    "rounds": 6,
    "rounds_max": 8,
    "actions_max": 1000,
    "deadline_s": 120
  }
}
