  "setup": [
    {
      "use": "update",
      "label": "starting purses",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "coins",
            "value": {
              "calc": "starting_coins"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "prize_points",
            "value": {
              "calc": "initial_prize_points"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "committed",
            "value": {
              "calc": "initial_committed"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "final_score",
            "value": {
              "calc": "initial_final_score"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "current_value",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "the table",
      "do": [
        {
          "set": {
            "key": "auction",
            "value": 0
          }
        },
        {
          "set": {
            "key": "top_bid",
            "value": 0
          }
        },
        {
          "set": {
            "key": "top_count",
            "value": 0
          }
        },
        {
          "set": {
            "key": "auction_winner",
            "value": "none"
          }
        },
        {
          "set": {
            "key": "prize_deck",
            "value": {
              "calc": "[prize_value_1, prize_value_2, prize_value_3, prize_value_4, prize_value_5, prize_value_6]"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "deal private values",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "values",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
            "key": "pool",
            "value": {
              "calc": "prize_deck"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "pick",
            "value": {
              "calc": "you.pool[int(uniform(0, len(you.pool)))]"
            }
          }
        },
        {
          "append": {
            "players": "all",
            "key": "values",
            "value": {
              "calc": "you.pick"
            }
          }
        },
        {
          "remove": {
            "players": "all",
            "key": "pool",
            "value": {
              "calc": "you.pick"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "pick",
            "value": {
              "calc": "you.pool[int(uniform(0, len(you.pool)))]"
            }
          }
        },
        {
          "append": {
            "players": "all",
            "key": "values",
            "value": {
              "calc": "you.pick"
            }
          }
        },
        {
          "remove": {
            "players": "all",
            "key": "pool",
            "value": {
              "calc": "you.pick"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "pick",
            "value": {
              "calc": "you.pool[int(uniform(0, len(you.pool)))]"
            }
          }
        },
        {
          "append": {
            "players": "all",
            "key": "values",
            "value": {
              "calc": "you.pick"
            }
          }
        },
        {
          "remove": {
            "players": "all",
            "key": "pool",
            "value": {
              "calc": "you.pick"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "pick",
            "value": {
              "calc": "you.pool[int(uniform(0, len(you.pool)))]"
            }
          }
        },
        {
          "append": {
            "players": "all",
            "key": "values",
            "value": {
              "calc": "you.pick"
            }
          }
        },
        {
          "remove": {
            "players": "all",
            "key": "pool",
            "value": {
              "calc": "you.pick"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "pick",
            "value": {
              "calc": "you.pool[int(uniform(0, len(you.pool)))]"
            }
          }
        },
        {
          "append": {
            "players": "all",
            "key": "values",
            "value": {
              "calc": "you.pick"
            }
          }
        },
        {
          "remove": {
            "players": "all",
            "key": "pool",
            "value": {
              "calc": "you.pick"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "pick",
            "value": {
              "calc": "you.pool[int(uniform(0, len(you.pool)))]"
            }
          }
        },
        {
          "append": {
            "players": "all",
            "key": "values",
            "value": {
              "calc": "you.pick"
            }
          }
        },
        {
          "remove": {
            "players": "all",
            "key": "pool",
            "value": {
              "calc": "you.pick"
            }
          }
        }
      ]
