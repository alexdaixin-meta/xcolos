            "value": [
              "Grain-0",
              "Grain-1",
              "Grain-1",
              "Grain-2",
              "Grain-2",
              "Grain-3",
              "Grain-3",
              "Grain-3",
              "Grain-4",
              "Grain-4",
              "Grain-5",
              "Grain-5",
              "Cloth-0",
              "Cloth-1",
              "Cloth-1",
              "Cloth-2",
              "Cloth-2",
              "Cloth-3",
              "Cloth-3",
              "Cloth-3",
              "Cloth-4",
              "Cloth-4",
              "Cloth-5",
              "Cloth-5",
              "Spice-0",
              "Spice-1",
              "Spice-1",
              "Spice-2",
              "Spice-2",
              "Spice-3",
