    {
      "use": "update",
      "label": "deal favoured goods",
      "do": [
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "goods_pool[min(int(uniform(0, len(goods_pool))), len(goods_pool) - 1)]"
            }
          }
        },
        {
          "set": {
            "players": {
