              "Dye-3",
              "Dye-3",
              "Dye-4",
              "Dye-4",
              "Dye-5",
              "Dye-5"
            ],
            "if": {
              "calc": "round % (rounds_per_day_per_player * len(players)) == 1"
            }
          }
        },
        {
          "set": {
            "key": "discard",
            "value": [],
            "if": {
              "calc": "round % (rounds_per_day_per_player * len(players)) == 1"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "round % (rounds_per_day_per_player * len(players)) == 1"
            },
            "key": "ship_cards",
            "value": []
          }
        },
        {
          "set": {
            "players": {
              "where": "round % (rounds_per_day_per_player * len(players)) == 1"
            },
            "key": "ship_value",
            "value": 0
          }
        },
        {
          "set": {
            "players": {
              "where": "round % (rounds_per_day_per_player * len(players)) == 1"
            },
            "key": "ship_count",
            "value": 0
          }
        },
        {
          "set": {
            "key": "active_seat",
            "value": {
              "calc": "((round - 1) % len(players)) + 1"
            }
          }
        },
        {
          "set": {
            "key": "winner_seat",
            "value": 0
          }
        },
        {
          "set": {
            "key": "price_paid",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "reveal",
      "label": "reveal three cards",
      "do": [
        {
          "set": {
            "key": "revealed",
            "value": []
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "key": "revealed",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "key": "revealed",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[min(int(uniform(0, len(deck))), len(deck) - 1)]"
            }
          }
        },
        {
          "append": {
            "key": "revealed",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "reveal",
      "label": "the reveal",
      "to": "all",
      "text": "Day {day}, round {round}: the active seat is {active_seat}. The revealed cards A, B, C are {revealed}."
    },
    {
      "use": "ask",
      "phase": "lot",
      "label": "lot size",
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "number",
        "min": {
          "calc": "min_lot_size"
        },
        "max": {
          "calc": "max_lot_size"
        }
      },
      "verify": {
        "bind": "lot_choice"
      },
      "text": "You are the active player. The revealed cards A, B, C are {revealed}. Choose the lot size: 1 (card A), 2 (cards A and B) or 3 (cards A, B and C). Unchosen revealed cards are discarded."
    },
    {
      "use": "update",
      "phase": "lot",
      "label": "form the lot",
      "do": [
        {
          "set": {
            "key": "lot_size",
            "value": {
              "calc": "int($lot_choice)"
            }
          }
        },
        {
          "set": {
            "key": "lot",
            "value": {
              "calc": "[revealed[0]] + ([revealed[1]] if lot_size >= 2 else []) + ([revealed[2]] if lot_size >= 3 else [])"
            }
          }
        },
        {
          "set": {
            "key": "lot_value",
            "value": {
              "calc": "sum([int(c[len(c) - 1]) for c in lot])"
            }
          }
        },
        {
          "set": {
            "key": "discard",
            "value": {
              "calc": "discard + ([revealed[1]] if lot_size < 2 else []) + ([revealed[2]] if lot_size < 3 else [])"
            }
          }
        },
        {
          "set": {
            "key": "revealed",
            "value": []
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "lot",
      "label": "the lot",
      "to": "all",
      "text": "The lot is {lot} ({lot_size} cards, total value {lot_value})."
    },
    {
      "use": "poll",
      "phase": "bid",
      "label": "sealed bids",
      "to": "acting",
      "answer": {
        "type": "number",
        "min": {
          "calc": "min_bid"
        },
        "max": {
          "calc": "you.florins"
        }
      },
      "store": "bid",
      "text": "Sealed bid for the lot {lot} ({lot_size} cards, total value {lot_value}). Bid a whole number of florins from 0 up to your current florins; 0 is a pass. If loading the lot would put your ship over {ship_capacity} cards, your bid counts as 0. Bids stay hidden."
    },
    {
      "use": "update",
      "phase": "bid",
      "label": "validity",
      "do": [
        {
          "set": {
            "players": {
              "where": "you.ship_count + lot_size > ship_capacity"
            },
            "key": "bid",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "bid",
      "label": "find the winner",
      "do": [
        {
          "set": {
            "key": "winner_seat",
            "value": {
              "calc": "0 if max([p.bid for p in players]) <= 0 else [p.seat for p in players if p.bid == max([q.bid for q in players]) and (len(players) - ((p.seat - active_seat + len(players)) % len(players))) == max([len(players) - ((q.seat - active_seat + len(players)) % len(players)) for q in players if q.bid == max([r.bid for r in players])])][0]"
            }
          }
        },
        {
          "set": {
            "key": "price_paid",
            "value": {
              "calc": "max([p.bid for p in players]) if winner_seat > 0 else 0"
            }
          }
        },
        {
          "set": {
            "key": "discard",
            "value": {
              "calc": "discard + lot"
            },
            "if": {
              "calc": "winner_seat == 0"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "load",
      "label": "payment and loading",
      "do": [
        {
          "adjust": {
            "players": {
              "where": "you.seat == winner_seat and you.florins >= price_paid"
            },
            "key": "florins",
            "value": {
              "calc": "-price_paid"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == winner_seat"
            },
            "key": "ship_cards",
            "value": {
              "calc": "you.ship_cards + lot"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == winner_seat"
            },
            "key": "ship_value",
            "value": {
              "calc": "lot_value"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == winner_seat"
            },
            "key": "ship_count",
            "value": {
              "calc": "lot_size"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == winner_seat"
            },
            "key": "total_cards",
            "value": {
              "calc": "lot_size"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == winner_seat"
            },
            "key": "grain_count",
            "value": {
              "calc": "count(c[0] == 'G' for c in lot)"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == winner_seat"
            },
            "key": "cloth_count",
            "value": {
              "calc": "count(c[0] == 'C' for c in lot)"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == winner_seat"
            },
            "key": "spice_count",
            "value": {
              "calc": "count(c[0] == 'S' for c in lot)"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.seat == winner_seat"
            },
            "key": "dye_count",
            "value": {
              "calc": "count(c[0] == 'D' for c in lot)"
            }
          }
        },
        {
          "set": {
            "key": "lot",
            "value": []
          }
        },
        {
          "set": {
            "key": "ship_counts",
            "value": {
              "calc": "[p.ship_count for p in players]"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "load",
      "label": "the announcement",
      "to": "all",
      "text": "Winner: seat {winner_seat} paid {price_paid} florins (seat 0 means nobody bid and the lot was discarded). Ship card counts of every seat, in seat order: {ship_counts}. Florins are not announced."
    },
    {
      "use": "update",
      "phase": "day end",
      "label": "day scoring",
      "when": {
        "calc": "round % (rounds_per_day_per_player * len(players)) == 0"
      },
      "do": [
        {
          "adjust": {
            "players": {
              "where": "you.ship_value > 0 and you.ship_value == max([p.ship_value for p in players]) and count(p.ship_value == max([q.ship_value for q in players]) for p in players) == 1"
            },
            "key": "florins",
            "value": {
              "calc": "day_first_prize"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.ship_value > 0 and you.ship_value == max([p.ship_value for p in players]) and count(p.ship_value == max([q.ship_value for q in players]) for p in players) > 1"
            },
            "key": "florins",
            "value": {
              "calc": "int(day_tied_first_pool / count(p.ship_value == max([q.ship_value for q in players]) for p in players))"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.ship_value > 0 and count(p.ship_value == max([q.ship_value for q in players]) for p in players) == 1 and you.ship_value == max([0] + [p.ship_value for p in players if p.ship_value < max([q.ship_value for q in players])])"
            },
            "key": "florins",
            "value": {
              "calc": "int(day_second_prize / count(p.ship_value == you.ship_value for p in players))"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "ship_cards",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
            "key": "ship_value",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "ship_count",
            "value": 0
          }
        },
        {
          "set": {
            "key": "discard",
            "value": []
          }
        },
        {
          "adjust": {
            "key": "day",
            "value": 1
          }
        }
      ],
      "text": "Day over: the day's ship prizes are paid and all ships are emptied."
    },
    {
      "use": "update",
      "phase": "game end",
      "label": "end-of-game scoring",
      "when": {
        "calc": "round == total_rounds_per_player * len(players)"
      },
      "do": [
        {
          "adjust": {
            "players": {
              "where": "you.grain_count > 0 and you.grain_count == max([p.grain_count for p in players])"
            },
            "key": "florins",
            "value": {
              "calc": "int(majority_prize / count(p.grain_count == you.grain_count for p in players))"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.cloth_count > 0 and you.cloth_count == max([p.cloth_count for p in players])"
            },
            "key": "florins",
            "value": {
              "calc": "int(majority_prize / count(p.cloth_count == you.cloth_count for p in players))"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.spice_count > 0 and you.spice_count == max([p.spice_count for p in players])"
            },
            "key": "florins",
            "value": {
              "calc": "int(majority_prize / count(p.spice_count == you.spice_count for p in players))"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.dye_count > 0 and you.dye_count == max([p.dye_count for p in players])"
            },
            "key": "florins",
            "value": {
              "calc": "int(majority_prize / count(p.dye_count == you.dye_count for p in players))"
            }
          }
        },
        {
          "adjust": {
            "players": "all",
            "key": "florins",
            "value": {
              "calc": "favoured_per_card * (you.grain_count if you.favoured_good == 'Grain' else (you.cloth_count if you.favoured_good == 'Cloth' else (you.spice_count if you.favoured_good == 'Spice' else (you.dye_count if you.favoured_good == 'Dye' else 0))))"
            }
          }
        },
        {
          "set": {
            "key": "favoured_reveal",
            "value": {
              "calc": "[p.favoured_good for p in players]"
            }
          }
        }
      ],
      "text": "Majorities and favoured goods are paid."
    },
    {
      "use": "tell",
      "phase": "game end",
      "label": "favoured goods revealed",
      "when": {
        "calc": "round == total_rounds_per_player * len(players)"
      },
      "to": "all",
      "text": "Favoured goods, in seat order: {favoured_reveal}."
    },
    {
      "use": "update",
      "phase": "end of round",
      "label": "next round",
      "do": [
        {
          "adjust": {
            "key": "round",
            "value": 1
          }
        }
      ]
    },
    {
      "use": "check",
      "phase": "end of round",
      "label": "after the last round",
      "when": {
        "calc": "round > total_rounds_per_player * len(players)"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "round > total_rounds_per_player * len(players)"
      },
      "rank_by": "you.florins * 1000 + you.total_cards",
      "reveal": [
        "florins",
        "favoured_good"
      ],
      "text": "Winner: {result}. Final [seat, florins, total cards]: {[[p.seat, p.florins, p.total_cards] for p in players]}."
    }
  },
  "limits": {
    "rounds": 30,
    "rounds_max": 30,
    "actions_max": 3000,
    "deadline_s": 120
  },
  "rules": "Each player starts with {starting_florins} florins. Your florins are private: only you and the engine know your total. The deck has {deck_size} cards: {goods_count} goods (Grain, Cloth, Spice, Dye) with {cards_per_good} cards each, valued 0,1,1,2,2,3,3,3,4,4,5,5. Each player is secretly dealt a different favoured good, chosen at random, and only that player knows it. Seats are numbered 1 to N. The active player in round r is seat ((r-1) mod N)+1.\n\nThe game lasts {days} days. Each day has {rounds_per_day_per_player}N rounds (6 with 3 players, 8 with 4), so {total_rounds_per_player}N rounds in all. At the start of each day all {deck_size} cards are shuffled into a fresh deck and every ship is empty. A ship holds at most {ship_capacity} cards.\n\nEach round:\n1. Reveal. The top {cards_revealed_per_round} cards of the deck are revealed to everyone, in order, as cards A, B and C.\n2. Lot size. The active player chooses {min_lot_size}, 2 or {max_lot_size}. The lot is card A, cards A and B, or cards A, B and C. Unchosen revealed cards are discarded. The lot is announced.\n3. Sealed bids. All players, including the active player, at the same moment secretly bid a whole number of florins from {min_bid} up to their own current florins. A bid of 0 is a pass.\n4. Validity. A bid is treated as 0 if loading the lot would put that player's ship over {ship_capacity} cards; otherwise it stands as bid.\n5. Winner. The highest valid bid above 0 wins. Ties go to the active player if tied. Otherwise they go to the tied player who comes first in seating order starting after the active player. If every bid is 0, the lot is discarded and nobody pays.\n6. Payment and loading. The winner pays the bid to the bank and loads the lot onto their ship. The winner's ship value rises by the sum of the lot's card values, their ship card count rises by the lot size, and their game-long count of each good rises by the number of cards of that good in the lot. Losing bidders pay nothing.\n7. Announcement. The engine announces the winner, the price paid, and every player's ship card count. It does not announce florin totals.\n\nEnd of day (after the last round of each day): the highest ship value earns {day_first_prize} florins and the second-highest earns {day_second_prize}. If several players tie for highest, they split {day_tied_first_pool} florins equally, rounded down, and no second place is paid. If several tie for second, they split {day_second_prize} equally, rounded down. A ship value of 0 earns nothing. Then all ships are emptied (value 0, card count 0); the game-long good counts are kept.\n\nEnd of game (after day 3 scoring): for each good, the player with the most cards of it over the whole game earns {majority_prize} florins; ties split {majority_prize} equally, rounded down; if nobody has any cards of a good, nothing is paid for it. Each player then earns {favoured_per_card} florins per card of their own favoured good collected over the game. Favoured goods are then revealed.\n\nThere is no talk phase.\n\nAfter the end-of-game scoring, the player with the most florins wins. If several tie for most, the tied player with more total cards collected over the game wins. If still tied, the game is a draw and those players share the win."
}
