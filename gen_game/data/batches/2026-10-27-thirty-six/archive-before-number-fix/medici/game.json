            "key": "bid",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "the favour tiles",
      "do": [
        {
          "set": {
            "key": "favour_tiles",
            "value": {
              "calc": "['Grain', 'Cloth', 'Spice', 'Dye'] * (favour_tiles_per_good_small if len(players) <= small_table_max else favour_tiles_per_good_large)"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "deal the favour tiles",
      "do": [
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "favour_tiles[int(uniform(0, len(favour_tiles)))]"
            }
          }
        },
        {
          "set": {
            "player": 1,
            "key": "favoured_good",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "favour_tiles",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "favour_tiles[int(uniform(0, len(favour_tiles)))]"
            }
          }
        },
        {
          "set": {
            "player": 2,
            "key": "favoured_good",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "favour_tiles",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "favour_tiles[int(uniform(0, len(favour_tiles)))]"
            }
          }
        },
        {
          "set": {
            "player": 3,
            "key": "favoured_good",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "favour_tiles",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "favour_tiles[int(uniform(0, len(favour_tiles)))]"
            },
            "if": {
              "calc": "len(players) >= 4"
            }
          }
        },
        {
          "set": {
            "player": 4,
            "key": "favoured_good",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "len(players) >= 4"
            }
          }
        },
        {
          "remove": {
            "key": "favour_tiles",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "len(players) >= 4"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "favour_tiles[int(uniform(0, len(favour_tiles)))]"
            },
            "if": {
              "calc": "len(players) >= 5"
            }
          }
        },
        {
          "set": {
            "player": 5,
            "key": "favoured_good",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "len(players) >= 5"
            }
          }
        },
        {
          "remove": {
            "key": "favour_tiles",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "len(players) >= 5"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "favour_tiles[int(uniform(0, len(favour_tiles)))]"
            },
            "if": {
              "calc": "len(players) >= 6"
            }
          }
        },
        {
          "set": {
            "player": 6,
            "key": "favoured_good",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "len(players) >= 6"
            }
          }
        },
        {
          "remove": {
            "key": "favour_tiles",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "len(players) >= 6"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "the round counter",
      "do": [
        {
          "set": {
            "key": "round",
            "value": 0
          }
        }
      ]
    },
    {
      "use": "sync",
      "label": "the table",
      "mode": "self",
      "to": "all",
      "text": "You start with:"
    },
    {
      "use": "tell",
      "label": "starting florins",
      "to": "all",
      "text": "Starting florins [seat, florins]: {[[p.seat, p.florins] for p in players]}."
    }
  ],
  "steps": [
    {
      "use": "update",
      "phase": "advance",
      "label": "advance",
      "do": [
        {
          "adjust": {
            "key": "round",
            "value": 1
          }
        },
        {
          "set": {
            "key": "active_seat",
            "value": {
              "calc": "((round - 1) % len(players)) + 1"
            }
          }
        }
      ],
      "text": "Round {round} begins. Seat {active_seat} chooses the lot size."
    },
    {
      "use": "update",
      "phase": "advance",
      "label": "new day",
      "when": {
        "calc": "round % (rounds_per_day_per_player * len(players)) == 1"
      },
      "do": [
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "[x[1] for x in sorted([[uniform(0, 1), c] for c in ['Grain:0', 'Grain:1', 'Grain:1', 'Grain:2', 'Grain:2', 'Grain:3', 'Grain:3', 'Grain:3', 'Grain:4', 'Grain:4', 'Grain:5', 'Grain:5', 'Cloth:0', 'Cloth:1', 'Cloth:1', 'Cloth:2', 'Cloth:2', 'Cloth:3', 'Cloth:3', 'Cloth:3', 'Cloth:4', 'Cloth:4', 'Cloth:5', 'Cloth:5', 'Spice:0', 'Spice:1', 'Spice:1', 'Spice:2', 'Spice:2', 'Spice:3', 'Spice:3', 'Spice:3', 'Spice:4', 'Spice:4', 'Spice:5', 'Spice:5', 'Dye:0', 'Dye:1', 'Dye:1', 'Dye:2', 'Dye:2', 'Dye:3', 'Dye:3', 'Dye:3', 'Dye:4', 'Dye:4', 'Dye:5', 'Dye:5']])]"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "ship_value",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "ship_count",
            "value": 0
          }
        }
      ],
      "text": "A new day begins: the full deck of {deck_size} cards is shuffled and every ship is emptied. Florins and goods counts are kept."
    },
    {
      "use": "update",
      "phase": "lot",
      "label": "reveal",
      "do": [
        {
          "set": {
            "key": "revealed",
            "value": {
              "calc": "[deck[0], deck[1], deck[2]]"
            }
          }
        }
      ],
      "text": "The top {reveal_count} cards of the deck, in order: {revealed}."
    },
    {
      "use": "ask",
      "phase": "lot",
      "label": "lot size",
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "choice",
        "options": [
          "1",
          "2",
          "3"
        ]
      },
      "verify": {
        "bind": "lot_choice"
      },
      "text": "You are the active seat. The top cards are {revealed}. Choose the lot size: 1, 2 or 3. The lot is the top that many cards."
    },
    {
      "use": "update",
      "phase": "lot",
      "label": "cut",
      "do": [
        {
          "set": {
            "key": "lot_size",
            "value": {
              "calc": "int($lot_choice)"
            }
          }
        },
        {
          "set": {
            "key": "lot_cards",
            "value": {
              "calc": "[deck[0]] + ([deck[1]] if lot_size >= 2 else []) + ([deck[2]] if lot_size >= 3 else [])"
            }
          }
        },
        {
          "set": {
            "key": "lot_value",
            "value": {
              "calc": "sum([int(c[-1]) for c in lot_cards])"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": 0
          }
        }
      ],
      "text": "The lot is {lot_size} card(s): {lot_cards}, worth {lot_value} in total."
    },
    {
      "use": "tell",
      "phase": "bid",
      "label": "ship full",
      "to": {
        "where": "you.ship_count + lot_size > ship_capacity"
      },
      "text": "Your ship cannot fit this lot (you hold {ship_count} cards, the lot has {lot_size}, capacity {ship_capacity}). Only a bid of 0 counts for you this round."
    },
    {
      "use": "poll",
      "phase": "bid",
      "label": "sealed bid",
      "to": "acting",
      "answer": {
        "type": "number",
        "min": {
          "calc": "bid_min"
        },
        "max": {
          "calc": "you.florins"
        }
      },
      "store": "bid",
      "text": "Sealed bid for the lot {lot_cards} (value {lot_value}, {lot_size} card(s)). Bid a whole number from {bid_min} to your florins. All bids are made at once; the sole highest bid above 0 wins and pays; a tie at the top or a top bid of 0 means nobody wins."
    },
    {
      "use": "update",
      "phase": "bid",
      "label": "validate",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": {
              "calc": "0 if (int(you.bid) > you.florins or you.ship_count + lot_size > ship_capacity) else int(you.bid)"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "resolve",
      "label": "resolve",
      "do": [
        {
          "set": {
            "key": "high_bid",
            "value": {
              "calc": "max([p.bid for p in players])"
            }
          }
        },
        {
          "set": {
            "key": "high_count",
            "value": {
              "calc": "count(p.bid == high_bid for p in players)"
            }
          }
        }
      ],
      "text": "Bids [seat, bid]: {[[p.seat, p.bid] for p in players]}. High bid {high_bid}, made by {high_count} player(s)."
    },
    {
      "use": "update",
      "phase": "resolve",
      "label": "pay",
      "when": {
        "calc": "high_bid > 0 and high_count == 1"
      },
      "do": [
        {
          "adjust": {
            "players": {
              "where": "you.bid == high_bid and you.florins >= high_bid"
            },
            "key": "florins",
            "value": {
              "calc": "-high_bid"
            },
            "text": "Seat {player} wins the lot and pays {high_bid} florins."
          }
        }
      ],
      "text": "Florins [seat, florins]: {[[p.seat, p.florins] for p in players]}."
    },
    {
      "use": "update",
      "phase": "resolve",
      "label": "load and clear",
      "do": [
        {
          "adjust": {
            "players": {
              "where": "you.bid == high_bid and high_bid > 0 and high_count == 1"
            },
            "key": "ship_value",
            "value": {
              "calc": "lot_value"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.bid == high_bid and high_bid > 0 and high_count == 1"
            },
            "key": "ship_count",
            "value": {
              "calc": "lot_size"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.bid == high_bid and high_bid > 0 and high_count == 1"
            },
            "key": "grain_count",
            "value": {
              "calc": "count(c[0] == 'G' for c in lot_cards)"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.bid == high_bid and high_bid > 0 and high_count == 1"
            },
            "key": "cloth_count",
            "value": {
              "calc": "count(c[0] == 'C' for c in lot_cards)"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.bid == high_bid and high_bid > 0 and high_count == 1"
            },
            "key": "spice_count",
            "value": {
              "calc": "count(c[0] == 'S' for c in lot_cards)"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "you.bid == high_bid and high_bid > 0 and high_count == 1"
            },
            "key": "dye_count",
            "value": {
              "calc": "count(c[0] == 'D' for c in lot_cards)"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "deck[0]"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "deck[0]"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "deck[0]"
            }
          }
        }
      ],
      "text": "The top {cards_cleared_per_round} cards are cleared from the deck. If nobody won, the lot is discarded."
    },
    {
      "use": "update",
      "phase": "day end",
      "label": "ship ranks",
      "when": {
        "calc": "round % (rounds_per_day_per_player * len(players)) == 0"
      },
      "do": [
        {
          "set": {
            "key": "top",
            "value": {
              "calc": "max([p.ship_value for p in players])"
            }
          }
        },
        {
          "set": {
            "key": "second",
            "value": {
              "calc": "max([p.ship_value for p in players if p.ship_value < top] + [0])"
            }
          }
        }
      ],
      "text": "The day ends. Highest ship value {top}, second highest {second}."
    },
    {
      "use": "update",
      "phase": "day end",
      "label": "ship payout",
      "when": {
        "calc": "round % (rounds_per_day_per_player * len(players)) == 0"
      },
      "do": [
        {
          "adjust": {
            "players": {
              "where": "top > 0 and you.ship_value == top"
            },
            "key": "florins",
            "value": {
              "calc": "ship_first_payout"
            },
            "text": "Seat {player} has the top ship and gains {ship_first_payout} florins."
          }
        },
        {
          "adjust": {
            "players": {
              "where": "second > 0 and you.ship_value == second"
            },
            "key": "florins",
            "value": {
              "calc": "ship_second_payout"
            },
            "text": "Seat {player} has the second ship and gains {ship_second_payout} florins."
          }
        }
      ],
      "text": "Florins [seat, florins]: {[[p.seat, p.florins] for p in players]}."
    },
    {
      "use": "update",
      "phase": "day end",
      "label": "grain track",
      "when": {
        "calc": "round % (rounds_per_day_per_player * len(players)) == 0"
      },
      "do": [
        {
          "set": {
            "key": "track_max",
            "value": {
              "calc": "max([p.grain_count for p in players])"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "track_max > 0 and you.grain_count == track_max"
            },
            "key": "florins",
            "value": {
              "calc": "track_bonus"
            },
            "text": "Seat {player} leads the Grain track and gains {track_bonus} florins."
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "day end",
      "label": "cloth track",
      "when": {
        "calc": "round % (rounds_per_day_per_player * len(players)) == 0"
      },
      "do": [
        {
          "set": {
            "key": "track_max",
            "value": {
              "calc": "max([p.cloth_count for p in players])"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "track_max > 0 and you.cloth_count == track_max"
            },
            "key": "florins",
            "value": {
              "calc": "track_bonus"
            },
            "text": "Seat {player} leads the Cloth track and gains {track_bonus} florins."
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "day end",
      "label": "spice track",
      "when": {
        "calc": "round % (rounds_per_day_per_player * len(players)) == 0"
      },
      "do": [
        {
          "set": {
            "key": "track_max",
            "value": {
              "calc": "max([p.spice_count for p in players])"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "track_max > 0 and you.spice_count == track_max"
            },
            "key": "florins",
            "value": {
              "calc": "track_bonus"
            },
            "text": "Seat {player} leads the Spice track and gains {track_bonus} florins."
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "day end",
      "label": "dye track",
      "when": {
        "calc": "round % (rounds_per_day_per_player * len(players)) == 0"
      },
      "do": [
        {
          "set": {
            "key": "track_max",
            "value": {
              "calc": "max([p.dye_count for p in players])"
            }
          }
        },
        {
          "adjust": {
            "players": {
              "where": "track_max > 0 and you.dye_count == track_max"
            },
            "key": "florins",
            "value": {
              "calc": "track_bonus"
            },
            "text": "Seat {player} leads the Dye track and gains {track_bonus} florins."
          }
        }
      ],
      "text": "Florins [seat, florins]: {[[p.seat, p.florins] for p in players]}."
    },
    {
      "use": "update",
      "phase": "finale",
      "label": "favour",
      "when": {
        "calc": "round == total_rounds_per_player * len(players)"
      },
      "do": [
        {
          "adjust": {
            "players": "all",
            "key": "florins",
            "value": {
              "calc": "favour_multiplier * (you.grain_count if you.favoured_good == 'Grain' else (you.cloth_count if you.favoured_good == 'Cloth' else (you.spice_count if you.favoured_good == 'Spice' else (you.dye_count if you.favoured_good == 'Dye' else 0))))"
            }
          }
        }
      ],
      "text": "Favoured goods revealed [seat, good]: {[[p.seat, p.favoured_good] for p in players]}. Final florins [seat, florins]: {[[p.seat, p.florins] for p in players]}."
    },
    {
      "use": "check",
      "phase": "finale",
      "label": "end of the game",
      "when": {
        "calc": "round == total_rounds_per_player * len(players)"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "round >= total_rounds_per_player * len(players)"
      },
      "rank_by": "you.florins",
      "reveal": [
        "favoured_good"
      ],
      "text": "Winner: {result}. Final florins [seat, florins]: {[[p.seat, p.florins] for p in players]}."
    }
  },
  "limits": {
    "rounds": 36,
    "rounds_max": 36,
    "actions_max": 2000,
    "deadline_s": 120
  },
  "rules": "Four goods: Grain, Cloth, Spice and Dye. The deck has {deck_size} cards: for each good, one card each of the values 0, 1, 1, 2, 2, 3, 3, 3, 4, 4, 5, 5 ({cards_per_good} cards worth {value_per_good_total} per good).\n\nSETUP: everyone starts with {starting_florins} florins (public), an empty ship (ship_value 0, ship_count 0) and all goods counts at 0. Favour tiles: with up to {small_table_max} players there is {favour_tiles_per_good_small} tile of each good, with 5 or 6 players {favour_tiles_per_good_large} of each. Each player is dealt one at random, face down: your secret favoured good, known only to you. Undealt tiles are never revealed. The game lasts {total_rounds_per_player}N rounds (N = number of players): {days} days of {rounds_per_day_per_player}N rounds each.\n\nEACH ROUND: 1. The round advances; the active seat is ((round - 1) mod N) + 1. 2. At the start of each day the full deck is shuffled, leftover cards are gone, and every ship is emptied (florins and goods counts are kept). 3. The top {reveal_count} cards are shown to everyone. 4. The active seat chooses a lot size of {lot_size_min}, 2 or {lot_size_max}. 5. The lot is the top that many cards; its value is the sum of their values. 6. A player whose ship_count + lot size is more than {ship_capacity} is told their ship cannot fit the lot and only a bid of 0 counts. 7. Everyone bids at the same moment, a whole number from {bid_min} to their florins. A bid above your florins, or from a ship that cannot fit the lot, becomes 0. 8. Every bid is announced. If the highest bid is above 0 and exactly one player made it, that player pays it (the florins leave the game), adds the lot value to ship_value and the lot size to ship_count, and adds 1 to their goods count for each lot card's good. If the highest bid is 0, or two or more players tie at the highest bid, nobody pays and the lot is discarded. Either way the top {cards_cleared_per_round} cards are removed from the deck.\n\nEND OF EACH DAY: every player with the highest ship_value (if above 0) gains {ship_first_payout} florins; every player with the highest ship_value strictly below that (if above 0) gains {ship_second_payout}. Then for each of Grain, Cloth, Spice and Dye, if the highest count is above 0, every player with that count gains {track_bonus} florins.\n\nEND OF THE GAME: after round {total_rounds_per_player}N each player gains {favour_multiplier} florins per card of their favoured good, all favoured goods are revealed, and the most florins wins. Players tied for the most florins share the result (a draw). There is no talk."
}
