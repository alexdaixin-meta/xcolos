  "setup": [
    {
      "use": "update",
      "label": "starting purses",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "florins",
            "value": {
              "calc": "starting_florins"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "ship_value",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "ship_count",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "grain_count",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "cloth_count",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "spice_count",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "dye_count",
            "value": 0
          }
        },
        {
          "set": {
