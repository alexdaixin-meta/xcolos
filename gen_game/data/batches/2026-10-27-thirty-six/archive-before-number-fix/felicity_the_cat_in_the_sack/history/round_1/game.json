{
  "schema": 1,
  "meta": {
    "id": "felicity_the_cat_in_the_sack",
    "name": "Cat in the Sack: Sealed Stages (Revised)",
    "players": {
      "min": 3,
      "max": 5,
      "suggested": 4
    },
    "blurb": "Everyone hides a card in a shared sack, talks, then bids for it in up to three sealed stages; most cat points plus mice after 9 rounds wins."
  },
  "statuses": [
    {
      "id": "playing",
      "acts": true,
      "initial": true
    }
  ],
  "attributes": {
    "player": [
      {
        "key": "hand",
        "visible": "ally",
        "type": "list",
        "initial": []
