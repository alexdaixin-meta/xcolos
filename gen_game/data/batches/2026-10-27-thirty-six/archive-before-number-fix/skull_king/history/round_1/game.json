    {
      "use": "sync",
      "phase": "deal",
      "label": "your hand",
      "mode": "self",
      "to": "all",
      "fields": [
        "hand"
      ],
      "text": "Your hand (card powers):"
    },
    {
      "use": "poll",
      "phase": "bid",
      "label": "bid",
      "to": "acting",
      "answer": {
        "type": "number",
        "min": {
          "calc": "bid_min"
        },
        "max": {
          "calc": "bid_max"
        }
      },
      "store": "bid",
      "text": "Round {round}: secretly bid how many of the {tricks_per_round} tricks you will win, a whole number from {bid_min} to {bid_max}. No bid is shown until all are in."
    },
    {
      "use": "tell",
      "phase": "bid",
      "label": "bids revealed",
      "to": "all",
      "text": "All bids are in. Bids [seat, bid]: {[[p.seat, p.bid] for p in players]}."
    },
    {
      "use": "poll",
      "phase": "trick",
      "label": "trick 1 card",
      "to": "acting",
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "hand"
        }
      },
      "store": "card_choice",
      "text": "Round {round}, trick 1: play one card from your hand (its power value). Nobody sees any card until all are in."
    },
    {
      "use": "update",
      "phase": "trick",
      "label": "resolve trick 1",
      "do": [
        {
          "adjust": {
            "key": "trick_number",
            "value": 1
          }
        },
        {
          "set": {
            "key": "trick_winner",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "played",
            "value": {
              "calc": "int(you.card_choice)"
            }
          }
        },
        {
          "remove": {
            "players": "all",
            "key": "hand",
            "value": {
              "calc": "you.played"
            }
          }
        },
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "deck + [p.played for p in players]"
            }
          }
        },
        {
          "set": {
            "key": "trick_winner",
            "value": {
              "calc": "min([p.seat for p in players if p.played == mermaid_power]) if (any([p.played == mermaid_power for p in players]) and any([p.played == skull_king_power for p in players])) else (min([p.seat for p in players if p.played == max([q.played for q in players])]) if max([q.played for q in players]) > escape_power else 0)"
            }
          }
        },
        {
          "set": {
            "key": "winner_card",
            "value": {
              "calc": "sum([p.played for p in players if p.seat == trick_winner]) if trick_winner > 0 else -1"
            }
          }
        },
        {
          "set": {
            "key": "trick_bonus",
            "value": {
              "calc": "(pirate_capture_bonus * count([p.played == pirate_a_power or p.played == pirate_b_power for p in players])) if winner_card == skull_king_power else (skull_king_capture_bonus if (winner_card == mermaid_power and any([p.played == skull_king_power for p in players])) else 0)"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "trick_winner"
            },
            "key": "tricks_won",
            "value": {
              "calc": "tricks_won_per_trick"
            },
            "if": {
              "calc": "trick_winner > 0"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "trick_winner"
            },
            "key": "bonus",
            "value": {
              "calc": "trick_bonus"
            },
            "if": {
              "calc": "trick_winner > 0 and trick_bonus > 0"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "trick",
      "label": "trick 1 result",
      "to": "all",
      "text": "Trick {trick_number}: cards played [seat, power]: {[[p.seat, p.played] for p in players]}. Winner: seat {trick_winner} (0 means every card was an Escape and nobody won). Capture bonus recorded: {trick_bonus}."
