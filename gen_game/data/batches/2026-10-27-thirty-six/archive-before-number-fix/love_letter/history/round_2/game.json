  "schema": 1,
  "meta": {
    "id": "love_letter",
    "name": "Love Letter: Short Hands",
    "players": {
      "min": 2,
      "max": 2,
      "suggested": 2
    },
    "blurb": "Two-player Love Letter over exactly 40 turns: draw, discard a card to use its effect, knock out the rival or win the showdown, and optionally raise a hand's stake to 2."
  },
