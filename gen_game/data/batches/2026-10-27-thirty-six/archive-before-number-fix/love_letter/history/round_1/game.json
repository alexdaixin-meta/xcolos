              "calc": "active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "last_discard"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "active_seat"
            },
            "key": "discard_sum",
            "value": {
              "calc": "last_discard"
            },
            "text": "Seat {player} discards {last_discard}."
          }
        },
        {
          "set": {
            "player": {
              "calc": "active_seat"
            },
            "key": "protected",
