          }
        },
        {
          "set": {
            "key": "prince_discard",
            "value": {
              "calc": "sum(players[prince_target - 1].hand)"
            },
            "if": {
              "calc": "last_discard == prince_rank and prince_target > 0"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "prince_target"
            },
            "key": "discard_sum",
            "value": {
              "calc": "prince_discard"
            },
            "if": {
              "calc": "last_discard == prince_rank and prince_target > 0"
            },
            "text": "Prince: Seat {player} discards {prince_discard} without effect."
          }
        },
        {
          "set": {
            "player": {
              "calc": "prince_target"
            },
            "key": "hand",
            "value": [],
            "if": {
              "calc": "last_discard == prince_rank and prince_target > 0"
            }
          }
        },
        {
          "set": {
            "player": {
              "calc": "prince_target"
            },
            "key": "eliminated",
            "value": true,
            "if": {
              "calc": "last_discard == prince_rank and prince_target > 0 and prince_discard == princess_rank"
            }
          }
        },
        {
          "set_status": {
            "player": {
              "calc": "prince_target"
            },
            "to": "out",
            "if": {
              "calc": "last_discard == prince_rank and prince_target > 0 and prince_discard == princess_rank"
            },
            "text": "Seat {player} was made to discard the Princess and is out of this hand."
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "burned[0]"
            },
            "if": {
              "calc": "last_discard == prince_rank and prince_target > 0 and prince_discard != princess_rank and len(deck) == 0 and len(burned) > 0"
            }
          }
        },
        {
          "append": {
            "player": {
              "calc": "prince_target"
            },
            "key": "hand",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "last_discard == prince_rank and prince_target > 0 and prince_discard != princess_rank and len(deck) == 0 and len(burned) > 0"
            }
          }
        },
        {
          "set": {
            "key": "burned",
            "value": [],
            "if": {
              "calc": "last_discard == prince_rank and prince_target > 0 and prince_discard != princess_rank and len(deck) == 0 and len(burned) > 0"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            },
            "if": {
              "calc": "last_discard == prince_rank and prince_target > 0 and prince_discard != princess_rank and len(deck) > 0"
            }
          }
        },
        {
          "append": {
            "player": {
              "calc": "prince_target"
            },
            "key": "hand",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "last_discard == prince_rank and prince_target > 0 and prince_discard != princess_rank and len(deck) > 0"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "last_discard == prince_rank and prince_target > 0 and prince_discard != princess_rank and len(deck) > 0"
            }
          }
        },
        {
          "set": {
            "key": "swap_tmp",
            "value": {
              "calc": "players[active_seat - 1].hand"
            },
            "if": {
              "calc": "last_discard == king_rank and not players[2 - active_seat].protected"
            }
          }
        },
        {
          "set": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "players[2 - active_seat].hand"
            },
            "if": {
              "calc": "last_discard == king_rank and not players[2 - active_seat].protected"
            }
          }
        },
        {
          "set": {
            "player": {
              "calc": "3 - active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "swap_tmp"
            },
            "if": {
              "calc": "last_discard == king_rank and not players[2 - active_seat].protected"
            },
            "text": "King: the two players swap their cards."
          }
        },
        {
          "set": {
            "key": "deck_count",
            "value": {
              "calc": "len(deck) + len(burned)"
            }
          }
        }
      ]
    },
    {
      "use": "sync",
      "phase": "effects",
      "label": "your current card",
      "when": {
        "calc": "response != 'concede'"
      },
      "mode": "self",
      "to": "all",
      "fields": [
        "hand"
      ],
      "text": "Your card now:"
    },
    {
      "use": "tell",
      "phase": "effects",
      "label": "announce the turn",
      "to": "all",
      "text": "Turn {turn}: Seat {active_seat} discarded {last_discard} (0 = no card played). Guard number named: {guard_guess} (0 = none). Prince target: seat {prince_target} (0 = none), who discarded {prince_discard} (0 = none). Stake {stake}. Points: Seat 1 {players[0].points}, Seat 2 {players[1].points}. Cards left in the deck: {deck_count}."
    },
    {
      "use": "update",
      "phase": "hand end",
      "label": "hand end check",
      "when": {
        "calc": "response != 'concede'"
      },
      "do": [
        {
          "set": {
            "key": "hand_winner",
            "value": {
              "calc": "sum(p.seat for p in players if not p.eliminated)"
            },
            "if": {
              "calc": "any(p.eliminated for p in players)"
            }
          }
        },
        {
          "disclose": {
            "attribute": "hand",
            "of": {
              "calc": "sum(p.seat for p in players if p.eliminated)"
            },
            "to": "all",
            "if": {
              "calc": "any(p.eliminated for p in players)"
            },
            "text": "Seat {subject} is eliminated; their card is revealed: {value}."
          }
        },
        {
          "set": {
            "key": "showdown",
            "value": {
              "calc": "deck_count <= hand_end_deck_threshold and not any(p.eliminated for p in players)"
            }
          }
        },
        {
          "disclose": {
            "attribute": "hand",
            "of": 1,
            "to": "all",
            "if": {
              "calc": "showdown"
            },
            "text": "Showdown: Seat {subject} reveals {value}."
          }
        },
        {
          "disclose": {
            "attribute": "hand",
            "of": 2,
            "to": "all",
            "if": {
              "calc": "showdown"
            },
            "text": "Showdown: Seat {subject} reveals {value}."
          }
        },
        {
          "set": {
            "key": "hand_winner",
            "value": {
              "calc": "1 if sum(players[0].hand) > sum(players[1].hand) else (2 if sum(players[1].hand) > sum(players[0].hand) else (1 if players[0].discard_sum > players[1].discard_sum else (2 if players[1].discard_sum > players[0].discard_sum else 0)))"
            },
            "if": {
              "calc": "showdown"
            }
          }
        },
        {
          "set": {
            "key": "hand_over",
            "value": {
              "calc": "showdown or any(p.eliminated for p in players)"
            }
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "hand_winner"
            },
            "key": "points",
            "value": {
              "calc": "stake"
            },
            "if": {
              "calc": "hand_over and hand_winner > 0"
            },
            "text": "Seat {player} wins the hand and gains {stake} point(s)."
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "hand_winner"
            },
            "key": "hands_won",
            "value": 1,
            "if": {
              "calc": "hand_over and hand_winner > 0"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "hand end",
      "label": "showdown result",
      "when": {
        "calc": "showdown"
      },
      "to": "all",
      "text": "Showdown: both cards are revealed. Discard sums this hand: Seat 1 {players[0].discard_sum}, Seat 2 {players[1].discard_sum}. Hand winner: seat {hand_winner} (0 means the cards and discard sums were equal and nobody scored)."
    },
    {
      "use": "update",
      "phase": "hand end",
      "label": "next turn",
      "do": [
        {
          "set": {
            "key": "starter_seat",
            "value": {
              "calc": "(3 - hand_winner) if hand_winner != 0 else (3 - starter_seat)"
            },
            "if": {
              "calc": "hand_over"
            }
          }
        },
        {
          "set": {
            "key": "new_hand_due",
            "value": true,
            "if": {
              "calc": "hand_over"
            }
          }
        },
        {
          "set": {
            "key": "active_seat",
            "value": {
              "calc": "3 - active_seat"
            },
            "if": {
              "calc": "not hand_over"
            }
          }
        }
      ]
    },
    {
      "use": "check",
      "phase": "hand end",
      "label": "match check",
      "when": {
        "calc": "max(p.points for p in players) >= points_to_win or turn >= max_turns"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "max(p.points for p in players) >= points_to_win or turn >= max_turns"
      },
      "rank_by": "you.points * 1000 + you.hands_won",
      "text": "Winner: {result}. Final points: Seat 1 {players[0].points}, Seat 2 {players[1].points}; hands won: Seat 1 {players[0].hands_won}, Seat 2 {players[1].hands_won}."
    }
  },
  "limits": {
    "rounds": 40,
    "rounds_max": 40,
    "actions_max": 2000,
    "deadline_s": 120
  },
  "rules": "Two-player Love Letter with one raise per hand. The deck has {deck_size} cards: five 1-Guard, two 2-Priest, two 3-Baron, two 4-Handmaid, two 5-Prince, one 6-King, one 7-Countess, one 8-Princess. Each player starts with {starting_points} points and {starting_hands_won} hands won.\n\nEach round is one turn by one player, the active player. The match lasts at most {max_turns} turns.\n\nSTARTING A HAND: all 16 cards are shuffled into a deck. The top {removed_face_up} cards are removed face up, out of play, and announced to both players. The starting player is dealt {cards_dealt_per_player} card face down, then the other player; each sees only their own card. The remaining {deck_after_deal} cards stay as the deck, unseen; the bottom card is the burned card and is never drawn normally. Stake = {starting_stake}, no raise has been made, nobody is protected, and every discard sum for the hand is 0. Seat {first_starter_seat} starts hand 1. Afterwards the player who did not win the previous hand starts; if nobody scored, the seat that did not start it starts. The starting player takes the first turn of the hand.\n\nA TURN:\n(1) RAISE: if no raise has been made in this hand, the active player, holding their one card, chooses 'raise' or 'no raise'. If they choose 'no raise', the turn goes on to the draw.\n(2) RESPONSE: if they raised, the opponent chooses 'accept' or 'concede'.\n(3) On 'concede', the active player wins the hand and gains {concede_gain} point (and 1 hand won); the hand ends and the rest of the turn is skipped. On 'accept', the stake becomes {raised_stake} and no further raise is possible this hand; the turn goes on.\n(4) DRAW: the active player loses any Handmaid protection and takes the top card of the deck, holding two cards.\n(5) PLAY: the active player chooses one of their two cards to discard face up.\n(6) If they hold the Countess together with the King or a Prince, the Countess is discarded instead, whatever they would choose (they are offered only the Countess). The discarded card's rank is added to their discard sum. If the discard is the Handmaid, they are protected until the start of their next turn. If the discard is the Princess, they are eliminated.\n(7) If the discard is a Guard, the active player names a number from {guard_guess_min} to {guard_guess_max}. If it is a Prince, they choose a target, themselves or the opponent; if the opponent is protected, they must target themselves.\n(8) EFFECTS. The Guard, Priest, Baron and King do nothing if the opponent is protected.\n- Guard: if the opponent's card equals the named number, the opponent is eliminated; otherwise nothing happens.\n- Priest: the opponent's card is shown privately to the active player.\n- Baron: both players privately see each other's cards. The lower card's holder is eliminated; on equal cards nothing happens.\n- Prince: the target discards their card face up without effect and adds its rank to their discard sum. If it was the Princess, they are eliminated. Otherwise they take the top card of the deck; this is the burned card if it is the only card left.\n- King: the two players swap their cards.\n- Countess, Handmaid, Princess: no further effect.\n(9) Both players are told the card discarded, any Guard number or Prince target, any card discarded by a Prince, any elimination with the eliminated player's revealed card, the stake, both scores, and the number of cards left in the deck.\n(10) HAND END: if a player is eliminated, the other player wins the hand and gains points equal to the stake. Otherwise, if the deck now holds {hand_end_deck_threshold} card or fewer (burned card included), both players reveal their cards: the higher card wins the hand and gains the stake; on equal cards the higher discard sum for this hand wins and gains the stake; if both are equal, nobody scores. The winner of a hand adds 1 to their hands won. If the hand did not end, the other player becomes active next turn; if it ended, the next turn starts a new hand.\n(11) MATCH: a player with {points_to_win} or more points wins the match immediately. Only one player can score per hand, so two players never reach {points_to_win} at once. If {max_turns} turns pass with neither at {points_to_win}, the player with more points wins; if points are equal, the player with more hands won wins; if those are also equal, the match is a draw."
}
