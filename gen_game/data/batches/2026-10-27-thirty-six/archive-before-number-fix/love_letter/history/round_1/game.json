{
  "schema": 1,
  "meta": {
    "id": "love_letter",
    "name": "Love Letter: One Raise",
    "players": {
      "min": 2,
      "max": 2,
      "suggested": 2
    },
    "blurb": "Two-player Love Letter with a 16-card deck and one raise per hand: the stake goes from 1 to 2, or the opponent concedes 1 point. First to 5 wins."
  },
