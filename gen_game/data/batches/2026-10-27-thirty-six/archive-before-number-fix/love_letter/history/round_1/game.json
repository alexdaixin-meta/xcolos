            "if": {
              "calc": "last_discard == guard_rank and not players[2 - active_seat].protected and players[2 - active_seat].hand[0] == guard_guess"
            },
            "text": "The Guard named {guard_guess} correctly: Seat {player} is out of this hand."
          }
