        },
        {
          "disclose": {
            "attribute": "hand",
            "of": {
              "calc": "3 - active_seat"
            },
            "to": {
              "where": "you.seat == active_seat"
            },
            "if": {
              "calc": "last_discard == baron_rank and not players[2 - active_seat].protected"
            },
            "text": "Baron: Seat {subject}'s card is {value}."
          }
        },
        {
          "disclose": {
            "attribute": "hand",
            "of": {
              "calc": "active_seat"
            },
            "to": {
              "where": "you.seat == 3 - active_seat"
            },
            "if": {
              "calc": "last_discard == baron_rank and not players[2 - active_seat].protected"
            },
            "text": "Baron: Seat {subject}'s card is {value}."
          }
        },
        {
          "set": {
            "key": "baron_loser",
            "value": {
              "calc": "0 if players[active_seat - 1].hand[0] == players[2 - active_seat].hand[0] else (active_seat if players[active_seat - 1].hand[0] < players[2 - active_seat].hand[0] else 3 - active_seat)"
            },
            "if": {
              "calc": "last_discard == baron_rank and not players[2 - active_seat].protected"
            }
          }
        },
        {
          "set": {
            "player": {
              "calc": "baron_loser"
            },
            "key": "eliminated",
            "value": true,
            "if": {
