          "opponent"
        ]
      },
      "each": {
        "do": [
          {
            "set": {
              "key": "prince_target",
              "value": {
                "calc": "active_seat if $answer == 'self' else 3 - active_seat"
              }
            }
          }
        ]
      },
      "text": "You discarded a Prince. Choose its target: 'self' or 'opponent'. The target discards their card face up without effect and draws a new one; if the discarded card is the Princess, the target is eliminated."
    },
    {
      "use": "update",
      "phase": "effects",
      "label": "card effects",
      "when": {
        "calc": "response != 'concede'"
      },
      "do": [
        {
          "set": {
            "player": {
              "calc": "3 - active_seat"
            },
            "key": "eliminated",
            "value": true,
            "if": {
              "calc": "last_discard == guard_rank and not players[2 - active_seat].protected and players[2 - active_seat].hand[0] == guard_guess"
