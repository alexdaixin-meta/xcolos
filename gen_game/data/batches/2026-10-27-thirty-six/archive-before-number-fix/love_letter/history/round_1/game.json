        {
          "disclose": {
            "attribute": "hand",
            "of": {
              "calc": "3 - active_seat"
            },
            "to": {
              "where": "you.seat == active_seat"
            },
            "if": {
              "calc": "last_discard == priest_rank and not players[2 - active_seat].protected"
            },
