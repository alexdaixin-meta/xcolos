  "setup": [
    {
      "use": "update",
      "label": "starting scores",
      "do": [
        {
          "set": {
            "players": "all",
            "key": "points",
            "value": {
              "calc": "starting_points"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hands_won",
            "value": {
              "calc": "starting_hands_won"
            }
          }
        }
      ]
    },
    {
      "use": "update",
      "label": "first hand due",
      "do": [
        {
          "set": {
            "key": "turn",
            "value": 0
          }
        },
        {
          "set": {
            "key": "starter_seat",
            "value": {
              "calc": "first_starter_seat"
            }
          }
        },
        {
          "set": {
            "key": "new_hand_due",
            "value": true
          }
        }
      ]
    },
    {
      "use": "sync",
      "label": "the table",
      "mode": "self",
      "to": "all",
      "text": "You start with:"
    }
  ],
  "steps": [
    {
      "use": "update",
      "phase": "deal",
      "label": "start a hand",
      "when": {
        "calc": "new_hand_due"
      },
      "do": [
        {
          "set": {
            "key": "deck",
            "value": {
              "calc": "[guard_rank] * guard_copies + [priest_rank] * priest_copies + [baron_rank] * baron_copies + [handmaid_rank] * handmaid_copies + [prince_rank] * prince_copies + [king_rank] * king_copies + [countess_rank] * countess_copies + [princess_rank] * princess_copies"
            }
          }
        },
        {
          "set": {
            "key": "removed",
            "value": []
          }
        },
        {
          "set": {
            "key": "burned",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
            "key": "hand",
            "value": []
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "append": {
            "key": "removed",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "append": {
            "key": "removed",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "append": {
            "key": "removed",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "append": {
            "player": {
              "calc": "starter_seat"
            },
            "key": "hand",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "append": {
            "player": {
              "calc": "3 - starter_seat"
            },
            "key": "hand",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "append": {
            "key": "burned",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "stake",
            "value": {
              "calc": "starting_stake"
            }
          }
        },
        {
          "set": {
            "key": "raised",
            "value": false
          }
        },
        {
          "set": {
            "key": "hand_over",
            "value": false
          }
        },
        {
          "set": {
            "key": "hand_winner",
            "value": 0
          }
        },
        {
          "set": {
            "players": "all",
            "key": "protected",
            "value": false
          }
        },
        {
          "set": {
            "players": "all",
            "key": "eliminated",
            "value": false
          }
        },
        {
          "set": {
            "players": "all",
            "key": "discard_sum",
            "value": 0
          }
        },
        {
          "set_status": {
            "players": "all",
            "to": "playing"
          }
        },
        {
          "set": {
            "key": "active_seat",
            "value": {
              "calc": "starter_seat"
            }
          }
        },
        {
          "set": {
            "key": "deck_count",
            "value": {
              "calc": "len(deck) + len(burned)"
            }
          }
        },
        {
          "set": {
            "key": "new_hand_due",
            "value": false
          }
        },
        {
          "set": {
            "key": "hand_start",
            "value": true
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "deal",
      "label": "announce the new hand",
      "when": {
        "calc": "hand_start"
      },
      "to": "all",
      "text": "A new hand begins. Removed face up, out of play: {removed}. Seat {starter_seat} starts and is active. Stake {stake}. Cards left in the deck: {deck_count}."
    },
    {
      "use": "sync",
      "phase": "deal",
      "label": "your card",
      "mode": "self",
      "to": "all",
      "fields": [
        "hand"
      ],
      "text": "Your card:"
    },
    {
      "use": "update",
      "phase": "turn",
      "label": "the turn begins",
      "do": [
        {
          "adjust": {
            "key": "turn",
            "value": 1
          }
        },
        {
          "set": {
            "key": "raise_choice",
            "value": ""
          }
        },
        {
          "set": {
            "key": "response",
            "value": ""
          }
        },
        {
          "set": {
            "key": "last_discard",
            "value": 0
          }
        },
        {
          "set": {
            "key": "guard_guess",
            "value": 0
          }
        },
        {
          "set": {
            "key": "prince_target",
            "value": 0
          }
        },
        {
          "set": {
            "key": "prince_discard",
            "value": 0
          }
        },
        {
          "set": {
            "key": "baron_loser",
            "value": 0
          }
        },
        {
          "set": {
            "key": "showdown",
            "value": false
          }
        },
        {
          "set": {
            "key": "hand_start",
            "value": false
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "raise",
      "label": "raise",
      "when": {
        "calc": "not raised"
      },
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "choice",
        "options": [
          "raise",
          "no raise"
        ]
      },
      "each": {
        "do": [
          {
            "set": {
              "key": "raise_choice",
              "value": "$answer"
            }
          }
        ]
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} chooses: {value}."
      },
      "text": "You are the active player and no raise has been made this hand. Before drawing, choose 'raise' or 'no raise'. Your card is shown in your state. If you raise, your opponent either concedes (you win the hand and 1 point, and the hand ends) or accepts (the stake becomes 2 and you go on to draw). If you do not raise, you draw at stake as it is."
    },
    {
      "use": "ask",
      "phase": "raise",
      "label": "response to a raise",
      "when": {
        "calc": "raise_choice == 'raise'"
      },
      "to": {
        "where": "you.seat == 3 - active_seat"
      },
      "answer": {
        "type": "choice",
        "options": [
          "accept",
          "concede"
        ]
      },
      "each": {
        "do": [
          {
            "set": {
              "key": "response",
              "value": "$answer"
            }
          }
        ]
      },
      "broadcast": {
        "to": "all",
        "text": "Seat {seat} answers the raise: {value}."
      },
      "text": "Your opponent has raised. Choose 'accept' or 'concede'. Your card is shown in your state. If you concede, your opponent wins this hand and gains 1 point, and the hand ends. If you accept, the stake becomes 2 for the rest of this hand, no further raise is possible, and play goes on."
    },
    {
      "use": "update",
      "phase": "draw",
      "label": "resolve the raise and draw",
      "do": [
        {
          "adjust": {
            "player": {
              "calc": "active_seat"
            },
            "key": "points",
            "value": {
              "calc": "concede_gain"
            },
            "if": {
              "calc": "response == 'concede'"
            },
            "text": "The raise was conceded: Seat {player} wins the hand and gains 1 point."
          }
        },
        {
          "adjust": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hands_won",
            "value": 1,
            "if": {
              "calc": "response == 'concede'"
            }
          }
        },
        {
          "set": {
            "key": "hand_winner",
            "value": {
              "calc": "active_seat"
            },
            "if": {
              "calc": "response == 'concede'"
            }
          }
        },
        {
          "set": {
            "key": "hand_over",
            "value": true,
            "if": {
              "calc": "response == 'concede'"
            }
          }
        },
        {
          "set": {
            "key": "stake",
            "value": {
              "calc": "raised_stake"
            },
            "if": {
              "calc": "response == 'accept'"
            },
            "text": "The raise is accepted: the stake for this hand is now {stake}."
          }
        },
        {
          "set": {
            "key": "raised",
            "value": true,
            "if": {
              "calc": "response == 'accept'"
            }
          }
        },
        {
          "set": {
            "player": {
              "calc": "active_seat"
            },
            "key": "protected",
            "value": false,
            "if": {
              "calc": "response != 'concede'"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            },
            "if": {
              "calc": "response != 'concede' and len(deck) > 0"
            }
          }
        },
        {
          "append": {
            "player": {
              "calc": "active_seat"
            },
            "key": "hand",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "response != 'concede' and len(deck) > 0"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            },
            "if": {
              "calc": "response != 'concede' and len(deck) > 0"
            }
          }
        },
        {
          "set": {
            "players": {
              "where": "you.seat == active_seat"
            },
            "key": "offer",
            "value": {
              "calc": "[countess_rank] if (countess_rank in you.hand and (prince_rank in you.hand or king_rank in you.hand)) else ([you.hand[0]] if you.hand[0] == you.hand[1] else [you.hand[0], you.hand[1]])"
            },
            "if": {
              "calc": "response != 'concede'"
            }
          }
        }
      ]
    },
    {
      "use": "sync",
      "phase": "draw",
      "label": "your two cards",
      "when": {
        "calc": "response != 'concede'"
      },
      "mode": "self",
      "to": {
        "where": "you.seat == active_seat"
      },
      "fields": [
        "hand"
      ],
      "text": "You drew. Your two cards:"
    },
    {
      "use": "ask",
      "phase": "play",
      "label": "card to discard",
      "when": {
        "calc": "response != 'concede' and len(players[active_seat - 1].offer) > 1"
      },
      "to": {
        "where": "you.seat == active_seat"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "each": {
        "do": [
          {
            "set": {
              "key": "last_discard",
              "value": {
                "calc": "int($answer)"
              }
            }
          }
        ]
      },
      "text": "Choose which of your two cards to discard face up; both are shown in your state. 1 Guard, 2 Priest, 3 Baron, 4 Handmaid, 5 Prince, 6 King, 7 Countess, 8 Princess. Discarding the Princess eliminates you."
    },
    {
      "use": "update",
      "phase": "play",
      "label": "discard bookkeeping",
      "when": {
        "calc": "response != 'concede'"
      },
      "do": [
        {
          "set": {
            "key": "last_discard",
            "value": {
              "calc": "players[active_seat - 1].offer[0]"
            },
            "if": {
              "calc": "last_discard == 0"
            }
          }
        },
        {
          "remove": {
