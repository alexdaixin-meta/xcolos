            "if": {
              "calc": "last_discard == handmaid_rank"
            },
            "text": "Seat {player} is protected by the Handmaid until the start of their next turn."
          }
        },
        {
          "set": {
            "player": {
              "calc": "active_seat"
            },
            "key": "eliminated",
            "value": true,
            "if": {
              "calc": "last_discard == princess_rank"
            }
          }
        },
        {
          "set_status": {
            "player": {
              "calc": "active_seat"
            },
            "to": "out",
            "if": {
              "calc": "last_discard == princess_rank"
            },
