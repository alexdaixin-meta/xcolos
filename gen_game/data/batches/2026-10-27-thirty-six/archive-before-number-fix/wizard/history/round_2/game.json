              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "append": {
            "player": 2,
            "key": "hand",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "append": {
            "player": 2,
            "key": "hand",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "append": {
            "player": 2,
            "key": "hand",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "append": {
            "player": 3,
            "key": "hand",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "append": {
            "player": 3,
            "key": "hand",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "append": {
            "player": 3,
            "key": "hand",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "pick",
            "value": {
              "calc": "deck[int(uniform(0, len(deck)))]"
            }
          }
        },
        {
          "set": {
            "key": "trump_card",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "remove": {
            "key": "deck",
            "value": {
              "calc": "pick"
            }
          }
        },
        {
          "set": {
            "key": "trump_suit",
            "value": {
              "calc": "trump_card[0] if trump_card[0] in ['R', 'B', 'G'] else 'none'"
            }
          }
        },
        {
          "set": {
            "key": "leader",
            "value": {
              "calc": "((hand_number - 1) % len(players)) + 1"
            }
          }
        }
      ],
      "text": "Hand {hand_number} is dealt. The trump card is {trump_card} (trump suit: {trump_suit}). Seat {leader} leads."
    },
    {
      "use": "sync",
      "phase": "deal",
      "label": "the new hand",
      "when": {
        "calc": "trick_in_hand == starting_trick_in_hand"
      },
      "mode": "self",
      "to": "all",
      "fields": [
        "hand",
        "score"
      ],
      "text": "Hand {hand_number} of {hands}. Trump card: {trump_card} (trump suit: {trump_suit}). Seat {leader} leads. Your cards and score:"
    },
    {
      "use": "poll",
      "phase": "bid",
      "label": "bidding",
      "when": {
        "calc": "trick_in_hand == starting_trick_in_hand"
      },
      "to": "acting",
      "answer": {
        "type": "choice",
        "options": [
          "0",
          "1",
          "2",
          "3"
        ]
      },
      "store": "bid_answer",
      "text": "Hand {hand_number}. Trump card {trump_card} (trump suit {trump_suit}); seat {leader} leads. Bid how many of the {tricks_per_hand} tricks you will take: 0, 1, 2 or 3. Exactly right scores {exact_bid_bonus} + {points_per_trick_when_exact} per trick taken; otherwise you lose {penalty_per_trick_off} per trick you are off."
    },
    {
      "use": "update",
      "phase": "bid",
      "label": "the bids",
      "when": {
        "calc": "trick_in_hand == starting_trick_in_hand"
      },
      "do": [
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": {
              "calc": "int(you.bid_answer) if (you.bid_answer in ['0', '1', '2', '3'] or you.bid_answer in [0, 1, 2, 3]) else default_bid"
            }
          }
        }
      ],
      "text": "Bids for hand {hand_number}: Seat 1 {players[0].bid}, Seat 2 {players[1].bid}, Seat 3 {players[2].bid}."
    },
    {
      "use": "update",
      "phase": "trick",
      "label": "trick setup",
      "do": [
        {
          "set": {
            "key": "led_suit",
            "value": "none"
          }
        },
        {
          "set": {
            "key": "wizard_played",
            "value": false
          }
        },
        {
          "set": {
            "key": "best_value",
            "value": {
              "calc": "initial_best_value"
            }
          }
        },
        {
          "set": {
            "key": "best_seat",
            "value": 0
          }
        },
        {
          "set": {
            "key": "played_cards",
            "value": []
          }
        },
        {
          "set": {
            "players": "all",
            "key": "played_card",
            "value": ""
          }
        }
      ]
    },
    {
      "use": "update",
      "phase": "trick",
      "label": "offer for the leader",
      "do": [
        {
          "set": {
            "players": {
              "where": "you.seat == leader"
            },
            "key": "offer",
            "value": {
              "calc": "[c for c in you.hand if c[0] == led_suit or c[0] in ['W', 'J']] if (led_suit != 'none' and count(c[0] == led_suit for c in you.hand) > 0) else you.hand"
            }
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "trick",
      "label": "leader plays",
      "to": {
        "where": "you.seat == leader"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "c1"
      },
      "text": "Hand {hand_number}, trick {trick_in_hand}. Trump card {trump_card} (trump suit {trump_suit}). You lead: play one card from your offer."
    },
    {
      "use": "update",
      "phase": "trick",
      "label": "resolve the lead",
      "do": [
        {
          "set": {
            "key": "cur_seat",
            "value": {
              "calc": "leader"
            }
          }
        },
        {
          "set": {
            "key": "cur_card",
            "value": {
              "calc": "$c1 if $c1 in [p.offer for p in players if p.seat == cur_seat][0] else [p.offer for p in players if p.seat == cur_seat][0][0]"
            }
          }
        },
        {
          "remove": {
            "player": {
              "calc": "cur_seat"
            },
            "key": "hand",
            "value": {
              "calc": "cur_card"
            }
          }
        },
        {
          "set": {
            "player": {
              "calc": "cur_seat"
            },
            "key": "played_card",
            "value": {
              "calc": "cur_card"
            }
          }
        },
        {
          "append": {
            "key": "played_cards",
            "value": {
              "calc": "cur_card"
            }
          }
        },
        {
          "set": {
            "key": "led_suit",
            "value": {
              "calc": "cur_card[0] if (cur_card[0] in ['R', 'B', 'G'] and led_suit == 'none' and not wizard_played) else led_suit"
            }
          }
        },
        {
          "set": {
            "key": "wizard_played",
            "value": {
              "calc": "wizard_played or cur_card[0] == 'W'"
            }
          }
        },
        {
          "set": {
            "key": "cur_strength",
            "value": {
              "calc": "wizard_strength if cur_card[0] == 'W' else ((trump_strength_bonus + int(cur_card[1])) if cur_card[0] == trump_suit else (int(cur_card[1]) if cur_card[0] == led_suit else jester_or_offsuit_strength))"
            }
          }
        },
        {
          "set": {
            "key": "best_seat",
            "value": {
              "calc": "cur_seat"
            },
            "if": {
              "calc": "cur_strength > best_value"
            }
          }
        },
        {
          "set": {
            "key": "best_value",
            "value": {
              "calc": "max(best_value, cur_strength)"
            }
          }
        }
      ],
      "text": "Seat {cur_seat} plays {cur_card}."
    },
    {
      "use": "update",
      "phase": "trick",
      "label": "offer for the second player",
      "do": [
        {
          "set": {
            "players": {
              "where": "you.seat == (leader % len(players)) + 1"
            },
            "key": "offer",
            "value": {
              "calc": "[c for c in you.hand if c[0] == led_suit or c[0] in ['W', 'J']] if (led_suit != 'none' and count(c[0] == led_suit for c in you.hand) > 0) else you.hand"
            }
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "trick",
      "label": "second player plays",
      "to": {
        "where": "you.seat == (leader % len(players)) + 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "c2"
      },
      "text": "Hand {hand_number}, trick {trick_in_hand}. Trump suit {trump_suit}, led suit {led_suit}. Cards played so far: {played_cards}. Play one card from your offer."
    },
    {
      "use": "update",
      "phase": "trick",
      "label": "resolve the second card",
      "do": [
        {
          "set": {
            "key": "cur_seat",
            "value": {
              "calc": "(leader % len(players)) + 1"
            }
          }
        },
        {
          "set": {
            "key": "cur_card",
            "value": {
              "calc": "$c2 if $c2 in [p.offer for p in players if p.seat == cur_seat][0] else [p.offer for p in players if p.seat == cur_seat][0][0]"
            }
          }
        },
        {
          "remove": {
            "player": {
              "calc": "cur_seat"
            },
            "key": "hand",
            "value": {
              "calc": "cur_card"
            }
          }
        },
        {
          "set": {
            "player": {
              "calc": "cur_seat"
            },
            "key": "played_card",
            "value": {
              "calc": "cur_card"
            }
          }
        },
        {
          "append": {
            "key": "played_cards",
            "value": {
              "calc": "cur_card"
            }
          }
        },
        {
          "set": {
            "key": "led_suit",
            "value": {
              "calc": "cur_card[0] if (cur_card[0] in ['R', 'B', 'G'] and led_suit == 'none' and not wizard_played) else led_suit"
            }
          }
        },
        {
          "set": {
            "key": "wizard_played",
            "value": {
              "calc": "wizard_played or cur_card[0] == 'W'"
            }
          }
        },
        {
          "set": {
            "key": "cur_strength",
            "value": {
              "calc": "wizard_strength if cur_card[0] == 'W' else ((trump_strength_bonus + int(cur_card[1])) if cur_card[0] == trump_suit else (int(cur_card[1]) if cur_card[0] == led_suit else jester_or_offsuit_strength))"
            }
          }
        },
        {
          "set": {
            "key": "best_seat",
            "value": {
              "calc": "cur_seat"
            },
            "if": {
              "calc": "cur_strength > best_value"
            }
          }
        },
        {
          "set": {
            "key": "best_value",
            "value": {
              "calc": "max(best_value, cur_strength)"
            }
          }
        }
      ],
      "text": "Seat {cur_seat} plays {cur_card}."
    },
    {
      "use": "update",
      "phase": "trick",
      "label": "offer for the third player",
      "do": [
        {
          "set": {
            "players": {
              "where": "you.seat == ((leader + 1) % len(players)) + 1"
            },
            "key": "offer",
            "value": {
              "calc": "[c for c in you.hand if c[0] == led_suit or c[0] in ['W', 'J']] if (led_suit != 'none' and count(c[0] == led_suit for c in you.hand) > 0) else you.hand"
            }
          }
        }
      ]
    },
    {
      "use": "ask",
      "phase": "trick",
      "label": "third player plays",
      "to": {
        "where": "you.seat == ((leader + 1) % len(players)) + 1"
      },
      "answer": {
        "type": "choice",
        "options": {
          "attribute": "offer"
        }
      },
      "verify": {
        "bind": "c3"
      },
      "text": "Hand {hand_number}, trick {trick_in_hand}. Trump suit {trump_suit}, led suit {led_suit}. Cards played so far: {played_cards}. Play one card from your offer."
    },
    {
      "use": "update",
      "phase": "trick",
      "label": "resolve the third card",
      "do": [
        {
          "set": {
            "key": "cur_seat",
            "value": {
              "calc": "((leader + 1) % len(players)) + 1"
            }
          }
        },
        {
          "set": {
            "key": "cur_card",
            "value": {
              "calc": "$c3 if $c3 in [p.offer for p in players if p.seat == cur_seat][0] else [p.offer for p in players if p.seat == cur_seat][0][0]"
            }
          }
        },
        {
          "remove": {
            "player": {
              "calc": "cur_seat"
            },
            "key": "hand",
            "value": {
              "calc": "cur_card"
            }
          }
        },
        {
          "set": {
            "player": {
              "calc": "cur_seat"
            },
            "key": "played_card",
            "value": {
              "calc": "cur_card"
            }
          }
        },
        {
          "append": {
            "key": "played_cards",
            "value": {
              "calc": "cur_card"
            }
          }
        },
        {
          "set": {
            "key": "led_suit",
            "value": {
              "calc": "cur_card[0] if (cur_card[0] in ['R', 'B', 'G'] and led_suit == 'none' and not wizard_played) else led_suit"
            }
          }
        },
        {
          "set": {
            "key": "wizard_played",
            "value": {
              "calc": "wizard_played or cur_card[0] == 'W'"
            }
          }
        },
        {
          "set": {
            "key": "cur_strength",
            "value": {
              "calc": "wizard_strength if cur_card[0] == 'W' else ((trump_strength_bonus + int(cur_card[1])) if cur_card[0] == trump_suit else (int(cur_card[1]) if cur_card[0] == led_suit else jester_or_offsuit_strength))"
            }
          }
        },
        {
          "set": {
            "key": "best_seat",
            "value": {
              "calc": "cur_seat"
            },
            "if": {
              "calc": "cur_strength > best_value"
            }
          }
        },
        {
          "set": {
            "key": "best_value",
            "value": {
              "calc": "max(best_value, cur_strength)"
            }
          }
        }
      ],
      "text": "Seat {cur_seat} plays {cur_card}."
    },
    {
      "use": "update",
      "phase": "trick",
      "label": "end of trick",
      "do": [
        {
          "adjust": {
            "player": {
              "calc": "best_seat"
            },
            "key": "tricks_taken",
            "value": 1
          }
        },
        {
          "set": {
            "key": "leader",
            "value": {
              "calc": "best_seat"
            }
          }
        }
      ],
      "text": "Seat {best_seat} wins the trick ({played_cards}) and leads next."
    },
    {
      "use": "update",
      "phase": "score",
      "label": "score or advance",
      "do": [
        {
          "adjust": {
            "players": "all",
            "key": "score",
            "value": {
              "calc": "(exact_bid_bonus + points_per_trick_when_exact * you.tricks_taken) if you.tricks_taken == you.bid else (0 - penalty_per_trick_off * abs(you.tricks_taken - you.bid))"
            },
            "if": {
              "calc": "trick_in_hand == tricks_per_hand"
            }
          }
        },
        {
          "set": {
            "players": "all",
            "key": "bid",
            "value": {
              "calc": "bid_min"
            },
            "if": {
              "calc": "trick_in_hand == tricks_per_hand"
            }
          }
        },
        {
          "set": {
            "key": "trick_in_hand",
            "value": {
              "calc": "starting_trick_in_hand if trick_in_hand == tricks_per_hand else trick_in_hand + 1"
            }
          }
        }
      ]
    },
    {
      "use": "tell",
      "phase": "score",
      "label": "the hand is scored",
      "when": {
        "calc": "trick_in_hand == starting_trick_in_hand"
      },
      "to": "all",
      "text": "Hand {hand_number} is scored. Scores: Seat 1 {players[0].score}, Seat 2 {players[1].score}, Seat 3 {players[2].score}."
    },
    {
      "use": "check",
      "phase": "score",
      "label": "after hand 12",
      "when": {
        "calc": "hand_number >= hands and trick_in_hand == starting_trick_in_hand"
      },
      "against": [
        "over"
      ]
    }
  ],
  "end": {
    "over": {
      "when": {
        "calc": "hand_number >= hands and trick_in_hand == starting_trick_in_hand"
      },
      "rank_by": "you.score",
      "text": "Winner: {result}. Final scores: Seat 1 {players[0].score}, Seat 2 {players[1].score}, Seat 3 {players[2].score}."
    }
  },
  "limits": {
    "rounds": 36,
    "rounds_max": 40,
    "actions_max": 3000,
    "deadline_s": 120
  },
  "rules": "Three players, seats 1, 2 and 3, each starting with a score of {starting_score}. The deck has {deck_size} cards: Red R1-R8, Blue B1-B8 and Green G1-G8 (the letter is the suit, the number the rank), two Wizards (W1, W2) and two Jesters (J1, J2). The game has {hands} hands of {tricks_per_hand} tricks each, {rounds} tricks in all.\n\nNew hand: all {deck_size} cards are shuffled into the deck, every hand is emptied and every tricks_taken is set to 0. Each player is dealt {cards_dealt_per_player} cards (seat 1, then seat 2, then seat 3), seen only by their owner. The next card, the {trump_card_position}th, is turned face up as the trump card; {cards_left_in_deck_after_deal} cards stay in the deck. If the trump card is suited, its suit letter is the trump suit; if it is a Wizard or a Jester, there is no trump suit (none) for the whole hand. The first trick of hand n is led by seat ((n - 1) mod 3) + 1: seat 1 in hands 1, 4, 7, 10; seat 2 in hands 2, 5, 8, 11; seat 3 in hands 3, 6, 9, 12.\n\nBidding: at the start of each hand all three players bid at the same time how many tricks they will take, choosing 0, 1, 2 or 3. Each bid is kept exactly as given (a 0 stays 0); a missing or invalid bid becomes {default_bid}. All bids are then announced. They need not sum to {tricks_per_hand}.\n\nEach trick: the leader plays first, then seat (leader mod 3) + 1, then seat ((leader + 1) mod 3) + 1. Each player sees the cards already played. If a suit has been led and you hold a card of that suit, you must play a card of the led suit or a Wizard or Jester; otherwise you may play any card in your hand. A missing or illegal answer plays the first legal card in hand order.\n\nThe first suited card played sets the led suit, unless a Wizard was played before it, in which case no suit is led. Wizards and Jesters never set the led suit. A card's strength is {wizard_strength} for a Wizard, {trump_strength_bonus} + rank for a trump card, its rank for a card of the led suit, and {jester_or_offsuit_strength} for a Jester or any other card. A card takes the lead only if its strength is strictly greater than the current best, so the first Wizard wins; otherwise the highest trump wins; otherwise the highest card of the led suit; if all three cards are Jesters, the first Jester wins. The winner of the trick adds 1 to tricks_taken and leads the next trick.\n\nScoring after the third trick of a hand: if your tricks taken equal your bid, you gain {exact_bid_bonus} + {points_per_trick_when_exact} x tricks taken (bid 0 and take 0: +20; bid 2 and take 2: +40). If not, you lose {penalty_per_trick_off} x the difference between tricks taken and bid (bid 3 and take 1: -20). All scores are announced, every bid is reset to 0 and the next hand begins.\n\nAfter hand {hands} the highest score wins; players tied at the top share the win."
}
